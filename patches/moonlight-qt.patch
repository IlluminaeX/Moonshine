+SDL_Surface* OverlayManager::renderStatsPanel(const char* text)
+{
+    // Scale with the screen, so it reads the same at 1080p and 4K.
+    SDL_DisplayMode mode;
+    int scale = 100;
+    if (SDL_GetCurrentDisplayMode(0, &mode) == 0 && mode.h > 1200) {
+        scale = SDL_min(mode.h * 100 / 1080, 200);
+    }
+    auto px = [&](float v) { return (int)std::lround(v * scale / 100.0f); };
+
+    if (scale != m_PanelScale) {
+        for (TTF_Font*& font : m_PanelFonts) {
+            if (font != nullptr) {
+                TTF_CloseFont(font);
+                font = nullptr;
+            }
+        }
+        m_PanelScale = scale;
+    }
+    if (m_PanelFonts[0] == nullptr) {
+        const char* files[4] = { "segoeui.ttf", "seguisb.ttf", "segoeui.ttf", "seguisb.ttf" };
+        const int sizes[4] = { px(13), px(13), px(11), px(26) };
+        char winDir[MAX_PATH] = "C:\\Windows";
+#ifdef Q_OS_WIN32
+        GetWindowsDirectoryA(winDir, sizeof(winDir));
+#endif
+        for (int i = 0; i < 4; i++) {
+            char path[MAX_PATH + 32];
+            snprintf(path, sizeof(path), "%s\\Fonts\\%s", winDir, files[i]);
+            m_PanelFonts[i] = TTF_OpenFont(path, sizes[i]);
+            if (m_PanelFonts[i] == nullptr && !m_FontData.isEmpty()) {
+                // No Segoe UI: fall back to the bundled font
+                m_PanelFonts[i] = TTF_OpenFontRW(SDL_RWFromConstMem(m_FontData.constData(), m_FontData.size()), 1, sizes[i]);
+            }
+            if (m_PanelFonts[i] == nullptr) {
+                return nullptr;
+            }
+        }
+    }
+    TTF_Font* labelFont = m_PanelFonts[0];
+    TTF_Font* valueFont = m_PanelFonts[1];
+    TTF_Font* smallFont = m_PanelFonts[2];
+    TTF_Font* bigFont = m_PanelFonts[3];
+
+    struct Row { QByteArray label, value, note; int level; };
+    QByteArray title, total;
+    int totalLevel = 0, worst = 0;
+    std::vector<Row> rows;
+    for (const QByteArray& line : QByteArray(text).split('\n')) {
+        QList<QByteArray> parts = line.split('\t');
+        if (parts.size() < 2 || parts[0] == "%") {
+            continue;
+        }
+        if (parts[0] == "#") {
+            title = parts[1];
+        }
+        else if (parts[0] == "!") {
+            total = parts[1] + " ms";
+            totalLevel = parts.size() >= 3 ? parts[2].toInt() : 0;
+            worst = SDL_max(worst, totalLevel);
+        }
+        else {
+            Row row { parts[0], parts[1], parts.size() >= 4 ? parts[3] : QByteArray(), parts.size() >= 3 ? parts[2].toInt() : 0 };
+            worst = SDL_max(worst, row.level);
+            rows.push_back(row);
+        }
+    }
+
+    const SDL_Color muted = { 0xB6, 0xA6, 0xBD, 0xFF };
+    const SDL_Color dim = { 0x8A, 0x7A, 0x94, 0xFF };
+    const SDL_Color white = { 0xF7, 0xF1, 0xF3, 0xFF };
+    const SDL_Color crimson = { 0xFF, 0x54, 0x70, 0xFF };
+    const SDL_Color levels[4] = { white, { 0x4F, 0xE0, 0xA0, 0xFF }, { 0xFF, 0xB3, 0x5C, 0xFF }, { 0xFF, 0x6B, 0x7B, 0xFF } };
+    // The accent stays crimson unless something is off, then it turns amber or red.
+    const SDL_Color accent = worst >= 2 ? levels[worst] : crimson;
+    const SDL_Color dot = worst >= 2 ? levels[worst] : levels[1];
+    const int margin = px(14);
+
+    auto card = [&](int w, int h, float radius) {
+        SDL_Surface* s = SDL_CreateRGBSurfaceWithFormat(0, w + margin * 2, h + margin * 2, 32, SDL_PIXELFORMAT_ARGB8888);
+        if (s != nullptr) {
+            SDL_FillRect(s, nullptr, 0);
+            fillRoundedRect(s, margin - px(2), margin + px(2), w + px(4), h + px(4), radius + px(2), { 0, 0, 0, 70 });
+            fillRoundedRect(s, margin, margin, w, h, radius, { 0x43, 0x35, 0x4F, 0xE0 });
+            fillRoundedRect(s, margin + 1, margin + 1, w - 2, h - 2, radius - 1, { 0x23, 0x1B, 0x2E, 0xE6 });
+        }
+        return s;
+    };
+
+    // ---- Compact: one slim line, e.g. "● 44 ms · 60 FPS · 5.3 Mbps"
+    if (m_DebugCompact) {
+        QByteArray fps, bitrate;
+        for (const Row& row : rows) {
+            if (row.label == "Frame rate") fps = row.value;
+            if (row.label == "Bitrate") bitrate = row.value;
+        }
+        struct Piece { QByteArray text; SDL_Color color; };
+        std::vector<Piece> pieces;
+        auto addPiece = [&](const QByteArray& t, SDL_Color c) {
+            if (t.isEmpty()) return;
+            if (!pieces.empty()) pieces.push_back({ "  \xC2\xB7  ", dim });
+            pieces.push_back({ t, c });
+        };
+        addPiece(total, levels[totalLevel]);
+        addPiece(fps, white);
+        addPiece(bitrate, white);
+        if (pieces.empty()) {
+            addPiece("Waiting for stats\xE2\x80\xA6", muted);
+        }
+
+        const int padX = px(12), height = TTF_FontLineSkip(valueFont) + px(10);
+        int width = padX * 2 + px(14);
+        for (const Piece& p : pieces) width += textWidth(valueFont, p.text.constData());
+        SDL_Surface* s = card(width, height, height / 2.0f);
+        if (s == nullptr) return nullptr;
+        int x = margin + padX;
+        fillRoundedRect(s, x, margin + height / 2.0f - px(3.5f), px(7), px(7), px(3.5f), dot);
+        x += px(14);
+        int y = margin + (height - TTF_FontLineSkip(valueFont)) / 2;
+        for (const Piece& p : pieces) {
+            blitText(valueFont, p.text.constData(), p.color, s, x, y);
+            x += textWidth(valueFont, p.text.constData());
+        }
+        return applyOpacity(s, m_DebugOpacity);
+    }
+
+    // ---- Full panel
+    std::vector<float> history[2];
+    SDL_AtomicLock(&m_HistoryLock);
+    history[0] = m_History[0];
+    history[1] = m_History[1];
+    SDL_AtomicUnlock(&m_HistoryLock);
+
+    const int pad = px(14), gap = px(22), rowGap = px(3);
+    const int lineH = TTF_FontLineSkip(valueFont);
+    const int smallH = TTF_FontLineSkip(smallFont);
+    const int bigH = TTF_FontLineSkip(bigFont);
+    const int graphH = px(34);
+
+    int labelW = 0, valueW = 0;
+    for (const Row& row : rows) {
+        labelW = SDL_max(labelW, textWidth(labelFont, row.label.constData()));
+        int w = textWidth(valueFont, row.value.constData());
+        if (!row.note.isEmpty()) w += px(8) + textWidth(smallFont, row.note.constData());
+        valueW = SDL_max(valueW, w);
+    }
+    int brandW = textWidth(smallFont, "MOONSHINE");
+    int contentW = SDL_max(labelW + gap + valueW, px(250));
+    contentW = SDL_max(contentW, px(14) + textWidth(valueFont, title.constData()) + px(16) + brandW);
+
+    bool graphs = history[0].size() >= 2 || history[1].size() >= 2;
+    int height = pad * 2 + lineH + px(8);                         // header
+    if (!total.isEmpty()) height += bigH + px(4);                 // total delay
+    if (graphs) height += smallH + graphH + px(10);               // mini-graphs
+    height += px(10) + (int)rows.size() * (lineH + rowGap) - rowGap; // divider + rows
+    int width = pad * 2 + px(8) + contentW;
+
+    SDL_Surface* s = card(width, height, px(14));
+    if (s == nullptr) return nullptr;
+    fillRoundedRect(s, margin + pad - px(3), margin + pad, px(2), height - pad * 2, px(1), accent);
+
+    const int x = margin + pad + px(8);
+    int y = margin + pad - px(1);
+
+    // Header: status dot, what's being streamed, and the brand on the right
+    fillRoundedRect(s, x, y + lineH / 2.0f - px(3.5f), px(7), px(7), px(3.5f), dot);
+    blitText(valueFont, title.constData(), white, s, x + px(14), y);
+    blitText(smallFont, "MOONSHINE", crimson, s, x + contentW - brandW, y + (lineH - smallH) / 2);
+    y += lineH + px(8);
+
+    // The delay you feel, large
+    if (!total.isEmpty()) {
+        blitText(bigFont, total.constData(), levels[totalLevel], s, x, y);
+        int w = textWidth(bigFont, total.constData());
+        blitText(smallFont, "total delay", muted, s, x + w + px(8), y + bigH - smallH - px(5));
+        y += bigH + px(4);
+    }
+
+    // Mini-graphs of the last 30 seconds: network (one way) and frame rate
+    if (graphs) {
+        int graphW = (contentW - px(12)) / 2;
+        const char* names[2] = { "Network", "Frame rate" };
+        for (int i = 0; i < 2; i++) {
+            int gx = x + i * (graphW + px(12));
+            blitText(smallFont, names[i], dim, s, gx, y);
+            fillRoundedRect(s, gx, y + smallH, graphW, graphH, px(4), { 0xFF, 0xFF, 0xFF, 0x0A });
+            float peak = 0;
+            for (float v : history[i]) peak = SDL_max(peak, v);
+            float top = i == 0 ? SDL_max(peak * 1.25f, 40.0f) : SDL_max(peak * 1.1f, 30.0f);
+            drawSparkline(s, gx + px(3), y + smallH + px(3), graphW - px(6), graphH - px(6), history[i], top,
+                          i == 0 ? crimson : levels[1], SDL_max(px(1.6f), 1));
+        }
+        y += smallH + graphH + px(10);
+    }
+
+    // Divider, then the rows: label left; note (small, grey) and value right
+    fillRoundedRect(s, x, y, contentW, 1, 0, { 0xFF, 0xFF, 0xFF, 0x1C });
+    y += px(10);
+    for (const Row& row : rows) {
+        blitText(labelFont, row.label.constData(), muted, s, x, y + (lineH - TTF_FontLineSkip(labelFont)) / 2);
+        int w = textWidth(valueFont, row.value.constData());
+        blitText(valueFont, row.value.constData(), levels[SDL_clamp(row.level, 0, 3)], s, x + contentW - w, y);
+        if (!row.note.isEmpty()) {
+            int nw = textWidth(smallFont, row.note.constData());
+            blitText(smallFont, row.note.constData(), dim, s, x + contentW - w - px(8) - nw, y + (lineH - smallH) / 2 + px(1));
+        }
+        y += lineH + rowGap;
+    }
+
+    return applyOpacity(s, m_DebugOpacity);
+}
