diff --git a/app/streaming/audio/audio.cpp b/app/streaming/audio/audio.cpp
index 4668eec9..b3cb5320 100644
--- a/app/streaming/audio/audio.cpp
+++ b/app/streaming/audio/audio.cpp
@@ -9,6 +9,143 @@
 
 #include <Limelight.h>
 
+#include <QString>
+#include <cmath>
+
+// Moonshine: volume boost, 1x to 10x, for a PC whose own volume is turned down. Moonshine writes it
+// ("2.5") to the file named by MOONSHINE_VOLUME_FILE, which is read twice a second; Ctrl+Alt+Shift+Up
+// and Down change it during the stream and write it back, so Moonshine shows the same value.
+static SDL_atomic_t s_VolumeMilli = { 1000 };
+static SDL_atomic_t s_VolumeNoticeId = { 0 };
+static const int k_VolumeSteps[] = { 1000, 1250, 1500, 2000, 2500, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000 };
+static const int k_VolumeStepCount = sizeof(k_VolumeSteps) / sizeof(k_VolumeSteps[0]);
+
+static QByteArray volumeFilePath()
+{
+    return qEnvironmentVariable("MOONSHINE_VOLUME_FILE").toUtf8();
+}
+
+static void readVolumeFile()
+{
+    QByteArray path = volumeFilePath();
+    if (path.isEmpty()) {
+        return;
+    }
+    SDL_RWops* rw = SDL_RWFromFile(path.constData(), "rb");
+    if (rw == nullptr) {
+        return;
+    }
+    char text[32] = {};
+    size_t read = SDL_RWread(rw, text, 1, sizeof(text) - 1);
+    SDL_RWclose(rw);
+    if (read > 0) {
+        double value = SDL_atof(text);
+        if (value > 0) {
+            SDL_AtomicSet(&s_VolumeMilli, SDL_max(1000, SDL_min(10000, (int)lround(value * 1000))));
+        }
+    }
+}
+
+static void writeVolumeFile(int milli)
+{
+    QByteArray path = volumeFilePath();
+    if (path.isEmpty()) {
+        return;
+    }
+    SDL_RWops* rw = SDL_RWFromFile(path.constData(), "wb");
+    if (rw != nullptr) {
+        char text[32];
+        int len = SDL_snprintf(text, sizeof(text), "%.2f", milli / 1000.0);
+        SDL_RWwrite(rw, text, 1, len);
+        SDL_RWclose(rw);
+    }
+}
+
+// Loud parts bend smoothly towards full scale instead of clipping harshly.
+static inline float softClip(float x)
+{
+    const float knee = 0.8f;
+    float a = fabsf(x);
+    if (a <= knee) {
+        return x;
+    }
+    float y = knee + (1.0f - knee) * tanhf((a - knee) / (1.0f - knee));
+    return x < 0 ? -y : y;
+}
+
+static void applyVolume(void* buffer, int bytes, bool isFloat)
+{
+    int milli = SDL_AtomicGet(&s_VolumeMilli);
+    if (milli == 1000 || bytes <= 0) {
+        return;
+    }
+    float gain = milli / 1000.0f;
+    if (isFloat) {
+        float* samples = (float*)buffer;
+        int count = bytes / (int)sizeof(float);
+        for (int i = 0; i < count; i++) {
+            samples[i] = softClip(samples[i] * gain);
+        }
+    }
+    else {
+        short* samples = (short*)buffer;
+        int count = bytes / (int)sizeof(short);
+        for (int i = 0; i < count; i++) {
+            samples[i] = (short)lrintf(softClip(samples[i] / 32768.0f * gain) * 32767.0f);
+        }
+    }
+}
+
+static Uint32 hideVolumeNotice(Uint32, void* param)
+{
+    Session* session = Session::get();
+    if (session != nullptr && SDL_AtomicGet(&s_VolumeNoticeId) == (int)(intptr_t)param) {
+        session->getOverlayManager().setOverlayState(Overlay::OverlayStatusUpdate, false);
+    }
+    return 0;
+}
+
+void Session::adjustVolumeBoost(int direction)
+{
+    readVolumeFile(); // Moonshine may have changed it since the last read
+    int current = SDL_AtomicGet(&s_VolumeMilli);
+    int milli = current;
+    if (direction > 0) {
+        // the first step above the current value
+        for (int i = 0; i < k_VolumeStepCount; i++) {
+            if (k_VolumeSteps[i] > current) {
+                milli = k_VolumeSteps[i];
+                break;
+            }
+        }
+    }
+    else {
+        // the last step below it
+        for (int i = k_VolumeStepCount - 1; i >= 0; i--) {
+            if (k_VolumeSteps[i] < current) {
+                milli = k_VolumeSteps[i];
+                break;
+            }
+        }
+    }
+    SDL_AtomicSet(&s_VolumeMilli, milli);
+    writeVolumeFile(milli);
+
+    if (s_ActiveSession != nullptr) {
+        char text[64];
+        if (milli == 1000) {
+            SDL_snprintf(text, sizeof(text), "Volume boost off");
+        }
+        else {
+            SDL_snprintf(text, sizeof(text), "Volume boost %gx", milli / 1000.0);
+        }
+        int id = SDL_AtomicIncRef(&s_VolumeNoticeId) + 1;
+        s_ActiveSession->m_OverlayManager.updateOverlayText(Overlay::OverlayStatusUpdate, text);
+        s_ActiveSession->m_OverlayManager.setOverlayState(Overlay::OverlayStatusUpdate, true);
+        SDL_AddTimer(2000, hideVolumeNotice, (void*)(intptr_t)id);
+    }
+}
+
