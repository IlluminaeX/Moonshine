+// Levels for the overlay's value colours: 0 plain, 1 good, 2 so-so, 3 bad.
+static int overlayLevel(double value, double good, double bad)
+{
+    return value <= good ? 1 : value <= bad ? 2 : 3;
+}
+
+void FFmpegVideoDecoder::stringifyOverlayStats(VIDEO_STATS& stats, char* output, int length)
+{
+    // Lines: "#\ttitle", "!\ttotal ms\tlevel", "%\tgraph\tvalue", and "label\tvalue\tlevel\tnote" rows.
+    int offset = 0;
+    output[0] = 0;
+    auto add = [&](const char* format, ...) {
+        if (offset >= length - 1) {
+            return;
+        }
+        va_list args;
+        va_start(args, format);
+        int ret = vsnprintf(&output[offset], length - offset, format, args);
+        va_end(args);
+        if (ret > 0) {
+            offset = SDL_min(offset + ret, length - 1);
+        }
+    };
+
+    if (m_VideoDecoderCtx != nullptr) {
+        add("#\t%d\xC3\x97%d \xC2\xB7 %s \xC2\xB7 %.0f FPS\n",
+            m_VideoDecoderCtx->width, m_VideoDecoderCtx->height, getCodecString(), stats.totalFps);
+    }
+    else {
+        add("#\t%s\n", getCodecString());
+    }
+
+    // What the delay is made of: the network one way (half the round trip), the host's
+    // capture and encode, and this PC's decode, queue and render.
+    double network = stats.lastRtt / 2.0;
+    double host = stats.framesWithHostProcessingLatency > 0 ?
+        (double)stats.totalHostProcessingLatency / 10 / stats.framesWithHostProcessingLatency : -1;
+    double local = -1;
+    if (stats.decodedFrames != 0 && stats.renderedFrames != 0) {
+        local = (double)(stats.totalDecodeTimeUs / 1000.0) / stats.decodedFrames +
+                (double)(stats.totalPacerTimeUs / 1000.0) / stats.renderedFrames +
+                (double)(stats.totalRenderTimeUs / 1000.0) / stats.renderedFrames;
+    }
+
+    if (stats.lastRtt != 0) {
+        double total = network + SDL_max(host, 0.0) + SDL_max(local, 0.0);
+        add("!\t%.0f\t%d\n", total, overlayLevel(total, 40, 80));
+        add("%%\tnet\t%.1f\n", network);
+        add("Network\t%.0f ms\t%d\t%u ms round trip  \xC2\xB1%u\n",
+            network, overlayLevel(network, 25, 50), stats.lastRtt, stats.lastRttVariance);
+    }
+    if (stats.receivedFps > 0) {
+        double behind = stats.totalFps > 0 ? (stats.totalFps - stats.renderedFps) / stats.totalFps * 100 : 0;
+        add("%%\tfps\t%.1f\n", stats.renderedFps);
+        add("Frame rate\t%.0f FPS\t%d\t\n", stats.renderedFps, overlayLevel(behind, 3, 10));
+    }
+    double mbps = m_BwTracker.GetAverageMbps();
+    if (mbps > 0) {
+        add("Bitrate\t%.1f Mbps\t0\t\n", mbps);
+    }
+    if (stats.renderedFrames != 0 && stats.totalFrames != 0 && stats.decodedFrames != 0) {
+        double networkDrops = (double)stats.networkDroppedFrames / stats.totalFrames * 100;
+        double jitterDrops = (double)stats.pacerDroppedFrames / stats.decodedFrames * 100;
+        add("Dropped frames\t%.1f%%\t%d\tnetwork %.1f \xC2\xB7 jitter %.1f\n",
+            networkDrops + jitterDrops, overlayLevel(networkDrops + jitterDrops, 0.1, 1.0), networkDrops, jitterDrops);
+    }
+    if (host >= 0) {
+        add("Host encode\t%.1f ms\t%d\t\n", host, overlayLevel(host, 8, 16));
+    }
+    if (local >= 0) {
+        add("This PC\t%.1f ms\t%d\tdecode + display\n", local, overlayLevel(local, 5, 12));
+    }
+}
