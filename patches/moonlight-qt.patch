+// Fades the whole panel to the opacity picked in Moonshine.
+static SDL_Surface* applyOpacity(SDL_Surface* s, int percent)
+{
+    if (s != nullptr && percent < 100) {
+        for (int y = 0; y < s->h; y++) {
+            Uint32* row = (Uint32*)((Uint8*)s->pixels + y * s->pitch);
+            for (int x = 0; x < s->w; x++) {
+                Uint32 a = (row[x] >> 24) * percent / 100;
+                row[x] = (row[x] & 0x00FFFFFF) | (a << 24);
+            }
+        }
+    }
+    return s;
+}
+
+// A filled mini-graph of the values, scaled so maxValue is the top.
+static void drawSparkline(SDL_Surface* s, int x, int y, int w, int h, const std::vector<float>& values, float maxValue, SDL_Color color, float thickness)
+{
+    if (values.size() < 2 || w < 2 || maxValue <= 0) {
+        return;
+    }
+    SDL_Color fill = { color.r, color.g, color.b, 0x30 };
+    for (int i = 0; i < w; i++) {
+        float t = (float)i / (w - 1) * (values.size() - 1);
+        size_t a = (size_t)t;
+        size_t b = SDL_min(a + 1, values.size() - 1);
+        float v = values[a] + (values[b] - values[a]) * (t - a);
+        float py = y + h - SDL_clamp(v / maxValue, 0.0f, 1.0f) * h;
+        fillRoundedRect(s, x + i, py, 1, y + h - py, 0, fill);
+        fillRoundedRect(s, x + i - thickness / 2, py - thickness / 2, thickness, thickness, thickness / 2, color);
+    }
+}
