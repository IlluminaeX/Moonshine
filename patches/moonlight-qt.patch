+namespace {
+    // Blend a colour into one ARGB8888 pixel with the given coverage (0-1).
+    void blendPixel(SDL_Surface* s, int x, int y, SDL_Color c, float coverage)
+    {
+        if (x < 0 || y < 0 || x >= s->w || y >= s->h || coverage <= 0) {
+            return;
+        }
+        Uint32* p = (Uint32*)((Uint8*)s->pixels + y * s->pitch) + x;
+        float sa = c.a / 255.0f * SDL_min(coverage, 1.0f);
+        float da = ((*p >> 24) & 0xFF) / 255.0f;
+        float oa = sa + da * (1 - sa);
+        if (oa <= 0) {
+            return;
+        }
+        auto mix = [&](int shift, Uint8 sc) {
+            float dc = ((*p >> shift) & 0xFF);
+            return (Uint32)SDL_clamp((sc * sa + dc * da * (1 - sa)) / oa, 0.0f, 255.0f);
+        };
+        *p = ((Uint32)(oa * 255) << 24) | (mix(16, c.r) << 16) | (mix(8, c.g) << 8) | mix(0, c.b);
+    }
+
+    // An anti-aliased rounded rectangle.
+    void fillRoundedRect(SDL_Surface* s, float x, float y, float w, float h, float r, SDL_Color c)
+    {
+        for (int py = (int)y; py < (int)std::ceil(y + h); py++) {
+            for (int px = (int)x; px < (int)std::ceil(x + w); px++) {
+                float cx = px + 0.5f, cy = py + 0.5f;
+                float dx = SDL_max(SDL_max(x + r - cx, cx - (x + w - r)), 0.0f);
+                float dy = SDL_max(SDL_max(y + r - cy, cy - (y + h - r)), 0.0f);
+                float coverage = r - std::sqrt(dx * dx + dy * dy) + 0.5f;
+                blendPixel(s, px, py, c, SDL_clamp(coverage, 0.0f, 1.0f));
+            }
+        }
+    }
+
+    void blitText(TTF_Font* font, const char* text, SDL_Color color, SDL_Surface* dst, int x, int y)
+    {
+        SDL_Surface* t = TTF_RenderUTF8_Blended(font, text, color);
+        if (t != nullptr) {
+            SDL_Rect r = { x, y, t->w, t->h };
+            SDL_SetSurfaceBlendMode(t, SDL_BLENDMODE_BLEND);
+            SDL_BlitSurface(t, nullptr, dst, &r);
+            SDL_FreeSurface(t);
+        }
+    }
+
+    int textWidth(TTF_Font* font, const char* text)
+    {
+        int w = 0, h = 0;
+        TTF_SizeUTF8(font, text, &w, &h);
+        return w;
+    }
+}
+
+// Fades the whole panel to the opacity picked in Moonshine.
+static SDL_Surface* applyOpacity(SDL_Surface* s, int percent)
+{
+    if (s != nullptr && percent < 100) {
+        for (int y = 0; y < s->h; y++) {
+            Uint32* row = (Uint32*)((Uint8*)s->pixels + y * s->pitch);
+            for (int x = 0; x < s->w; x++) {
+                Uint32 a = (row[x] >> 24) * percent / 100;
+                row[x] = (row[x] & 0x00FFFFFF) | (a << 24);
+            }
+        }
+    }
+    return s;
+}
+
+// A filled mini-graph of the values, scaled so maxValue is the top.
+static void drawSparkline(SDL_Surface* s, int x, int y, int w, int h, const std::vector<float>& values, float maxValue, SDL_Color color, float thickness)
+{
+    if (values.size() < 2 || w < 2 || maxValue <= 0) {
+        return;
+    }
+    SDL_Color fill = { color.r, color.g, color.b, 0x30 };
+    for (int i = 0; i < w; i++) {
+        float t = (float)i / (w - 1) * (values.size() - 1);
+        size_t a = (size_t)t;
+        size_t b = SDL_min(a + 1, values.size() - 1);
+        float v = values[a] + (values[b] - values[a]) * (t - a);
+        float py = y + h - SDL_clamp(v / maxValue, 0.0f, 1.0f) * h;
+        fillRoundedRect(s, x + i, py, 1, y + h - py, 0, fill);
+        fillRoundedRect(s, x + i - thickness / 2, py - thickness / 2, thickness, thickness, thickness / 2, color);
+    }
+}
