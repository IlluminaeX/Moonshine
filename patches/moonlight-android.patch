@@ -0,0 +1,1160 @@
+package com.moonshine.tunnel;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.Inet4Address;
+import java.net.Inet6Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.NetworkInterface;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.security.GeneralSecurityException;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * A direct connection to a friend's PC with no port forwarding or VPN: the phone's side of the desktop
+ * app's tunnel (app/lib/tunnel-engine.js), speaking exactly the same protocol.
+ *
+ * Both sides learn their public address from STUN, swap addresses and keys through Moonshine's service,
+ * then send packets at each other at the same time so both routers let the other side in ("hole
+ * punching"). Everything then travels in one encrypted UDP path: the player's UDP streams (video,
+ * control, audio) as datagrams, and its TCP connections (HTTP, HTTPS, RTSP) over a small retransmitting
+ * stream layer. Only the host's six streaming ports are reachable through it.
+ *
+ * The player connects to a stand-in address on this phone (127.77.x.y) on the host's own port numbers
+ * (no host runs on a phone, so they are free).
+ *
+ * Threads: one loop thread owns all tunnel state; socket threads only read and hand packets to it.
+ */
+public final class Tunnel {
+    public interface Listener {
+        /** No direct path after a few seconds: time to try the relay. */
+        void onRelayWanted();
+
+        void onClosed(String reason);
+    }
+
+    /** An address the other side might be reached at. */
+    public static final class Cand {
+        public final String a;
+        public final int p;
+
+        public Cand(String a, int p) {
+            this.a = a;
+            this.p = p;
+        }
+    }
+
+    public static final class Prep {
+        public final String pub;
+        public final List<Cand> cands;
+        public final String nat; // cone, symmetric, unknown, blocked
+
+        Prep(String pub, List<Cand> cands, String nat) {
+            this.pub = pub;
+            this.cands = cands;
+            this.nat = nat;
+        }
+    }
+
+    /** Failure with a reason code the arranger turns into words: no-path, closed, peer-gone, ... */
+    public static final class TunnelException extends IOException {
+        public final String code;
+
+        TunnelException(String code) {
+            super(code);
+            this.code = code;
+        }
+    }
+
+    // Ports a tunnel carries, as offsets from the host's base port (47989 by default)
+    public static final int[] PORTS = { -5, 0, 21, 9, 10, 11 }; // HTTPS, HTTP, RTSP (TCP); video, control, audio (UDP)
+    static final int[] TCP_IDX = { 0, 1, 2 };
+    static final int[] UDP_IDX = { 3, 4, 5 };
+
+    static final int PROBE = 1, PROBE_ACK = 2, KEEPALIVE = 3, CLOSE = 4, UDP = 0x10, DATA = 0x20, ACK = 0x21, RST = 0x22;
+    static final int SYN = 1, FIN = 2;
+
+    static final int MSS = 1100;
+    static final int WINDOW = 256;
+    static final int QUEUE_PAUSE = 1024 * 1024;
+    static final int RECV_AHEAD = 4096;
+    static final int MAX_TRIES = 12;
+    static final int MAX_STREAMS = 256;
+    static final int MAX_FLOWS = 64;
+    static final long FLOW_IDLE_MS = 2 * 60 * 1000;
+    static final long CLOSED_LINGER_MS = 30 * 1000;
+    static final long STREAM_IDLE_MS = 30 * 60 * 1000;
+    static final long PUNCH_EVERY_MS = 150;
+    static final long PUNCH_FOR_MS = 15000;
+    static final long PUNCH_RELAY_MS = 30000;
+    static final long RELAY_AFTER_MS = 4000;
+    static final long KEEPALIVE_MS = 5000;
+    static final long DEAD_MS = 30000;
+    static final long TICK_MS = 50;
+    static final long MAX_WRITE_BACKLOG = 16L * 1024 * 1024;
+
+    static final String[][] STUN_SERVERS = { { "stun.cloudflare.com", "3478" }, { "stun.l.google.com", "19302" } };
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    /** Where packets go out: this phone's IPv4 or IPv6 socket, or the relay. */
+    enum Via { V4, V6, RELAY }
+
+    private static final class Path {
+        final Via via;
+        final String address;
+        final int port;
+
+        Path(Via via, String address, int port) {
+            this.via = via;
+            this.address = address;
+            this.port = port;
+        }
+
+        boolean same(Path o) {
+            return o != null && via == o.via && port == o.port && address.equals(o.address);
+        }
+    }
+
+    private final Listener listener;
+    private final ScheduledExecutorService loop = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread t = new Thread(r, "Moonshine tunnel");
+        t.setDaemon(true);
+        return t;
+    });
+    private final byte[][] keyPair = TunnelCrypto.newKeyPair();
+    private final List<ScheduledFuture<?>> timers = new ArrayList<>();
+    private final Map<String, CountDownLatch> stunWaits = Collections.synchronizedMap(new HashMap<>());
+    private final Map<String, String[]> stunResults = Collections.synchronizedMap(new HashMap<>());
+
+    // Tests can drop a share of outgoing packets to check the stream layer copes
+    double dropRate = 0;
+    // Tests: extra candidates and relaying to private addresses
+    List<Cand> extraCands = null;
+    boolean allowPrivateRelay = false;
+
+    private DatagramSocket sock4;
+    private DatagramSocket sock6;
+    private TurnClient turn;
+    private TunnelCrypto.Sealer sealer;
+    private TunnelCrypto.Opener opener;
+    private final Object openLock = new Object();
+    private volatile Path path;
+    private volatile boolean connected;
+    private volatile boolean closed;
+    private String closeReason = "";
+    private long lastRecv;
+    private long lastSent;
+    private final AtomicLong lastUse = new AtomicLong(System.currentTimeMillis());
+    private long punchFor = PUNCH_FOR_MS;
+    private final List<Cand> targets = new ArrayList<>();
+    private CountDownLatch connectedLatch;
+
+    // TCP
+    private final Map<Integer, Stream> streams = new HashMap<>();
+    private final Map<Integer, long[]> closedStreams = new HashMap<>(); // id -> [next, until]
+    private int nextStreamId = 1;
+    double srtt = 0;
+    private double rttvar = 0;
+    private double rto = 500;
+    // UDP
+    private final Map<Integer, Flow> flows = new HashMap<>();
+    private final Map<String, Flow> flowByKey = new HashMap<>();
+    private int nextFlowId = 1;
+    // stand-in listeners for the player
+    private final List<ServerSocket> servers = new ArrayList<>();
+    private final Map<Integer, DatagramSocket> udpLocal = new HashMap<>();
+
+    public Tunnel(Listener listener) {
+        this.listener = listener;
+    }
+
+    // ---- setup -----------------------------------------------------------------------------------
+
+    /** Open the UDP sockets and ask STUN for the public address. Blocking. */
+    public Prep prepare() throws IOException {
+        sock4 = new DatagramSocket(new InetSocketAddress(InetAddress.getByName("0.0.0.0"), 0));
+        bufferSizes(sock4);
+        startReceiver(sock4, Via.V4);
+        try {
+            sock6 = new DatagramSocket(new InetSocketAddress(InetAddress.getByName("::"), 0));
+            bufferSizes(sock6);
+            startReceiver(sock6, Via.V6);
+        } catch (IOException e) {
+            sock6 = null; // no IPv6 here
+        }
+
+        List<String[]> mapped = new ArrayList<>();
+        List<Thread> asks = new ArrayList<>();
+        final String[][] results = new String[STUN_SERVERS.length][];
+        for (int i = 0; i < STUN_SERVERS.length; i++) {
+            final int idx = i;
+            Thread t = new Thread(() -> results[idx] = stun(STUN_SERVERS[idx][0], Integer.parseInt(STUN_SERVERS[idx][1])));
+            t.start();
+            asks.add(t);
+        }
+        for (Thread t : asks) {
+            try {
+                t.join(2500);
+            } catch (InterruptedException e) {
+                throw new TunnelException("closed");
+            }
+        }
+        for (String[] r : results) if (r != null) mapped.add(r);
+
+        List<Cand> cands = new ArrayList<>();
+        for (String[] m : mapped) addCand(cands, new Cand(m[0], Integer.parseInt(m[1])));
+        // A router that picks a new outgoing port per destination ("symmetric NAT") makes punching unlikely
+        String nat = mapped.size() < 2 ? (mapped.isEmpty() ? "blocked" : "unknown")
+                : mapped.get(0)[1].equals(mapped.get(1)[1]) ? "cone" : "symmetric";
+        for (Cand c : localCandidates(sock4.getLocalPort(), sock6 != null ? sock6.getLocalPort() : 0)) addCand(cands, c);
+        if (extraCands != null) cands.addAll(extraCands);
+        return new Prep(TunnelCrypto.b64url(keyPair[1]), cands.size() > 16 ? cands.subList(0, 16) : cands, nat);
+    }
+
+    private static void addCand(List<Cand> list, Cand c) {
+        for (Cand x : list) if (x.a.equals(c.a) && x.p == c.p) return;
+        list.add(c);
+    }
+
+    private static void bufferSizes(DatagramSocket s) {
+        try {
+            s.setReceiveBufferSize(4 * 1024 * 1024);
+            s.setSendBufferSize(4 * 1024 * 1024);
+        } catch (IOException ignored) {
+            // keep the defaults
+        }
+    }
+
+    /** This phone's own addresses a peer on the same network (or over IPv6) might reach directly. */
+    static List<Cand> localCandidates(int port4, int port6) {
+        List<Cand> out = new ArrayList<>();
+        try {
+            for (NetworkInterface ni : Collections.list(NetworkInterface.getNetworkInterfaces())) {
+                if (!ni.isUp() || ni.isLoopback()) continue;
+                for (InetAddress a : Collections.list(ni.getInetAddresses())) {
+                    String s = a.getHostAddress();
+                    if (a instanceof Inet4Address && port4 > 0) {
+                        if (s.startsWith("169.254.") || isTailnet(s)) continue; // Tailscale: not ours to use
+                        out.add(new Cand(s, port4));
+                    } else if (a instanceof Inet6Address && port6 > 0) {
+                        int pct = s.indexOf('%');
+                        if (pct >= 0) s = s.substring(0, pct);
+                        // Global addresses only (link-local needs a zone, fd7a: is Tailscale, 2001:0: and 2002: are old tunnels)
+                        if (!s.matches("^[23].*") || s.matches("(?i)^2001:0{0,4}:.*") || s.matches("(?i)^2002:.*")) continue;
+                        out.add(new Cand(s, port6));
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+            // no interfaces readable
+        }
+        return out;
+    }
+
+    static boolean isTailnet(String a) {
+        return a.matches("^100\\.(6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\..*") || a.toLowerCase().startsWith("fd7a:115c:a1e0:");
+    }
+
+    /** Ask one STUN server for this phone's public IPv4 address: [address, port], or null. */
+    private String[] stun(String host, int port) {
+        InetAddress addr = null;
+        try {
+            for (InetAddress a : InetAddress.getAllByName(host)) {
+                if (a instanceof Inet4Address) {
+                    addr = a;
+                    break;
+                }
+            }
+        } catch (IOException e) {
+            return null;
+        }
+        if (addr == null) return null;
+        byte[] msg = Stun.request();
+        String key = hex(msg, 8, 12);
+        CountDownLatch done = new CountDownLatch(1);
+        stunWaits.put(key, done);
+        try {
+            long[] tries = { 0, 250, 600, 1100 };
+            long start = System.currentTimeMillis();
+            for (long at : tries) {
+                long wait = start + at - System.currentTimeMillis();
+                if (wait > 0 && done.await(wait, TimeUnit.MILLISECONDS)) break;
+                if (closed) return null;
+                try {
+                    sock4.send(new DatagramPacket(msg, msg.length, addr, port));
+                } catch (IOException ignored) {
+                    // try the next time
+                }
+            }
+            done.await(Math.max(0, start + 2000 - System.currentTimeMillis()), TimeUnit.MILLISECONDS);
+            return stunResults.remove(key);
+        } catch (InterruptedException e) {
+            return null;
+        } finally {
+            stunWaits.remove(key);
+        }
+    }
+
+    private static String hex(byte[] b, int off, int len) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = off; i < off + len; i++) sb.append(String.format("%02x", b[i]));
+        return sb.toString();
+    }
+
+    private void startReceiver(DatagramSocket sock, Via via) {
+        Thread t = new Thread(() -> {
+            byte[] buf = new byte[65536];
+            DatagramPacket p = new DatagramPacket(buf, buf.length);
+            while (!sock.isClosed()) {
+                try {
+                    p.setLength(buf.length);
+                    sock.receive(p);
+                } catch (IOException e) {
+                    if (sock.isClosed()) break;
+                    continue;
+                }
+                String from = p.getAddress().getHostAddress();
+                int pct = from.indexOf('%');
+                if (pct >= 0) from = from.substring(0, pct);
+                onPacket(via, buf, p.getLength(), from, p.getPort());
+            }
+        }, "Moonshine tunnel " + via);
+        t.setDaemon(true);
+        t.start();
+    }
+
+    /** Listen on localIp for the player, on the host's own port numbers. Blocking. */
+    public void listen(String localIp, int hostBase) throws IOException {
+        InetAddress ip = InetAddress.getByName(localIp);
+        List<ServerSocket> made = new ArrayList<>();
+        Map<Integer, DatagramSocket> udps = new HashMap<>();
+        try {
+            for (int idx : TCP_IDX) {
+                ServerSocket server = new ServerSocket();
+                server.setReuseAddress(true);
+                server.bind(new InetSocketAddress(ip, hostBase + PORTS[idx]));
+                made.add(server);
+            }
+            for (int idx : UDP_IDX) {
+                DatagramSocket sock = new DatagramSocket(new InetSocketAddress(ip, hostBase + PORTS[idx]));
+                bufferSizes(sock);
+                udps.put(idx, sock);
+            }
+        } catch (IOException e) {
+            for (ServerSocket s : made) try { s.close(); } catch (IOException ignored) { }
+            for (DatagramSocket u : udps.values()) u.close();
+            throw new TunnelException("no-ports");
+        }
+        synchronized (servers) {
+            servers.addAll(made);
+            udpLocal.putAll(udps);
+        }
+        for (int i = 0; i < made.size(); i++) {
+            final int idx = TCP_IDX[i];
+            final ServerSocket server = made.get(i);
+            Thread t = new Thread(() -> {
+                while (!server.isClosed()) {
+                    try {
+                        Socket s = server.accept();
+                        loop.execute(() -> onLocalConnection(idx, s));
+                    } catch (IOException e) {
+                        if (server.isClosed()) break;
+                    } catch (java.util.concurrent.RejectedExecutionException e) {
+                        break;
+                    }
+                }
+            }, "Moonshine tunnel accept " + idx);
+            t.setDaemon(true);
+            t.start();
+        }
+        for (Map.Entry<Integer, DatagramSocket> e : udps.entrySet()) {
+            final int idx = e.getKey();
+            final DatagramSocket sock = e.getValue();
+            Thread t = new Thread(() -> {
+                byte[] buf = new byte[65536];
+                DatagramPacket p = new DatagramPacket(buf, buf.length);
+                while (!sock.isClosed()) {
+                    try {
+                        p.setLength(buf.length);
+                        sock.receive(p);
+                        final byte[] data = java.util.Arrays.copyOf(buf, p.getLength());
+                        final InetAddress from = p.getAddress();
+                        final int fromPort = p.getPort();
+                        loop.execute(() -> onLocalDatagram(idx, data, from, fromPort));
+                    } catch (IOException ex) {
+                        if (sock.isClosed()) break;
+                    } catch (java.util.concurrent.RejectedExecutionException ex) {
+                        break;
+                    }
+                }
+            }, "Moonshine tunnel udp " + idx);
+            t.setDaemon(true);
+            t.start();
+        }
+    }
+
+    /** Start punching towards the other PC; returns once packets go both ways. Blocking. */
+    public void start(String peerPub, List<Cand> peerCands, String session) throws IOException {
+        byte[][] keys;
+        try {
+            keys = TunnelCrypto.deriveKeys(keyPair[0], peerPub, session, true);
+            sealer = new TunnelCrypto.Sealer(keys[0]);
+            synchronized (openLock) {
+                opener = new TunnelCrypto.Opener(keys[1]);
+            }
+        } catch (IllegalArgumentException | GeneralSecurityException e) {
+            throw new TunnelException("bad-key");
+        }
+        final long started = System.currentTimeMillis();
+        connectedLatch = new CountDownLatch(1);
+        loop.execute(() -> {
+            for (Cand c : peerCands) {
+                if (c != null && c.a != null && c.p > 0 && c.p < 65536 && isIp(c.a)) targets.add(c);
+            }
+            timers.add(loop.scheduleWithFixedDelay(() -> punch(started), 0, PUNCH_EVERY_MS, TimeUnit.MILLISECONDS));
+            timers.add(loop.scheduleWithFixedDelay(this::tick, TICK_MS, TICK_MS, TimeUnit.MILLISECONDS));
+            timers.add(loop.schedule(() -> {
+                if (!closed && !connected) listener.onRelayWanted();
+            }, RELAY_AFTER_MS, TimeUnit.MILLISECONDS));
+        });
+        try {
+            connectedLatch.await();
+        } catch (InterruptedException e) {
+            close("closed");
+            throw new TunnelException("closed");
+        }
+        if (!connected) throw new TunnelException(closeReason.isEmpty() ? "closed" : closeReason);
+    }
+
+    static boolean isIp(String a) {
+        return TurnClient.isIpv4(a) || (a.contains(":") && a.matches("^[0-9a-fA-F:]{2,39}$"));
+    }
+
+    private void punch(long started) {
+        if (closed || connected) return;
+        if (System.currentTimeMillis() - started > punchFor) {
+            close("no-path");
+            return;
+        }
+        for (Cand c : targets) {
+            byte[] probe = new byte[9];
+            probe[0] = PROBE;
+            fillRandom(probe, 1);
+            boolean v4 = TurnClient.isIpv4(c.a);
+            if (v4 && sock4 != null) sendRaw(Via.V4, seal(probe), c.a, c.p);
+            if (!v4 && sock6 != null) sendRaw(Via.V6, seal(probe), c.a, c.p);
+            if (turn != null && relayable(c.a)) sendRaw(Via.RELAY, seal(probe), c.a, c.p);
+        }
+    }
+
+    private static void fillRandom(byte[] b, int from) {
+        byte[] r = new byte[b.length - from];
+        RANDOM.nextBytes(r);
+        System.arraycopy(r, 0, b, from, r.length);
+    }
+
+    // ---- relay (last resort) ---------------------------------------------------------------------
+
+    boolean relayable(String address) {
+        if (!TurnClient.isIpv4(address)) return false;
+        if (allowPrivateRelay) return true;
+        return !address.matches("^(10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|100\\.(6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.).*");
+    }
+
+    /**
+     * Get a relayed address on this side (the other PC sends to it). The relay is told to accept packets
+     * from the other PC's public addresses. Blocking.
+     */
+    public Cand useRelay(List<String> urls, String username, String credential) throws IOException {
+        if (closed || turn != null) throw new TunnelException("closed");
+        TurnClient t = new TurnClient(urls, username, credential, new TurnClient.Events() {
+            @Override
+            public void onData(byte[] data, String fromAddress, int fromPort) {
+                onPacket(Via.RELAY, data, data.length, fromAddress, fromPort);
+            }
+
+            @Override
+            public void onClosed(String why) {
+                // Losing the relay ends a tunnel that was using it
+                try {
+                    loop.execute(() -> {
+                        Path p = path;
+                        if (p != null && p.via == Via.RELAY) close("relay-lost");
+                    });
+                } catch (java.util.concurrent.RejectedExecutionException ignored) {
+                    // already closed
+                }
+            }
+        });
+        Object[] relayed = t.allocate();
+        if (closed) {
+            t.close();
+            throw new TunnelException("closed");
+        }
+        List<String> ips = new ArrayList<>();
+        CountDownLatch got = new CountDownLatch(1);
+        loop.execute(() -> {
+            turn = t;
+            punchFor = PUNCH_RELAY_MS;
+            for (Cand c : targets) if (relayable(c.a)) ips.add(c.a);
+            got.countDown();
+        });
+        try {
+            got.await();
+        } catch (InterruptedException e) {
+            throw new TunnelException("closed");
+        }
+        t.permit(ips);
+        return new Cand((String) relayed[0], (Integer) relayed[1]);
+    }
+
+    // ---- packets ---------------------------------------------------------------------------------
+
+    private byte[] seal(byte[] frame) {
+        try {
+            return sealer.seal(frame, 0, frame.length);
+        } catch (GeneralSecurityException e) {
+            return null;
+        }
+    }
+
+    private void sendRaw(Via via, byte[] packet, String address, int port) {
+        if (closed || packet == null) return;
+        if (dropRate > 0 && RANDOM.nextDouble() < dropRate) return;
+        try {
+            if (via == Via.RELAY) {
+                if (turn != null) turn.send(address, port, packet);
+                return;
+            }
+            DatagramSocket s = via == Via.V4 ? sock4 : sock6;
+            if (s != null) s.send(new DatagramPacket(packet, packet.length, InetAddress.getByName(address), port));
+        } catch (IOException ignored) {
+            // ICMP errors from probes to dead candidates; harmless
+        }
+    }
+
+    /** Loop thread only. */
+    void sendFrame(byte[] frame) {
+        Path p = path;
+        if (p == null || closed) return;
+        lastSent = System.currentTimeMillis();
+        sendRaw(p.via, seal(frame), p.address, p.port);
+    }
+
+    /** From a socket thread: STUN answers are handled here, tunnel packets are opened and passed to the loop. */
+    private void onPacket(Via via, byte[] buf, int len, String fromAddress, int fromPort) {
+        if (closed) return;
+        if (len >= 20 && (buf[0] & 0xff) < 2) {
+            Stun.Mapped m = Stun.parse(buf, len);
+            if (m != null) {
+                String key = hex(m.tx, 0, 12);
+                CountDownLatch w = stunWaits.get(key);
+                if (w != null) {
+                    stunResults.put(key, new String[] { m.address, String.valueOf(m.port) });
+                    w.countDown();
+                }
+            }
+            return;
+        }
+        final byte[] frame;
+        synchronized (openLock) {
+            if (opener == null) return;
+            frame = opener.open(buf, len);
+        }
+        if (frame == null || frame.length == 0) return;
+        final Path from = new Path(via, fromAddress, fromPort);
+        try {
+            loop.execute(() -> onFrame(from, frame));
+        } catch (java.util.concurrent.RejectedExecutionException ignored) {
+            // closed
+        }
+    }
+
+    private void onFrame(Path from, byte[] frame) {
+        if (closed) return;
+        lastRecv = System.currentTimeMillis();
+        int type = frame[0] & 0xff;
+        if (type == PROBE) {
+            // Always answer: the other side may not have heard our answer yet
+            byte[] ack = frame.clone();
+            ack[0] = PROBE_ACK;
+            sendRaw(from.via, seal(ack), from.address, from.port);
+            if (!connected) {
+                // The other side's real address is only learned from what it sends (through the relay, or from
+                // a router that picks a new port per destination): probe it back there too
+                byte[] back = new byte[9];
+                back[0] = PROBE;
+                fillRandom(back, 1);
+                sendRaw(from.via, seal(back), from.address, from.port);
+            }
+            return;
+        }
+        if (type == PROBE_ACK) {
+            if (!connected) {
+                path = from;
+                connected = true;
+                lastSent = System.currentTimeMillis();
+                connectedLatch.countDown();
+            }
+            return;
+        }
+        if (!connected) return;
+        // The other side only sends data on its chosen path: follow it if its address changed (new network)
+        if (!from.same(path)) path = from;
+        switch (type) {
+            case KEEPALIVE: return;
+            case CLOSE: close("peer-closed"); return;
+            case UDP: onUdpFrame(frame); return;
+            case DATA: onDataFrame(frame); return;
+            case ACK: onAckFrame(frame); return;
+            case RST: onRstFrame(frame); return;
+            default:
+        }
+    }
+
+    private void tick() {
+        if (closed || !connected) return;
+        long now = System.currentTimeMillis();
+        if (now - lastRecv > DEAD_MS) {
+            close("peer-gone");
+            return;
+        }
+        if (now - lastSent > KEEPALIVE_MS) sendFrame(new byte[] { KEEPALIVE });
+        for (Stream s : new ArrayList<>(streams.values())) {
+            if (!s.retransmit(now, rto)) {
+                reset(s);
+                continue;
+            }
+            if (now - s.lastActive > STREAM_IDLE_MS && s.unacked.isEmpty()) reset(s);
+        }
+        for (Iterator<Map.Entry<Integer, long[]>> it = closedStreams.entrySet().iterator(); it.hasNext(); ) {
+            if (it.next().getValue()[1] < now) it.remove();
+        }
+        for (Integer id : new ArrayList<>(flows.keySet())) {
+            if (now - flows.get(id).lastActive > FLOW_IDLE_MS) dropFlow(id);
+        }
+    }
+
+    void rttSample(double ms) {
+        if (srtt == 0) {
+            srtt = ms;
+            rttvar = ms / 2;
+        } else {
+            rttvar = 0.75 * rttvar + 0.25 * Math.abs(srtt - ms);
+            srtt = 0.875 * srtt + 0.125 * ms;
+        }
+        rto = Math.min(Math.max(srtt + 4 * rttvar, 150), 3000);
+    }
+
+    // ---- TCP over the tunnel ---------------------------------------------------------------------
+
+    void sendAck(int id, long next, long got) {
+        byte[] f = new byte[got < 0 ? 7 : 11];
+        f[0] = (byte) ACK;
+        Stun.putShort(f, 1, id);
+        Stun.putInt(f, 3, (int) next);
+        if (got >= 0) Stun.putInt(f, 7, (int) got);
+        sendFrame(f);
+    }
+
+    void sendRst(int id) {
+        byte[] f = new byte[3];
+        f[0] = (byte) RST;
+        Stun.putShort(f, 1, id);
+        sendFrame(f);
+    }
+
+    private static long u32(byte[] b, int off) {
+        return Stun.getInt(b, off) & 0xffffffffL;
+    }
+
+    private void onDataFrame(byte[] frame) {
+        if (frame.length < 8) return;
+        lastUse.set(System.currentTimeMillis());
+        int id = Stun.getShort(frame, 1);
+        long seq = u32(frame, 3);
+        int flags = frame[7] & 0xff;
+        byte[] payload = java.util.Arrays.copyOfRange(frame, 8, frame.length);
+        Stream s = streams.get(id);
+        if (s == null) {
+            long[] old = closedStreams.get(id);
+            if (old != null) {
+                if (seq < old[0]) sendAck(id, old[0], -1); // a late resend: say it arrived
+                else sendRst(id);
+                return;
+            }
+            // Only this side (the client) opens connections
+            sendRst(id);
+            return;
+        }
+        s.onData(seq, flags, payload);
+    }
+
+    private void onAckFrame(byte[] frame) {
+        if (frame.length < 7) return;
+        Stream s = streams.get(Stun.getShort(frame, 1));
+        if (s != null) s.onAck(u32(frame, 3), frame.length >= 11 ? u32(frame, 7) : -1);
+    }
+
+    private void onRstFrame(byte[] frame) {
+        if (frame.length < 3) return;
+        Stream s = streams.get(Stun.getShort(frame, 1));
+        if (s != null) forget(s, true);
+    }
+
+    /** Abort a stream on both sides. */
+    void reset(Stream s) {
+        if (s.closed) return;
+        sendRst(s.id);
+        forget(s, true);
+    }
+
+    void forget(Stream s, boolean abort) {
+        if (s.closed) return;
+        s.closed = true;
+        streams.remove(s.id);
+        closedStreams.put(s.id, new long[] { s.recvNext, System.currentTimeMillis() + CLOSED_LINGER_MS });
+        s.closeSocket(abort);
+    }
+
+    private void onLocalConnection(int idx, Socket socket) {
+        if (!connected || closed || streams.size() >= MAX_STREAMS) {
+            try { socket.close(); } catch (IOException ignored) { }
+            return;
+        }
+        int id = nextStreamId;
+        for (int n = 0; n < 65535 && (streams.containsKey(id) || closedStreams.containsKey(id) || id == 0); n++) id = (id % 65535) + 1;
+        nextStreamId = (id % 65535) + 1;
+        Stream s = new Stream(id);
+        s.opened = true;
+        streams.put(id, s);
+        lastUse.set(System.currentTimeMillis());
+        s.send(new byte[] { (byte) idx }, SYN);
+        s.attach(socket);
+    }
+
+    /** One TCP connection carried over the tunnel. Loop thread only, except the socket reader. */
+    final class Stream {
+        final int id;
+        Socket socket;
+        OutputStream out;
+        final ExecutorService writer = Executors.newSingleThreadExecutor(r -> {
+            Thread t = new Thread(r, "Moonshine tunnel write");
+            t.setDaemon(true);
+            return t;
+        });
+        final AtomicLong backlog = new AtomicLong();
+        // sending
+        long sendNext = 0;
+        final LinkedHashMap<Long, Seg> unacked = new LinkedHashMap<>();
+        final LinkedList<Object[]> queue = new LinkedList<>(); // [payload, flags]
+        long queued = 0;
+        long ackedTo = 0;
+        int dupAcks = 0;
+        boolean finQueued = false;
+        volatile boolean paused = false;
+        // receiving
+        long recvNext = 0;
+        final Map<Long, Object[]> ahead = new HashMap<>();
+        boolean finReceived = false;
+        boolean opened = false;
+        long lastActive = System.currentTimeMillis();
+        volatile boolean closed = false;
+
+        Stream(int id) {
+            this.id = id;
+        }
+
+        void send(byte[] payload, int flags) {
+            if (closed) return;
+            if (flags != 0) {
+                queue.add(new Object[] { payload, flags });
+            } else {
+                for (int off = 0; off < payload.length; off += MSS) {
+                    byte[] part = java.util.Arrays.copyOfRange(payload, off, Math.min(payload.length, off + MSS));
+                    queue.add(new Object[] { part, 0 });
+                    queued += part.length;
+                }
+            }
+            pump();
+            if (queued > QUEUE_PAUSE) paused = true;
+        }
+
+        void pump() {
+            // Room in the window, and never further ahead of the first gap than the other side keeps
+            while (!queue.isEmpty() && unacked.size() < WINDOW && sendNext - ackedTo < RECV_AHEAD) {
+                Object[] seg = queue.removeFirst();
+                byte[] payload = (byte[]) seg[0];
+                int flags = (Integer) seg[1];
+                if (flags == 0) queued -= payload.length;
+                long seq = sendNext++;
+                byte[] frame = new byte[8 + payload.length];
+                frame[0] = (byte) DATA;
+                Stun.putShort(frame, 1, id);
+                Stun.putInt(frame, 3, (int) seq);
+                frame[7] = (byte) flags;
+                System.arraycopy(payload, 0, frame, 8, payload.length);
+                unacked.put(seq, new Seg(frame));
+                sendFrame(frame);
+            }
+            if (paused && queued < QUEUE_PAUSE / 4 && !closed) {
+                synchronized (this) {
+                    paused = false;
+                    notifyAll();
+                }
+            }
+        }
+
+        void onAck(long next, long got) {
+            long now = System.currentTimeMillis();
+            lastActive = now;
+            double sample = -1;
+            boolean moved = false;
+            if (next > ackedTo) {
+                for (Iterator<Map.Entry<Long, Seg>> it = unacked.entrySet().iterator(); it.hasNext(); ) {
+                    Map.Entry<Long, Seg> e = it.next();
+                    if (e.getKey() >= next) break;
+                    if (e.getValue().tries == 1) sample = now - e.getValue().sentAt;
+                    it.remove();
+                }
+                ackedTo = next;
+                dupAcks = 0;
+                moved = true;
+            } else if (next == ackedTo && !unacked.isEmpty() && got < 0) {
+                // The same ack again: a packet went missing. Resend it now rather than waiting for the timer.
+                dupAcks += 1;
+                if (dupAcks == 3) {
+                    Seg seg = unacked.get(next);
+                    if (seg != null) resend(seg);
+                }
+            }
+            if (got >= 0 && got >= next) {
+                Seg seg = unacked.remove(got);
+                if (seg != null) {
+                    if (seg.tries == 1) sample = now - seg.sentAt;
+                    moved = true;
+                }
+                // A later packet got through, so earlier ones still missing well after it are lost: resend them
+                double late = srtt * 1.25 + 2;
+                for (Map.Entry<Long, Seg> e : unacked.entrySet()) {
+                    if (e.getKey() + 3 > got) break;
+                    if (now - e.getValue().sentAt > late) resend(e.getValue());
+                }
+            }
+            if (sample >= 0) rttSample(sample);
+            if (moved) {
+                pump();
+                maybeDone();
+            }
+        }
+
+        void resend(Seg seg) {
+            seg.tries += 1;
+            seg.sentAt = System.currentTimeMillis();
+            sendFrame(seg.frame);
+        }
+
+        /** Resend what's overdue; false when the other side stopped answering. */
+        boolean retransmit(long now, double rto) {
+            int sent = 0;
+            for (Seg seg : unacked.values()) {
+                if (now - seg.sentAt < rto * (1 << Math.min(seg.tries - 1, 3))) continue;
+                if (seg.tries >= MAX_TRIES) return false;
+                resend(seg);
+                if (++sent >= 32) break;
+            }
+            return true;
+        }
+
+        void onData(long seq, int flags, byte[] payload) {
+            lastActive = System.currentTimeMillis();
+            boolean inRange = seq >= recvNext && seq < recvNext + RECV_AHEAD;
+            if (inRange && !ahead.containsKey(seq)) {
+                ahead.put(seq, new Object[] { flags, payload });
+                while (ahead.containsKey(recvNext)) {
+                    Object[] seg = ahead.remove(recvNext);
+                    recvNext += 1;
+                    deliver((Integer) seg[0], (byte[]) seg[1]);
+                    if (closed) return;
+                }
+            }
+            // Say which packet came in if it's held back behind a gap, so only the missing ones are resent
+            sendAck(id, recvNext, inRange && seq >= recvNext ? seq : -1);
+        }
+
+        void deliver(int flags, byte[] payload) {
+            if ((flags & SYN) != 0) { // only the client opens connections
+                reset(this);
+                return;
+            }
+            if (!opened) {
+                reset(this);
+                return;
+            }
+            if ((flags & FIN) != 0) {
+                finReceived = true;
+                writer.execute(() -> {
+                    try { if (socket != null) socket.shutdownOutput(); } catch (IOException ignored) { }
+                });
+                maybeDone();
+                return;
+            }
+            if (out != null) {
+                if (backlog.addAndGet(payload.length) > MAX_WRITE_BACKLOG) { // the reader stopped reading
+                    reset(this);
+                    return;
+                }
+                writer.execute(() -> {
+                    try {
+                        out.write(payload);
+                    } catch (IOException e) {
+                        try { socket.close(); } catch (IOException ignored) { }
+                    } finally {
+                        backlog.addAndGet(-payload.length);
+                    }
+                });
+            }
+        }
+
+        /** Both directions finished and everything sent was received: tidy up. */
+        void maybeDone() {
+            if (closed || !finReceived || !finQueued || !queue.isEmpty() || !unacked.isEmpty()) return;
+            forget(this, false);
+        }
+
+        /** Wire a local TCP socket to this stream, in both directions. */
+        void attach(Socket s) {
+            socket = s;
+            try {
+                s.setTcpNoDelay(true);
+                out = s.getOutputStream();
+            } catch (IOException e) {
+                reset(this);
+                return;
+            }
+            Thread t = new Thread(() -> {
+                byte[] buf = new byte[16 * 1024];
+                try {
+                    InputStream in = s.getInputStream();
+                    while (true) {
+                        synchronized (this) {
+                            while (paused && !closed) wait();
+                        }
+                        if (closed) return;
+                        int n = in.read(buf);
+                        if (n < 0) break;
+                        final byte[] chunk = java.util.Arrays.copyOf(buf, n);
+                        loop.execute(() -> {
+                            lastUse.set(System.currentTimeMillis());
+                            send(chunk, 0);
+                        });
+                    }
+                    loop.execute(() -> {
+                        finQueued = true;
+                        send(new byte[0], FIN);
+                        maybeDone();
+                    });
+                } catch (IOException | InterruptedException | java.util.concurrent.RejectedExecutionException e) {
+                    // Closed before both sides finished: tell the other side to drop it
+                    try {
+                        loop.execute(() -> {
+                            if (!closed && !(finQueued && finReceived)) reset(this);
+                        });
+                    } catch (java.util.concurrent.RejectedExecutionException ignored) {
+                        // tunnel closed
+                    }
+                }
+            }, "Moonshine tunnel read");
+            t.setDaemon(true);
+            t.start();
+        }
+
+        void closeSocket(boolean abort) {
+            synchronized (this) {
+                notifyAll();
+            }
+            final Socket s = socket;
+            if (s == null) {
+                writer.shutdown();
+                return;
+            }
+            if (abort) {
+                try { s.close(); } catch (IOException ignored) { }
+                writer.shutdownNow();
+            } else {
+                writer.execute(() -> {
+                    try { s.close(); } catch (IOException ignored) { }
+                });
+                writer.shutdown();
+            }
+        }
+    }
+
+    static final class Seg {
+        final byte[] frame;
+        long sentAt = System.currentTimeMillis();
+        int tries = 1;
+
+        Seg(byte[] frame) {
+            this.frame = frame;
+        }
+    }
+
+    // ---- UDP over the tunnel ---------------------------------------------------------------------
+
+    static final class Flow {
+        final int id;
+        final int idx;
+        final String key;
+        final InetAddress address;
+        final int port;
+        long lastActive = System.currentTimeMillis();
+
+        Flow(int id, int idx, String key, InetAddress address, int port) {
+            this.id = id;
+            this.idx = idx;
+            this.key = key;
+            this.address = address;
+            this.port = port;
+        }
+    }
+
+    private void onUdpFrame(byte[] frame) {
+        if (frame.length < 4) return;
+        lastUse.set(System.currentTimeMillis());
+        int id = Stun.getShort(frame, 1);
+        Flow flow = flows.get(id);
+        if (flow == null) return;
+        flow.lastActive = System.currentTimeMillis();
+        DatagramSocket sock;
+        synchronized (servers) {
+            sock = udpLocal.get(flow.idx);
+        }
+        if (sock == null) return;
+        try {
+            sock.send(new DatagramPacket(frame, 4, frame.length - 4, flow.address, flow.port));
+        } catch (IOException ignored) {
+            // the player went away
+        }
+    }
+
+    private void sendUdp(int id, int idx, byte[] payload) {
+        byte[] f = new byte[4 + payload.length];
+        f[0] = (byte) UDP;
+        Stun.putShort(f, 1, id);
+        f[3] = (byte) idx;
+        System.arraycopy(payload, 0, f, 4, payload.length);
+        sendFrame(f);
+    }
+
+    private void dropFlow(int id) {
+        Flow flow = flows.remove(id);
+        if (flow != null) flowByKey.remove(flow.key);
+    }
+
+    private void onLocalDatagram(int idx, byte[] msg, InetAddress from, int fromPort) {
+        if (!connected || closed) return;
+        lastUse.set(System.currentTimeMillis());
+        String key = idx + "|" + from.getHostAddress() + "|" + fromPort;
+        Flow flow = flowByKey.get(key);
+        if (flow == null) {
+            if (flows.size() >= MAX_FLOWS) return;
+            int id = nextFlowId;
+            for (int n = 0; n < 65535 && (flows.containsKey(id) || id == 0); n++) id = (id % 65535) + 1;
+            nextFlowId = (id % 65535) + 1;
+            flow = new Flow(id, idx, key, from, fromPort);
+            flows.put(id, flow);
+            flowByKey.put(key, flow);
+        }
+        flow.lastActive = System.currentTimeMillis();
+        sendUdp(flow.id, idx, msg);
+    }
+
+    // ---- shutdown --------------------------------------------------------------------------------
+
+    /** Close the tunnel (from any thread). */
+    public void close(String reason) {
+        try {
+            loop.execute(() -> closeNow(reason));
+        } catch (java.util.concurrent.RejectedExecutionException ignored) {
+            // already closed
+        }
+    }
+
+    private void closeNow(String reason) {
+        if (closed) return;
+        if (connected) {
+            // Say goodbye (twice, in case one is lost) so the other side doesn't wait for a timeout
+            sendFrame(new byte[] { CLOSE });
+            sendFrame(new byte[] { CLOSE });
+        }
+        closed = true;
+        closeReason = reason;
+        for (ScheduledFuture<?> t : timers) t.cancel(false);
+        synchronized (stunWaits) {
+            for (CountDownLatch w : stunWaits.values()) w.countDown();
+        }
+        for (Stream s : streams.values()) s.closeSocket(true);
+        streams.clear();
+        flows.clear();
+        flowByKey.clear();
+        synchronized (servers) {
+            for (ServerSocket s : servers) try { s.close(); } catch (IOException ignored) { }
+            for (DatagramSocket u : udpLocal.values()) u.close();
+            servers.clear();
+            udpLocal.clear();
+        }
+        if (turn != null) turn.close();
+        if (connectedLatch != null) connectedLatch.countDown();
+        // Let the goodbye leave before the sockets close
+        loop.schedule(() -> {
+            if (sock4 != null) sock4.close();
+            if (sock6 != null) sock6.close();
+            loop.shutdown();
+        }, 50, TimeUnit.MILLISECONDS);
+        listener.onClosed(reason);
+    }
+
+    /** Tests: the IPv4 socket's port. */
+    int localPort4() {
+        return sock4 != null ? sock4.getLocalPort() : 0;
+    }
+
+    public boolean isConnected() {
+        return connected && !closed;
+    }
+
+    public boolean isClosed() {
+        return closed;
+    }
+
+    public boolean isRelayed() {
+        Path p = path;
+        return p != null && p.via == Via.RELAY;
+    }
+
+    /** When the player last sent or got anything (not keep-alives). */
+    public long lastUse() {
+        return lastUse.get();
+    }
+}
