index 00000000..5431d4ab
--- /dev/null
+++ b/app/src/test/java/com/moonshine/FileReceiverTest.java
@@ -0,0 +1,154 @@
+package com.moonshine;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import android.content.Intent;
+
+import org.json.JSONObject;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import okhttp3.OkHttpClient;
+import okhttp3.mockwebserver.Dispatcher;
+import okhttp3.mockwebserver.MockResponse;
+import okhttp3.mockwebserver.MockWebServer;
+import okhttp3.mockwebserver.RecordedRequest;
+import okio.Buffer;
+
+/** Receiving a file on the phone: the offer is checked, the pieces are pulled and assembled, bad cases are refused. */
+@RunWith(RobolectricTestRunner.class)
+public class FileReceiverTest {
+    private static final int PIECE = 8 << 20;
+    private MockWebServer server;
+    private byte[] data;
+    private String base;
+
+    private JSONObject message() throws Exception {
+        return new JSONObject().put("type", "file-offer").put("id", "abcdef0123456789abcdef01").put("hostUuid", "1234abcd-5678").put("port", 47989)
+                .put("key", "K".repeat(32)).put("name", "photo.png").put("size", 20_000_000L)
+                .put("from", new JSONObject().put("username", "pat").put("device", 7));
+    }
+
+    private FileReceiver.Offer offer(long size) throws Exception {
+        return FileReceiver.parse(message().put("size", size));
+    }
+
+    @Before
+    public void start() throws Exception {
+        data = new byte[20_000_000];
+        new Random(3).nextBytes(data);
+        server = new MockWebServer();
+        server.setDispatcher(new Dispatcher() {
+            @Override
+            public MockResponse dispatch(RecordedRequest r) {
+                String path = r.getPath();
+                if (!path.startsWith("/moonshine/take?id=abcdef0123456789abcdef01&key=" + "K".repeat(32) + "&offset=")) return new MockResponse().setResponseCode(404);
+                long offset = Long.parseLong(path.substring(path.lastIndexOf('=') + 1));
+                if (offset >= data.length) return new MockResponse().setResponseCode(416);
+                int n = (int) Math.min(PIECE, data.length - offset);
+                return new MockResponse().setBody(new Buffer().write(data, (int) offset, n));
+            }
+        });
+        server.start();
+        base = "http://" + server.getHostName() + ":" + server.getPort();
+    }
+
+    @After
+    public void stop() throws Exception {
+        server.shutdown();
+    }
+
+    @Test
+    public void aWellFormedOfferIsAccepted() throws Exception {
+        FileReceiver.Offer o = FileReceiver.parse(message());
+        assertNotNull(o);
+        assertEquals("pat", o.from);
+        assertEquals(7, o.device);
+        assertEquals("photo.png", o.name);
+    }
+
+    @Test
+    public void malformedOffersAreIgnored() throws Exception {
+        assertNull(FileReceiver.parse(message().put("size", 0)));
+        assertNull(FileReceiver.parse(message().put("key", "short")));
+        assertNull(FileReceiver.parse(message().put("id", "../etc")));
+        assertNull(FileReceiver.parse(message().put("port", 0)));
+        assertNull(FileReceiver.parse(message().put("from", new JSONObject().put("username", "").put("device", 7))));
+        assertNull(FileReceiver.parse(message().put("name", "   ")));
+    }
+
+    @Test
+    public void fileNamesAreMadeSafe() {
+        assertEquals("passwd", FileReceiver.safeName("../../etc/passwd"));
+        assertEquals("evil.exe", FileReceiver.safeName("C:\\Users\\x\\evil.exe"));
+        assertEquals("a_b_c.txt", FileReceiver.safeName("a:b?c.txt"));
+        assertEquals("file", FileReceiver.safeName("..."));
+        assertEquals("photoexe.png", FileReceiver.safeName("photo\u202Eexe.png").replace("_", ""));
+        assertTrue(FileReceiver.safeName("x".repeat(400) + ".png").length() <= 150);
+    }
+
+    @Test
+    public void theOfferSurvivesAnIntent() throws Exception {
+        Intent i = new Intent();
+        offer(1234).into(i);
+        FileReceiver.Offer back = FileReceiver.Offer.from(i);
+        assertNotNull(back);
+        assertEquals(1234, back.size);
+        assertEquals("K".repeat(32), back.key);
+    }
+
+    @Test
+    public void thePiecesAreAssembledInOrder() throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        long[] last = { 0 };
+        FileReceiver.pull(new OkHttpClient(), base, offer(data.length), out, (d, t) -> last[0] = d, new AtomicBoolean());
+        assertArrayEquals(data, out.toByteArray());
+        assertEquals(data.length, last[0]);
+        assertEquals(3, server.getRequestCount()); // 8 MB + 8 MB + the rest
+    }
+
+    private void expect(FileReceiver.Offer o, String contains, AtomicBoolean cancelled) {
+        try {
+            FileReceiver.pull(new OkHttpClient(), base, o, new ByteArrayOutputStream(), (d, t) -> { }, cancelled);
+            fail("expected a failure");
+        } catch (IOException e) {
+            assertTrue(e.getMessage(), e.getMessage().contains(contains));
+        }
+    }
+
+    @Test
+    public void aFileThatStoppedBeingOfferedIsReported() throws Exception {
+        FileReceiver.Offer wrong = FileReceiver.parse(message().put("key", "Z".repeat(32)));
+        expect(wrong, "no longer offering", new AtomicBoolean());
+    }
+
+    @Test
+    public void aFileBiggerThanItSaidIsRefused() throws Exception {
+        expect(offer(5_000_000), "bigger than it said", new AtomicBoolean());
+    }
+
+    @Test
+    public void aShorterFileThanPromisedIsRefused() throws Exception {
+        // the offer says 25 MB, the PC has 20 MB: after the last byte the PC answers with an error, not more data
+        expect(offer(25_000_000), "416", new AtomicBoolean());
+    }
+
+    @Test
+    public void cancellingStopsTheDownload() throws Exception {
+        AtomicBoolean stop = new AtomicBoolean(true);
+        expect(offer(data.length), "Cancelled", stop);
+    }
+}
