+package com.moonshine.tunnel;
+
+import org.bouncycastle.crypto.digests.SHA256Digest;
+import org.bouncycastle.crypto.generators.HKDFBytesGenerator;
+import org.bouncycastle.crypto.params.HKDFParameters;
+import org.bouncycastle.math.ec.rfc7748.X25519;
+
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.SecureRandom;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * The tunnel's encryption, the same as the desktop app's (app/lib/tunnel-engine.js): X25519 key
+ * agreement, HKDF-SHA256 into one key per direction, AES-256-GCM per packet with a 64-bit counter
+ * (the 9-byte header is the associated data) and a replay window.
+ */
+public final class TunnelCrypto {
+    static final int VERSION = 0x4d;
+    static final int HEADER = 9;
+    static final int TAG = 16;
+    private static final byte[] INFO = "moonshine tunnel v1".getBytes(StandardCharsets.US_ASCII);
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private TunnelCrypto() {}
+
+    /** A new X25519 key pair: [private, public], 32 bytes each. */
+    public static byte[][] newKeyPair() {
+        byte[] priv = new byte[X25519.SCALAR_SIZE];
+        byte[] pub = new byte[X25519.POINT_SIZE];
+        X25519.generatePrivateKey(RANDOM, priv);
+        X25519.generatePublicKey(priv, 0, pub, 0);
+        return new byte[][] { priv, pub };
+    }
+
+    private static final char[] B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".toCharArray();
+
+    /** Base64url without padding (plain Java, so the tunnel also runs in tests off the phone). */
+    public static String b64url(byte[] b) {
+        StringBuilder sb = new StringBuilder((b.length * 4 + 2) / 3);
+        for (int i = 0; i < b.length; i += 3) {
+            int n = (b[i] & 0xff) << 16 | (i + 1 < b.length ? (b[i + 1] & 0xff) << 8 : 0) | (i + 2 < b.length ? b[i + 2] & 0xff : 0);
+            sb.append(B64[n >>> 18 & 63]).append(B64[n >>> 12 & 63]);
+            if (i + 1 < b.length) sb.append(B64[n >>> 6 & 63]);
+            if (i + 2 < b.length) sb.append(B64[n & 63]);
+        }
+        return sb.toString();
+    }
+
+    /** Decode base64url without padding; throws IllegalArgumentException on anything else. */
+    public static byte[] unb64url(String s) {
+        if (s == null || s.length() % 4 == 1) throw new IllegalArgumentException("bad base64url");
+        byte[] out = new byte[s.length() * 3 / 4];
+        int bits = 0, have = 0, o = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            int v = c >= 'A' && c <= 'Z' ? c - 'A' : c >= 'a' && c <= 'z' ? c - 'a' + 26 : c >= '0' && c <= '9' ? c - '0' + 52
+                    : c == '-' ? 62 : c == '_' ? 63 : -1;
+            if (v < 0) throw new IllegalArgumentException("bad base64url");
+            bits = bits << 6 | v;
+            have += 6;
+            if (have >= 8) {
+                have -= 8;
+                out[o++] = (byte) (bits >>> have);
+                bits &= (1 << have) - 1;
+            }
+        }
+        return o == out.length ? out : java.util.Arrays.copyOf(out, o);
+    }
+
+    /** Keys for each direction: [send, recv] for this side (`client` true for the side that watches). */
+    public static byte[][] deriveKeys(byte[] priv, String peerPub, String session, boolean client) {
+        byte[] peer = peerPub == null ? new byte[0] : unb64url(peerPub);
+        if (peer.length != 32) throw new IllegalArgumentException("bad peer key");
+        byte[] shared = new byte[32];
+        if (!X25519.calculateAgreement(priv, 0, peer, 0, shared, 0)) throw new IllegalArgumentException("bad peer key");
+        HKDFBytesGenerator hkdf = new HKDFBytesGenerator(new SHA256Digest());
+        hkdf.init(new HKDFParameters(shared, session.getBytes(StandardCharsets.UTF_8), INFO));
+        byte[] okm = new byte[64];
+        hkdf.generateBytes(okm, 0, 64);
+        byte[] toHost = new byte[32];
+        byte[] toClient = new byte[32];
+        System.arraycopy(okm, 0, toHost, 0, 32);
+        System.arraycopy(okm, 32, toClient, 0, 32);
+        return client ? new byte[][] { toHost, toClient } : new byte[][] { toClient, toHost };
+    }
+
+    /** One direction's sealing (encrypting) state. Not thread-safe: one sender. */
+    static final class Sealer {
+        private final SecretKeySpec key;
+        private final Cipher cipher;
+        private long counter;
+
+        Sealer(byte[] key) throws GeneralSecurityException {
+            this.key = new SecretKeySpec(key, "AES");
+            this.cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        }
+
+        byte[] seal(byte[] frame, int off, int len) throws GeneralSecurityException {
+            long n = counter++;
+            byte[] out = new byte[HEADER + len + TAG];
+            out[0] = (byte) VERSION;
+            for (int i = 0; i < 8; i++) out[1 + i] = (byte) (n >>> (56 - 8 * i));
+            byte[] iv = new byte[12];
+            System.arraycopy(out, 1, iv, 4, 8);
+            cipher.init(Cipher.ENCRYPT_MODE, key, new GCMParameterSpec(128, iv));
+            cipher.updateAAD(out, 0, HEADER);
+            cipher.doFinal(frame, off, len, out, HEADER);
+            return out;
+        }
+    }
+
+    /** One direction's opening (decrypting) state with its replay window. Not thread-safe: one receiver at a time. */
+    static final class Opener {
+        private final SecretKeySpec key;
+        private final Cipher cipher;
+        private final ReplayWindow replay = new ReplayWindow(2048);
+
+        Opener(byte[] key) throws GeneralSecurityException {
+            this.key = new SecretKeySpec(key, "AES");
+            this.cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        }
+
+        /** The frame inside, or null if it isn't a fresh packet from the other side. */
+        byte[] open(byte[] packet, int len) {
+            if (len < HEADER + 1 + TAG || (packet[0] & 0xff) != VERSION) return null;
+            long n = 0;
+            for (int i = 0; i < 8; i++) n = (n << 8) | (packet[1 + i] & 0xff);
+            if (n < 0 || !replay.fresh(n)) return null;
+            byte[] iv = new byte[12];
+            System.arraycopy(packet, 1, iv, 4, 8);
+            byte[] frame;
+            try {
+                cipher.init(Cipher.DECRYPT_MODE, key, new GCMParameterSpec(128, iv));
+                cipher.updateAAD(packet, 0, HEADER);
+                frame = cipher.doFinal(packet, HEADER, len - HEADER);
+            } catch (GeneralSecurityException e) {
+                return null; // not from the other side
+            }
+            replay.mark(n);
+            return frame;
+        }
+    }
+
+    /** Rejects packets seen before or too old. */
+    static final class ReplayWindow {
+        private final int size;
+        private final boolean[] bits;
+        private long top = -1;
+
+        ReplayWindow(int size) {
+            this.size = size;
+            this.bits = new boolean[size];
+        }
+
+        boolean fresh(long n) {
+            if (n > top) return true;
+            if (top - n >= size) return false;
+            return !bits[(int) (n % size)];
+        }
+
+        void mark(long n) {
+            if (n > top) {
+                long gap = Math.min(n - top, size);
+                for (long i = 1; i <= gap; i++) bits[(int) ((top + i) % size)] = false;
+                top = n;
+            }
+            bits[(int) (n % size)] = true;
+        }
+    }
+}
diff --git a/app/src/main/java/com/moonshine/tunnel/Tunnels.java b/app/src/main/java/com/moonshine/tunnel/Tunnels.java
new file mode 100644
index 00000000..b8c97885
--- /dev/null
+++ b/app/src/main/java/com/moonshine/tunnel/Tunnels.java
@@ -0,0 +1,406 @@
+package com.moonshine.tunnel;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.moonshine.Hub;
+import com.moonshine.Service;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Direct connections to friends' PCs, over the internet with no port forwarding or VPN: the phone's side
+ * of the desktop app's lib/tunnels.js. Asks the friend's PC through Moonshine's service (the live link
+ * carries its answer back), opens the tunnel, and hands back a stand-in address (127.77.x.y) the player
+ * uses as if it were the friend's PC. When no direct path works it asks Cloudflare's relay to carry it.
+ */
+public final class Tunnels {
+    /** A friend's PC to connect to. `link` and `token`: the login to ask with (the account's or an invite's). */
+    public static final class Target {
+        public final String hostUuid;
+        public final long device;
+        public final int port;
+        public final String name;
+        public final Hub link;
+        public final String token;
+
+        public Target(String hostUuid, long device, int port, String name, Hub link, String token) {
+            this.hostUuid = hostUuid;
+            this.device = device;
+            this.port = port;
+            this.name = name;
+            this.link = link;
+            this.token = token;
+        }
+    }
+
+    /** Finds the friend's PC behind a stand-in address again, to reopen its tunnel. */
+    public interface Finder {
+        Target find(String hostUuid);
+    }
+
+    public static final String LOCAL_PREFIX = "127.77.";
+    private static final long ANSWER_WAIT_MS = 20_000;
+    private static final long IDLE_MS = 10 * 60 * 1000;
+    private static final String PREFS = "moonshine_tunnels";
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private static final class Entry {
+        final Target target;
+        Tunnel tunnel;
+        String session = "";
+        String relay = "none"; // none, asked, failed
+        String ip;
+        boolean open;
+        final Object lock = new Object();
+
+        Entry(Target target) {
+            this.target = target;
+        }
+    }
+
+    private final Context context;
+    private final Map<String, Entry> entries = new HashMap<>();
+    private final ScheduledExecutorService timer = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread t = new Thread(r, "Moonshine tunnels");
+        t.setDaemon(true);
+        return t;
+    });
+    private volatile Finder finder;
+    private volatile InUse inUse = address -> false;
+
+    /** Is the player using this stand-in address right now (a stream is running)? */
+    public interface InUse {
+        boolean test(String address);
+    }
+
+    public Tunnels(Context context) {
+        this.context = context.getApplicationContext();
+        timer.scheduleWithFixedDelay(this::closeIdle, 60, 60, TimeUnit.SECONDS);
+    }
+
+    public void setFinder(Finder f) {
+        finder = f;
+    }
+
+    public void setInUse(InUse f) {
+        inUse = f;
+    }
+
+    // ---- stand-in addresses ------------------------------------------------------------------------
+
+    private SharedPreferences prefs() {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** A stable stand-in address per friend's PC, so the PC saved in the list keeps its address. */
+    public synchronized String localIpFor(String hostUuid) {
+        String saved = prefs().getString("ip:" + hostUuid, null);
+        if (saved != null && saved.startsWith(LOCAL_PREFIX)) return saved;
+        Set<String> used = new HashSet<>();
+        for (Map.Entry<String, ?> e : prefs().getAll().entrySet()) {
+            if (e.getKey().startsWith("ip:")) used.add(String.valueOf(e.getValue()));
+        }
+        byte[] h;
+        try {
+            h = MessageDigest.getInstance("SHA-256").digest(hostUuid.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception e) {
+            h = new byte[32];
+            RANDOM.nextBytes(h);
+        }
+        String ip = null;
+        for (int i = 0; i < 64 && ip == null; i++) {
+            String c = LOCAL_PREFIX + (((h[i % 32] & 0xff) + i) % 254 + 1) + "." + (((h[(i + 1) % 32] & 0xff) * 7 + i) % 254 + 1);
+            if (!used.contains(c)) ip = c;
+        }
+        if (ip == null) ip = LOCAL_PREFIX + (RANDOM.nextInt(254) + 1) + "." + (RANDOM.nextInt(254) + 1);
+        prefs().edit().putString("ip:" + hostUuid, ip).apply();
+        return ip;
+    }
+
+    public static boolean isTunnelAddress(String address) {
+        return address != null && address.startsWith(LOCAL_PREFIX);
+    }
+
+    /** The friend's PC behind a stand-in address, or null. */
+    public String hostFor(String address) {
+        if (!isTunnelAddress(address)) return null;
+        for (Map.Entry<String, ?> e : prefs().getAll().entrySet()) {
+            if (e.getKey().startsWith("ip:") && address.equals(e.getValue())) return e.getKey().substring(3);
+        }
+        return null;
+    }
+
+    public void forget(String hostUuid) {
+        prefs().edit().remove("ip:" + hostUuid).apply();
+    }
+
+    // ---- connecting --------------------------------------------------------------------------------
+
+    /** Open (or reuse) a tunnel to a friend's PC; returns its stand-in address. Blocking: call off the main thread. */
+    public String connect(Target pc) throws IOException {
+        Entry entry;
+        synchronized (entries) {
+            entry = entries.get(pc.hostUuid);
+            if (entry != null && entry.tunnel != null && entry.tunnel.isClosed()) entry = null; // a closed one is replaced
+            if (entry == null) {
+                entry = new Entry(pc);
+                entries.put(pc.hostUuid, entry);
+            }
+        }
+        synchronized (entry.lock) {
+            if (entry.open && entry.tunnel != null && entry.tunnel.isConnected()) return entry.ip;
+            try {
+                return open(entry);
+            } catch (IOException e) {
+                synchronized (entries) {
+                    if (entries.get(pc.hostUuid) == entry) entries.remove(pc.hostUuid);
+                }
+                if (entry.tunnel != null) entry.tunnel.close("failed");
+                throw e;
+            }
+        }
+    }
+
+    private String open(Entry entry) throws IOException {
+        Target pc = entry.target;
+        String name = pc.name == null || pc.name.isEmpty() ? "your friend’s PC" : pc.name;
+        try {
+            if (pc.link == null || !pc.link.whenConnected(5000)) throw new IOException(friendlyError("no-service", name));
+        } catch (InterruptedException e) {
+            throw new IOException(friendlyError("closed", name));
+        }
+        byte[] s = new byte[24];
+        RANDOM.nextBytes(s);
+        final String session = TunnelCrypto.b64url(s);
+        entry.session = session;
+        entry.relay = "none";
+        entry.open = false;
+        final Entry e = entry;
+        Tunnel tunnel = new Tunnel(new Tunnel.Listener() {
+            @Override
+            public void onRelayWanted() {
+                timer.execute(() -> askForRelay(e));
+            }
+
+            @Override
+            public void onClosed(String reason) {
+                synchronized (entries) {
+                    if (entries.get(pc.hostUuid) == e && e.tunnel != null && e.tunnel.isClosed()) {
+                        e.open = false;
+                        entries.remove(pc.hostUuid);
+                    }
+                }
+            }
+        });
+        entry.tunnel = tunnel;
+        Tunnel.Prep prep = tunnel.prepare();
+        String ip = localIpFor(pc.hostUuid);
+        int hostBase = pc.port > 0 && pc.port < 65536 ? pc.port : 47989;
+        try {
+            tunnel.listen(ip, hostBase);
+        } catch (Tunnel.TunnelException ex) {
+            throw new IOException(friendlyError(ex.code, name));
+        }
+
+        Hub.Waiter answer = pc.link.waitFor(m -> "tunnel-answer".equals(m.optString("type")) && session.equals(m.optString("session")));
+        try {
+            JSONObject offer = new JSONObject();
+            offer.put("device", pc.device);
+            offer.put("session", session);
+            offer.put("pub", prep.pub);
+            offer.put("cands", candsJson(prep.cands));
+            Service.call("POST", "/tunnel/offer", offer, pc.token);
+        } catch (Service.ServiceException ex) {
+            answer.cancel();
+            throw new IOException(ex.status == 409 ? friendlyError("offline", name) : ex.getMessage());
+        } catch (IOException | JSONException ex) {
+            answer.cancel();
+            throw new IOException(friendlyError("no-service", name));
+        }
+        JSONObject ans;
+        try {
+            ans = answer.await(ANSWER_WAIT_MS);
+        } catch (InterruptedException ex) {
+            throw new IOException(friendlyError("closed", name));
+        }
+        if (ans == null) throw new IOException(friendlyError("no-answer", name));
+        String err = ans.optString("error", "");
+        if (!err.isEmpty()) throw new IOException(friendlyError(err, name));
+        try {
+            tunnel.start(ans.optString("pub", ""), parseCands(ans.optJSONArray("cands")), session);
+        } catch (Tunnel.TunnelException ex) {
+            if ("no-path".equals(ex.code)) {
+                throw new IOException(noPathError(name, prep.nat, "asked".equals(entry.relay) || "failed".equals(entry.relay)));
+            }
+            throw new IOException(friendlyError(ex.code, name));
+        }
+        entry.ip = ip;
+        entry.open = true;
+        return ip;
+    }
+
+    /** No direct path after a few seconds: get a relayed address from Cloudflare's relay and hand it to the other PC. */
+    private void askForRelay(Entry entry) {
+        if (!"none".equals(entry.relay) || entry.tunnel == null || entry.tunnel.isClosed()) return;
+        entry.relay = "failed";
+        try {
+            JSONObject creds = Service.call("POST", "/turn", new JSONObject(), entry.target.token);
+            JSONArray urlsJson = creds.optJSONArray("urls");
+            List<String> urls = new ArrayList<>();
+            if (urlsJson != null) for (int i = 0; i < urlsJson.length(); i++) urls.add(urlsJson.optString(i));
+            Tunnel.Cand relayed = entry.tunnel.useRelay(urls, creds.optString("username"), creds.optString("credential"));
+            JSONObject body = new JSONObject();
+            body.put("device", entry.target.device);
+            body.put("session", entry.session);
+            body.put("relay", new JSONObject().put("a", relayed.a).put("p", relayed.p));
+            Service.call("POST", "/tunnel/relay", body, entry.target.token);
+            entry.relay = "asked";
+        } catch (IOException | JSONException ignored) {
+            // no relay: the punching carries on until it gives up
+        }
+    }
+
+    static JSONArray candsJson(List<Tunnel.Cand> cands) throws JSONException {
+        JSONArray out = new JSONArray();
+        for (Tunnel.Cand c : cands) out.put(new JSONObject().put("a", c.a).put("p", c.p));
+        return out;
+    }
+
+    static List<Tunnel.Cand> parseCands(JSONArray arr) {
+        List<Tunnel.Cand> out = new ArrayList<>();
+        if (arr == null) return out;
+        for (int i = 0; i < arr.length() && i < 16; i++) {
+            JSONObject o = arr.optJSONObject(i);
+            if (o == null) continue;
+            String a = o.optString("a", "");
+            int p = o.optInt("p", 0);
+            if (Tunnel.isIp(a) && p > 0 && p < 65536) out.add(new Tunnel.Cand(a, p));
+        }
+        return out;
+    }
+
+    /** Before using a stand-in address: make sure its tunnel is open, reopening it if it closed. Blocking. */
+    public void ensureFor(String address) throws IOException {
+        String hostUuid = hostFor(address);
+        if (hostUuid == null) return;
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            if (e != null && e.open && e.tunnel != null && e.tunnel.isConnected()) return;
+        }
+        Finder f = finder;
+        Target pc = f != null ? f.find(hostUuid) : null;
+        if (pc == null) throw new IOException("That friend’s PC isn’t online, or you’re no longer friends.");
+        connect(pc);
+    }
+
+    public boolean isOpen(String hostUuid) {
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            return e != null && e.open && e.tunnel != null && e.tunnel.isConnected();
+        }
+    }
+
+    public boolean isRelayed(String hostUuid) {
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            return e != null && e.open && e.tunnel != null && e.tunnel.isRelayed();
+        }
+    }
+
+    public void closeFor(String hostUuid) {
+        Entry e;
+        synchronized (entries) {
+            e = entries.remove(hostUuid);
+        }
+        if (e != null && e.tunnel != null) e.tunnel.close("closed");
+    }
+
+    /** Close everything (signing out). */
+    public void closeAll() {
+        List<Entry> all;
+        synchronized (entries) {
+            all = new ArrayList<>(entries.values());
+            entries.clear();
+        }
+        for (Entry e : all) if (e.tunnel != null) e.tunnel.close("signed-out");
+    }
+
+    private void closeIdle() {
+        List<Entry> idle = new ArrayList<>();
+        synchronized (entries) {
+            for (Iterator<Entry> it = entries.values().iterator(); it.hasNext(); ) {
+                Entry e = it.next();
+                if (!e.open || e.tunnel == null) continue;
+                if (inUse.test(e.ip)) continue;
+                if (System.currentTimeMillis() - e.tunnel.lastUse() > IDLE_MS) {
+                    idle.add(e);
+                    it.remove();
+                }
+            }
+        }
+        for (Entry e : idle) e.tunnel.close("idle");
+    }
+
+    /** "Can this phone connect directly?": what STUN says about this network (cone, symmetric, unknown, blocked). Blocking. */
+    public static String checkNetwork() {
+        Tunnel t = new Tunnel(new Tunnel.Listener() {
+            @Override
+            public void onRelayWanted() {
+            }
+
+            @Override
+            public void onClosed(String reason) {
+            }
+        });
+        try {
+            return t.prepare().nat;
+        } catch (IOException e) {
+            return "blocked";
+        } finally {
+            t.close("checked");
+        }
+    }
+
+    // ---- words ---------------------------------------------------------------------------------------
+
+    static String friendlyError(String code, String name) {
+        switch (code == null ? "" : code) {
+            case "not-hosting": return name + " isn’t hosting right now.";
+            case "not-invited": return name + " didn’t accept the invite. Ask for a new link.";
+            case "busy": return name + " has too many connections open. Try again in a minute.";
+            case "offline": return "Moonshine on " + name + " isn’t connected right now. Ask your friend to open Moonshine.";
+            case "no-answer": return name + " didn’t answer. Their Moonshine may have just closed.";
+            case "no-service": return "Can’t reach Moonshine’s service right now. Check your internet connection.";
+            case "no-ports": return "Couldn’t open the connection on this phone. Close other streaming apps and try again.";
+            case "peer-gone": return "The connection to " + name + " dropped.";
+            default: return "Couldn’t connect to " + name + ".";
+        }
+    }
+
+    static String noPathError(String name, String nat, boolean relayTried) {
+        if (relayTried) {
+            return "Couldn’t connect to " + name + ": no direct path, and the relay that takes over then didn’t work either. Tailscale still works for this friend.";
+        }
+        return "symmetric".equals(nat)
+                ? "Couldn’t connect directly to " + name + ": your network doesn’t allow direct connections (common on mobile data). Try Wi-Fi, or Tailscale."
+                : "Couldn’t connect directly to " + name + ". Their network may not allow direct connections. Tailscale still works for this friend.";
+    }
+}
diff --git a/app/src/main/java/com/moonshine/tunnel/TurnClient.java b/app/src/main/java/com/moonshine/tunnel/TurnClient.java
new file mode 100644
index 00000000..7b594df5
--- /dev/null
+++ b/app/src/main/java/com/moonshine/tunnel/TurnClient.java
@@ -0,0 +1,529 @@
+package com.moonshine.tunnel;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+
+/**
+ * A small TURN client (RFC 8656), the same as the desktop app's (app/lib/turn.js): asks Cloudflare's relay
+ * for a public address that forwards to this phone, the last resort when no direct path works. Everything
+ * that crosses it is already encrypted end to end by the tunnel. UDP, TCP or TLS to the relay; long-term
+ * credentials; Send/Data indications; the allocation and permissions are refreshed until close().
+ */
+final class TurnClient {
+    interface Events {
+        void onData(byte[] data, String fromAddress, int fromPort);
+
+        void onClosed(String why);
+    }
+
+    private static final int ALLOCATE = 0x0003, REFRESH = 0x0004, PERMISSION = 0x0008, SEND = 0x0016, DATA = 0x0017;
+    private static final int A_USERNAME = 0x0006, A_INTEGRITY = 0x0008, A_ERROR = 0x0009, A_LIFETIME = 0x000d,
+            A_PEER = 0x0012, A_DATA = 0x0013, A_REALM = 0x0014, A_NONCE = 0x0015, A_RELAYED = 0x0016, A_TRANSPORT = 0x0019;
+    private static final long REFRESH_EVERY_MS = 4 * 60 * 1000;
+    private static final int CONNECT_TIMEOUT_MS = 2500;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    static final class Server {
+        final boolean secure;
+        final String host;
+        final int port;
+        final String transport; // udp, tcp, tls
+
+        Server(boolean secure, String host, int port, String transport) {
+            this.secure = secure;
+            this.host = host;
+            this.port = port;
+            this.transport = transport;
+        }
+    }
+
+    private static final Pattern URL = Pattern.compile("^(turns?):([A-Za-z0-9.-]{1,253})(?::(\\d{1,5}))?(?:\\?transport=(udp|tcp))?$", Pattern.CASE_INSENSITIVE);
+
+    static Server parseUrl(String url) {
+        Matcher m = URL.matcher(String.valueOf(url));
+        if (!m.matches()) return null;
+        boolean secure = m.group(1).equalsIgnoreCase("turns");
+        int port = m.group(3) != null ? Integer.parseInt(m.group(3)) : (secure ? 5349 : 3478);
+        if (port < 1 || port > 65535) return null;
+        String transport = secure ? "tls" : (m.group(4) != null ? m.group(4).toLowerCase() : "udp");
+        return new Server(secure, m.group(2), port, transport);
+    }
+
+    /** The addresses to try, UDP before TCP before TLS. */
+    static List<Server> plan(List<String> urls) {
+        List<Server> out = new ArrayList<>();
+        for (String u : urls) {
+            Server s = parseUrl(u);
+            if (s != null) out.add(s);
+        }
+        List<String> rank = Arrays.asList("udp", "tcp", "tls");
+        java.util.Collections.sort(out, (a, b) -> rank.indexOf(a.transport) - rank.indexOf(b.transport));
+        return out;
+    }
+
+    /** A parsed STUN/TURN message. */
+    static final class Message {
+        int type;
+        byte[] tx;
+        final Map<Integer, List<byte[]>> attrs = new HashMap<>();
+
+        byte[] first(int attr) {
+            List<byte[]> l = attrs.get(attr);
+            return l == null || l.isEmpty() ? null : l.get(0);
+        }
+    }
+
+    static Message parse(byte[] buf, int length) {
+        if (length < 20 || (buf[0] & 0xc0) != 0 || Stun.getInt(buf, 4) != Stun.COOKIE) return null;
+        int len = Stun.getShort(buf, 2);
+        if (20 + len > length) return null;
+        Message m = new Message();
+        m.type = Stun.getShort(buf, 0);
+        m.tx = Arrays.copyOfRange(buf, 8, 20);
+        for (int off = 20; off + 4 <= 20 + len; ) {
+            int type = Stun.getShort(buf, off);
+            int alen = Stun.getShort(buf, off + 2);
+            if (off + 4 + alen > 20 + len) return null;
+            List<byte[]> l = m.attrs.get(type);
+            if (l == null) m.attrs.put(type, l = new ArrayList<>());
+            l.add(Arrays.copyOfRange(buf, off + 4, off + 4 + alen));
+            off += 4 + alen + pad4(alen);
+        }
+        return m;
+    }
+
+    static int pad4(int n) {
+        return (4 - (n % 4)) % 4;
+    }
+
+    /** Build a message; with `key`, MESSAGE-INTEGRITY is appended. */
+    static byte[] build(int type, List<Object[]> attrs, byte[] key, byte[] tx) throws IOException {
+        int len = 0;
+        for (Object[] a : attrs) len += 4 + ((byte[]) a[1]).length + pad4(((byte[]) a[1]).length);
+        byte[] msg = new byte[20 + len + (key != null ? 24 : 0)];
+        Stun.putShort(msg, 0, type);
+        Stun.putShort(msg, 2, len + (key != null ? 24 : 0)); // the length counts the integrity attribute
+        Stun.putInt(msg, 4, Stun.COOKIE);
+        System.arraycopy(tx, 0, msg, 8, 12);
+        int off = 20;
+        for (Object[] a : attrs) {
+            byte[] v = (byte[]) a[1];
+            Stun.putShort(msg, off, (Integer) a[0]);
+            Stun.putShort(msg, off + 2, v.length);
+            System.arraycopy(v, 0, msg, off + 4, v.length);
+            off += 4 + v.length + pad4(v.length);
+        }
+        if (key != null) {
+            try {
+                Mac mac = Mac.getInstance("HmacSHA1");
+                mac.init(new SecretKeySpec(key, "HmacSHA1"));
+                mac.update(msg, 0, 20 + len);
+                byte[] h = mac.doFinal();
+                Stun.putShort(msg, off, A_INTEGRITY);
+                Stun.putShort(msg, off + 2, 20);
+                System.arraycopy(h, 0, msg, off + 4, 20);
+            } catch (Exception e) {
+                throw new IOException(e);
+            }
+        }
+        return msg;
+    }
+
+    static byte[] xorAddr(String address, int port) {
+        byte[] b = new byte[8];
+        b[1] = 1;
+        Stun.putShort(b, 2, port ^ (Stun.COOKIE >>> 16));
+        String[] o = address.split("\\.");
+        byte[] c = new byte[4];
+        Stun.putInt(c, 0, Stun.COOKIE);
+        for (int i = 0; i < 4; i++) b[4 + i] = (byte) (Integer.parseInt(o[i]) ^ (c[i] & 0xff));
+        return b;
+    }
+
+    /** [address, port] from an IPv4 XOR address, or null. */
+    static Object[] readXorAddr(byte[] v) {
+        if (v == null || v.length < 8 || v[1] != 1) return null;
+        byte[] c = new byte[4];
+        Stun.putInt(c, 0, Stun.COOKIE);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 4; i++) {
+            if (i > 0) sb.append('.');
+            sb.append((v[4 + i] ^ c[i]) & 0xff);
+        }
+        return new Object[] { sb.toString(), Stun.getShort(v, 2) ^ (Stun.COOKIE >>> 16) };
+    }
+
+    static boolean isIpv4(String a) {
+        return a != null && a.matches("^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$");
+    }
+
+    // ---- state ----
+
+    private final List<String> urls;
+    private final String username;
+    private final String credential;
+    private final Events events;
+    private final Object lock = new Object();
+    private final Map<String, Object[]> pending = new HashMap<>(); // tx hex -> [Message or null]
+    private final Set<String> permitted = new LinkedHashSet<>();
+    private final ScheduledExecutorService timer = Executors.newSingleThreadScheduledExecutor(r -> new Thread(r, "Moonshine relay timer"));
+
+    private Server server;
+    private DatagramSocket udp;
+    private InetAddress udpAddress;
+    private Socket stream;
+    private OutputStream streamOut;
+    private String realm = "";
+    private byte[] nonce = new byte[0];
+    private byte[] key;
+    private Object[] relayed;
+    private volatile boolean closed;
+
+    TurnClient(List<String> urls, String username, String credential, Events events) {
+        this.urls = urls;
+        this.username = username;
+        this.credential = credential;
+        this.events = events;
+    }
+
+    private void connectTo(Server s) throws IOException {
+        InetAddress addr = null;
+        for (InetAddress a : InetAddress.getAllByName(s.host)) {
+            if (a instanceof Inet4Address) {
+                addr = a;
+                break;
+            }
+        }
+        if (addr == null) throw new IOException("no IPv4 address for the relay");
+        if ("udp".equals(s.transport)) {
+            DatagramSocket sock = new DatagramSocket();
+            udp = sock;
+            udpAddress = addr;
+            Thread t = new Thread(() -> {
+                byte[] buf = new byte[65536];
+                DatagramPacket p = new DatagramPacket(buf, buf.length);
+                while (!closed && !sock.isClosed()) {
+                    try {
+                        p.setLength(buf.length);
+                        sock.receive(p);
+                        if (p.getAddress().equals(udpAddress) && p.getPort() == s.port) onMessage(buf, p.getLength());
+                    } catch (IOException e) {
+                        break;
+                    }
+                }
+            }, "Moonshine relay (UDP)");
+            t.setDaemon(true);
+            t.start();
+            return;
+        }
+        Socket sock = new Socket();
+        sock.connect(new InetSocketAddress(addr, s.port), CONNECT_TIMEOUT_MS);
+        if ("tls".equals(s.transport)) {
+            // TLS with the relay's name (sent as SNI), and its certificate checked against that name
+            SSLSocket ssl = (SSLSocket) ((SSLSocketFactory) SSLSocketFactory.getDefault()).createSocket(sock, s.host, s.port, true);
+            ssl.setSoTimeout(CONNECT_TIMEOUT_MS * 2);
+            ssl.startHandshake();
+            ssl.setSoTimeout(0);
+            if (!javax.net.ssl.HttpsURLConnection.getDefaultHostnameVerifier().verify(s.host, ssl.getSession())) {
+                ssl.close();
+                throw new IOException("the relay's certificate doesn't match its name");
+            }
+            sock = ssl;
+        }
+        sock.setTcpNoDelay(true);
+        stream = sock;
+        streamOut = sock.getOutputStream();
+        final InputStream in = sock.getInputStream();
+        Thread t = new Thread(() -> {
+            byte[] head = new byte[20];
+            try {
+                while (!closed) {
+                    readFully(in, head, 20);
+                    int total = 20 + Stun.getShort(head, 2);
+                    byte[] msg = new byte[total];
+                    System.arraycopy(head, 0, msg, 0, 20);
+                    readFully(in, msg, 20, total - 20);
+                    onMessage(msg, total);
+                }
+            } catch (IOException e) {
+                lost("relay connection closed");
+            }
+        }, "Moonshine relay (TCP)");
+        t.setDaemon(true);
+        t.start();
+    }
+
+    private static void readFully(InputStream in, byte[] b, int len) throws IOException {
+        readFully(in, b, 0, len);
+    }
+
+    private static void readFully(InputStream in, byte[] b, int off, int len) throws IOException {
+        while (len > 0) {
+            int n = in.read(b, off, len);
+            if (n < 0) throw new IOException("closed");
+            off += n;
+            len -= n;
+        }
+    }
+
+    private void sendWire(byte[] msg) {
+        try {
+            if (udp != null) {
+                udp.send(new DatagramPacket(msg, msg.length, udpAddress, server.port));
+            } else if (streamOut != null) {
+                synchronized (streamOut) {
+                    streamOut.write(msg);
+                    streamOut.flush();
+                }
+            }
+        } catch (IOException e) {
+            if (stream != null) lost("relay connection error");
+        }
+    }
+
+    private void dropConnection() {
+        try { if (udp != null) udp.close(); } catch (Exception ignored) { }
+        try { if (stream != null) stream.close(); } catch (Exception ignored) { }
+        udp = null;
+        stream = null;
+        streamOut = null;
+        key = null;
+        server = null;
+    }
+
+    private void lost(String why) {
+        if (closed) return;
+        closed = true;
+        timer.shutdownNow();
+        synchronized (lock) {
+            pending.clear();
+            lock.notifyAll();
+        }
+        events.onClosed(why);
+    }
+
+    private void onMessage(byte[] buf, int len) {
+        Message m = parse(buf, len);
+        if (m == null) return;
+        if (m.type == DATA) {
+            Object[] peer = readXorAddr(m.first(A_PEER));
+            byte[] data = m.first(A_DATA);
+            if (peer != null && data != null) events.onData(data, (String) peer[0], (Integer) peer[1]);
+            return;
+        }
+        String k = hex(m.tx);
+        synchronized (lock) {
+            Object[] slot = pending.get(k);
+            if (slot != null) {
+                slot[0] = m;
+                lock.notifyAll();
+            }
+        }
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) sb.append(String.format("%02x", x));
+        return sb.toString();
+    }
+
+    private Message attempt(int type, List<Object[]> attrs, boolean withKey) throws IOException {
+        List<Object[]> all = new ArrayList<>(attrs);
+        if (withKey) {
+            all.add(new Object[] { A_USERNAME, username.getBytes(StandardCharsets.UTF_8) });
+            all.add(new Object[] { A_REALM, realm.getBytes(StandardCharsets.UTF_8) });
+            all.add(new Object[] { A_NONCE, nonce });
+        }
+        byte[] tx = new byte[12];
+        RANDOM.nextBytes(tx);
+        byte[] msg = build(type, all, withKey ? key : null, tx);
+        String k = hex(tx);
+        Object[] slot = new Object[1];
+        boolean isUdp = server != null && "udp".equals(server.transport);
+        long[] resends = isUdp ? new long[] { 0, 300, 700 } : new long[] { 0 };
+        long deadline = System.currentTimeMillis() + resends[resends.length - 1] + (isUdp ? 1000 : 4000);
+        long start = System.currentTimeMillis();
+        int sent = 0;
+        synchronized (lock) {
+            pending.put(k, slot);
+        }
+        try {
+            while (true) {
+                long now = System.currentTimeMillis();
+                while (sent < resends.length && now - start >= resends[sent]) {
+                    if (!closed) sendWire(msg);
+                    sent++;
+                }
+                synchronized (lock) {
+                    if (slot[0] != null) return (Message) slot[0];
+                    if (closed) throw new IOException("closed");
+                    long nextResend = sent < resends.length ? start + resends[sent] : Long.MAX_VALUE;
+                    long wait = Math.min(nextResend, deadline) - System.currentTimeMillis();
+                    if (System.currentTimeMillis() >= deadline) throw new IOException("the relay didn't answer");
+                    if (wait > 0) lock.wait(wait);
+                }
+            }
+        } catch (InterruptedException e) {
+            throw new IOException("interrupted");
+        } finally {
+            synchronized (lock) {
+                pending.remove(k);
+            }
+        }
+    }
+
+    private static int errorCode(Message m) {
+        byte[] v = m.first(A_ERROR);
+        return v != null && v.length >= 4 ? (v[2] & 0xff) * 100 + (v[3] & 0xff) : 0;
+    }
+
+    private Message request(int type, List<Object[]> attrs) throws IOException {
+        Message res = attempt(type, attrs, key != null);
+        int code = errorCode(res);
+        if (code == 401 || code == 438) {
+            // The server's challenge: its realm and a nonce to sign with (also how a stale nonce is renewed)
+            byte[] r = res.first(A_REALM);
+            byte[] n = res.first(A_NONCE);
+            if (r != null && n != null) {
+                realm = new String(r, StandardCharsets.UTF_8);
+                nonce = n;
+                try {
+                    key = MessageDigest.getInstance("MD5").digest((username + ":" + realm + ":" + credential).getBytes(StandardCharsets.UTF_8));
+                } catch (Exception e) {
+                    throw new IOException(e);
+                }
+                res = attempt(type, attrs, true);
+                code = errorCode(res);
+            }
+        }
+        if (code != 0) throw new IOException("the relay refused (" + code + ")");
+        return res;
+    }
+
+    /** Connect to the first relay address that works and get a relayed address there: [address, port]. */
+    Object[] allocate() throws IOException {
+        List<String> tried = new ArrayList<>();
+        for (Server s : plan(urls)) {
+            try {
+                connectTo(s);
+                server = s;
+                List<Object[]> attrs = new ArrayList<>();
+                attrs.add(new Object[] { A_TRANSPORT, new byte[] { 17, 0, 0, 0 } }); // UDP
+                Message res = request(ALLOCATE, attrs);
+                Object[] r = readXorAddr(res.first(A_RELAYED));
+                if (r == null) throw new IOException("no address given");
+                relayed = r;
+                timer.scheduleWithFixedDelay(() -> {
+                    try {
+                        refresh();
+                    } catch (IOException e) {
+                        lost(e.getMessage());
+                    }
+                }, REFRESH_EVERY_MS, REFRESH_EVERY_MS, TimeUnit.MILLISECONDS);
+                return r;
+            } catch (IOException e) {
+                tried.add(s.transport + "://" + s.host + ":" + s.port + " " + e.getMessage());
+                dropConnection();
+                if (closed) break;
+            }
+        }
+        StringBuilder why = new StringBuilder();
+        for (String t : tried) why.append(why.length() > 0 ? "; " : "").append(t);
+        throw new IOException("no relay reachable (" + (tried.isEmpty() ? "no addresses" : why) + ")");
+    }
+
+    /** Let these IPv4 addresses send to the relayed address. */
+    void permit(List<String> ips) throws IOException {
+        List<Object[]> attrs = new ArrayList<>();
+        Set<String> fresh = new LinkedHashSet<>();
+        for (String ip : ips) if (isIpv4(ip)) fresh.add(ip);
+        if (fresh.isEmpty()) return;
+        for (String ip : fresh) attrs.add(new Object[] { A_PEER, xorAddr(ip, 0) });
+        request(PERMISSION, attrs);
+        synchronized (permitted) {
+            permitted.addAll(fresh);
+        }
+    }
+
+    private void refresh() throws IOException {
+        byte[] lifetime = new byte[4];
+        Stun.putInt(lifetime, 0, 600);
+        List<Object[]> attrs = new ArrayList<>();
+        attrs.add(new Object[] { A_LIFETIME, lifetime });
+        request(REFRESH, attrs);
+        List<Object[]> perms = new ArrayList<>();
+        synchronized (permitted) {
+            for (String ip : permitted) perms.add(new Object[] { A_PEER, xorAddr(ip, 0) });
+        }
+        if (!perms.isEmpty()) request(PERMISSION, perms);
+    }
+
+    /** Send a packet to a peer through the relay. */
+    void send(String address, int port, byte[] data) {
+        if (closed || !isIpv4(address)) return;
+        try {
+            List<Object[]> attrs = new ArrayList<>();
+            attrs.add(new Object[] { A_PEER, xorAddr(address, port) });
+            attrs.add(new Object[] { A_DATA, data });
+            byte[] tx = new byte[12];
+            RANDOM.nextBytes(tx);
+            sendWire(build(SEND, attrs, null, tx));
+        } catch (IOException ignored) {
+            // dropped, like any datagram
+        }
+    }
+
+    void close() {
+        if (closed) return;
+        // Hand the allocation back (best effort), then drop the connection
+        if (relayed != null && key != null) {
+            try {
+                List<Object[]> attrs = new ArrayList<>();
+                attrs.add(new Object[] { A_LIFETIME, new byte[4] });
+                attrs.add(new Object[] { A_USERNAME, username.getBytes(StandardCharsets.UTF_8) });
+                attrs.add(new Object[] { A_REALM, realm.getBytes(StandardCharsets.UTF_8) });
+                attrs.add(new Object[] { A_NONCE, nonce });
+                byte[] tx = new byte[12];
+                RANDOM.nextBytes(tx);
+                sendWire(build(REFRESH, attrs, key, tx));
+            } catch (Exception ignored) {
+                // going away anyway
+            }
+        }
+        closed = true;
+        timer.shutdownNow();
+        synchronized (lock) {
+            pending.clear();
+            lock.notifyAll();
+        }
+        dropConnection();
+        events.onClosed("closed");
+    }
+}
