index 00000000..7b594df5
--- /dev/null
+++ b/app/src/main/java/com/moonshine/tunnel/TurnClient.java
@@ -0,0 +1,529 @@
+package com.moonshine.tunnel;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+
+/**
+ * A small TURN client (RFC 8656), the same as the desktop app's (app/lib/turn.js): asks Cloudflare's relay
+ * for a public address that forwards to this phone, the last resort when no direct path works. Everything
+ * that crosses it is already encrypted end to end by the tunnel. UDP, TCP or TLS to the relay; long-term
+ * credentials; Send/Data indications; the allocation and permissions are refreshed until close().
+ */
+final class TurnClient {
+    interface Events {
+        void onData(byte[] data, String fromAddress, int fromPort);
+
+        void onClosed(String why);
+    }
+
+    private static final int ALLOCATE = 0x0003, REFRESH = 0x0004, PERMISSION = 0x0008, SEND = 0x0016, DATA = 0x0017;
+    private static final int A_USERNAME = 0x0006, A_INTEGRITY = 0x0008, A_ERROR = 0x0009, A_LIFETIME = 0x000d,
+            A_PEER = 0x0012, A_DATA = 0x0013, A_REALM = 0x0014, A_NONCE = 0x0015, A_RELAYED = 0x0016, A_TRANSPORT = 0x0019;
+    private static final long REFRESH_EVERY_MS = 4 * 60 * 1000;
+    private static final int CONNECT_TIMEOUT_MS = 2500;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    static final class Server {
+        final boolean secure;
+        final String host;
+        final int port;
+        final String transport; // udp, tcp, tls
+
+        Server(boolean secure, String host, int port, String transport) {
+            this.secure = secure;
+            this.host = host;
+            this.port = port;
+            this.transport = transport;
+        }
+    }
+
+    private static final Pattern URL = Pattern.compile("^(turns?):([A-Za-z0-9.-]{1,253})(?::(\\d{1,5}))?(?:\\?transport=(udp|tcp))?$", Pattern.CASE_INSENSITIVE);
+
+    static Server parseUrl(String url) {
+        Matcher m = URL.matcher(String.valueOf(url));
+        if (!m.matches()) return null;
+        boolean secure = m.group(1).equalsIgnoreCase("turns");
+        int port = m.group(3) != null ? Integer.parseInt(m.group(3)) : (secure ? 5349 : 3478);
+        if (port < 1 || port > 65535) return null;
+        String transport = secure ? "tls" : (m.group(4) != null ? m.group(4).toLowerCase() : "udp");
+        return new Server(secure, m.group(2), port, transport);
+    }
+
+    /** The addresses to try, UDP before TCP before TLS. */
+    static List<Server> plan(List<String> urls) {
+        List<Server> out = new ArrayList<>();
+        for (String u : urls) {
+            Server s = parseUrl(u);
+            if (s != null) out.add(s);
+        }
+        List<String> rank = Arrays.asList("udp", "tcp", "tls");
+        java.util.Collections.sort(out, (a, b) -> rank.indexOf(a.transport) - rank.indexOf(b.transport));
+        return out;
+    }
+
+    /** A parsed STUN/TURN message. */
+    static final class Message {
+        int type;
+        byte[] tx;
+        final Map<Integer, List<byte[]>> attrs = new HashMap<>();
+
+        byte[] first(int attr) {
+            List<byte[]> l = attrs.get(attr);
+            return l == null || l.isEmpty() ? null : l.get(0);
+        }
+    }
+
+    static Message parse(byte[] buf, int length) {
+        if (length < 20 || (buf[0] & 0xc0) != 0 || Stun.getInt(buf, 4) != Stun.COOKIE) return null;
+        int len = Stun.getShort(buf, 2);
+        if (20 + len > length) return null;
+        Message m = new Message();
+        m.type = Stun.getShort(buf, 0);
+        m.tx = Arrays.copyOfRange(buf, 8, 20);
+        for (int off = 20; off + 4 <= 20 + len; ) {
+            int type = Stun.getShort(buf, off);
+            int alen = Stun.getShort(buf, off + 2);
+            if (off + 4 + alen > 20 + len) return null;
+            List<byte[]> l = m.attrs.get(type);
+            if (l == null) m.attrs.put(type, l = new ArrayList<>());
+            l.add(Arrays.copyOfRange(buf, off + 4, off + 4 + alen));
+            off += 4 + alen + pad4(alen);
+        }
+        return m;
+    }
+
+    static int pad4(int n) {
+        return (4 - (n % 4)) % 4;
+    }
+
+    /** Build a message; with `key`, MESSAGE-INTEGRITY is appended. */
+    static byte[] build(int type, List<Object[]> attrs, byte[] key, byte[] tx) throws IOException {
+        int len = 0;
+        for (Object[] a : attrs) len += 4 + ((byte[]) a[1]).length + pad4(((byte[]) a[1]).length);
+        byte[] msg = new byte[20 + len + (key != null ? 24 : 0)];
+        Stun.putShort(msg, 0, type);
+        Stun.putShort(msg, 2, len + (key != null ? 24 : 0)); // the length counts the integrity attribute
+        Stun.putInt(msg, 4, Stun.COOKIE);
+        System.arraycopy(tx, 0, msg, 8, 12);
+        int off = 20;
+        for (Object[] a : attrs) {
+            byte[] v = (byte[]) a[1];
+            Stun.putShort(msg, off, (Integer) a[0]);
+            Stun.putShort(msg, off + 2, v.length);
+            System.arraycopy(v, 0, msg, off + 4, v.length);
+            off += 4 + v.length + pad4(v.length);
+        }
+        if (key != null) {
+            try {
+                Mac mac = Mac.getInstance("HmacSHA1");
+                mac.init(new SecretKeySpec(key, "HmacSHA1"));
+                mac.update(msg, 0, 20 + len);
+                byte[] h = mac.doFinal();
+                Stun.putShort(msg, off, A_INTEGRITY);
+                Stun.putShort(msg, off + 2, 20);
+                System.arraycopy(h, 0, msg, off + 4, 20);
+            } catch (Exception e) {
+                throw new IOException(e);
+            }
+        }
+        return msg;
+    }
+
+    static byte[] xorAddr(String address, int port) {
+        byte[] b = new byte[8];
+        b[1] = 1;
+        Stun.putShort(b, 2, port ^ (Stun.COOKIE >>> 16));
+        String[] o = address.split("\\.");
+        byte[] c = new byte[4];
+        Stun.putInt(c, 0, Stun.COOKIE);
+        for (int i = 0; i < 4; i++) b[4 + i] = (byte) (Integer.parseInt(o[i]) ^ (c[i] & 0xff));
+        return b;
+    }
+
+    /** [address, port] from an IPv4 XOR address, or null. */
+    static Object[] readXorAddr(byte[] v) {
+        if (v == null || v.length < 8 || v[1] != 1) return null;
+        byte[] c = new byte[4];
+        Stun.putInt(c, 0, Stun.COOKIE);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 4; i++) {
+            if (i > 0) sb.append('.');
+            sb.append((v[4 + i] ^ c[i]) & 0xff);
+        }
+        return new Object[] { sb.toString(), Stun.getShort(v, 2) ^ (Stun.COOKIE >>> 16) };
+    }
+
+    static boolean isIpv4(String a) {
+        return a != null && a.matches("^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$");
+    }
+
+    // ---- state ----
+
+    private final List<String> urls;
+    private final String username;
+    private final String credential;
+    private final Events events;
+    private final Object lock = new Object();
+    private final Map<String, Object[]> pending = new HashMap<>(); // tx hex -> [Message or null]
+    private final Set<String> permitted = new LinkedHashSet<>();
+    private final ScheduledExecutorService timer = Executors.newSingleThreadScheduledExecutor(r -> new Thread(r, "Moonshine relay timer"));
+
+    private Server server;
+    private DatagramSocket udp;
+    private InetAddress udpAddress;
+    private Socket stream;
+    private OutputStream streamOut;
+    private String realm = "";
+    private byte[] nonce = new byte[0];
+    private byte[] key;
+    private Object[] relayed;
+    private volatile boolean closed;
+
+    TurnClient(List<String> urls, String username, String credential, Events events) {
+        this.urls = urls;
+        this.username = username;
+        this.credential = credential;
+        this.events = events;
+    }
+
+    private void connectTo(Server s) throws IOException {
+        InetAddress addr = null;
+        for (InetAddress a : InetAddress.getAllByName(s.host)) {
+            if (a instanceof Inet4Address) {
+                addr = a;
+                break;
+            }
+        }
+        if (addr == null) throw new IOException("no IPv4 address for the relay");
+        if ("udp".equals(s.transport)) {
+            DatagramSocket sock = new DatagramSocket();
+            udp = sock;
+            udpAddress = addr;
+            Thread t = new Thread(() -> {
+                byte[] buf = new byte[65536];
+                DatagramPacket p = new DatagramPacket(buf, buf.length);
+                while (!closed && !sock.isClosed()) {
+                    try {
+                        p.setLength(buf.length);
+                        sock.receive(p);
+                        if (p.getAddress().equals(udpAddress) && p.getPort() == s.port) onMessage(buf, p.getLength());
+                    } catch (IOException e) {
+                        break;
+                    }
+                }
+            }, "Moonshine relay (UDP)");
+            t.setDaemon(true);
+            t.start();
+            return;
+        }
+        Socket sock = new Socket();
+        sock.connect(new InetSocketAddress(addr, s.port), CONNECT_TIMEOUT_MS);
+        if ("tls".equals(s.transport)) {
+            // TLS with the relay's name (sent as SNI), and its certificate checked against that name
+            SSLSocket ssl = (SSLSocket) ((SSLSocketFactory) SSLSocketFactory.getDefault()).createSocket(sock, s.host, s.port, true);
+            ssl.setSoTimeout(CONNECT_TIMEOUT_MS * 2);
+            ssl.startHandshake();
+            ssl.setSoTimeout(0);
+            if (!javax.net.ssl.HttpsURLConnection.getDefaultHostnameVerifier().verify(s.host, ssl.getSession())) {
+                ssl.close();
+                throw new IOException("the relay's certificate doesn't match its name");
+            }
+            sock = ssl;
+        }
+        sock.setTcpNoDelay(true);
+        stream = sock;
+        streamOut = sock.getOutputStream();
+        final InputStream in = sock.getInputStream();
+        Thread t = new Thread(() -> {
+            byte[] head = new byte[20];
+            try {
+                while (!closed) {
+                    readFully(in, head, 20);
+                    int total = 20 + Stun.getShort(head, 2);
+                    byte[] msg = new byte[total];
+                    System.arraycopy(head, 0, msg, 0, 20);
+                    readFully(in, msg, 20, total - 20);
+                    onMessage(msg, total);
+                }
+            } catch (IOException e) {
+                lost("relay connection closed");
+            }
+        }, "Moonshine relay (TCP)");
+        t.setDaemon(true);
+        t.start();
+    }
+
+    private static void readFully(InputStream in, byte[] b, int len) throws IOException {
+        readFully(in, b, 0, len);
+    }
+
+    private static void readFully(InputStream in, byte[] b, int off, int len) throws IOException {
+        while (len > 0) {
+            int n = in.read(b, off, len);
+            if (n < 0) throw new IOException("closed");
+            off += n;
+            len -= n;
+        }
+    }
+
+    private void sendWire(byte[] msg) {
+        try {
+            if (udp != null) {
+                udp.send(new DatagramPacket(msg, msg.length, udpAddress, server.port));
+            } else if (streamOut != null) {
+                synchronized (streamOut) {
+                    streamOut.write(msg);
+                    streamOut.flush();
+                }
+            }
+        } catch (IOException e) {
+            if (stream != null) lost("relay connection error");
+        }
+    }
+
+    private void dropConnection() {
+        try { if (udp != null) udp.close(); } catch (Exception ignored) { }
+        try { if (stream != null) stream.close(); } catch (Exception ignored) { }
+        udp = null;
+        stream = null;
+        streamOut = null;
+        key = null;
+        server = null;
+    }
+
+    private void lost(String why) {
+        if (closed) return;
+        closed = true;
+        timer.shutdownNow();
+        synchronized (lock) {
+            pending.clear();
+            lock.notifyAll();
+        }
+        events.onClosed(why);
+    }
+
+    private void onMessage(byte[] buf, int len) {
+        Message m = parse(buf, len);
+        if (m == null) return;
+        if (m.type == DATA) {
+            Object[] peer = readXorAddr(m.first(A_PEER));
+            byte[] data = m.first(A_DATA);
+            if (peer != null && data != null) events.onData(data, (String) peer[0], (Integer) peer[1]);
+            return;
+        }
+        String k = hex(m.tx);
+        synchronized (lock) {
+            Object[] slot = pending.get(k);
+            if (slot != null) {
+                slot[0] = m;
+                lock.notifyAll();
+            }
+        }
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) sb.append(String.format("%02x", x));
+        return sb.toString();
+    }
+
+    private Message attempt(int type, List<Object[]> attrs, boolean withKey) throws IOException {
+        List<Object[]> all = new ArrayList<>(attrs);
+        if (withKey) {
+            all.add(new Object[] { A_USERNAME, username.getBytes(StandardCharsets.UTF_8) });
+            all.add(new Object[] { A_REALM, realm.getBytes(StandardCharsets.UTF_8) });
+            all.add(new Object[] { A_NONCE, nonce });
+        }
+        byte[] tx = new byte[12];
+        RANDOM.nextBytes(tx);
+        byte[] msg = build(type, all, withKey ? key : null, tx);
+        String k = hex(tx);
+        Object[] slot = new Object[1];
+        boolean isUdp = server != null && "udp".equals(server.transport);
+        long[] resends = isUdp ? new long[] { 0, 300, 700 } : new long[] { 0 };
+        long deadline = System.currentTimeMillis() + resends[resends.length - 1] + (isUdp ? 1000 : 4000);
+        long start = System.currentTimeMillis();
+        int sent = 0;
+        synchronized (lock) {
+            pending.put(k, slot);
+        }
+        try {
+            while (true) {
+                long now = System.currentTimeMillis();
+                while (sent < resends.length && now - start >= resends[sent]) {
+                    if (!closed) sendWire(msg);
+                    sent++;
+                }
+                synchronized (lock) {
+                    if (slot[0] != null) return (Message) slot[0];
+                    if (closed) throw new IOException("closed");
+                    long nextResend = sent < resends.length ? start + resends[sent] : Long.MAX_VALUE;
+                    long wait = Math.min(nextResend, deadline) - System.currentTimeMillis();
+                    if (System.currentTimeMillis() >= deadline) throw new IOException("the relay didn't answer");
+                    if (wait > 0) lock.wait(wait);
+                }
+            }
+        } catch (InterruptedException e) {
+            throw new IOException("interrupted");
+        } finally {
+            synchronized (lock) {
+                pending.remove(k);
+            }
+        }
+    }
+
+    private static int errorCode(Message m) {
+        byte[] v = m.first(A_ERROR);
+        return v != null && v.length >= 4 ? (v[2] & 0xff) * 100 + (v[3] & 0xff) : 0;
+    }
+
+    private Message request(int type, List<Object[]> attrs) throws IOException {
+        Message res = attempt(type, attrs, key != null);
+        int code = errorCode(res);
+        if (code == 401 || code == 438) {
+            // The server's challenge: its realm and a nonce to sign with (also how a stale nonce is renewed)
+            byte[] r = res.first(A_REALM);
+            byte[] n = res.first(A_NONCE);
+            if (r != null && n != null) {
+                realm = new String(r, StandardCharsets.UTF_8);
+                nonce = n;
+                try {
+                    key = MessageDigest.getInstance("MD5").digest((username + ":" + realm + ":" + credential).getBytes(StandardCharsets.UTF_8));
+                } catch (Exception e) {
+                    throw new IOException(e);
+                }
+                res = attempt(type, attrs, true);
+                code = errorCode(res);
+            }
+        }
+        if (code != 0) throw new IOException("the relay refused (" + code + ")");
+        return res;
+    }
+
+    /** Connect to the first relay address that works and get a relayed address there: [address, port]. */
+    Object[] allocate() throws IOException {
+        List<String> tried = new ArrayList<>();
+        for (Server s : plan(urls)) {
+            try {
+                connectTo(s);
+                server = s;
+                List<Object[]> attrs = new ArrayList<>();
+                attrs.add(new Object[] { A_TRANSPORT, new byte[] { 17, 0, 0, 0 } }); // UDP
+                Message res = request(ALLOCATE, attrs);
+                Object[] r = readXorAddr(res.first(A_RELAYED));
+                if (r == null) throw new IOException("no address given");
+                relayed = r;
+                timer.scheduleWithFixedDelay(() -> {
+                    try {
+                        refresh();
+                    } catch (IOException e) {
+                        lost(e.getMessage());
+                    }
+                }, REFRESH_EVERY_MS, REFRESH_EVERY_MS, TimeUnit.MILLISECONDS);
+                return r;
+            } catch (IOException e) {
+                tried.add(s.transport + "://" + s.host + ":" + s.port + " " + e.getMessage());
+                dropConnection();
+                if (closed) break;
+            }
+        }
+        StringBuilder why = new StringBuilder();
+        for (String t : tried) why.append(why.length() > 0 ? "; " : "").append(t);
+        throw new IOException("no relay reachable (" + (tried.isEmpty() ? "no addresses" : why) + ")");
+    }
+
+    /** Let these IPv4 addresses send to the relayed address. */
+    void permit(List<String> ips) throws IOException {
+        List<Object[]> attrs = new ArrayList<>();
+        Set<String> fresh = new LinkedHashSet<>();
+        for (String ip : ips) if (isIpv4(ip)) fresh.add(ip);
+        if (fresh.isEmpty()) return;
+        for (String ip : fresh) attrs.add(new Object[] { A_PEER, xorAddr(ip, 0) });
+        request(PERMISSION, attrs);
+        synchronized (permitted) {
+            permitted.addAll(fresh);
+        }
+    }
+
+    private void refresh() throws IOException {
+        byte[] lifetime = new byte[4];
+        Stun.putInt(lifetime, 0, 600);
+        List<Object[]> attrs = new ArrayList<>();
+        attrs.add(new Object[] { A_LIFETIME, lifetime });
+        request(REFRESH, attrs);
+        List<Object[]> perms = new ArrayList<>();
+        synchronized (permitted) {
+            for (String ip : permitted) perms.add(new Object[] { A_PEER, xorAddr(ip, 0) });
+        }
+        if (!perms.isEmpty()) request(PERMISSION, perms);
+    }
+
+    /** Send a packet to a peer through the relay. */
+    void send(String address, int port, byte[] data) {
+        if (closed || !isIpv4(address)) return;
+        try {
+            List<Object[]> attrs = new ArrayList<>();
+            attrs.add(new Object[] { A_PEER, xorAddr(address, port) });
+            attrs.add(new Object[] { A_DATA, data });
+            byte[] tx = new byte[12];
+            RANDOM.nextBytes(tx);
+            sendWire(build(SEND, attrs, null, tx));
+        } catch (IOException ignored) {
+            // dropped, like any datagram
+        }
+    }
+
+    void close() {
+        if (closed) return;
+        // Hand the allocation back (best effort), then drop the connection
+        if (relayed != null && key != null) {
+            try {
+                List<Object[]> attrs = new ArrayList<>();
+                attrs.add(new Object[] { A_LIFETIME, new byte[4] });
+                attrs.add(new Object[] { A_USERNAME, username.getBytes(StandardCharsets.UTF_8) });
+                attrs.add(new Object[] { A_REALM, realm.getBytes(StandardCharsets.UTF_8) });
+                attrs.add(new Object[] { A_NONCE, nonce });
+                byte[] tx = new byte[12];
+                RANDOM.nextBytes(tx);
+                sendWire(build(REFRESH, attrs, key, tx));
+            } catch (Exception ignored) {
+                // going away anyway
+            }
+        }
+        closed = true;
+        timer.shutdownNow();
+        synchronized (lock) {
+            pending.clear();
+            lock.notifyAll();
+        }
+        dropConnection();
+        events.onClosed("closed");
+    }
+}
