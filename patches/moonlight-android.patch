+
+    @Before
+    public void start() throws Exception {
+        apk = new byte[2_500_000];
+        new Random(7).nextBytes(apk);
+        server = new MockWebServer();
+        server.setDispatcher(new Dispatcher() {
+            @Override
+            public MockResponse dispatch(RecordedRequest request) {
+                String path = request.getPath();
+                if ("/good".equals(path)) return new MockResponse().setBody(new Buffer().write(apk));
+                if ("/tiny".equals(path)) return new MockResponse().setBody(new Buffer().write(new byte[1000]));
+                return new MockResponse().setResponseCode(404);
+            }
+        });
+        server.start();
+        base = server.url("/").toString();
+        Updates.downloadsFrom = base;
+    }
+
+    @After
+    public void stop() throws Exception {
+        server.shutdown();
+        Updates.downloadsFrom = Updates.DOWNLOADS;
+    }
+
+    private static String sha(byte[] b) throws Exception {
+        StringBuilder s = new StringBuilder();
+        for (byte x : MessageDigest.getInstance("SHA-256").digest(b)) s.append(String.format("%02x", x));
+        return s.toString();
+    }
+
+    private Updates.Found found(String path, String sha) {
+        return new Updates.Found("0.8.0", "page", base + path, 2_500_000, sha);
+    }
+
+    private void expectFailure(String path, String sha, String contains) throws Exception {
+        File out = File.createTempFile("moonshine", ".apk");
+        try {
+            Updates.fetch(found(path, sha), out, (d, t) -> { }, new AtomicBoolean());
+            fail("expected a failure");
+        } catch (IOException e) {
+            assertTrue(e.getMessage(), e.getMessage().contains(contains));
+        } finally {
+            out.delete();
+        }
+    }
+
+    @Test
+    public void aMatchingDownloadIsSaved() throws Exception {
+        File out = File.createTempFile("moonshine", ".apk");
+        Updates.fetch(found("good", sha(apk)), out, (d, t) -> { }, new AtomicBoolean());
+        assertEquals(apk.length, out.length());
+        assertTrue(Arrays.equals(apk, Files.readAllBytes(out.toPath())));
+        out.delete();
+    }
+
+    @Test
+    public void aDifferentChecksumIsRefused() throws Exception {
+        expectFailure("good", "0".repeat(64), "checksum");
+    }
+
+    @Test
+    public void aTooSmallFileIsRefused() throws Exception {
+        expectFailure("tiny", "", "incomplete");
+    }
+
+    @Test
+    public void aFailedDownloadIsReported() throws Exception {
+        expectFailure("missing", "", "404");
+    }
+
+    @Test
+    public void aLinkOutsideTheReleasesIsRefused() throws Exception {
+        Updates.downloadsFrom = Updates.DOWNLOADS;
+        expectFailure("good", "", "isn’t a Moonshine download");
+    }
+}
