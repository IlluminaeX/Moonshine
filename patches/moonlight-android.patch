+
+    private void joinGame(Intent i) {
+        final String hostUuid = i.getStringExtra("join_host_uuid");
+        final String app = i.getStringExtra("join_app");
+        final String hostName = String.valueOf(i.getStringExtra("join_host"));
+        i.removeExtra("join_host_uuid");
+        if (hostUuid == null) return;
+        showProgress("Looking for " + hostName + "…");
+        m.run(() -> {
+            // The friends list as it is now: their PC's addresses and whether it can be reached directly
+            JSONObject pc = null;
+            try {
+                JSONObject f = Service.call("GET", "/friends", null, m.token());
+                pc = findPc(f, hostUuid);
+            } catch (IOException ignored) {
+                pc = m.friendPc(hostUuid);
+            }
+            final JSONObject found = pc;
+            runOnUiThread(() -> {
+                hideProgress();
+                if (found == null) {
+                    toast(hostName + " isn’t hosting any more.");
+                    return;
+                }
+                String name = Moonshine.clean(found.optString("name"), 60);
+                Tunnels.Target t = found.optBoolean("tunnel") && found.optLong("device") > 0
+                        ? new Tunnels.Target(hostUuid, found.optLong("device"), found.optInt("port", 47989), name, m.hub, m.token()) : null;
+                connect(hostUuid, name, found.optInt("port", 47989), found.optJSONArray("addrs"), t, app);
+            });
+        });
+    }
+
+    private static JSONObject findPc(JSONObject f, String hostUuid) {
+        JSONArray list = f.optJSONArray("friends");
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend == null || !"accepted".equals(friend.optString("status"))) continue;
+            JSONArray pcs = friend.optJSONArray("pcs");
+            for (int j = 0; pcs != null && j < pcs.length(); j++) {
+                JSONObject pc = pcs.optJSONObject(j);
+                if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) return pc;
+            }
+        }
+        return null;
+    }
+
+    // ---- sending files to a PC -----------------------------------------------------------------------
+
+    private void pickFiles(JSONObject pc) {
+        filePc = pc;
+        Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT).addCategory(Intent.CATEGORY_OPENABLE).setType("*/*")
+                .putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
+        try {
+            startActivityForResult(i, PICK_FILES);
+        } catch (android.content.ActivityNotFoundException e) {
+            toast("This phone has no file picker.");
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != PICK_FILES || resultCode != RESULT_OK || data == null || filePc == null) return;
+        java.util.List<Uri> uris = new java.util.ArrayList<>();
+        if (data.getClipData() != null) {
+            for (int k = 0; k < data.getClipData().getItemCount() && k < 50; k++) uris.add(data.getClipData().getItemAt(k).getUri());
+        } else if (data.getData() != null) {
+            uris.add(data.getData());
+        }
+        if (!uris.isEmpty()) sendFilesTo(filePc, uris);
+    }
+
+    private void sendFilesTo(JSONObject pc, java.util.List<Uri> uris) {
+        if (binder == null) {
+            toast("Moonshine is still getting ready. Try again in a moment.");
+            return;
+        }
+        final ComputerManagerService.ComputerManagerBinder b = binder;
+        final String uuid = pc.optString("hostUuid");
+        final String name = PcPrefs.get(this).name(uuid, Moonshine.clean(pc.optString("name"), 60));
+        final int port = pc.optInt("port", 47989);
+        final java.util.List<String> addrs = Connect.addrs(pc);
+        final Tunnels.Target target = pc.optBoolean("tunnel") && pc.optLong("device") > 0
+                ? new Tunnels.Target(uuid, pc.optLong("device"), port, name, m.hub, m.token()) : null;
+        final java.util.concurrent.atomic.AtomicBoolean cancelled = new java.util.concurrent.atomic.AtomicBoolean();
+        final TextView msg = text("Connecting to " + name + "…", 15, TEXT, false);
+        FrameLayout wrap = new FrameLayout(this);
+        wrap.setPadding(dp(24), dp(20), dp(24), dp(8));
+        wrap.addView(msg);
+        final AlertDialog dlg = new AlertDialog.Builder(this, R.style.MoonshineDialog).setTitle("Sending to " + name).setView(wrap)
+                .setCancelable(false).setNegativeButton("Cancel", (d, w) -> cancelled.set(true)).create();
+        dlg.show();
+        final boolean own = m.isMyPc(uuid);
+        Connect.Progress ui = new Connect.Progress() {
+            @Override
+            public void status(String text) {
+                runOnUiThread(() -> msg.setText(text));
+            }
+
+            @Override
+            public void pairing(String pin, boolean moonshine) {
+                runOnUiThread(() -> msg.setText(moonshine
+                        ? (own ? "Pairing with " + name + "…" : "Asking " + name + " to accept this phone…")
+                        : "Pairing with " + name + ". Enter this PIN in that PC’s host settings: " + pin));
+            }
+        };
+        m.run(() -> {
+            String error = null;
+            try {
+                ComputerDetails d = Connect.reach(this, b, uuid, name, port, addrs, target, ui);
+                error = Connect.pair(this, b, d, ui);
+                if (error == null) {
+                    com.limelight.nvstream.http.NvHTTP http = new com.limelight.nvstream.http.NvHTTP(d.activeAddress, d.httpsPort,
+                            b.getUniqueId(), d.serverCert, com.limelight.binding.PlatformBinding.getCryptoProvider(this));
+                    int n = 0;
+                    for (Uri uri : uris) {
+                        n++;
+                        final int number = n;
+                        FileSender.send(this, http, name, uri, (file, state, sent, size) -> runOnUiThread(() -> msg.setText(
+                                "asking".equals(state) ? "Asking " + name + " to accept " + file + "…\n(" + number + " of " + uris.size() + ")"
+                                        : "Sending " + file + "  " + (size > 0 ? (sent * 100 / size) : 0) + "%\n(" + number + " of " + uris.size() + ")")), cancelled);
+                    }
+                }
+            } catch (IOException e) {
+                error = e.getMessage();
+            } catch (InterruptedException e) {
+                error = "Sending was interrupted.";
+            }
+            final String err = error;
+            runOnUiThread(() -> {
+                dlg.dismiss();
+                if (isFinishing()) return;
+                if (err != null) {
+                    if (!cancelled.get()) new AlertDialog.Builder(this, R.style.MoonshineDialog).setTitle("Couldn’t send").setMessage(err).setPositiveButton("OK", null).show();
+                } else {
+                    toast(uris.size() == 1 ? "Sent to " + name + "." : "Sent " + uris.size() + " files to " + name + ".");
+                }
+            });
+        });
+    }
