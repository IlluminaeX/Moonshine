+    /** Find out, in the background, how this phone would reach the PC (and how long it takes), for the badge. */
+    private void probeConn(JSONObject pc) {
+        final String uuid = pc.optString("hostUuid");
+        long now = System.currentTimeMillis();
+        Long last = connAsked.get(uuid);
+        if (last != null && now - last < 20_000) return;
+        connAsked.put(uuid, now);
+        final int port = pc.optInt("port", 47989);
+        final java.util.List<String> addrs = Connect.addrs(pc);
+        m.run(() -> {
+            PcSheets.Conn c = PcSheets.probe(m, uuid, addrs, port);
+            runOnUiThread(() -> {
+                PcSheets.Conn old = conns.get(uuid);
+                boolean same = old == null ? c == null : c != null && old.kind.equals(c.kind) && old.ms == c.ms;
+                if (c == null) conns.remove(uuid);
+                else conns.put(uuid, c);
+                if (!same && !isFinishing()) render();
+            });
+        });
+    }
