+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.limelight.R;
+
+/** A list setting that shows its current choice on the right of its row, so the settings read at a glance. */
+public class MoonshineListPreference extends ListPreference {
+    public MoonshineListPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setWidgetLayoutResource(R.layout.moonshine_widget_value);
