+    private void sendPresence() {
+        String token = token();
+        if (token.isEmpty()) return;
+        try {
+            JSONObject body = new JSONObject();
+            body.put("kind", "phone");
+            body.put("name", deviceName(ctx));
+            body.put("addrs", new JSONArray(localAddresses()));
+            body.put("tunnel", true);
+            body.put("dnd", PcPrefs.get(ctx).dnd());
+            body.put("version", BuildConfig.VERSION_NAME.replaceAll("[^0-9A-Za-z.\\-]", ""));
+            Service.call("POST", "/presence", body, token);
+        } catch (IOException | JSONException ignored) {
+            // tried again in a minute
+        }
