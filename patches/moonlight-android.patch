+    private interface TextResult {
+        void done(String text);
+    }
+
+    private void promptText(String title, String hint, int max, String initial, TextResult result) {
+        EditText e = field(hint);
+        e.setFilters(new InputFilter[] { new InputFilter.LengthFilter(max) });
+        e.setText(initial);
+        FrameLayout wrap = new FrameLayout(this);
+        wrap.setPadding(dp(20), dp(8), dp(20), 0);
+        wrap.addView(e);
+        new AlertDialog.Builder(this, R.style.MoonshineDialog)
+                .setTitle(title)
+                .setView(wrap)
+                .setPositiveButton("OK", (d, w) -> result.done(e.getText().toString().trim()))
+                .setNegativeButton("Cancel", null)
+                .show();
+    }
+
+    private static JSONObject body(Object... kv) {
+        JSONObject o = new JSONObject();
+        try {
+            for (int i = 0; i + 1 < kv.length; i += 2) o.put((String) kv[i], kv[i + 1]);
+        } catch (JSONException ignored) {
+            // keys are fixed strings
+        }
+        return o;
+    }
+
+    private void friendAction(String path, JSONObject body, String done) {
+        m.run(() -> {
+            try {
+                m.friendCall(path, body);
+                if (done != null) runOnUiThread(() -> toast(done));
+            } catch (IOException e) {
+                runOnUiThread(() -> toast(e.getMessage()));
+            }
+        });
+    }
+
+    private void toast(String s) {
+        Toast.makeText(this, s, Toast.LENGTH_LONG).show();
+    }
