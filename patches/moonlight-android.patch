+    private void applyCategory() {
+        android.widget.LinearLayout chips = findViewById(R.id.settings_chips);
+        for (int i = 0; i < categories.size(); i++) {
+            categories.get(i).setVisible(selectedCategory < 0 || i == selectedCategory);
+            if (i < chips.getChildCount()) {
+                android.widget.TextView chip = (android.widget.TextView) chips.getChildAt(i);
+                chip.setSelected(i == selectedCategory);
+                chip.setTextColor(i == selectedCategory ? 0xFFFFFFFF : 0xFFB6A6BD);
+            }
+        }
+    }
