+/**
+ * The tunnel's encryption, the same as the desktop app's (app/lib/tunnel-engine.js): X25519 key
+ * agreement, HKDF-SHA256 into one key per direction, AES-256-GCM per packet with a 64-bit counter
+ * (the 9-byte header is the associated data) and a replay window.
+ */
+public final class TunnelCrypto {
+    static final int VERSION = 0x4d;
+    static final int HEADER = 9;
+    static final int TAG = 16;
+    private static final byte[] INFO = "moonshine tunnel v1".getBytes(StandardCharsets.US_ASCII);
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private TunnelCrypto() {}
+
+    /** A new X25519 key pair: [private, public], 32 bytes each. */
+    public static byte[][] newKeyPair() {
+        byte[] priv = new byte[X25519.SCALAR_SIZE];
+        byte[] pub = new byte[X25519.POINT_SIZE];
+        X25519.generatePrivateKey(RANDOM, priv);
+        X25519.generatePublicKey(priv, 0, pub, 0);
+        return new byte[][] { priv, pub };
+    }
+
+    private static final char[] B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".toCharArray();
+
+    /** Base64url without padding (plain Java, so the tunnel also runs in tests off the phone). */
+    public static String b64url(byte[] b) {
+        StringBuilder sb = new StringBuilder((b.length * 4 + 2) / 3);
+        for (int i = 0; i < b.length; i += 3) {
+            int n = (b[i] & 0xff) << 16 | (i + 1 < b.length ? (b[i + 1] & 0xff) << 8 : 0) | (i + 2 < b.length ? b[i + 2] & 0xff : 0);
+            sb.append(B64[n >>> 18 & 63]).append(B64[n >>> 12 & 63]);
+            if (i + 1 < b.length) sb.append(B64[n >>> 6 & 63]);
+            if (i + 2 < b.length) sb.append(B64[n & 63]);
+        }
+        return sb.toString();
+    }
+
+    /** Decode base64url without padding; throws IllegalArgumentException on anything else. */
+    public static byte[] unb64url(String s) {
+        if (s == null || s.length() % 4 == 1) throw new IllegalArgumentException("bad base64url");
+        byte[] out = new byte[s.length() * 3 / 4];
+        int bits = 0, have = 0, o = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            int v = c >= 'A' && c <= 'Z' ? c - 'A' : c >= 'a' && c <= 'z' ? c - 'a' + 26 : c >= '0' && c <= '9' ? c - '0' + 52
+                    : c == '-' ? 62 : c == '_' ? 63 : -1;
+            if (v < 0) throw new IllegalArgumentException("bad base64url");
+            bits = bits << 6 | v;
+            have += 6;
+            if (have >= 8) {
+                have -= 8;
+                out[o++] = (byte) (bits >>> have);
+                bits &= (1 << have) - 1;
+            }
+        }
+        return o == out.length ? out : java.util.Arrays.copyOf(out, o);
+    }
+
+    /** Keys for each direction: [send, recv] for this side (`client` true for the side that watches). */
+    public static byte[][] deriveKeys(byte[] priv, String peerPub, String session, boolean client) {
+        byte[] peer = peerPub == null ? new byte[0] : unb64url(peerPub);
+        if (peer.length != 32) throw new IllegalArgumentException("bad peer key");
+        byte[] shared = new byte[32];
+        if (!X25519.calculateAgreement(priv, 0, peer, 0, shared, 0)) throw new IllegalArgumentException("bad peer key");
+        HKDFBytesGenerator hkdf = new HKDFBytesGenerator(new SHA256Digest());
+        hkdf.init(new HKDFParameters(shared, session.getBytes(StandardCharsets.UTF_8), INFO));
+        byte[] okm = new byte[64];
+        hkdf.generateBytes(okm, 0, 64);
+        byte[] toHost = new byte[32];
+        byte[] toClient = new byte[32];
+        System.arraycopy(okm, 0, toHost, 0, 32);
+        System.arraycopy(okm, 32, toClient, 0, 32);
+        return client ? new byte[][] { toHost, toClient } : new byte[][] { toClient, toHost };
+    }
+
+    /** One direction's sealing (encrypting) state. Not thread-safe: one sender. */
+    static final class Sealer {
+        private final SecretKeySpec key;
+        private final Cipher cipher;
+        private long counter;
+
+        Sealer(byte[] key) throws GeneralSecurityException {
+            this.key = new SecretKeySpec(key, "AES");
+            this.cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        }
+
+        byte[] seal(byte[] frame, int off, int len) throws GeneralSecurityException {
+            long n = counter++;
+            byte[] out = new byte[HEADER + len + TAG];
+            out[0] = (byte) VERSION;
+            for (int i = 0; i < 8; i++) out[1 + i] = (byte) (n >>> (56 - 8 * i));
+            byte[] iv = new byte[12];
+            System.arraycopy(out, 1, iv, 4, 8);
+            cipher.init(Cipher.ENCRYPT_MODE, key, new GCMParameterSpec(128, iv));
+            cipher.updateAAD(out, 0, HEADER);
+            cipher.doFinal(frame, off, len, out, HEADER);
+            return out;
+        }
+    }
+
+    /** One direction's opening (decrypting) state with its replay window. Not thread-safe: one receiver at a time. */
+    static final class Opener {
+        private final SecretKeySpec key;
+        private final Cipher cipher;
+        private final ReplayWindow replay = new ReplayWindow(2048);
+
+        Opener(byte[] key) throws GeneralSecurityException {
+            this.key = new SecretKeySpec(key, "AES");
+            this.cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        }
+
+        /** The frame inside, or null if it isn't a fresh packet from the other side. */
+        byte[] open(byte[] packet, int len) {
+            if (len < HEADER + 1 + TAG || (packet[0] & 0xff) != VERSION) return null;
+            long n = 0;
+            for (int i = 0; i < 8; i++) n = (n << 8) | (packet[1 + i] & 0xff);
+            if (n < 0 || !replay.fresh(n)) return null;
+            byte[] iv = new byte[12];
+            System.arraycopy(packet, 1, iv, 4, 8);
+            byte[] frame;
+            try {
+                cipher.init(Cipher.DECRYPT_MODE, key, new GCMParameterSpec(128, iv));
+                cipher.updateAAD(packet, 0, HEADER);
+                frame = cipher.doFinal(packet, HEADER, len - HEADER);
+            } catch (GeneralSecurityException e) {
+                return null; // not from the other side
+            }
+            replay.mark(n);
+            return frame;
+        }
+    }
+
+    /** Rejects packets seen before or too old. */
+    static final class ReplayWindow {
+        private final int size;
+        private final boolean[] bits;
+        private long top = -1;
+
+        ReplayWindow(int size) {
+            this.size = size;
+            this.bits = new boolean[size];
+        }
+
+        boolean fresh(long n) {
+            if (n > top) return true;
+            if (top - n >= size) return false;
+            return !bits[(int) (n % size)];
+        }
+
+        void mark(long n) {
+            if (n > top) {
+                long gap = Math.min(n - top, size);
+                for (long i = 1; i <= gap; i++) bits[(int) ((top + i) % size)] = false;
+                top = n;
+            }
+            bits[(int) (n % size)] = true;
+        }
+    }
+}
diff --git a/app/src/main/java/com/moonshine/tunnel/Tunnels.java b/app/src/main/java/com/moonshine/tunnel/Tunnels.java
new file mode 100644
index 00000000..bebbca6e
--- /dev/null
+++ b/app/src/main/java/com/moonshine/tunnel/Tunnels.java
@@ -0,0 +1,386 @@
+package com.moonshine.tunnel;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.moonshine.Hub;
+import com.moonshine.Service;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Direct connections to friends' PCs, over the internet with no port forwarding or VPN: the phone's side
+ * of the desktop app's lib/tunnels.js. Asks the friend's PC through Moonshine's service (the live link
+ * carries its answer back), opens the tunnel, and hands back a stand-in address (127.77.x.y) the player
+ * uses as if it were the friend's PC. When no direct path works it asks Cloudflare's relay to carry it.
+ */
+public final class Tunnels {
+    /** A friend's PC to connect to. `link` and `token`: the login to ask with (the account's or an invite's). */
+    public static final class Target {
+        public final String hostUuid;
+        public final long device;
+        public final int port;
+        public final String name;
+        public final Hub link;
+        public final String token;
+
+        public Target(String hostUuid, long device, int port, String name, Hub link, String token) {
+            this.hostUuid = hostUuid;
+            this.device = device;
+            this.port = port;
+            this.name = name;
+            this.link = link;
+            this.token = token;
+        }
+    }
+
+    /** Finds the friend's PC behind a stand-in address again, to reopen its tunnel. */
+    public interface Finder {
+        Target find(String hostUuid);
+    }
+
+    public static final String LOCAL_PREFIX = "127.77.";
+    private static final long ANSWER_WAIT_MS = 20_000;
+    private static final long IDLE_MS = 10 * 60 * 1000;
+    private static final String PREFS = "moonshine_tunnels";
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private static final class Entry {
+        final Target target;
+        Tunnel tunnel;
+        String session = "";
+        String relay = "none"; // none, asked, failed
+        String ip;
+        boolean open;
+        final Object lock = new Object();
+
+        Entry(Target target) {
+            this.target = target;
+        }
+    }
+
+    private final Context context;
+    private final Map<String, Entry> entries = new HashMap<>();
+    private final ScheduledExecutorService timer = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread t = new Thread(r, "Moonshine tunnels");
+        t.setDaemon(true);
+        return t;
+    });
+    private volatile Finder finder;
+    private volatile InUse inUse = address -> false;
+
+    /** Is the player using this stand-in address right now (a stream is running)? */
+    public interface InUse {
+        boolean test(String address);
+    }
+
+    public Tunnels(Context context) {
+        this.context = context.getApplicationContext();
+        timer.scheduleWithFixedDelay(this::closeIdle, 60, 60, TimeUnit.SECONDS);
+    }
+
+    public void setFinder(Finder f) {
+        finder = f;
+    }
+
+    public void setInUse(InUse f) {
+        inUse = f;
+    }
+
+    // ---- stand-in addresses ------------------------------------------------------------------------
+
+    private SharedPreferences prefs() {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** A stable stand-in address per friend's PC, so the PC saved in the list keeps its address. */
+    public synchronized String localIpFor(String hostUuid) {
+        String saved = prefs().getString("ip:" + hostUuid, null);
+        if (saved != null && saved.startsWith(LOCAL_PREFIX)) return saved;
+        Set<String> used = new HashSet<>();
+        for (Map.Entry<String, ?> e : prefs().getAll().entrySet()) {
+            if (e.getKey().startsWith("ip:")) used.add(String.valueOf(e.getValue()));
+        }
+        byte[] h;
+        try {
+            h = MessageDigest.getInstance("SHA-256").digest(hostUuid.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception e) {
+            h = new byte[32];
+            RANDOM.nextBytes(h);
+        }
+        String ip = null;
+        for (int i = 0; i < 64 && ip == null; i++) {
+            String c = LOCAL_PREFIX + (((h[i % 32] & 0xff) + i) % 254 + 1) + "." + (((h[(i + 1) % 32] & 0xff) * 7 + i) % 254 + 1);
+            if (!used.contains(c)) ip = c;
+        }
+        if (ip == null) ip = LOCAL_PREFIX + (RANDOM.nextInt(254) + 1) + "." + (RANDOM.nextInt(254) + 1);
+        prefs().edit().putString("ip:" + hostUuid, ip).apply();
+        return ip;
+    }
+
+    public static boolean isTunnelAddress(String address) {
+        return address != null && address.startsWith(LOCAL_PREFIX);
+    }
+
+    /** The friend's PC behind a stand-in address, or null. */
+    public String hostFor(String address) {
+        if (!isTunnelAddress(address)) return null;
+        for (Map.Entry<String, ?> e : prefs().getAll().entrySet()) {
+            if (e.getKey().startsWith("ip:") && address.equals(e.getValue())) return e.getKey().substring(3);
+        }
+        return null;
+    }
+
+    public void forget(String hostUuid) {
+        prefs().edit().remove("ip:" + hostUuid).apply();
+    }
+
+    // ---- connecting --------------------------------------------------------------------------------
+
+    /** Open (or reuse) a tunnel to a friend's PC; returns its stand-in address. Blocking: call off the main thread. */
+    public String connect(Target pc) throws IOException {
+        Entry entry;
+        synchronized (entries) {
+            entry = entries.get(pc.hostUuid);
+            if (entry != null && entry.tunnel != null && entry.tunnel.isClosed()) entry = null; // a closed one is replaced
+            if (entry == null) {
+                entry = new Entry(pc);
+                entries.put(pc.hostUuid, entry);
+            }
+        }
+        synchronized (entry.lock) {
+            if (entry.open && entry.tunnel != null && entry.tunnel.isConnected()) return entry.ip;
+            try {
+                return open(entry);
+            } catch (IOException e) {
+                synchronized (entries) {
+                    if (entries.get(pc.hostUuid) == entry) entries.remove(pc.hostUuid);
+                }
+                if (entry.tunnel != null) entry.tunnel.close("failed");
+                throw e;
+            }
+        }
+    }
+
+    private String open(Entry entry) throws IOException {
+        Target pc = entry.target;
+        String name = pc.name == null || pc.name.isEmpty() ? "your friend’s PC" : pc.name;
+        try {
+            if (pc.link == null || !pc.link.whenConnected(5000)) throw new IOException(friendlyError("no-service", name));
+        } catch (InterruptedException e) {
+            throw new IOException(friendlyError("closed", name));
+        }
+        byte[] s = new byte[24];
+        RANDOM.nextBytes(s);
+        final String session = TunnelCrypto.b64url(s);
+        entry.session = session;
+        entry.relay = "none";
+        entry.open = false;
+        final Entry e = entry;
+        Tunnel tunnel = new Tunnel(new Tunnel.Listener() {
+            @Override
+            public void onRelayWanted() {
+                timer.execute(() -> askForRelay(e));
+            }
+
+            @Override
+            public void onClosed(String reason) {
+                synchronized (entries) {
+                    if (entries.get(pc.hostUuid) == e && e.tunnel != null && e.tunnel.isClosed()) {
+                        e.open = false;
+                        entries.remove(pc.hostUuid);
+                    }
+                }
+            }
+        });
+        entry.tunnel = tunnel;
+        Tunnel.Prep prep = tunnel.prepare();
+        String ip = localIpFor(pc.hostUuid);
+        int hostBase = pc.port > 0 && pc.port < 65536 ? pc.port : 47989;
+        try {
+            tunnel.listen(ip, hostBase);
+        } catch (Tunnel.TunnelException ex) {
+            throw new IOException(friendlyError(ex.code, name));
+        }
+
+        Hub.Waiter answer = pc.link.waitFor(m -> "tunnel-answer".equals(m.optString("type")) && session.equals(m.optString("session")));
+        try {
+            JSONObject offer = new JSONObject();
+            offer.put("device", pc.device);
+            offer.put("session", session);
+            offer.put("pub", prep.pub);
+            offer.put("cands", candsJson(prep.cands));
+            Service.call("POST", "/tunnel/offer", offer, pc.token);
+        } catch (Service.ServiceException ex) {
+            answer.cancel();
+            throw new IOException(ex.status == 409 ? friendlyError("offline", name) : ex.getMessage());
+        } catch (IOException | JSONException ex) {
+            answer.cancel();
+            throw new IOException(friendlyError("no-service", name));
+        }
+        JSONObject ans;
+        try {
+            ans = answer.await(ANSWER_WAIT_MS);
+        } catch (InterruptedException ex) {
+            throw new IOException(friendlyError("closed", name));
+        }
+        if (ans == null) throw new IOException(friendlyError("no-answer", name));
+        String err = ans.optString("error", "");
+        if (!err.isEmpty()) throw new IOException(friendlyError(err, name));
+        try {
+            tunnel.start(ans.optString("pub", ""), parseCands(ans.optJSONArray("cands")), session);
+        } catch (Tunnel.TunnelException ex) {
+            if ("no-path".equals(ex.code)) {
+                throw new IOException(noPathError(name, prep.nat, "asked".equals(entry.relay) || "failed".equals(entry.relay)));
+            }
+            throw new IOException(friendlyError(ex.code, name));
+        }
+        entry.ip = ip;
+        entry.open = true;
+        return ip;
+    }
+
+    /** No direct path after a few seconds: get a relayed address from Cloudflare's relay and hand it to the other PC. */
+    private void askForRelay(Entry entry) {
+        if (!"none".equals(entry.relay) || entry.tunnel == null || entry.tunnel.isClosed()) return;
+        entry.relay = "failed";
+        try {
+            JSONObject creds = Service.call("POST", "/turn", new JSONObject(), entry.target.token);
+            JSONArray urlsJson = creds.optJSONArray("urls");
+            List<String> urls = new ArrayList<>();
+            if (urlsJson != null) for (int i = 0; i < urlsJson.length(); i++) urls.add(urlsJson.optString(i));
+            Tunnel.Cand relayed = entry.tunnel.useRelay(urls, creds.optString("username"), creds.optString("credential"));
+            JSONObject body = new JSONObject();
+            body.put("device", entry.target.device);
+            body.put("session", entry.session);
+            body.put("relay", new JSONObject().put("a", relayed.a).put("p", relayed.p));
+            Service.call("POST", "/tunnel/relay", body, entry.target.token);
+            entry.relay = "asked";
+        } catch (IOException | JSONException ignored) {
+            // no relay: the punching carries on until it gives up
+        }
+    }
+
+    static JSONArray candsJson(List<Tunnel.Cand> cands) throws JSONException {
+        JSONArray out = new JSONArray();
+        for (Tunnel.Cand c : cands) out.put(new JSONObject().put("a", c.a).put("p", c.p));
+        return out;
+    }
+
+    static List<Tunnel.Cand> parseCands(JSONArray arr) {
+        List<Tunnel.Cand> out = new ArrayList<>();
+        if (arr == null) return out;
+        for (int i = 0; i < arr.length() && i < 16; i++) {
+            JSONObject o = arr.optJSONObject(i);
+            if (o == null) continue;
+            String a = o.optString("a", "");
+            int p = o.optInt("p", 0);
+            if (Tunnel.isIp(a) && p > 0 && p < 65536) out.add(new Tunnel.Cand(a, p));
+        }
+        return out;
+    }
+
+    /** Before using a stand-in address: make sure its tunnel is open, reopening it if it closed. Blocking. */
+    public void ensureFor(String address) throws IOException {
+        String hostUuid = hostFor(address);
+        if (hostUuid == null) return;
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            if (e != null && e.open && e.tunnel != null && e.tunnel.isConnected()) return;
+        }
+        Finder f = finder;
+        Target pc = f != null ? f.find(hostUuid) : null;
+        if (pc == null) throw new IOException("That friend’s PC isn’t online, or you’re no longer friends.");
+        connect(pc);
+    }
+
+    public boolean isOpen(String hostUuid) {
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            return e != null && e.open && e.tunnel != null && e.tunnel.isConnected();
+        }
+    }
+
+    public boolean isRelayed(String hostUuid) {
+        synchronized (entries) {
+            Entry e = entries.get(hostUuid);
+            return e != null && e.open && e.tunnel != null && e.tunnel.isRelayed();
+        }
+    }
+
+    public void closeFor(String hostUuid) {
+        Entry e;
+        synchronized (entries) {
+            e = entries.remove(hostUuid);
+        }
+        if (e != null && e.tunnel != null) e.tunnel.close("closed");
+    }
+
+    /** Close everything (signing out). */
+    public void closeAll() {
+        List<Entry> all;
+        synchronized (entries) {
+            all = new ArrayList<>(entries.values());
+            entries.clear();
+        }
+        for (Entry e : all) if (e.tunnel != null) e.tunnel.close("signed-out");
+    }
+
+    private void closeIdle() {
+        List<Entry> idle = new ArrayList<>();
+        synchronized (entries) {
+            for (Iterator<Entry> it = entries.values().iterator(); it.hasNext(); ) {
+                Entry e = it.next();
+                if (!e.open || e.tunnel == null) continue;
+                if (inUse.test(e.ip)) continue;
+                if (System.currentTimeMillis() - e.tunnel.lastUse() > IDLE_MS) {
+                    idle.add(e);
+                    it.remove();
+                }
+            }
+        }
+        for (Entry e : idle) e.tunnel.close("idle");
+    }
+
+    // ---- words ---------------------------------------------------------------------------------------
+
+    static String friendlyError(String code, String name) {
+        switch (code == null ? "" : code) {
+            case "not-hosting": return name + " isn’t hosting right now.";
+            case "not-invited": return name + " didn’t accept the invite. Ask for a new link.";
+            case "busy": return name + " has too many connections open. Try again in a minute.";
+            case "offline": return "Moonshine on " + name + " isn’t connected right now. Ask your friend to open Moonshine.";
+            case "no-answer": return name + " didn’t answer. Their Moonshine may have just closed.";
+            case "no-service": return "Can’t reach Moonshine’s service right now. Check your internet connection.";
+            case "no-ports": return "Couldn’t open the connection on this phone. Close other streaming apps and try again.";
+            case "peer-gone": return "The connection to " + name + " dropped.";
+            default: return "Couldn’t connect to " + name + ".";
+        }
+    }
+
+    static String noPathError(String name, String nat, boolean relayTried) {
+        if (relayTried) {
+            return "Couldn’t connect to " + name + ": no direct path, and the relay that takes over then didn’t work either. Tailscale still works for this friend.";
+        }
+        return "symmetric".equals(nat)
+                ? "Couldn’t connect directly to " + name + ": your network doesn’t allow direct connections (common on mobile data). Try Wi-Fi, or Tailscale."
+                : "Couldn’t connect directly to " + name + ". Their network may not allow direct connections. Tailscale still works for this friend.";
+    }
+}
