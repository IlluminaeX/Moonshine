+
+    static boolean isIp(String a) {
+        return TurnClient.isIpv4(a) || (a.contains(":") && a.matches("^[0-9a-fA-F:]{2,39}$"));
+    }
+
+    private void punch(long started) {
+        if (closed || connected) return;
+        if (System.currentTimeMillis() - started > punchFor) {
+            close("no-path");
+            return;
+        }
+        for (Cand c : targets) {
+            byte[] probe = new byte[9];
+            probe[0] = PROBE;
+            fillRandom(probe, 1);
+            boolean v4 = TurnClient.isIpv4(c.a);
+            if (v4 && sock4 != null) sendRaw(Via.V4, seal(probe), c.a, c.p);
+            if (!v4 && sock6 != null) sendRaw(Via.V6, seal(probe), c.a, c.p);
+            if (turn != null && relayable(c.a)) sendRaw(Via.RELAY, seal(probe), c.a, c.p);
+        }
+    }
+
+    private static void fillRandom(byte[] b, int from) {
+        byte[] r = new byte[b.length - from];
+        RANDOM.nextBytes(r);
+        System.arraycopy(r, 0, b, from, r.length);
+    }
+
+    // ---- relay (last resort) ---------------------------------------------------------------------
+
+    boolean relayable(String address) {
+        if (!TurnClient.isIpv4(address)) return false;
+        if (allowPrivateRelay) return true;
+        return !address.matches("^(10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|100\\.(6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.).*");
+    }
+
+    /**
+     * Get a relayed address on this side (the other PC sends to it). The relay is told to accept packets
+     * from the other PC's public addresses. Blocking.
+     */
+    public Cand useRelay(List<String> urls, String username, String credential) throws IOException {
+        if (closed || turn != null) throw new TunnelException("closed");
+        TurnClient t = new TurnClient(urls, username, credential, new TurnClient.Events() {
+            @Override
+            public void onData(byte[] data, String fromAddress, int fromPort) {
+                onPacket(Via.RELAY, data, data.length, fromAddress, fromPort);
+            }
+
+            @Override
+            public void onClosed(String why) {
+                // Losing the relay ends a tunnel that was using it
+                try {
+                    loop.execute(() -> {
+                        Path p = path;
+                        if (p != null && p.via == Via.RELAY) close("relay-lost");
+                    });
+                } catch (java.util.concurrent.RejectedExecutionException ignored) {
+                    // already closed
+                }
+            }
+        });
+        Object[] relayed = t.allocate();
+        if (closed) {
+            t.close();
+            throw new TunnelException("closed");
+        }
+        List<String> ips = new ArrayList<>();
+        CountDownLatch got = new CountDownLatch(1);
+        loop.execute(() -> {
+            turn = t;
+            punchFor = PUNCH_RELAY_MS;
+            for (Cand c : targets) if (relayable(c.a)) ips.add(c.a);
+            got.countDown();
+        });
+        try {
+            got.await();
+        } catch (InterruptedException e) {
+            throw new TunnelException("closed");
+        }
+        t.permit(ips);
+        return new Cand((String) relayed[0], (Integer) relayed[1]);
+    }
+
+    // ---- packets ---------------------------------------------------------------------------------
+
+    private byte[] seal(byte[] frame) {
+        try {
+            return sealer.seal(frame, 0, frame.length);
+        } catch (GeneralSecurityException e) {
+            return null;
+        }
+    }
+
+    private void sendRaw(Via via, byte[] packet, String address, int port) {
+        if (closed || packet == null) return;
+        if (dropRate > 0 && RANDOM.nextDouble() < dropRate) return;
+        try {
+            if (via == Via.RELAY) {
+                if (turn != null) turn.send(address, port, packet);
+                return;
+            }
+            DatagramSocket s = via == Via.V4 ? sock4 : sock6;
+            if (s != null) s.send(new DatagramPacket(packet, packet.length, InetAddress.getByName(address), port));
+        } catch (IOException ignored) {
+            // ICMP errors from probes to dead candidates; harmless
+        }
+    }
+
+    /** Loop thread only. */
+    void sendFrame(byte[] frame) {
+        Path p = path;
+        if (p == null || closed) return;
+        lastSent = System.currentTimeMillis();
+        sendRaw(p.via, seal(frame), p.address, p.port);
+    }
+
+    /** From a socket thread: STUN answers are handled here, tunnel packets are opened and passed to the loop. */
+    private void onPacket(Via via, byte[] buf, int len, String fromAddress, int fromPort) {
+        if (closed) return;
+        if (len >= 20 && (buf[0] & 0xff) < 2) {
+            Stun.Mapped m = Stun.parse(buf, len);
+            if (m != null) {
+                String key = hex(m.tx, 0, 12);
+                CountDownLatch w = stunWaits.get(key);
+                if (w != null) {
+                    stunResults.put(key, new String[] { m.address, String.valueOf(m.port) });
+                    w.countDown();
+                }
+            }
+            return;
+        }
+        final byte[] frame;
+        synchronized (openLock) {
+            if (opener == null) return;
+            frame = opener.open(buf, len);
+        }
+        if (frame == null || frame.length == 0) return;
+        final Path from = new Path(via, fromAddress, fromPort);
+        try {
+            loop.execute(() -> onFrame(from, frame));
+        } catch (java.util.concurrent.RejectedExecutionException ignored) {
+            // closed
+        }
+    }
+
+    private void onFrame(Path from, byte[] frame) {
+        if (closed) return;
+        lastRecv = System.currentTimeMillis();
+        int type = frame[0] & 0xff;
+        if (type == PROBE) {
+            // Always answer: the other side may not have heard our answer yet
+            byte[] ack = frame.clone();
+            ack[0] = PROBE_ACK;
+            sendRaw(from.via, seal(ack), from.address, from.port);
+            if (!connected) {
+                // The other side's real address is only learned from what it sends (through the relay, or from
+                // a router that picks a new port per destination): probe it back there too
+                byte[] back = new byte[9];
+                back[0] = PROBE;
+                fillRandom(back, 1);
+                sendRaw(from.via, seal(back), from.address, from.port);
+            }
+            return;
+        }
+        if (type == PROBE_ACK) {
+            if (!connected) {
+                path = from;
+                connected = true;
+                lastSent = System.currentTimeMillis();
+                connectedLatch.countDown();
+            }
+            return;
+        }
+        if (!connected) return;
+        // The other side only sends data on its chosen path: follow it if its address changed (new network)
+        if (!from.same(path)) path = from;
+        switch (type) {
+            case KEEPALIVE: return;
+            case CLOSE: close("peer-closed"); return;
+            case UDP: onUdpFrame(frame); return;
+            case DATA: onDataFrame(frame); return;
+            case ACK: onAckFrame(frame); return;
+            case RST: onRstFrame(frame); return;
+            default:
+        }
+    }
+
+    private void tick() {
+        if (closed || !connected) return;
+        long now = System.currentTimeMillis();
+        if (now - lastRecv > DEAD_MS) {
+            close("peer-gone");
+            return;
+        }
+        if (now - lastSent > KEEPALIVE_MS) sendFrame(new byte[] { KEEPALIVE });
+        for (Stream s : new ArrayList<>(streams.values())) {
+            if (!s.retransmit(now, rto)) {
+                reset(s);
+                continue;
+            }
+            if (now - s.lastActive > STREAM_IDLE_MS && s.unacked.isEmpty()) reset(s);
+        }
+        for (Iterator<Map.Entry<Integer, long[]>> it = closedStreams.entrySet().iterator(); it.hasNext(); ) {
+            if (it.next().getValue()[1] < now) it.remove();
+        }
+        for (Integer id : new ArrayList<>(flows.keySet())) {
+            if (now - flows.get(id).lastActive > FLOW_IDLE_MS) dropFlow(id);
+        }
+    }
+
+    void rttSample(double ms) {
+        if (srtt == 0) {
+            srtt = ms;
+            rttvar = ms / 2;
+        } else {
+            rttvar = 0.75 * rttvar + 0.25 * Math.abs(srtt - ms);
+            srtt = 0.875 * srtt + 0.125 * ms;
+        }
+        rto = Math.min(Math.max(srtt + 4 * rttvar, 150), 3000);
+    }
+
+    // ---- TCP over the tunnel ---------------------------------------------------------------------
+
+    void sendAck(int id, long next, long got) {
+        byte[] f = new byte[got < 0 ? 7 : 11];
+        f[0] = (byte) ACK;
+        Stun.putShort(f, 1, id);
+        Stun.putInt(f, 3, (int) next);
+        if (got >= 0) Stun.putInt(f, 7, (int) got);
+        sendFrame(f);
+    }
+
+    void sendRst(int id) {
+        byte[] f = new byte[3];
+        f[0] = (byte) RST;
+        Stun.putShort(f, 1, id);
+        sendFrame(f);
+    }
+
+    private static long u32(byte[] b, int off) {
+        return Stun.getInt(b, off) & 0xffffffffL;
+    }
+
+    private void onDataFrame(byte[] frame) {
+        if (frame.length < 8) return;
+        lastUse.set(System.currentTimeMillis());
+        int id = Stun.getShort(frame, 1);
+        long seq = u32(frame, 3);
+        int flags = frame[7] & 0xff;
+        byte[] payload = java.util.Arrays.copyOfRange(frame, 8, frame.length);
+        Stream s = streams.get(id);
+        if (s == null) {
+            long[] old = closedStreams.get(id);
+            if (old != null) {
+                if (seq < old[0]) sendAck(id, old[0], -1); // a late resend: say it arrived
+                else sendRst(id);
+                return;
+            }
+            // Only this side (the client) opens connections
+            sendRst(id);
+            return;
+        }
+        s.onData(seq, flags, payload);
+    }
+
+    private void onAckFrame(byte[] frame) {
+        if (frame.length < 7) return;
+        Stream s = streams.get(Stun.getShort(frame, 1));
+        if (s != null) s.onAck(u32(frame, 3), frame.length >= 11 ? u32(frame, 7) : -1);
+    }
+
+    private void onRstFrame(byte[] frame) {
+        if (frame.length < 3) return;
+        Stream s = streams.get(Stun.getShort(frame, 1));
+        if (s != null) forget(s, true);
+    }
+
+    /** Abort a stream on both sides. */
+    void reset(Stream s) {
+        if (s.closed) return;
+        sendRst(s.id);
+        forget(s, true);
+    }
+
+    void forget(Stream s, boolean abort) {
+        if (s.closed) return;
+        s.closed = true;
+        streams.remove(s.id);
+        closedStreams.put(s.id, new long[] { s.recvNext, System.currentTimeMillis() + CLOSED_LINGER_MS });
+        s.closeSocket(abort);
+    }
+
+    private void onLocalConnection(int idx, Socket socket) {
+        if (!connected || closed || streams.size() >= MAX_STREAMS) {
+            try { socket.close(); } catch (IOException ignored) { }
+            return;
+        }
+        int id = nextStreamId;
+        for (int n = 0; n < 65535 && (streams.containsKey(id) || closedStreams.containsKey(id) || id == 0); n++) id = (id % 65535) + 1;
+        nextStreamId = (id % 65535) + 1;
+        Stream s = new Stream(id);
+        s.opened = true;
+        streams.put(id, s);
+        lastUse.set(System.currentTimeMillis());
+        s.send(new byte[] { (byte) idx }, SYN);
+        s.attach(socket);
+    }
+
+    /** One TCP connection carried over the tunnel. Loop thread only, except the socket reader. */
+    final class Stream {
+        final int id;
+        Socket socket;
+        OutputStream out;
+        final ExecutorService writer = Executors.newSingleThreadExecutor(r -> {
+            Thread t = new Thread(r, "Moonshine tunnel write");
+            t.setDaemon(true);
+            return t;
+        });
+        final AtomicLong backlog = new AtomicLong();
+        // sending
+        long sendNext = 0;
+        final LinkedHashMap<Long, Seg> unacked = new LinkedHashMap<>();
+        final LinkedList<Object[]> queue = new LinkedList<>(); // [payload, flags]
+        long queued = 0;
+        long ackedTo = 0;
+        int dupAcks = 0;
+        boolean finQueued = false;
+        volatile boolean paused = false;
+        // receiving
+        long recvNext = 0;
+        final Map<Long, Object[]> ahead = new HashMap<>();
+        boolean finReceived = false;
+        boolean opened = false;
+        long lastActive = System.currentTimeMillis();
+        volatile boolean closed = false;
+
+        Stream(int id) {
+            this.id = id;
+        }
+
+        void send(byte[] payload, int flags) {
+            if (closed) return;
+            if (flags != 0) {
+                queue.add(new Object[] { payload, flags });
+            } else {
+                for (int off = 0; off < payload.length; off += MSS) {
+                    byte[] part = java.util.Arrays.copyOfRange(payload, off, Math.min(payload.length, off + MSS));
+                    queue.add(new Object[] { part, 0 });
+                    queued += part.length;
+                }
+            }
+            pump();
+            if (queued > QUEUE_PAUSE) paused = true;
+        }
+
+        void pump() {
+            // Room in the window, and never further ahead of the first gap than the other side keeps
+            while (!queue.isEmpty() && unacked.size() < WINDOW && sendNext - ackedTo < RECV_AHEAD) {
+                Object[] seg = queue.removeFirst();
+                byte[] payload = (byte[]) seg[0];
+                int flags = (Integer) seg[1];
+                if (flags == 0) queued -= payload.length;
+                long seq = sendNext++;
+                byte[] frame = new byte[8 + payload.length];
+                frame[0] = (byte) DATA;
+                Stun.putShort(frame, 1, id);
+                Stun.putInt(frame, 3, (int) seq);
+                frame[7] = (byte) flags;
+                System.arraycopy(payload, 0, frame, 8, payload.length);
+                unacked.put(seq, new Seg(frame));
+                sendFrame(frame);
+            }
+            if (paused && queued < QUEUE_PAUSE / 4 && !closed) {
+                synchronized (this) {
+                    paused = false;
+                    notifyAll();
+                }
+            }
+        }
+
+        void onAck(long next, long got) {
+            long now = System.currentTimeMillis();
+            lastActive = now;
+            double sample = -1;
+            boolean moved = false;
+            if (next > ackedTo) {
+                for (Iterator<Map.Entry<Long, Seg>> it = unacked.entrySet().iterator(); it.hasNext(); ) {
+                    Map.Entry<Long, Seg> e = it.next();
+                    if (e.getKey() >= next) break;
+                    if (e.getValue().tries == 1) sample = now - e.getValue().sentAt;
+                    it.remove();
+                }
+                ackedTo = next;
+                dupAcks = 0;
+                moved = true;
+            } else if (next == ackedTo && !unacked.isEmpty() && got < 0) {
+                // The same ack again: a packet went missing. Resend it now rather than waiting for the timer.
+                dupAcks += 1;
+                if (dupAcks == 3) {
+                    Seg seg = unacked.get(next);
+                    if (seg != null) resend(seg);
+                }
+            }
+            if (got >= 0 && got >= next) {
+                Seg seg = unacked.remove(got);
+                if (seg != null) {
+                    if (seg.tries == 1) sample = now - seg.sentAt;
+                    moved = true;
+                }
+                // A later packet got through, so earlier ones still missing well after it are lost: resend them
+                double late = srtt * 1.25 + 2;
+                for (Map.Entry<Long, Seg> e : unacked.entrySet()) {
+                    if (e.getKey() + 3 > got) break;
+                    if (now - e.getValue().sentAt > late) resend(e.getValue());
+                }
+            }
+            if (sample >= 0) rttSample(sample);
+            if (moved) {
+                pump();
+                maybeDone();
+            }
+        }
+
+        void resend(Seg seg) {
+            seg.tries += 1;
+            seg.sentAt = System.currentTimeMillis();
+            sendFrame(seg.frame);
+        }
+
+        /** Resend what's overdue; false when the other side stopped answering. */
+        boolean retransmit(long now, double rto) {
+            int sent = 0;
+            for (Seg seg : unacked.values()) {
+                if (now - seg.sentAt < rto * (1 << Math.min(seg.tries - 1, 3))) continue;
+                if (seg.tries >= MAX_TRIES) return false;
+                resend(seg);
+                if (++sent >= 32) break;
+            }
+            return true;
+        }
+
+        void onData(long seq, int flags, byte[] payload) {
+            lastActive = System.currentTimeMillis();
+            boolean inRange = seq >= recvNext && seq < recvNext + RECV_AHEAD;
+            if (inRange && !ahead.containsKey(seq)) {
+                ahead.put(seq, new Object[] { flags, payload });
+                while (ahead.containsKey(recvNext)) {
+                    Object[] seg = ahead.remove(recvNext);
+                    recvNext += 1;
+                    deliver((Integer) seg[0], (byte[]) seg[1]);
+                    if (closed) return;
+                }
+            }
+            // Say which packet came in if it's held back behind a gap, so only the missing ones are resent
+            sendAck(id, recvNext, inRange && seq >= recvNext ? seq : -1);
+        }
+
+        void deliver(int flags, byte[] payload) {
+            if ((flags & SYN) != 0) { // only the client opens connections
+                reset(this);
+                return;
+            }
+            if (!opened) {
+                reset(this);
+                return;
+            }
+            if ((flags & FIN) != 0) {
+                finReceived = true;
+                writer.execute(() -> {
+                    try { if (socket != null) socket.shutdownOutput(); } catch (IOException ignored) { }
+                });
+                maybeDone();
+                return;
+            }
+            if (out != null) {
+                if (backlog.addAndGet(payload.length) > MAX_WRITE_BACKLOG) { // the reader stopped reading
+                    reset(this);
+                    return;
+                }
+                writer.execute(() -> {
+                    try {
+                        out.write(payload);
+                    } catch (IOException e) {
+                        try { socket.close(); } catch (IOException ignored) { }
+                    } finally {
+                        backlog.addAndGet(-payload.length);
+                    }
+                });
+            }
+        }
+
+        /** Both directions finished and everything sent was received: tidy up. */
+        void maybeDone() {
+            if (closed || !finReceived || !finQueued || !queue.isEmpty() || !unacked.isEmpty()) return;
+            forget(this, false);
+        }
+
+        /** Wire a local TCP socket to this stream, in both directions. */
+        void attach(Socket s) {
+            socket = s;
+            try {
+                s.setTcpNoDelay(true);
+                out = s.getOutputStream();
+            } catch (IOException e) {
+                reset(this);
+                return;
+            }
+            Thread t = new Thread(() -> {
+                byte[] buf = new byte[16 * 1024];
+                try {
+                    InputStream in = s.getInputStream();
+                    while (true) {
+                        synchronized (this) {
+                            while (paused && !closed) wait();
+                        }
+                        if (closed) return;
+                        int n = in.read(buf);
+                        if (n < 0) break;
+                        final byte[] chunk = java.util.Arrays.copyOf(buf, n);
+                        loop.execute(() -> {
+                            lastUse.set(System.currentTimeMillis());
+                            send(chunk, 0);
+                        });
+                    }
+                    loop.execute(() -> {
+                        finQueued = true;
+                        send(new byte[0], FIN);
+                        maybeDone();
+                    });
+                } catch (IOException | InterruptedException | java.util.concurrent.RejectedExecutionException e) {
+                    // Closed before both sides finished: tell the other side to drop it
+                    try {
+                        loop.execute(() -> {
+                            if (!closed && !(finQueued && finReceived)) reset(this);
+                        });
+                    } catch (java.util.concurrent.RejectedExecutionException ignored) {
+                        // tunnel closed
+                    }
+                }
+            }, "Moonshine tunnel read");
+            t.setDaemon(true);
+            t.start();
+        }
+
+        void closeSocket(boolean abort) {
+            synchronized (this) {
+                notifyAll();
+            }
+            final Socket s = socket;
+            if (s == null) {
+                writer.shutdown();
+                return;
+            }
+            if (abort) {
+                try { s.close(); } catch (IOException ignored) { }
+                writer.shutdownNow();
+            } else {
+                writer.execute(() -> {
+                    try { s.close(); } catch (IOException ignored) { }
+                });
+                writer.shutdown();
+            }
+        }
+    }
+
+    static final class Seg {
+        final byte[] frame;
+        long sentAt = System.currentTimeMillis();
+        int tries = 1;
+
+        Seg(byte[] frame) {
+            this.frame = frame;
+        }
+    }
+
+    // ---- UDP over the tunnel ---------------------------------------------------------------------
+
+    static final class Flow {
+        final int id;
+        final int idx;
+        final String key;
+        final InetAddress address;
+        final int port;
+        long lastActive = System.currentTimeMillis();
+
+        Flow(int id, int idx, String key, InetAddress address, int port) {
+            this.id = id;
+            this.idx = idx;
+            this.key = key;
+            this.address = address;
+            this.port = port;
+        }
+    }
+
+    private void onUdpFrame(byte[] frame) {
+        if (frame.length < 4) return;
+        lastUse.set(System.currentTimeMillis());
+        int id = Stun.getShort(frame, 1);
+        Flow flow = flows.get(id);
+        if (flow == null) return;
+        flow.lastActive = System.currentTimeMillis();
+        DatagramSocket sock;
+        synchronized (servers) {
+            sock = udpLocal.get(flow.idx);
+        }
+        if (sock == null) return;
+        try {
+            sock.send(new DatagramPacket(frame, 4, frame.length - 4, flow.address, flow.port));
+        } catch (IOException ignored) {
+            // the player went away
+        }
+    }
+
+    private void sendUdp(int id, int idx, byte[] payload) {
+        byte[] f = new byte[4 + payload.length];
+        f[0] = (byte) UDP;
+        Stun.putShort(f, 1, id);
+        f[3] = (byte) idx;
+        System.arraycopy(payload, 0, f, 4, payload.length);
+        sendFrame(f);
+    }
+
+    private void dropFlow(int id) {
+        Flow flow = flows.remove(id);
+        if (flow != null) flowByKey.remove(flow.key);
+    }
+
+    private void onLocalDatagram(int idx, byte[] msg, InetAddress from, int fromPort) {
+        if (!connected || closed) return;
+        lastUse.set(System.currentTimeMillis());
+        String key = idx + "|" + from.getHostAddress() + "|" + fromPort;
+        Flow flow = flowByKey.get(key);
+        if (flow == null) {
+            if (flows.size() >= MAX_FLOWS) return;
+            int id = nextFlowId;
+            for (int n = 0; n < 65535 && (flows.containsKey(id) || id == 0); n++) id = (id % 65535) + 1;
+            nextFlowId = (id % 65535) + 1;
+            flow = new Flow(id, idx, key, from, fromPort);
+            flows.put(id, flow);
+            flowByKey.put(key, flow);
+        }
+        flow.lastActive = System.currentTimeMillis();
+        sendUdp(flow.id, idx, msg);
+    }
+
+    // ---- shutdown --------------------------------------------------------------------------------
+
+    /** Close the tunnel (from any thread). */
+    public void close(String reason) {
+        try {
+            loop.execute(() -> closeNow(reason));
+        } catch (java.util.concurrent.RejectedExecutionException ignored) {
+            // already closed
+        }
+    }
+
+    private void closeNow(String reason) {
+        if (closed) return;
+        if (connected) {
+            // Say goodbye (twice, in case one is lost) so the other side doesn't wait for a timeout
+            sendFrame(new byte[] { CLOSE });
+            sendFrame(new byte[] { CLOSE });
+        }
+        closed = true;
+        closeReason = reason;
+        for (ScheduledFuture<?> t : timers) t.cancel(false);
+        synchronized (stunWaits) {
+            for (CountDownLatch w : stunWaits.values()) w.countDown();
+        }
+        for (Stream s : streams.values()) s.closeSocket(true);
+        streams.clear();
+        flows.clear();
+        flowByKey.clear();
+        synchronized (servers) {
+            for (ServerSocket s : servers) try { s.close(); } catch (IOException ignored) { }
+            for (DatagramSocket u : udpLocal.values()) u.close();
+            servers.clear();
+            udpLocal.clear();
+        }
+        if (turn != null) turn.close();
+        if (connectedLatch != null) connectedLatch.countDown();
+        // Let the goodbye leave before the sockets close
+        loop.schedule(() -> {
+            if (sock4 != null) sock4.close();
+            if (sock6 != null) sock6.close();
+            loop.shutdown();
+        }, 50, TimeUnit.MILLISECONDS);
+        listener.onClosed(reason);
+    }
+
+    /** Tests: the IPv4 socket's port. */
+    int localPort4() {
+        return sock4 != null ? sock4.getLocalPort() : 0;
+    }
+
+    public boolean isConnected() {
+        return connected && !closed;
+    }
+
+    public boolean isClosed() {
+        return closed;
+    }
+
+    public boolean isRelayed() {
+        Path p = path;
+        return p != null && p.via == Via.RELAY;
+    }
+
+    /** When the player last sent or got anything (not keep-alives). */
+    public long lastUse() {
+        return lastUse.get();
+    }
+}
