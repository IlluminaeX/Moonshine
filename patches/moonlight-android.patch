+                    float bitrateValue = Float.parseFloat(value) * 1000;
+                    int bitrate = (int) bitrateValue;
+                    SharedPreferences prefs = getPrefs();
+                    prefs.edit().putInt(PreferenceConfiguration.BITRATE_PREF_STRING, bitrate).apply();
