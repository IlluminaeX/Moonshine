+        line.addView(nameView, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        PcSheets.Conn conn = live ? conns.get(uuid) : null;
+        info.addView(line);
+        String state = !online ? "Offline" : !hosting ? "Not hosting" : !game.isEmpty() ? (game.equalsIgnoreCase("desktop") ? "Streaming" : "Playing " + game)
+                : guests > 0 ? (guests == 1 ? "1 person watching" : guests + " people watching") : pc.optBoolean("busy") ? "In use" : "Ready";
+        LinearLayout stateLine = row();
+        stateLine.addView(Ui.dot(this, live ? ONLINE : 0xFF6E6076, 8));
+        stateLine.addView(gap(6));
+        stateLine.addView(text(state, 13, live ? ONLINE : MUTED, false));
+        info.addView(stateLine);
+        if (conn != null) {
+            // How you reach it, under the name so a long PC name keeps its room
+            View badge = Ui.badge(this, PcSheets.kindLabel(conn.kind) + (conn.ms > 0 ? " · " + (conn.ms <= 10 ? "<20" : String.valueOf(conn.ms)) + " ms" : ""), ACCENT);
+            LinearLayout.LayoutParams bp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            bp.topMargin = dp(6);
+            info.addView(badge, bp);
