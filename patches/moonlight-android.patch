+
+    /** Ask whether to join a friend's game (from the live link, or a tapped notification). */
+    static void askToJoin(Activity a, Moonshine.PlayInvite inv) {
+        Moonshine m = Moonshine.get(a);
+        new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                .setTitle(m.friendLabel(inv.from) + " invites you to play")
+                .setMessage((inv.game.isEmpty() ? inv.app : inv.game) + " on " + inv.host + "\nFrom your friend " + inv.from)
+                .setPositiveButton("Join", (d, w) -> {
+                    m.answerPlayInvite(inv, true);
+                    Intent i = m.sign(new Intent(a, FriendsActivity.class).putExtra("join_host_uuid", inv.hostUuid)
+                            .putExtra("join_app", inv.app).putExtra("join_host", inv.host).putExtra("join_from", inv.from));
+                    if (a instanceof FriendsActivity) ((FriendsActivity) a).joinGame(i);
+                    else a.startActivity(i);
+                })
+                .setNegativeButton("Not now", (d, w) -> m.answerPlayInvite(inv, false))
+                .setCancelable(false)
+                .show();
+    }
+
+    @Override
+    protected void onPostCreate(Bundle savedInstanceState) {
+        super.onPostCreate(savedInstanceState);
+        Intent i = getIntent();
+        if (i != null && i.getStringExtra("join_host_uuid") != null && m.isOurs(i)) joinGame(i);
+    }
+
+    private void joinGame(Intent i) {
+        final String hostUuid = i.getStringExtra("join_host_uuid");
+        final String app = i.getStringExtra("join_app");
+        final String hostName = String.valueOf(i.getStringExtra("join_host"));
+        i.removeExtra("join_host_uuid");
+        if (hostUuid == null) return;
+        showProgress("Looking for " + hostName + "…");
+        m.run(() -> {
+            // The friends list as it is now: their PC's addresses and whether it can be reached directly
+            JSONObject pc = null;
+            try {
+                JSONObject f = Service.call("GET", "/friends", null, m.token());
+                pc = findPc(f, hostUuid);
+            } catch (IOException ignored) {
+                pc = m.friendPc(hostUuid);
+            }
+            final JSONObject found = pc;
+            runOnUiThread(() -> {
+                hideProgress();
+                if (found == null) {
+                    toast(hostName + " isn’t hosting any more.");
+                    return;
+                }
+                String name = Moonshine.clean(found.optString("name"), 60);
+                Tunnels.Target t = found.optBoolean("tunnel") && found.optLong("device") > 0
+                        ? new Tunnels.Target(hostUuid, found.optLong("device"), found.optInt("port", 47989), name, m.hub, m.token()) : null;
+                connect(hostUuid, name, found.optInt("port", 47989), found.optJSONArray("addrs"), t, app);
+            });
+        });
+    }
+
+    private static JSONObject findPc(JSONObject f, String hostUuid) {
+        JSONArray list = f.optJSONArray("friends");
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend == null || !"accepted".equals(friend.optString("status"))) continue;
+            JSONArray pcs = friend.optJSONArray("pcs");
+            for (int j = 0; pcs != null && j < pcs.length(); j++) {
+                JSONObject pc = pcs.optJSONObject(j);
+                if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) return pc;
+            }
+        }
+        return null;
+    }
+
+    // ---- connecting --------------------------------------------------------------------------------
+
+    private void showProgress(String s) {
+        if (progress == null) {
+            progressText = text(s, 15, TEXT, false);
+            FrameLayout wrap = new FrameLayout(this);
+            wrap.setPadding(dp(24), dp(20), dp(24), dp(8));
+            wrap.addView(progressText);
+            progress = new AlertDialog.Builder(this, R.style.MoonshineDialog).setView(wrap).setCancelable(false)
+                    .setNegativeButton("Hide", null).create();
+        }
+        progressText.setText(s);
+        if (!progress.isShowing() && !isFinishing()) progress.show();
+    }
+
+    private void hideProgress() {
+        if (progress != null && progress.isShowing()) progress.dismiss();
+    }
+
+    /** Reach a PC, pair if needed, then open its app list (or start `appName` straight away). */
+    private void connect(String hostUuid, String name, int port, JSONArray addrsJson, Tunnels.Target target, String appName) {
+        if (!hostUuid.matches("[0-9A-Za-z-]{8,64}")) return;
+        if (connecting) {
+            toast("Already connecting to a PC.");
+            return;
+        }
+        if (binder == null) {
+            afterBind = () -> connect(hostUuid, name, port, addrsJson, target, appName);
+            showProgress("Getting ready…");
+            return;
+        }
+        connecting = true;
+        showProgress("Looking for " + name + "…");
+        final ComputerManagerService.ComputerManagerBinder b = binder;
+        final java.util.List<String> addrs;
+        try {
+            addrs = Connect.addrs(new JSONObject().put("addrs", addrsJson == null ? new JSONArray() : addrsJson));
+        } catch (JSONException e) {
+            connecting = false;
+            return;
+        }
+        final boolean own = m.isMyPc(hostUuid);
+        Connect.Progress ui = new Connect.Progress() {
+            @Override
+            public void status(String text) {
+                runOnUiThread(() -> showProgress(text));
+            }
+
+            @Override
+            public void pairing(String pin, boolean moonshine) {
+                runOnUiThread(() -> showProgress(moonshine
+                        ? (own ? "Pairing with " + name + "…\nIt’s on your account, so it accepts by itself."
+                        : "Asking " + name + " to accept this phone…\nYour friend sees the request in Moonshine. (PIN " + pin + ")")
+                        : "Pairing with " + name + ". Enter this PIN in that PC’s host settings: " + pin));
+            }
+        };
+        m.run(() -> {
+            String error = null;
+            ComputerDetails computer = null;
+            NvApp app = null;
+            try {
+                computer = Connect.reach(this, b, hostUuid, name, port, addrs, target, ui);
+                error = Connect.pair(this, b, computer, ui);
+                if (error == null && !TextUtils.isEmpty(appName)) {
+                    ComputerDetails fresh = b.getComputer(hostUuid);
+                    if (fresh != null && fresh.serverCert == null) fresh.serverCert = computer.serverCert;
+                    if (fresh != null) computer = fresh;
+                    app = Connect.findApp(this, b, computer, appName);
+                }
+            } catch (IOException e) {
+                error = e.getMessage();
+            } catch (InterruptedException e) {
+                error = "Connecting was interrupted.";
+            }
+            final String err = error;
+            final ComputerDetails pc = computer;
+            final NvApp found = app;
+            runOnUiThread(() -> {
+                connecting = false;
+                hideProgress();
+                if (isFinishing()) return;
+                if (err != null) {
+                    new AlertDialog.Builder(this, R.style.MoonshineDialog).setTitle("Couldn’t connect").setMessage(err).setPositiveButton("OK", null).show();
+                    return;
+                }
+                if (found != null && pc.activeAddress != null) {
+                    m.setActiveStream(pc.activeAddress.address);
+                    startActivity(ServerHelper.createStartIntent(this, found, pc, b, false));
+                    return;
+                }
+                Intent i = new Intent(this, AppView.class);
+                i.putExtra(AppView.NAME_EXTRA, pc.name);
+                i.putExtra(AppView.UUID_EXTRA, pc.uuid);
+                i.putExtra(AppView.NEW_PAIR_EXTRA, true);
+                i.putExtra(AppView.SHOW_HIDDEN_APPS_EXTRA, false);
+                startActivity(i);
+            });
+        });
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Hub.java b/app/src/main/java/com/moonshine/Hub.java
new file mode 100644
index 00000000..395a0fe6
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Hub.java
@@ -0,0 +1,296 @@
+package com.moonshine;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.WebSocket;
+import okhttp3.WebSocketListener;
+
+/**
+ * The live link to Moonshine's service (a WebSocket): the service pushes friends-list changes, quick
+ * messages, "join my game" invites and direct-connection answers here the moment they happen. Saying
+ * "bye" on it shows this phone offline to friends at once. Reconnects after network trouble; idle, it
+ * costs one small ping every 30 seconds. One link per login (the account's, or a guest's).
+ */
+public final class Hub {
+    public interface Listener {
+        void onMessage(JSONObject msg);
+    }
+
+    /** Picks out the message a caller is waiting for. */
+    public interface Match {
+        boolean test(JSONObject msg);
+    }
+
+    public interface Tokens {
+        /** The login to make a ticket with, or null when there is none (signed out). */
+        String token();
+    }
+
+    private static final long PING_MS = 30_000;
+    private static final long PONG_WAIT_MS = 15_000;
+    private static final int MAX_MESSAGE = 64 * 1024;
+
+    private final Tokens tokens;
+    private final Handler handler;
+    private final CopyOnWriteArrayList<Listener> listeners = new CopyOnWriteArrayList<>();
+    private final CopyOnWriteArrayList<Runnable> stateListeners = new CopyOnWriteArrayList<>();
+    private final OkHttpClient client;
+    private final Object lock = new Object();
+
+    private WebSocket ws;
+    private volatile boolean connected;
+    private boolean running;
+    private long retryMs = 2000;
+    private int generation; // bumped on every connect/stop, so old sockets' callbacks are ignored
+
+    public Hub(Tokens tokens) {
+        this(tokens, new Handler(Looper.getMainLooper()));
+    }
+
+    Hub(Tokens tokens, Handler handler) {
+        this.tokens = tokens;
+        this.handler = handler;
+        this.client = Service.http.newBuilder().readTimeout(0, TimeUnit.MILLISECONDS).build();
+    }
+
+    public boolean isConnected() {
+        return connected;
+    }
+
+    public void addListener(Listener l) {
+        listeners.add(l);
+    }
+
+    public void removeListener(Listener l) {
+        listeners.remove(l);
+    }
+
+    /** Called (on the main thread) whenever the link goes up or down. */
+    public void addStateListener(Runnable r) {
+        stateListeners.add(r);
+    }
+
+    /** Keep the link up. */
+    public void start() {
+        synchronized (lock) {
+            if (running) return;
+            running = true;
+            retryMs = 2000;
+        }
+        connectSoon(0);
+    }
+
+    /** Drop the link. With `bye`, tell the service first so friends see this phone go offline straight away. */
+    public void stop(boolean bye) {
+        WebSocket old;
+        synchronized (lock) {
+            running = false;
+            generation++;
+            old = ws;
+            ws = null;
+        }
+        handler.removeCallbacksAndMessages(this);
+        setConnected(false);
+        if (old != null) {
+            if (bye) old.send("bye");
+            old.close(1000, "bye");
+        }
+    }
+
+    public void restart() {
+        stop(false);
+        start();
+    }
+
+    private void connectSoon(long delayMs) {
+        handler.postAtTime(() -> new Thread(this::connect, "Moonshine live link").start(), this,
+                android.os.SystemClock.uptimeMillis() + delayMs);
+    }
+
+    private void scheduleRetry() {
+        long delay;
+        synchronized (lock) {
+            if (!running) return;
+            delay = retryMs;
+            retryMs = Math.min(retryMs * 2, 60_000);
+        }
+        connectSoon(delay);
+    }
+
+    private void connect() {
+        final int gen;
+        synchronized (lock) {
+            if (!running || ws != null) return;
+            gen = ++generation;
+        }
+        String token = tokens.token();
+        if (token == null || token.isEmpty()) {
+            scheduleRetry();
+            return;
+        }
+        String ticket;
+        try {
+            ticket = Service.call("POST", "/hub/ticket", null, token).optString("ticket", "");
+        } catch (Exception e) {
+            scheduleRetry();
+            return;
+        }
+        if (!ticket.matches("[A-Za-z0-9_-]{22,64}")) {
+            scheduleRetry();
+            return;
+        }
+        String base = Service.base.replaceFirst("^http", "ws");
+        Request req = new Request.Builder().url(base + "/hub?ticket=" + ticket).build();
+        synchronized (lock) {
+            if (!running || gen != generation) return;
+            ws = client.newWebSocket(req, new WebSocketListener() {
+                @Override
+                public void onOpen(WebSocket socket, Response response) {
+                    if (!current(socket)) return;
+                    synchronized (lock) { retryMs = 2000; }
+                    setConnected(true);
+                    schedulePing(socket);
+                }
+
+                @Override
+                public void onMessage(WebSocket socket, String text) {
+                    if (!current(socket)) return;
+                    if ("pong".equals(text)) {
+                        handler.removeCallbacksAndMessages(pongToken);
+                        return;
+                    }
+                    if (text.length() > MAX_MESSAGE) return;
+                    try {
+                        JSONObject msg = new JSONObject(text);
+                        if (!msg.optString("type", "").isEmpty()) {
+                            handler.post(() -> {
+                                for (Listener l : listeners) l.onMessage(msg);
+                            });
+                        }
+                    } catch (JSONException ignored) {
+                        // not ours
+                    }
+                }
+
+                @Override
+                public void onClosing(WebSocket socket, int code, String reason) {
+                    socket.close(1000, null);
+                }
+
+                @Override
+                public void onClosed(WebSocket socket, int code, String reason) {
+                    gone(socket);
+                }
+
+                @Override
+                public void onFailure(WebSocket socket, Throwable t, Response response) {
+                    gone(socket);
+                }
+            });
+        }
+    }
+
+    private final Object pongToken = new Object();
+
+    private void schedulePing(WebSocket socket) {
+        handler.postAtTime(() -> {
+            if (!current(socket)) return;
+            socket.send("ping");
+            // No answer in time: the link is dead
+            handler.postAtTime(() -> { if (current(socket)) socket.cancel(); }, pongToken,
+                    android.os.SystemClock.uptimeMillis() + PONG_WAIT_MS);
+            schedulePing(socket);
+        }, this, android.os.SystemClock.uptimeMillis() + PING_MS);
+    }
+
+    private boolean current(WebSocket socket) {
+        synchronized (lock) {
+            return ws == socket;
+        }
+    }
+
+    private void gone(WebSocket socket) {
+        synchronized (lock) {
+            if (ws != socket) return;
+            ws = null;
+        }
+        handler.removeCallbacksAndMessages(pongToken);
+        setConnected(false);
+        scheduleRetry();
+    }
+
+    private void setConnected(boolean on) {
+        if (connected == on) return;
+        connected = on;
+        handler.post(() -> {
+            for (Runnable r : stateListeners) r.run();
+        });
+    }
+
+    /**
+     * Wait (blocking, off the main thread) for a message matching `test`, registered before the caller
+     * sends what it answers. Returns null after timeoutMs.
+     */
+    public Waiter waitFor(Match test) {
+        Waiter w = new Waiter(test);
+        addListener(w);
+        return w;
+    }
+
+    public final class Waiter implements Listener {
+        private final Match test;
+        private JSONObject got;
+
+        Waiter(Match test) {
+            this.test = test;
+        }
+
+        @Override
+        public synchronized void onMessage(JSONObject msg) {
+            if (got == null && test.test(msg)) {
+                got = msg;
+                notifyAll();
+            }
+        }
+
+        public JSONObject await(long timeoutMs) throws InterruptedException {
+            long deadline = System.currentTimeMillis() + timeoutMs;
+            try {
+                synchronized (this) {
+                    while (got == null) {
+                        long left = deadline - System.currentTimeMillis();
+                        if (left <= 0) break;
+                        wait(left);
+                    }
+                    return got;
+                }
+            } finally {
+                cancel();
+            }
+        }
+
+        public void cancel() {
+            removeListener(this);
+        }
+    }
+
+    /** Wait (blocking) until the link is up; false after timeoutMs. */
+    public boolean whenConnected(long timeoutMs) throws InterruptedException {
+        long deadline = System.currentTimeMillis() + timeoutMs;
+        while (!connected) {
+            if (System.currentTimeMillis() >= deadline) return false;
+            Thread.sleep(100);
+        }
+        return true;
+    }
+}
