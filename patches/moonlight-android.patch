+// Moonshine: the version is the Moonshine desktop app's (app/package.json at the repo root), so a phone
+// and a PC on the same release report the same version to the friends service.
+def moonshineVersion = new groovy.json.JsonSlurper().parse(rootProject.file('../../app/package.json')).version
+def moonshineVersionCode = { String v ->
+    def p = v.split('-')[0].tokenize('.').collect { it as int }
+    return p[0] * 1000000 + p[1] * 10000 + p[2] * 100
+}
+// Release signing: a key kept outside the repo (scripts/build-android.ps1 makes it on first use)
+def signingProps = new Properties()
+def signingFile = new File(System.getenv('MOONSHINE_ANDROID_SIGNING') ?: (System.getProperty('user.home') + '/.moonshine-release/android-signing.properties'))
+if (signingFile.exists()) signingFile.withInputStream { signingProps.load(it) }
+
