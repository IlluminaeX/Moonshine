+    private void hideProgress() {
+        if (progress != null && progress.isShowing()) progress.dismiss();
+    }
+
+    /** Reach a PC, pair if needed, then open its app list (or start `appName` straight away). */
+    private void connect(String hostUuid, String name, int port, JSONArray addrsJson, Tunnels.Target target, String appName) {
+        if (!hostUuid.matches("[0-9A-Za-z-]{8,64}")) return;
+        if (connecting) {
+            toast("Already connecting to a PC.");
+            return;
+        }
+        if (binder == null) {
+            afterBind = () -> connect(hostUuid, name, port, addrsJson, target, appName);
+            showProgress("Getting ready…");
+            return;
+        }
+        connecting = true;
+        showProgress("Looking for " + name + "…");
+        final ComputerManagerService.ComputerManagerBinder b = binder;
+        final java.util.List<String> addrs;
+        try {
+            addrs = Connect.addrs(new JSONObject().put("addrs", addrsJson == null ? new JSONArray() : addrsJson));
+        } catch (JSONException e) {
+            connecting = false;
+            return;
+        }
+        final boolean own = m.isMyPc(hostUuid);
+        Connect.Progress ui = new Connect.Progress() {
+            @Override
+            public void status(String text) {
+                runOnUiThread(() -> showProgress(text));
+            }
+
+            @Override
+            public void pairing(String pin, boolean moonshine) {
+                runOnUiThread(() -> showProgress(moonshine
+                        ? (own ? "Pairing with " + name + "…\nIt’s on your account, so it accepts by itself."
+                        : "Asking " + name + " to accept this phone…\nYour friend sees the request in Moonshine. (PIN " + pin + ")")
+                        : "Pairing with " + name + ". Enter this PIN in that PC’s host settings: " + pin));
+            }
+        };
+        m.run(() -> {
+            String error = null;
+            ComputerDetails computer = null;
+            NvApp app = null;
+            try {
+                computer = Connect.reach(this, b, hostUuid, name, port, addrs, target, ui);
+                error = Connect.pair(this, b, computer, ui);
+                if (error == null && computer.activeAddress != null && !Tunnels.isTunnelAddress(computer.activeAddress.address)
+                        && PcSheets.isLan(computer.activeAddress.address)) {
+                    ComputerDetails seen = b.getComputer(hostUuid);
+                    PcPrefs.get(this).rememberWake(hostUuid, seen != null && seen.macAddress != null ? seen.macAddress : computer.macAddress,
+                            computer.activeAddress.address, computer.activeAddress.port);
+                }
+                if (error == null && !TextUtils.isEmpty(appName)) {
+                    ComputerDetails fresh = b.getComputer(hostUuid);
+                    if (fresh != null && fresh.serverCert == null) fresh.serverCert = computer.serverCert;
+                    if (fresh != null) computer = fresh;
+                    app = Connect.findApp(this, b, computer, appName);
+                }
+            } catch (IOException e) {
+                error = e.getMessage();
+            } catch (InterruptedException e) {
+                error = "Connecting was interrupted.";
+            }
+            final String err = error;
+            final ComputerDetails pc = computer;
+            final NvApp found = app;
+            runOnUiThread(() -> {
+                connecting = false;
+                hideProgress();
+                if (isFinishing()) return;
+                if (err != null) {
+                    new AlertDialog.Builder(this, R.style.MoonshineDialog).setTitle("Couldn’t connect").setMessage(err).setPositiveButton("OK", null).show();
+                    return;
+                }
+                if (found != null && pc.activeAddress != null) {
+                    m.setActiveStream(pc.activeAddress.address);
+                    startActivity(ServerHelper.createStartIntent(this, found, pc, b, false));
+                    return;
+                }
+                Intent i = new Intent(this, AppView.class);
+                i.putExtra(AppView.NAME_EXTRA, PcPrefs.get(this).name(pc.uuid, pc.name));
+                i.putExtra(AppView.UUID_EXTRA, pc.uuid);
+                i.putExtra(AppView.NEW_PAIR_EXTRA, true);
+                i.putExtra(AppView.SHOW_HIDDEN_APPS_EXTRA, false);
+                startActivity(i);
+            });
+        });
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Hub.java b/app/src/main/java/com/moonshine/Hub.java
new file mode 100644
index 00000000..395a0fe6
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Hub.java
@@ -0,0 +1,296 @@
+package com.moonshine;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.WebSocket;
+import okhttp3.WebSocketListener;
+
+/**
+ * The live link to Moonshine's service (a WebSocket): the service pushes friends-list changes, quick
+ * messages, "join my game" invites and direct-connection answers here the moment they happen. Saying
+ * "bye" on it shows this phone offline to friends at once. Reconnects after network trouble; idle, it
+ * costs one small ping every 30 seconds. One link per login (the account's, or a guest's).
+ */
+public final class Hub {
+    public interface Listener {
+        void onMessage(JSONObject msg);
+    }
+
+    /** Picks out the message a caller is waiting for. */
+    public interface Match {
+        boolean test(JSONObject msg);
+    }
+
+    public interface Tokens {
+        /** The login to make a ticket with, or null when there is none (signed out). */
+        String token();
+    }
+
+    private static final long PING_MS = 30_000;
+    private static final long PONG_WAIT_MS = 15_000;
+    private static final int MAX_MESSAGE = 64 * 1024;
+
+    private final Tokens tokens;
+    private final Handler handler;
+    private final CopyOnWriteArrayList<Listener> listeners = new CopyOnWriteArrayList<>();
+    private final CopyOnWriteArrayList<Runnable> stateListeners = new CopyOnWriteArrayList<>();
+    private final OkHttpClient client;
+    private final Object lock = new Object();
+
+    private WebSocket ws;
+    private volatile boolean connected;
+    private boolean running;
+    private long retryMs = 2000;
+    private int generation; // bumped on every connect/stop, so old sockets' callbacks are ignored
+
+    public Hub(Tokens tokens) {
+        this(tokens, new Handler(Looper.getMainLooper()));
+    }
+
+    Hub(Tokens tokens, Handler handler) {
+        this.tokens = tokens;
+        this.handler = handler;
+        this.client = Service.http.newBuilder().readTimeout(0, TimeUnit.MILLISECONDS).build();
+    }
+
+    public boolean isConnected() {
+        return connected;
+    }
+
+    public void addListener(Listener l) {
+        listeners.add(l);
+    }
+
+    public void removeListener(Listener l) {
+        listeners.remove(l);
+    }
+
+    /** Called (on the main thread) whenever the link goes up or down. */
+    public void addStateListener(Runnable r) {
+        stateListeners.add(r);
+    }
+
+    /** Keep the link up. */
+    public void start() {
+        synchronized (lock) {
+            if (running) return;
+            running = true;
+            retryMs = 2000;
+        }
+        connectSoon(0);
+    }
+
+    /** Drop the link. With `bye`, tell the service first so friends see this phone go offline straight away. */
+    public void stop(boolean bye) {
+        WebSocket old;
+        synchronized (lock) {
+            running = false;
+            generation++;
+            old = ws;
+            ws = null;
+        }
+        handler.removeCallbacksAndMessages(this);
+        setConnected(false);
+        if (old != null) {
+            if (bye) old.send("bye");
+            old.close(1000, "bye");
+        }
+    }
+
+    public void restart() {
+        stop(false);
+        start();
+    }
+
+    private void connectSoon(long delayMs) {
+        handler.postAtTime(() -> new Thread(this::connect, "Moonshine live link").start(), this,
+                android.os.SystemClock.uptimeMillis() + delayMs);
+    }
+
+    private void scheduleRetry() {
+        long delay;
+        synchronized (lock) {
+            if (!running) return;
+            delay = retryMs;
+            retryMs = Math.min(retryMs * 2, 60_000);
+        }
+        connectSoon(delay);
+    }
+
+    private void connect() {
+        final int gen;
+        synchronized (lock) {
+            if (!running || ws != null) return;
+            gen = ++generation;
+        }
+        String token = tokens.token();
+        if (token == null || token.isEmpty()) {
+            scheduleRetry();
+            return;
+        }
+        String ticket;
+        try {
+            ticket = Service.call("POST", "/hub/ticket", null, token).optString("ticket", "");
+        } catch (Exception e) {
+            scheduleRetry();
+            return;
+        }
+        if (!ticket.matches("[A-Za-z0-9_-]{22,64}")) {
+            scheduleRetry();
+            return;
+        }
+        String base = Service.base.replaceFirst("^http", "ws");
+        Request req = new Request.Builder().url(base + "/hub?ticket=" + ticket).build();
+        synchronized (lock) {
+            if (!running || gen != generation) return;
+            ws = client.newWebSocket(req, new WebSocketListener() {
+                @Override
+                public void onOpen(WebSocket socket, Response response) {
+                    if (!current(socket)) return;
+                    synchronized (lock) { retryMs = 2000; }
+                    setConnected(true);
+                    schedulePing(socket);
+                }
+
+                @Override
+                public void onMessage(WebSocket socket, String text) {
+                    if (!current(socket)) return;
+                    if ("pong".equals(text)) {
+                        handler.removeCallbacksAndMessages(pongToken);
+                        return;
+                    }
+                    if (text.length() > MAX_MESSAGE) return;
+                    try {
+                        JSONObject msg = new JSONObject(text);
+                        if (!msg.optString("type", "").isEmpty()) {
+                            handler.post(() -> {
+                                for (Listener l : listeners) l.onMessage(msg);
+                            });
+                        }
+                    } catch (JSONException ignored) {
+                        // not ours
+                    }
+                }
+
+                @Override
+                public void onClosing(WebSocket socket, int code, String reason) {
+                    socket.close(1000, null);
+                }
+
+                @Override
+                public void onClosed(WebSocket socket, int code, String reason) {
+                    gone(socket);
+                }
+
+                @Override
+                public void onFailure(WebSocket socket, Throwable t, Response response) {
+                    gone(socket);
+                }
+            });
+        }
+    }
+
+    private final Object pongToken = new Object();
+
+    private void schedulePing(WebSocket socket) {
+        handler.postAtTime(() -> {
+            if (!current(socket)) return;
+            socket.send("ping");
+            // No answer in time: the link is dead
+            handler.postAtTime(() -> { if (current(socket)) socket.cancel(); }, pongToken,
+                    android.os.SystemClock.uptimeMillis() + PONG_WAIT_MS);
+            schedulePing(socket);
+        }, this, android.os.SystemClock.uptimeMillis() + PING_MS);
+    }
+
+    private boolean current(WebSocket socket) {
+        synchronized (lock) {
+            return ws == socket;
+        }
+    }
+
+    private void gone(WebSocket socket) {
+        synchronized (lock) {
+            if (ws != socket) return;
+            ws = null;
+        }
+        handler.removeCallbacksAndMessages(pongToken);
+        setConnected(false);
+        scheduleRetry();
+    }
+
+    private void setConnected(boolean on) {
+        if (connected == on) return;
+        connected = on;
+        handler.post(() -> {
+            for (Runnable r : stateListeners) r.run();
+        });
+    }
+
+    /**
+     * Wait (blocking, off the main thread) for a message matching `test`, registered before the caller
+     * sends what it answers. Returns null after timeoutMs.
+     */
+    public Waiter waitFor(Match test) {
+        Waiter w = new Waiter(test);
+        addListener(w);
+        return w;
+    }
+
+    public final class Waiter implements Listener {
+        private final Match test;
+        private JSONObject got;
+
+        Waiter(Match test) {
+            this.test = test;
+        }
+
+        @Override
+        public synchronized void onMessage(JSONObject msg) {
+            if (got == null && test.test(msg)) {
+                got = msg;
+                notifyAll();
+            }
+        }
+
+        public JSONObject await(long timeoutMs) throws InterruptedException {
+            long deadline = System.currentTimeMillis() + timeoutMs;
+            try {
+                synchronized (this) {
+                    while (got == null) {
+                        long left = deadline - System.currentTimeMillis();
+                        if (left <= 0) break;
+                        wait(left);
+                    }
+                    return got;
+                }
+            } finally {
+                cancel();
+            }
+        }
+
+        public void cancel() {
+            removeListener(this);
+        }
+    }
+
+    /** Wait (blocking) until the link is up; false after timeoutMs. */
+    public boolean whenConnected(long timeoutMs) throws InterruptedException {
+        long deadline = System.currentTimeMillis() + timeoutMs;
+        while (!connected) {
+            if (System.currentTimeMillis() >= deadline) return false;
+            Thread.sleep(100);
+        }
+        return true;
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Logs.java b/app/src/main/java/com/moonshine/Logs.java
new file mode 100644
index 00000000..33bc9446
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Logs.java
@@ -0,0 +1,110 @@
+package com.moonshine;
+
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Build;
+import android.widget.Toast;
+
+import androidx.core.content.FileProvider;
+
+import com.limelight.BuildConfig;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * Moonshine's own log: while the app runs, its log lines (this app only, nothing from other apps) are
+ * kept in a small rolling file, so a stream that went wrong a while ago can still be looked at.
+ * "Export log" bundles that with the phone and app details into one text file to share.
+ */
+public final class Logs {
+    private static Process recorder;
+
+    private Logs() {
+    }
+
+    private static File dir(Context c) {
+        File d = new File(c.getFilesDir(), "logs");
+        //noinspection ResultOfMethodCallIgnored
+        d.mkdirs();
+        return d;
+    }
+
+    /** Start keeping the log (two files of about 512 KB each; the oldest is dropped). Safe to call again. */
+    public static synchronized void start(Context c) {
+        if (recorder != null) return;
+        try {
+            File f = new File(dir(c), "moonshine.log");
+            recorder = new ProcessBuilder("logcat", "-v", "threadtime", "-f", f.getAbsolutePath(), "-r", "512", "-n", "2")
+                    .redirectErrorStream(true).start();
+        } catch (IOException | RuntimeException ignored) {
+            recorder = null; // no log is kept, everything else works
+        }
+    }
+
+    private static void copy(File f, OutputStream out) throws IOException {
+        if (!f.isFile()) return;
+        byte[] buf = new byte[16384];
+        try (InputStream in = new java.io.FileInputStream(f)) {
+            int n;
+            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        }
+    }
+
+    /** Write the log file and open the share sheet. Runs on a background thread. */
+    public static void export(Context c) {
+        final Context app = c.getApplicationContext();
+        new Thread(() -> {
+            try {
+                File out = new File(app.getCacheDir(), "moonshine-log-" + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date()) + ".txt");
+                try (OutputStream o = new FileOutputStream(out)) {
+                    String head = "Moonshine for Android " + BuildConfig.VERSION_NAME + "\n"
+                            + "Phone: " + Build.MANUFACTURER + " " + Build.MODEL + ", Android " + Build.VERSION.RELEASE + " (API " + Build.VERSION.SDK_INT + ")\n"
+                            + "Saved: " + new Date() + "\n"
+                            + "This file has Moonshine's log only. It can include PC names and addresses, so look it over before you share it.\n"
+                            + "------------------------------------------------------------\n";
+                    o.write(head.getBytes(StandardCharsets.UTF_8));
+                    File d = dir(app);
+                    copy(new File(d, "moonshine.log.1"), o); // the older half, if there is one
+                    copy(new File(d, "moonshine.log"), o);
+                    // What the system still holds right now (covers the moment the log file was started)
+                    try {
+                        Process p = new ProcessBuilder("logcat", "-d", "-v", "threadtime").redirectErrorStream(true).start();
+                        o.write("\n------------ current log ------------\n".getBytes(StandardCharsets.UTF_8));
+                        byte[] buf = new byte[16384];
+                        try (InputStream in = p.getInputStream()) {
+                            int n;
+                            long total = 0;
+                            while ((n = in.read(buf)) > 0 && total < 1_500_000) {
+                                o.write(buf, 0, n);
+                                total += n;
+                            }
+                        }
+                        p.destroy();
+                    } catch (IOException | RuntimeException ignored) {
+                        // the file above is still useful
+                    }
+                }
+                final Uri uri = FileProvider.getUriForFile(app, app.getPackageName() + ".fileprovider", out);
+                Intent send = new Intent(Intent.ACTION_SEND)
+                        .setType("text/plain")
+                        .putExtra(Intent.EXTRA_STREAM, uri)
+                        .putExtra(Intent.EXTRA_SUBJECT, "Moonshine log")
+                        .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+                Intent chooser = Intent.createChooser(send, "Export Moonshine log").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                new android.os.Handler(app.getMainLooper()).post(() -> app.startActivity(chooser));
+            } catch (IOException | RuntimeException e) {
+                new android.os.Handler(app.getMainLooper()).post(() ->
+                        Toast.makeText(app, "Couldn’t save the log: " + e.getMessage(), Toast.LENGTH_LONG).show());
+            }
+        }, "log-export").start();
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Moonshine.java b/app/src/main/java/com/moonshine/Moonshine.java
new file mode 100644
index 00000000..4c2ecc17
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Moonshine.java
@@ -0,0 +1,882 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.Application;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import com.limelight.BuildConfig;
+import com.limelight.R;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.moonshine.tunnel.TunnelCrypto;
+import com.moonshine.tunnel.Tunnels;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.lang.ref.WeakReference;
+import java.net.Inet4Address;
+import java.net.Inet6Address;
+import java.net.InetAddress;
+import java.net.NetworkInterface;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Moonshine's account features on this phone: signing in with Discord, friends, telling friends this
+ * phone is online, the live link (messages, "join my game" invites, direct connections) and invite links
+ * (joining a PC as a guest without an account). One per app.
+ *
+ * The phone only watches: it never hosts, so friends see it under their list and never as a PC.
+ */
+public final class Moonshine {
+    public interface Listener {
+        /** Something changed (signed in or out, the friends list, the live link): redraw. Main thread. */
+        void onChanged();
+    }
+
+    public static final String CHANNEL = "moonshine_friends";
+    private static final String PREFS = "moonshine";
+    private static final long PRESENCE_MS = 60_000;
+    private static final long PRESENCE_LINKED_MS = 2 * 60_000;
+    private static final long BACKGROUND_GRACE_MS = 60_000;
+    private static final long LOGIN_POLL_MS = 2000;
+    private static final long LOGIN_WAIT_MS = 10 * 60_000;
+    private static final long FRIENDS_FRESH_MS = 30_000;
+    private static final long REOPEN_EVERY_MS = 2 * 60_000;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private static Moonshine instance;
+
+    public static synchronized Moonshine get(Context ctx) {
+        if (instance == null) instance = new Moonshine(ctx.getApplicationContext());
+        return instance;
+    }
+
+    private final Context ctx;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService work = Executors.newCachedThreadPool(r -> {
+        Thread t = new Thread(r, "Moonshine");
+        t.setDaemon(true);
+        return t;
+    });
+    private final CopyOnWriteArrayList<Listener> listeners = new CopyOnWriteArrayList<>();
+    public final Hub hub;
+    private Hub guestHub;
+    public final Tunnels tunnels;
+
+    private volatile JSONObject friends; // the last GET /friends
+    private volatile long friendsAt;
+    private volatile String loginSession; // a Discord sign-in in progress
+    private volatile String lastError = "";
+    private volatile int started; // activities on screen (changed on the main thread only)
+    private WeakReference<Activity> resumed = new WeakReference<>(null);
+    private final Set<String> seenInvites = Collections.synchronizedSet(new LinkedHashSet<>());
+    private final Map<String, Long> reopenTried = new HashMap<>();
+    private volatile String activeStream = ""; // the stand-in address a stream is using
+
+    private Moonshine(Context ctx) {
+        this.ctx = ctx;
+        hub = new Hub(this::token);
+        hub.addListener(this::onHubMessage);
+        hub.addStateListener(this::changed);
+        tunnels = new Tunnels(ctx);
+        tunnels.setFinder(this::targetFor);
+        tunnels.setInUse(address -> address != null && address.equals(activeStream));
+        Service.loginLost = lost -> main.post(() -> {
+            if (lost.equals(token())) signedOutLocally();
+            else if (lost.equals(guestToken())) leaveInviteLocally("ended");
+        });
+        makeChannel();
+    }
+
+    /** From the Application: follow which screens are open, to stay online only while the app is in use. */
+    public void attach(Application app) {
+        Updates.start(app);
+        app.registerActivityLifecycleCallbacks(new Application.ActivityLifecycleCallbacks() {
+            @Override public void onActivityStarted(Activity a) {
+                if (started++ == 0) cameForward();
+            }
+            @Override public void onActivityStopped(Activity a) {
+                if (--started == 0) main.postDelayed(goneBack, BACKGROUND_GRACE_MS);
+            }
+            @Override public void onActivityResumed(Activity a) {
+                resumed = new WeakReference<>(a);
+                Updates.offerWaiting(a);
+            }
+            @Override public void onActivityPaused(Activity a) {
+                if (resumed.get() == a) resumed = new WeakReference<>(null);
+            }
+            @Override public void onActivityCreated(Activity a, Bundle b) { }
+            @Override public void onActivitySaveInstanceState(Activity a, Bundle b) { }
+            @Override public void onActivityDestroyed(Activity a) { }
+        });
+    }
+
+    private final Runnable goneBack = this::wentBack;
+
+    private void wentBack() {
+        if (started > 0) return;
+        // Out of sight for a minute: show offline to friends at once rather than after a timeout
+        hub.stop(true);
+        if (guestHub != null) guestHub.stop(true);
+        main.removeCallbacks(presenceTick);
+    }
+
+    private void cameForward() {
+        main.removeCallbacks(goneBack);
+        if (signedIn()) {
+            hub.start();
+            main.removeCallbacks(presenceTick);
+            main.post(presenceTick);
+        }
+        if (guestInvite() != null) ensureGuestHub().start();
+    }
+
+    public Activity resumedActivity() {
+        return resumed.get();
+    }
+
+    public void addListener(Listener l) {
+        listeners.add(l);
+    }
+
+    public void removeListener(Listener l) {
+        listeners.remove(l);
+    }
+
+    void changed() {
+        main.post(() -> {
+            for (Listener l : listeners) l.onChanged();
+        });
+    }
+
+    public void run(Runnable r) {
+        work.execute(r);
+    }
+
+    public void onMain(Runnable r) {
+        main.post(r);
+    }
+
+    private SharedPreferences prefs() {
+        return ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * The Friends screen is open to other apps (for moonshine:// links), so the extras Moonshine passes
+     * itself (invite popups, joining a game) carry a key only this app knows. Without it they're ignored,
+     * so no other app can make Moonshine connect somewhere or show a made-up invite.
+     */
+    private synchronized String intentKey() {
+        String k = prefs().getString("intentKey", null);
+        if (k == null || k.length() < 32) {
+            byte[] b = new byte[24];
+            new java.security.SecureRandom().nextBytes(b);
+            k = android.util.Base64.encodeToString(b, android.util.Base64.NO_WRAP | android.util.Base64.URL_SAFE | android.util.Base64.NO_PADDING);
+            prefs().edit().putString("intentKey", k).apply();
+        }
+        return k;
+    }
+
+    public Intent sign(Intent i) {
+        return i.putExtra("moonshine_key", intentKey());
+    }
+
+    public boolean isOurs(Intent i) {
+        String k = i == null ? null : i.getStringExtra("moonshine_key");
+        return k != null && java.security.MessageDigest.isEqual(k.getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                intentKey().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+    }
+
+    // ---- account -----------------------------------------------------------------------------------
+
+    public String token() {
+        return Secrets.get(ctx, "token");
+    }
+
+    public boolean signedIn() {
+        return !token().isEmpty();
+    }
+
+    public String username() {
+        return prefs().getString("username", "");
+    }
+
+    public boolean signingIn() {
+        return loginSession != null;
+    }
+
+    public String lastError() {
+        return lastError;
+    }
+
+    /** Start signing in: Discord's page opens in the browser, and this waits for the answer. */
+    public void signIn(Activity from) {
+        byte[] b = new byte[24];
+        RANDOM.nextBytes(b);
+        final String session = TunnelCrypto.b64url(b);
+        loginSession = session;
+        lastError = "";
+        changed();
+        Intent i = new Intent(Intent.ACTION_VIEW, Uri.parse(Service.base + "/auth/discord/start?session=" + session));
+        try {
+            from.startActivity(i);
+        } catch (Exception e) {
+            loginSession = null;
+            lastError = "No web browser is installed to sign in with.";
+            changed();
+            return;
+        }
+        run(() -> pollLogin(session));
+    }
+
+    public void cancelSignIn() {
+        loginSession = null;
+        changed();
+    }
+
+    private void pollLogin(String session) {
+        long deadline = System.currentTimeMillis() + LOGIN_WAIT_MS;
+        while (session.equals(loginSession) && System.currentTimeMillis() < deadline) {
+            try {
+                Thread.sleep(LOGIN_POLL_MS);
+                JSONObject r = Service.call("GET", "/auth/poll?session=" + session, null, null);
+                if (r.optBoolean("pending", false)) continue;
+                String token = r.optString("token", "");
+                if (token.isEmpty()) break;
+                if (!session.equals(loginSession)) return;
+                Secrets.put(ctx, "token", token);
+                prefs().edit().putString("username", r.isNull("username") ? "" : r.optString("username", "")).apply();
+                loginSession = null;
+                main.post(() -> {
+                    hub.start();
+                    main.removeCallbacks(presenceTick);
+                    main.post(presenceTick);
+                });
+                refreshFriends();
+                changed();
+                return;
+            } catch (Service.ServiceException e) {
+                // 410: the browser hasn't opened the sign-in page yet (a phone's browser can take a while,
+                // with its own first-run screens), or it expired; keep waiting until this side gives up
+                if (e.status == 401) {
+                    lastError = "cancelled".equals(e.getMessage()) ? "Sign-in cancelled." : "Discord sign-in failed. Try again.";
+                    break;
+                }
+            } catch (IOException e) {
+                // no internet for a moment: keep waiting
+            } catch (InterruptedException e) {
+                break;
+            }
+        }
+        if (session.equals(loginSession)) {
+            loginSession = null;
+            if (lastError.isEmpty()) lastError = "Signing in took too long. Try again.";
+        }
+        changed();
+    }
