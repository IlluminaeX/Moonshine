+    /** A "join my game" invite. */
+    public static final class PlayInvite {
+        public final String id;
+        public final String from;
+        public final long device;
+        public final String hostUuid;
+        public final String app;
+        public final String game;
+        public final String host;
+
+        PlayInvite(String id, String from, long device, String hostUuid, String app, String game, String host) {
+            this.id = id;
+            this.from = from;
+            this.device = device;
+            this.hostUuid = hostUuid;
+            this.app = app.isEmpty() ? "a game" : app;
+            this.game = game;
+            this.host = host.isEmpty() ? "their PC" : host;
+        }
+
+        void into(Intent i) {
+            i.putExtra("invite_id", id).putExtra("invite_from", from).putExtra("invite_device", device)
+                    .putExtra("invite_host_uuid", hostUuid).putExtra("invite_app", app).putExtra("invite_game", game).putExtra("invite_host", host);
+        }
+
+        static PlayInvite from(Intent i) {
+            String id = i.getStringExtra("invite_id");
+            if (id == null) return null;
+            return new PlayInvite(id, String.valueOf(i.getStringExtra("invite_from")), i.getLongExtra("invite_device", 0),
+                    String.valueOf(i.getStringExtra("invite_host_uuid")), String.valueOf(i.getStringExtra("invite_app")),
+                    String.valueOf(i.getStringExtra("invite_game")), String.valueOf(i.getStringExtra("invite_host")));
+        }
+    }
+
+    /** Tell the friend whether this phone is joining. */
+    public void answerPlayInvite(PlayInvite inv, boolean joining) {
+        cancelNotification("play:" + inv.id);
+        run(() -> {
+            try {
+                Service.call("POST", "/friends/play-answer", new JSONObject().put("device", inv.device).put("id", inv.id).put("status", joining ? "joined" : "declined"), token());
+            } catch (IOException | JSONException ignored) {
+                // their popup times out by itself
+            }
+        });
+    }
+
+    // ---- notifications -----------------------------------------------------------------------------
+
+    private void makeChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return;
+        NotificationChannel ch = new NotificationChannel(CHANNEL, ctx.getString(R.string.moonshine_channel_friends), NotificationManager.IMPORTANCE_HIGH);
+        ch.setDescription(ctx.getString(R.string.moonshine_channel_friends_desc));
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm != null) nm.createNotificationChannel(ch);
+    }
+
+    private void notify(String key, String title, String text, PlayInvite inv) {
+        if (inv == null) notifyWith(key, title, text, null, null);
+        else notifyWith(key, title, text, "com.moonshine.PLAY_INVITE." + inv.id, inv::into); // one PendingIntent per invite
+    }
+
+    interface Extras {
+        void put(Intent i);
+    }
+
+    /** A notification that opens Moonshine; `extras` puts the thing it is about into the intent (signed, so only this app's are believed). */
+    private void notifyWith(String key, String title, String text, String action, Extras extras) {
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm == null) return;
+        Intent open = new Intent(ctx, FriendsActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        if (extras != null) {
+            extras.put(open);
+            sign(open);
+            open.setAction(action);
+        }
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT | (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? PendingIntent.FLAG_IMMUTABLE : 0);
+        PendingIntent pi = PendingIntent.getActivity(ctx, key.hashCode(), open, flags);
+        android.app.Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                ? new android.app.Notification.Builder(ctx, CHANNEL)
+                : new android.app.Notification.Builder(ctx);
+        b.setSmallIcon(R.drawable.ic_stat_moonshine)
+                .setContentTitle(title)
+                .setContentText(text)
+                .setStyle(new android.app.Notification.BigTextStyle().bigText(text))
+                .setAutoCancel(true)
+                .setContentIntent(pi);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) b.setColor(0xFFF0708C);
+        try {
+            nm.notify(key, 1, b.build());
+        } catch (SecurityException ignored) {
+            // notifications not allowed
+        }
+    }
+
+    void cancelNotification(String key) {
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm != null) nm.cancel(key, 1);
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Pairing.java b/app/src/main/java/com/moonshine/Pairing.java
new file mode 100644
index 00000000..4ffd9cc7
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Pairing.java
@@ -0,0 +1,124 @@
+package com.moonshine;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.HttpUrl;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * Pairing with a PC that hosts with Moonshine without anyone typing the PIN, the same as the desktop app
+ * (app/lib/invite.js): this phone tells the host the PIN it is about to pair with, Moonshine on that PC
+ * asks its user "wants to pair: Accept / Decline", and on Accept the host enters the PIN itself. A host
+ * accepts a friend's device by itself when it comes through a direct connection or from the friend's
+ * Tailscale or home-network address.
+ */
+public final class Pairing {
+    /** The host refused to take the request: closed (Moonshine isn't open there), disabled, busy. */
+    public static final class Refused extends IOException {
+        public final String reason;
+
+        Refused(String reason) {
+            super(reason);
+            this.reason = reason;
+        }
+    }
+
+    private static final OkHttpClient http = Service.http.newBuilder()
+            .connectTimeout(3, TimeUnit.SECONDS)
+            .readTimeout(4, TimeUnit.SECONDS)
+            .retryOnConnectionFailure(false)
+            .build();
+
+    private Pairing() {}
+
+    private static HttpUrl url(String host, int port, String path) {
+        HttpUrl.Builder b = new HttpUrl.Builder().scheme("http").host(host).port(port);
+        int q = path.indexOf('?');
+        b.addPathSegments((q < 0 ? path : path.substring(0, q)).replaceFirst("^/", ""));
+        return b.build();
+    }
+
+    /** [status, json or null]; never more than 16 KB read. */
+    private static Object[] get(HttpUrl url, long timeoutMs) throws IOException {
+        OkHttpClient c = http.newBuilder().callTimeout(timeoutMs, TimeUnit.MILLISECONDS).build();
+        try (Response res = c.newCall(new Request.Builder().url(url).header("Connection", "close").build()).execute()) {
+            ResponseBody body = res.body();
+            JSONObject json = null;
+            if (body != null) {
+                okio.BufferedSource src = body.source();
+                src.request(16 * 1024 + 1);
+                if (src.getBuffer().size() <= 16 * 1024) {
+                    try {
+                        json = new JSONObject(src.readUtf8());
+                    } catch (JSONException ignored) {
+                        // another kind of host answers in XML
+                    }
+                }
+            }
+            return new Object[] { res.code(), json };
+        }
+    }
+
+    /** Is the host at this address a Moonshine? Blocking. */
+    public static boolean probe(String host, int port) {
+        try {
+            Object[] r = get(url(host, port, "/moonshine/hello"), 2000);
+            JSONObject j = (JSONObject) r[1];
+            return (Integer) r[0] == 200 && j != null && "moonshine".equals(j.optString("app"));
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    /**
+     * Ask the host's user to accept this phone. Returns the request id to poll, or null when the host isn't
+     * a Moonshine (the PIN then has to be typed there). Blocking.
+     */
+    public static String request(String host, int port, String pin, String name) throws IOException {
+        HttpUrl u = url(host, port, "/moonshine/pair").newBuilder()
+                .addQueryParameter("pin", pin)
+                .addQueryParameter("name", name.length() > 64 ? name.substring(0, 64) : name)
+                .build();
+        Object[] r;
+        try {
+            r = get(u, 5000);
+        } catch (IOException e) {
+            return null;
+        }
+        int code = (Integer) r[0];
+        JSONObject j = (JSONObject) r[1];
+        if (code == 404 || j == null) return null;
+        if (code != 200) throw new Refused(j.optString("error", "error"));
+        String id = j.optString("id", "");
+        return id.matches("[0-9A-Za-z-]{8,64}") ? id : null;
+    }
+
+    /** pending, accepted, declined (or pending when the host can't be asked right now). Blocking. */
+    public static String status(String host, int port, String id) {
+        try {
+            Object[] r = get(url(host, port, "/moonshine/pair-status").newBuilder().addQueryParameter("id", id).build(), 4000);
+            JSONObject j = (JSONObject) r[1];
+            String s = j != null ? j.optString("status", "") : "";
+            return s.isEmpty() ? "pending" : s;
+        } catch (IOException e) {
+            return "pending";
+        }
+    }
+
+    /** Words for a refusal. */
+    public static String refusedMessage(String reason, String pcName) {
+        switch (reason == null ? "" : reason) {
+            case "closed": return "Moonshine isn’t open on " + pcName + ", so nobody there can accept this phone. Ask your friend to open it.";
+            case "disabled": return pcName + " has pairing turned off.";
+            case "busy": return pcName + " has too many pairing requests waiting. Try again in a minute.";
+            default: return "Couldn’t ask " + pcName + " to pair.";
+        }
+    }
+}
diff --git a/app/src/main/java/com/moonshine/PcPrefs.java b/app/src/main/java/com/moonshine/PcPrefs.java
new file mode 100644
index 00000000..b6453983
--- /dev/null
+++ b/app/src/main/java/com/moonshine/PcPrefs.java
@@ -0,0 +1,202 @@
+package com.moonshine;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.limelight.nvstream.jni.MoonBridge;
+import com.limelight.preferences.PreferenceConfiguration;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * What this phone remembers per PC (a name of its own, its network address for Wake, the volume boost, stream
+ * settings that differ from the defaults) and the notification switches. Stored on the phone only.
+ */
+public final class PcPrefs {
+    public static final float MAX_BOOST = 10f;
+    private static PcPrefs instance;
+    private final SharedPreferences p;
+    private final Context ctx;
+
+    private PcPrefs(Context c) {
+        ctx = c.getApplicationContext();
+        p = ctx.getSharedPreferences("moonshine_pcs", Context.MODE_PRIVATE);
+    }
+
+    public static synchronized PcPrefs get(Context c) {
+        if (instance == null) instance = new PcPrefs(c);
+        return instance;
+    }
+
+    // ---- name ----------------------------------------------------------------------------------------
+
+    /** The name this phone gives a PC: the one typed here, else `fallback`. */
+    public String name(String uuid, String fallback) {
+        String n = p.getString("name:" + uuid, "");
+        return n.isEmpty() ? fallback : n;
+    }
+
+    public void setName(String uuid, String name) {
+        String n = Moonshine.clean(name, 40);
+        if (n.isEmpty()) p.edit().remove("name:" + uuid).apply();
+        else p.edit().putString("name:" + uuid, n).apply();
+        Moonshine.get(ctx).pushName(uuid, n);
+    }
+
+    /**
+     * Names are kept by the friends service so a PC renamed on the PC app or another phone is renamed here.
+     * The service's list wins; a name only this phone has is sent up once; one the service dropped is dropped.
+     */
+    public synchronized void syncNames(JSONObject remote, Moonshine m) {
+        if (remote == null) return;
+        SharedPreferences.Editor e = p.edit();
+        java.util.Set<String> synced = new java.util.HashSet<>(p.getStringSet("namesSynced", new java.util.HashSet<>()));
+        java.util.Set<String> now = new java.util.HashSet<>();
+        java.util.Iterator<String> it = remote.keys();
+        while (it.hasNext()) {
+            String uuid = it.next();
+            e.putString("name:" + uuid, Moonshine.clean(remote.optString(uuid), 60));
+            now.add(uuid);
+        }
+        for (String key : new java.util.ArrayList<>(p.getAll().keySet())) {
+            if (!key.startsWith("name:")) continue;
+            String uuid = key.substring(5);
+            if (remote.has(uuid)) continue;
+            if (synced.contains(uuid)) e.remove(key);
+            else {
+                m.pushName(uuid, p.getString(key, ""));
+                now.add(uuid);
+            }
+        }
+        e.putStringSet("namesSynced", now).apply();
+    }
+
+    // ---- wake ----------------------------------------------------------------------------------------
+
+    /** Remember a PC's network (MAC) address and where it was on this network, so it can be woken later. */
+    public void rememberWake(String uuid, String mac, String address, int port) {
+        if (mac == null || !mac.matches("(?i)([0-9a-f]{2}:){5}[0-9a-f]{2}") || mac.equals("00:00:00:00:00:00")) return;
+        p.edit().putString("mac:" + uuid, mac).putString("lan:" + uuid, address + ":" + port).apply();
+    }
+
+    public boolean canWake(String uuid) {
+        return !p.getString("mac:" + uuid, "").isEmpty();
+    }
+
+    public String mac(String uuid) {
+        return p.getString("mac:" + uuid, "");
+    }
+
+    /** {address, port} where the PC was seen on this phone's network, or null. */
+    public String[] lan(String uuid) {
+        String s = p.getString("lan:" + uuid, "");
+        int i = s.lastIndexOf(':');
+        return i > 0 ? new String[] { s.substring(0, i), s.substring(i + 1) } : null;
+    }
+
+    // ---- volume boost --------------------------------------------------------------------------------
+
+    public float volume(String uuid) {
+        return clampBoost(p.getFloat("vol:" + uuid, 1f));
+    }
+
+    public void setVolume(String uuid, float v) {
+        v = clampBoost(v);
+        if (v <= 1.001f) p.edit().remove("vol:" + uuid).apply();
+        else p.edit().putFloat("vol:" + uuid, v).apply();
+    }
+
+    static float clampBoost(float v) {
+        if (Float.isNaN(v)) return 1f;
+        return Math.round(Math.min(MAX_BOOST, Math.max(1f, v)) * 100f) / 100f;
+    }
+
+    // ---- stream settings that differ from the defaults ----------------------------------------------
+
+    /** This PC's own stream settings, or null when it follows the defaults. */
+    public JSONObject streamSettings(String uuid) {
+        String s = p.getString("ss:" + uuid, "");
+        if (s.isEmpty()) return null;
+        try {
+            return new JSONObject(s);
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    public void setStreamSettings(String uuid, JSONObject o) {
+        if (o == null) p.edit().remove("ss:" + uuid).apply();
+        else p.edit().putString("ss:" + uuid, o.toString()).apply();
+    }
+
+    /** Apply a PC's own settings on top of the defaults the stream was about to use. */
+    public static void apply(PreferenceConfiguration c, JSONObject o) {
+        if (o == null) return;
+        String res = o.optString("resolution", "");
+        if (res.matches("\\d{3,5}x\\d{3,5}")) {
+            String[] wh = res.split("x");
+            c.width = Integer.parseInt(wh[0]);
+            c.height = Integer.parseInt(wh[1]);
+        }
+        int fps = o.optInt("fps", 0);
+        if (fps >= 15 && fps <= 240) c.fps = fps;
+        int mbps = o.optInt("bitrateMbps", 0);
+        if (mbps >= 1 && mbps <= 500) c.bitrate = mbps * 1000;
+        switch (o.optString("codec", "")) {
+            case "h264": c.videoFormat = PreferenceConfiguration.FormatOption.FORCE_H264; break;
+            case "hevc": c.videoFormat = PreferenceConfiguration.FormatOption.FORCE_HEVC; break;
+            case "av1": c.videoFormat = PreferenceConfiguration.FormatOption.FORCE_AV1; break;
+            default:
+        }
+        if (o.has("hdr")) c.enableHdr = o.optBoolean("hdr");
+        switch (o.optString("audio", "")) {
+            case "stereo": c.audioConfiguration = MoonBridge.AUDIO_CONFIGURATION_STEREO; break;
+            case "51": c.audioConfiguration = MoonBridge.AUDIO_CONFIGURATION_51_SURROUND; break;
+            case "71": c.audioConfiguration = MoonBridge.AUDIO_CONFIGURATION_71_SURROUND; break;
+            default:
+        }
+    }
+
+    // ---- notifications -------------------------------------------------------------------------------
+
+    /** 0 = off, -1 = until turned off, otherwise the time it ends (ms). */
+    public long dndUntil() {
+        return p.getLong("dndUntil", 0);
+    }
+
+    public boolean dnd() {
+        long u = dndUntil();
+        return u == -1 || u > System.currentTimeMillis();
+    }
+
+    public void setDnd(long until) {
+        p.edit().putLong("dndUntil", until).apply();
+        Moonshine.get(ctx).presenceSoon();
+    }
+
+    public boolean notifyMessages() {
+        return p.getBoolean("notifyMessages", true);
+    }
+
+    public void setNotifyMessages(boolean on) {
+        p.edit().putBoolean("notifyMessages", on).apply();
+    }
+
+    public boolean notifyInvites() {
+        return p.getBoolean("notifyInvites", true);
+    }
+
+    public void setNotifyInvites(boolean on) {
+        p.edit().putBoolean("notifyInvites", on).apply();
+    }
+
+    /** Whether a dropped stream is picked up again by itself. */
+    public boolean autoReconnect() {
+        return p.getBoolean("autoReconnect", true);
+    }
+
+    public void setAutoReconnect(boolean on) {
+        p.edit().putBoolean("autoReconnect", on).apply();
+    }
+}
diff --git a/app/src/main/java/com/moonshine/PcSheets.java b/app/src/main/java/com/moonshine/PcSheets.java
new file mode 100644
index 00000000..9bcd128f
--- /dev/null
+++ b/app/src/main/java/com/moonshine/PcSheets.java
@@ -0,0 +1,359 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.text.InputFilter;
+import android.view.ViewGroup;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.limelight.R;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.limelight.nvstream.wol.WakeOnLanSender;
+import com.moonshine.tunnel.Tunnels;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.text.DateFormat;
+import java.util.Date;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * The sheets behind a PC's "…" button and the account button: rename, wake, volume boost, this PC's own
+ * stream settings, a speed test, the direct-connection check, and the notification switches.
+ */
+public final class PcSheets {
+    private PcSheets() {}
+
+    // ---- how this phone reaches a PC -----------------------------------------------------------------
+
+    public static final class Conn {
+        public final String kind; // lan, tailscale, direct, relay, internet
+        public final int ms;      // 0 = unknown
+
+        Conn(String kind, int ms) {
+            this.kind = kind;
+            this.ms = ms;
+        }
+    }
+
+    static boolean isLan(String ip) {
+        return ip.matches("^(10\\..*|192\\.168\\..*|172\\.(1[6-9]|2[0-9]|3[01])\\..*|169\\.254\\..*|fe80:.*|f[cd][0-9a-f]{2}:.*)$");
+    }
+
+    static boolean isTailscale(String ip) {
+        if (!ip.matches("^100\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$")) return false;
+        int second = Integer.parseInt(ip.split("\\.")[1]);
+        return second >= 64 && second <= 127;
+    }
+
+    /** What kind of path an address is: same network, Tailscale, a direct connection or relay, or the open internet. */
+    public static String kindOf(String address, boolean relayed) {
+        if (Tunnels.isTunnelAddress(address)) return relayed ? "relay" : "direct";
+        if (isTailscale(address)) return "tailscale";
+        return isLan(address) || !address.matches("^[0-9.]+$|.*:.*") ? "lan" : "internet";
+    }
+
+    public static String kindLabel(String kind) {
+        switch (kind) {
+            case "lan": return "Same network";
+            case "tailscale": return "Tailscale";
+            case "direct": return "Direct";
+            case "relay": return "Relay";
+            default: return "Internet";
+        }
+    }
+
+    /** A delay rounded to the nearest 10 ms (10 means under 20), so the list doesn't redraw for every wobble. */
+    static int bucket(int ms) {
+        return ms <= 0 ? 0 : ms < 20 ? 10 : Math.round(ms / 10f) * 10;
+    }
+
+    /** How long a TCP connection to this address takes, in ms (0 = didn't answer). Blocking, up to 1.5 s. */
+    public static int pingMs(String address, int port) {
+        long t0 = System.nanoTime();
+        try (Socket s = new Socket()) {
+            s.connect(new InetSocketAddress(address, port), 1500);
+            return bucket((int) Math.max(1, (System.nanoTime() - t0) / 1_000_000));
+        } catch (IOException e) {
+            return 0;
+        }
+    }
+
+    /** The connection to a PC as this phone has it right now, or null if nothing answers without opening a tunnel. Blocking. */
+    public static Conn probe(Moonshine m, String hostUuid, java.util.List<String> addrs, int port) {
+        if (m.tunnels.isOpen(hostUuid)) {
+            String ip = m.tunnels.localIpFor(hostUuid);
+            if (ip != null) return new Conn(kindOf(ip, m.tunnels.isRelayed(hostUuid)), pingMs(ip, port));
+        }
+        for (String a : addrs) {
+            if (Tunnels.isTunnelAddress(a)) continue;
+            int ms = pingMs(a, port);
+            if (ms > 0) return new Conn(kindOf(a, false), ms);
+        }
+        return null;
+    }
+
+    // ---- small dialogs --------------------------------------------------------------------------------
+
+    public interface Text {
+        void done(String text);
+    }
+
+    static void prompt(Activity a, String title, String hint, int max, String initial, Text result) {
+        EditText e = new EditText(a);
+        e.setHint(hint);
+        e.setTextColor(Ui.TEXT);
+        e.setHintTextColor(Ui.MUTED);
+        e.setSingleLine(true);
+        e.setFilters(new InputFilter[] { new InputFilter.LengthFilter(max) });
+        e.setText(initial);
+        e.setSelection(e.getText().length());
+        e.setBackground(Ui.shape(a, Ui.CARD_HIGH, Ui.STROKE, 14));
+        e.setPadding(Ui.dp(a, 14), Ui.dp(a, 12), Ui.dp(a, 14), Ui.dp(a, 12));
+        FrameLayout wrap = new FrameLayout(a);
+        wrap.setPadding(Ui.dp(a, 20), Ui.dp(a, 8), Ui.dp(a, 20), 0);
+        wrap.addView(e);
+        new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                .setTitle(title)
+                .setView(wrap)
+                .setPositiveButton("OK", (d, w) -> result.done(e.getText().toString().trim()))
+                .setNegativeButton("Cancel", null)
+                .show();
+    }
+
+    interface Picked {
+        void value(String v);
+    }
+
+    static void choose(Activity a, String title, String[] labels, String[] values, String current, Picked picked) {
+        int at = 0;
+        for (int i = 0; i < values.length; i++) if (values[i].equals(current)) at = i;
+        new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                .setTitle(title)
+                .setSingleChoiceItems(labels, at, (d, which) -> {
+                    d.dismiss();
+                    picked.value(values[which]);
+                })
+                .setNegativeButton("Cancel", null)
+                .show();
+    }
+
+    private static void toast(Activity a, String s) {
+        Toast.makeText(a, s, Toast.LENGTH_LONG).show();
+    }
+
+    // ---- a PC ------------------------------------------------------------------------------------------
+
+    public interface PcActions {
+        /** Pick files and send them to this PC. */
+        void sendFiles();
+
+        /** Something changed that the list should redraw (a new name). */
+        void changed();
+    }
+
+    public static void pc(Activity a, Moonshine m, String uuid, String defaultName, boolean online, PcActions actions) {
+        PcPrefs p = PcPrefs.get(a);
+        String name = p.name(uuid, defaultName);
+        Sheet s = Sheet.open(a, name, online ? "Online" : "Offline", false);
+        s.row(R.drawable.ic_edit, "Rename", "A name only you see", "", true, () ->
+                prompt(a, "Rename this PC", "Name (empty to use " + defaultName + ")", 40, p.name(uuid, ""), t -> {
+                    p.setName(uuid, t);
+                    actions.changed();
+                }));
+        if (!online && p.canWake(uuid)) {
+            s.row(R.drawable.ic_power, "Wake", "Sends a wake-up signal over your network", "", true, () -> wake(a, m, uuid, defaultName));
+        }
+        s.slider(R.drawable.ic_volume, "Volume boost", 1f, PcPrefs.MAX_BOOST, 90, p.volume(uuid),
+                v -> String.format(java.util.Locale.US, "%.1fx", v), v -> p.setVolume(uuid, v));
+        s.row(R.drawable.ic_tune, "Stream settings", p.streamSettings(uuid) == null ? "Using your defaults" : "This PC has its own", "", true,
+                () -> streamSettings(a, m, uuid, name));
+        if (online) {
+            s.row(R.drawable.ic_file, "Send files", "To this PC, if it allows it", "", true, actions::sendFiles);
+        }
+        s.show();
+    }
+
+    private static void wake(Activity a, Moonshine m, String uuid, String name) {
+        PcPrefs p = PcPrefs.get(a);
+        String[] lan = p.lan(uuid);
+        if (lan == null) {
+            toast(a, "Moonshine hasn’t seen " + name + " on this network yet, so it can’t wake it.");
+            return;
+        }
+        m.run(() -> {
+            try {
+                ComputerDetails d = new ComputerDetails();
+                d.macAddress = p.mac(uuid);
+                d.localAddress = new ComputerDetails.AddressTuple(lan[0], Integer.parseInt(lan[1]));
+                WakeOnLanSender.sendWolPacket(d);
+                m.onMain(() -> toast(a, "Sent a wake-up signal to " + name + ". It can take a minute. It has to be on this Wi-Fi, with wake-on-LAN turned on."));
+            } catch (IOException | RuntimeException e) {
+                m.onMain(() -> toast(a, "Couldn’t send the wake-up signal."));
+            }
+        });
+    }
+
+    // ---- this PC's stream settings ----------------------------------------------------------------------
+
+    private static final String[] RES_LABELS = { "Same as my defaults", "720p", "1080p", "1440p", "4K" };
+    private static final String[] RES_VALUES = { "", "1280x720", "1920x1080", "2560x1440", "3840x2160" };
+    private static final String[] FPS_LABELS = { "Same as my defaults", "30", "60", "90", "120" };
+    private static final String[] FPS_VALUES = { "", "30", "60", "90", "120" };
+    private static final String[] RATE_LABELS = { "Same as my defaults", "5 Mbps", "10 Mbps", "20 Mbps", "30 Mbps", "50 Mbps", "80 Mbps", "100 Mbps", "150 Mbps" };
+    private static final String[] RATE_VALUES = { "", "5", "10", "20", "30", "50", "80", "100", "150" };
+    private static final String[] CODEC_LABELS = { "Same as my defaults", "H.264", "HEVC", "AV1" };
+    private static final String[] CODEC_VALUES = { "", "h264", "hevc", "av1" };
+    private static final String[] AUDIO_LABELS = { "Same as my defaults", "Stereo", "5.1 surround", "7.1 surround" };
+    private static final String[] AUDIO_VALUES = { "", "stereo", "51", "71" };
+
+    private static String labelFor(String[] labels, String[] values, String v) {
+        for (int i = 0; i < values.length; i++) if (values[i].equals(v)) return i == 0 ? "Default" : labels[i];
+        return "Default";
+    }
+
+    static void streamSettings(Activity a, Moonshine m, String uuid, String name) {
+        PcPrefs p = PcPrefs.get(a);
+        JSONObject o = p.streamSettings(uuid);
+        boolean custom = o != null;
+        Sheet s = Sheet.open(a, "Stream settings", name, false);
+        s.toggle(R.drawable.ic_check_circle, "Use my defaults", "Off lets this PC have its own", !custom, on -> {
+            p.setStreamSettings(uuid, on ? null : put(new JSONObject(), "custom", true));
+            s.dismiss();
+            streamSettings(a, m, uuid, name);
+        });
+        if (custom) {
+            s.row(R.drawable.ic_computer, "Resolution", null, labelFor(RES_LABELS, RES_VALUES, o.optString("resolution")), true,
+                    () -> choose(a, "Resolution", RES_LABELS, RES_VALUES, o.optString("resolution"), v -> save(a, m, uuid, name, "resolution", v)));
+            s.row(R.drawable.ic_speed, "Frame rate", null, labelFor(FPS_LABELS, FPS_VALUES, o.optString("fps")), true,
+                    () -> choose(a, "Frame rate", FPS_LABELS, FPS_VALUES, o.optString("fps"), v -> save(a, m, uuid, name, "fps", v)));
+            s.row(R.drawable.ic_wifi, "Bitrate", null, labelFor(RATE_LABELS, RATE_VALUES, o.optString("bitrateMbps")), true,
+                    () -> choose(a, "Bitrate", RATE_LABELS, RATE_VALUES, o.optString("bitrateMbps"), v -> save(a, m, uuid, name, "bitrateMbps", v)));
+            s.row(R.drawable.ic_tune, "Video codec", null, labelFor(CODEC_LABELS, CODEC_VALUES, o.optString("codec")), true,
+                    () -> choose(a, "Video codec", CODEC_LABELS, CODEC_VALUES, o.optString("codec"), v -> save(a, m, uuid, name, "codec", v)));
+            s.row(R.drawable.ic_volume, "Surround sound", null, labelFor(AUDIO_LABELS, AUDIO_VALUES, o.optString("audio")), true,
+                    () -> choose(a, "Surround sound", AUDIO_LABELS, AUDIO_VALUES, o.optString("audio"), v -> save(a, m, uuid, name, "audio", v)));
+            s.toggle(R.drawable.ic_bolt, "HDR", "If this PC and your phone support it", o.optBoolean("hdr"), on -> {
+                JSONObject cur = p.streamSettings(uuid);
+                if (cur != null) p.setStreamSettings(uuid, put(cur, "hdr", on));
+            });
+            s.row(R.drawable.ic_speed, "Test my speed", "Suggests a bitrate for this PC", "", true, () -> speedTest(a, m, uuid));
+        } else {
+            s.note("This PC streams with the settings from Settings. Turn the switch off to give it its own resolution, frame rate, bitrate and more.");
+        }
+        s.show();
+    }
+
+    private static JSONObject put(JSONObject o, String k, Object v) {
+        try {
+            o.put(k, v);
+        } catch (JSONException ignored) {
+            // fixed keys
+        }
+        return o;
+    }
+
+    private static void save(Activity a, Moonshine m, String uuid, String name, String key, String value) {
+        PcPrefs p = PcPrefs.get(a);
+        JSONObject o = p.streamSettings(uuid);
+        if (o == null) o = new JSONObject();
+        if (value.isEmpty()) o.remove(key);
+        else if (key.equals("fps") || key.equals("bitrateMbps")) put(o, key, Integer.parseInt(value));
+        else put(o, key, value);
+        p.setStreamSettings(uuid, o);
+        streamSettings(a, m, uuid, name);
+    }
+
+    // ---- speed test -------------------------------------------------------------------------------------
+
+    /** Test the connection; with a PC given, offer to use the suggested bitrate for it. */
+    public static void speedTest(Activity a, Moonshine m, String uuidOrNull) {
+        TextView msg = Ui.text(a, "Testing your download speed…", 15, Ui.TEXT, false);
+        FrameLayout wrap = new FrameLayout(a);
+        wrap.setPadding(Ui.dp(a, 24), Ui.dp(a, 20), Ui.dp(a, 24), Ui.dp(a, 8));
+        wrap.addView(msg);
+        final AtomicBoolean cancelled = new AtomicBoolean();
+        AlertDialog d = new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                .setTitle("Speed test")
+                .setView(wrap)
+                .setNegativeButton("Cancel", (x, w) -> cancelled.set(true))
+                .setOnCancelListener(x -> cancelled.set(true))
+                .create();
+        d.show();
+        m.run(() -> {
+            try {
+                double mbps = SpeedTest.download(now -> m.onMain(() -> msg.setText(String.format(java.util.Locale.US, "Testing… %.0f Mbps", now))), cancelled);
+                int suggest = SpeedTest.recommendBitrate(mbps);
+                m.onMain(() -> {
+                    d.dismiss();
+                    AlertDialog.Builder b = new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                            .setTitle(String.format(java.util.Locale.US, "%.0f Mbps", mbps))
+                            .setMessage("A bitrate of " + suggest + " Mbps should stream well on this connection. Test again on the Wi-Fi or mobile data you’ll use.");
+                    if (uuidOrNull != null) {
+                        b.setPositiveButton("Use " + suggest + " Mbps", (x, w) -> {
+                            PcPrefs p = PcPrefs.get(a);
+                            JSONObject o = p.streamSettings(uuidOrNull);
+                            p.setStreamSettings(uuidOrNull, put(o == null ? new JSONObject() : o, "bitrateMbps", suggest));
+                            toast(a, "This PC will stream at " + suggest + " Mbps.");
+                        }).setNegativeButton("Close", null);
+                    } else {
+                        b.setPositiveButton("OK", null);
+                    }
+                    if (!a.isFinishing()) b.show();
+                });
+            } catch (IOException e) {
+                m.onMain(() -> {
+                    d.dismiss();
+                    if (!cancelled.get()) toast(a, e.getMessage());
+                });
+            }
+        });
+    }
+
+    // ---- the account ----------------------------------------------------------------------------------------
+
+    private static String dndValue(PcPrefs p) {
+        if (!p.dnd()) return "Off";
+        long u = p.dndUntil();
+        return u == -1 ? "On" : "Until " + DateFormat.getTimeInstance(DateFormat.SHORT).format(new Date(u));
+    }
+
+    public static void account(Activity a, Moonshine m, Runnable changed) {
+        PcPrefs p = PcPrefs.get(a);
+        Sheet s = Sheet.open(a, m.username(), m.hub.isConnected() ? "Signed in and online" : "Signed in. Connecting to Moonshine’s service…", false);
+        s.row(R.drawable.ic_bell_off, "Do not disturb", "Silences messages and game invites", dndValue(p), true, () ->
+                choose(a, "Do not disturb", new String[] { "Off", "For 1 hour", "For 8 hours", "Until I turn it off" },
+                        new String[] { "0", "1", "8", "-1" }, p.dnd() ? (p.dndUntil() == -1 ? "-1" : "") : "0", v -> {
+                            long until = v.equals("-1") ? -1 : v.equals("0") ? 0 : System.currentTimeMillis() + Long.parseLong(v) * 3_600_000L;
+                            p.setDnd(until);
+                            changed.run();
+                        }));
+        s.toggle(R.drawable.ic_bell, "Messages", "Notify me when a friend writes", p.notifyMessages(), p::setNotifyMessages);
+        s.toggle(R.drawable.ic_gamepad, "Game invites", "Notify me when a friend asks me to play", p.notifyInvites(), p::setNotifyInvites);
+        s.toggle(R.drawable.ic_refresh, "Reconnect by itself", "Picks a dropped stream back up", p.autoReconnect(), p::setAutoReconnect);
+        s.row(R.drawable.ic_speed, "Test my speed", "Suggests a stream bitrate", "", true, () -> speedTest(a, m, null));
+        s.row(R.drawable.ic_download, "Updates", "Moonshine " + com.limelight.BuildConfig.VERSION_NAME + " · " + Updates.everyLabel(Updates.every(a)), "", true, () ->
+                choose(a, "Check for updates", new String[] { "Check now", "Every day", "Every 3 days", "Every week", "Every time it opens" },
+                        new String[] { "now", "day", "3days", "week", "launch" }, Updates.every(a), v -> {
+                            if (v.equals("now")) Updates.check(a.getApplicationContext(), true, a);
+                            else Updates.setEvery(a, v);
+                        }));
+        s.button("Sign out", Ui.NEUTRAL, () -> {
+            s.dismiss();
+            new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                    .setTitle("Sign out of Moonshine?")
+                    .setMessage("You can’t connect to your PCs or your friends’ PCs from anywhere until you sign in again.")
+                    .setPositiveButton("Sign out", (d2, w2) -> m.signOut())
+                    .setNegativeButton("Cancel", null)
+                    .show();
+        });
+        s.show();
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Reconnect.java b/app/src/main/java/com/moonshine/Reconnect.java
new file mode 100644
index 00000000..c9eda15d
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Reconnect.java
@@ -0,0 +1,89 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import com.limelight.R;
+
+import java.io.IOException;
+
+/**
+ * A stream that drops by itself is picked up again: up to 5 tries over about 30 seconds, with a "Stop
+ * reconnecting" button. Each try is a fresh stream screen for the same PC and game, so what the PC is
+ * running continues where it was. A stream that held for a while before dropping gets a fresh set of tries.
+ */
+public final class Reconnect {
+    public static final String EXTRA_TRY = "moonshine_reconnect_try";
+    public static final int TRIES = 5;
+    static final int[] WAIT_SECONDS = { 2, 4, 6, 8, 10 };
+    static final long STEADY_MS = 20_000;
+
+    private Reconnect() {}
+
+    /** The number of the next try (1-based), or 0 for none: `current` is the try this stream was (0 = the first stream). */
+    static int next(int current, long ranMs, boolean enabled) {
+        if (!enabled) return 0;
+        if (current == 0 && ranMs <= 0) return 0; // the first stream never got going: that's an error, not a drop
+        if (ranMs >= STEADY_MS) current = 0;      // it was working: a fresh set of tries
+        return current + 1 <= TRIES ? current + 1 : 0;
+    }
+
+    /**
+     * Called by the stream screen when its stream ended without anyone asking. Returns true when a reconnect
+     * has been taken over (the caller then shows no error); false to show the usual error.
+     */
+    public static boolean begin(Activity game, Intent original, long ranMs) {
+        PcPrefs p = PcPrefs.get(game);
+        final int number = next(original.getIntExtra(EXTRA_TRY, 0), ranMs, p.autoReconnect());
+        if (number == 0) return false;
+        final Moonshine m = Moonshine.get(game);
+        final String host = original.getStringExtra("Host");
+        final boolean[] stopped = { false };
+        final Handler ui = new Handler(Looper.getMainLooper());
+
+        TextView msg = Ui.text(game, "", 15, Ui.TEXT, false);
+        msg.setText("Try " + number + " of " + TRIES + ". Reconnecting in " + WAIT_SECONDS[number - 1] + " seconds…");
+        FrameLayout wrap = new FrameLayout(game);
+        wrap.setPadding(Ui.dp(game, 24), Ui.dp(game, 20), Ui.dp(game, 24), Ui.dp(game, 8));
+        wrap.addView(msg);
+        final AlertDialog d = new AlertDialog.Builder(game, R.style.MoonshineDialog)
+                .setTitle("The connection dropped")
+                .setView(wrap)
+                .setCancelable(false)
+                .setNegativeButton("Stop reconnecting", (x, w) -> {
+                    stopped[0] = true;
+                    game.finish();
+                })
+                .create();
+        if (!game.isFinishing()) d.show();
+
+        ui.postDelayed(() -> {
+            if (stopped[0] || game.isFinishing()) return;
+            msg.setText("Reconnecting… (try " + number + " of " + TRIES + ")");
+            m.run(() -> {
+                // A direct connection closes when the stream stops: open it again first
+                if (host != null && com.moonshine.tunnel.Tunnels.isTunnelAddress(host)) {
+                    try {
+                        m.tunnels.ensureFor(host);
+                    } catch (IOException ignored) {
+                        // the next try's own error says what's wrong
+                    }
+                }
+                ui.post(() -> {
+                    if (stopped[0] || game.isFinishing()) return;
+                    Intent again = new Intent(original);
+                    again.putExtra(EXTRA_TRY, number);
+                    d.dismiss();
+                    game.startActivity(again);
+                    game.finish();
+                });
+            });
+        }, WAIT_SECONDS[number - 1] * 1000L);
+        return true;
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Secrets.java b/app/src/main/java/com/moonshine/Secrets.java
new file mode 100644
index 00000000..0da4babf
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Secrets.java
@@ -0,0 +1,91 @@
+package com.moonshine;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.util.Base64;
+
+import java.nio.charset.StandardCharsets;
+import java.security.KeyStore;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Logins (the account's token, a guest token) kept encrypted with a key that never leaves the phone's
+ * keystore, in this app's private storage. On Android 5 (no app keystore keys) they are kept in private
+ * storage only.
+ */
+final class Secrets {
+    private static final String PREFS = "moonshine_secrets";
+    private static final String KEY_ALIAS = "moonshine_secrets_v1";
+
+    private Secrets() {}
+
+    static synchronized void put(Context ctx, String name, String value) {
+        SharedPreferences p = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        if (value == null || value.isEmpty()) {
+            p.edit().remove(name).apply();
+            return;
+        }
+        String stored;
+        try {
+            stored = Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? "k1:" + encrypt(value) : "p0:" + value;
+        } catch (Exception e) {
+            stored = "p0:" + value; // keystore broken on this device: private storage only
+        }
+        p.edit().putString(name, stored).apply();
+    }
+
+    static synchronized String get(Context ctx, String name) {
+        String stored = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(name, "");
+        if (stored.startsWith("p0:")) return stored.substring(3);
+        if (stored.startsWith("k1:") && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            try {
+                return decrypt(stored.substring(3));
+            } catch (Exception e) {
+                return ""; // the key went away (restored to another phone): sign in again
+            }
+        }
+        return "";
+    }
+
+    private static SecretKey key() throws Exception {
+        KeyStore ks = KeyStore.getInstance("AndroidKeyStore");
+        ks.load(null);
+        KeyStore.Entry e = ks.getEntry(KEY_ALIAS, null);
+        if (e instanceof KeyStore.SecretKeyEntry) return ((KeyStore.SecretKeyEntry) e).getSecretKey();
+        KeyGenerator gen = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore");
+        gen.init(new KeyGenParameterSpec.Builder(KEY_ALIAS, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build());
+        return gen.generateKey();
+    }
+
+    private static String encrypt(String text) throws Exception {
+        Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+        c.init(Cipher.ENCRYPT_MODE, key());
+        byte[] iv = c.getIV();
+        byte[] body = c.doFinal(text.getBytes(StandardCharsets.UTF_8));
+        byte[] out = new byte[1 + iv.length + body.length];
+        out[0] = (byte) iv.length;
+        System.arraycopy(iv, 0, out, 1, iv.length);
+        System.arraycopy(body, 0, out, 1 + iv.length, body.length);
+        return Base64.encodeToString(out, Base64.NO_WRAP);
+    }
+
+    private static String decrypt(String stored) throws Exception {
+        byte[] all = Base64.decode(stored, Base64.NO_WRAP);
+        int ivLen = all[0] & 0xff;
+        Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+        c.init(Cipher.DECRYPT_MODE, key(), new GCMParameterSpec(128, all, 1, ivLen));
+        byte[] text = c.doFinal(all, 1 + ivLen, all.length - 1 - ivLen);
+        return new String(text, StandardCharsets.UTF_8);
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Service.java b/app/src/main/java/com/moonshine/Service.java
new file mode 100644
index 00000000..b64490e1
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Service.java
@@ -0,0 +1,133 @@
+package com.moonshine;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * Moonshine's friends service (a Cloudflare Worker, the same one the desktop app uses): sign-in, friends,
+ * presence, the live link and direct connections. Video never goes through it; it only helps devices find
+ * each other. Every call is HTTPS to one fixed address.
+ */
+public final class Service {
+    public static final String URL = "https://moonshine.moonshine-streaming.workers.dev";
+
+    private static final MediaType JSON = MediaType.get("application/json; charset=utf-8");
+    private static final int MAX_RESPONSE = 1024 * 1024;
+
+    /**
+     * Overridable for tests (a local stand-in for the service). Debug builds only also take one from
+     * `adb shell setprop debug.moonshine.service http://10.0.2.2:8787`; release builds always use URL.
+     */
+    static String base = debugOverride();
+
+    private static String debugOverride() {
+        if (!com.limelight.BuildConfig.DEBUG) return URL;
+        try {
+            Object v = Class.forName("android.os.SystemProperties").getMethod("get", String.class).invoke(null, "debug.moonshine.service");
+            String s = v == null ? "" : v.toString().trim();
+            if (s.matches("^https?://[A-Za-z0-9.-]{1,253}(:\\d{1,5})?$")) return s;
+        } catch (Throwable ignored) {
+            // not on a phone (tests)
+        }
+        return URL;
+    }
+
+    static final OkHttpClient http = new OkHttpClient.Builder()
+            .connectTimeout(8, TimeUnit.SECONDS)
+            .readTimeout(8, TimeUnit.SECONDS)
+            .writeTimeout(8, TimeUnit.SECONDS)
+            .pingInterval(0, TimeUnit.SECONDS)
+            .build();
+
+    /** The service said no: its message is in getMessage(), the HTTP status in {@link #status}. */
+    public static class ServiceException extends IOException {
+        public final int status;
+
+        ServiceException(int status, String message) {
+            super(message);
+            this.status = status;
+        }
+    }
+
+    /** Called when the service no longer knows this device's login (signed out elsewhere). */
+    interface LoginLost {
+        /** `token`: the login the service turned down (the account's, or an invite's). */
+        void onLoginLost(String token);
+    }
+
+    static LoginLost loginLost = null;
+
+    private Service() {}
+
+    /**
+     * One call. `token` is the login to use (the account's, or a guest's from an invite link), or null.
+     * Blocking: never call on the main thread.
+     */
+    public static JSONObject call(String method, String path, JSONObject body, String token) throws IOException {
+        Request.Builder rb = new Request.Builder().url(base + path);
+        if (token != null && !token.isEmpty()) rb.header("Authorization", "Bearer " + token);
+        if (body != null) rb.method(method, RequestBody.create(body.toString(), JSON));
+        else if ("POST".equals(method)) rb.method(method, RequestBody.create("{}", JSON));
+        else rb.method(method, null);
+
+        try (Response res = http.newCall(rb.build()).execute()) {
+            JSONObject json = null;
+            ResponseBody rbody = res.body();
+            if (rbody != null) {
+                String text = readCapped(rbody);
+                try {
+                    json = new JSONObject(text);
+                } catch (JSONException ignored) {
+                    // not JSON
+                }
+            }
+            if (!res.isSuccessful()) {
+                if (res.code() == 401 && token != null && !path.startsWith("/auth/poll") && loginLost != null) {
+                    loginLost.onLoginLost(token);
+                }
+                String msg = json != null ? json.optString("error", "") : "";
+                throw new ServiceException(res.code(), msg.isEmpty() ? "Moonshine's service answered " + res.code() : msg);
+            }
+            return json != null ? json : new JSONObject();
+        }
+    }
+
+    /** A picture (this account's or an accepted friend's), or null. */
+    public static byte[] avatar(String username, String token) {
+        Request req = new Request.Builder()
+                .url(base + "/friends/avatar?username=" + android.net.Uri.encode(username))
+                .header("Authorization", "Bearer " + token)
+                .build();
+        try (Response res = http.newCall(req).execute()) {
+            ResponseBody b = res.body();
+            String type = res.header("Content-Type", "");
+            if (!res.isSuccessful() || b == null || type == null || !type.matches("image/(png|jpeg|webp|gif).*")) return null;
+            if (b.contentLength() > 512 * 1024) return null;
+            okio.BufferedSource src = b.source();
+            src.request(512 * 1024 + 1);
+            if (src.getBuffer().size() > 512 * 1024) return null;
+            return src.readByteArray();
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private static String readCapped(ResponseBody body) throws IOException {
+        long len = body.contentLength();
+        if (len > MAX_RESPONSE) throw new IOException("The answer from Moonshine's service was too large");
+        okio.BufferedSource src = body.source();
+        src.request(MAX_RESPONSE + 1);
+        if (src.getBuffer().size() > MAX_RESPONSE) throw new IOException("The answer from Moonshine's service was too large");
+        return src.readUtf8();
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Sheet.java b/app/src/main/java/com/moonshine/Sheet.java
new file mode 100644
index 00000000..c03fd04f
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Sheet.java
@@ -0,0 +1,236 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+
+/**
+ * A rounded sheet from the bottom of the screen, in Moonshine's glass style: a title, then rows with a
+ * round icon chip, a label, and a chevron, a value or a switch. Used for a PC's options, the account
+ * sheet and the in-stream menu.
+ */
+public final class Sheet {
+    public interface Toggled {
+        void on(boolean checked);
+    }
+
+    private final Context a;
+    private final Dialog dialog;
+    private final LinearLayout list;
+
+    private Sheet(Context a, Dialog d, LinearLayout list) {
+        this.a = a;
+        this.dialog = d;
+        this.list = list;
+    }
+
+    /** `blur` blurs the picture behind the sheet (Android 12+), for a sheet over the stream. */
+    public static Sheet open(Context a, String title, String subtitle, boolean blur) {
+        final Dialog d = new Dialog(a);
+        d.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        LinearLayout panel = new LinearLayout(a);
+        panel.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(blur ? Ui.GLASS : 0xFF1A1421);
+        float r = Ui.dp(a, 28);
+        bg.setCornerRadii(new float[] { r, r, r, r, 0, 0, 0, 0 });
+        bg.setStroke(Math.max(1, Ui.dp(a, 1)), Ui.STROKE);
+        panel.setBackground(bg);
+        panel.setPadding(Ui.dp(a, 8), Ui.dp(a, 10), Ui.dp(a, 8), Ui.dp(a, 12));
+
+        View handle = new View(a);
+        handle.setBackground(Ui.shape(a, 0x40FFFFFF, 0, 3));
+        LinearLayout.LayoutParams hp = new LinearLayout.LayoutParams(Ui.dp(a, 40), Ui.dp(a, 4));
+        hp.gravity = Gravity.CENTER_HORIZONTAL;
+        hp.bottomMargin = Ui.dp(a, 12);
+        panel.addView(handle, hp);
+
+        if (title != null) {
+            TextView t = Ui.text(a, title, 20, Ui.TEXT, true);
+            t.setPadding(Ui.dp(a, 14), 0, Ui.dp(a, 14), 0);
+            panel.addView(t);
+            if (subtitle != null && !subtitle.isEmpty()) {
+                TextView s = Ui.text(a, subtitle, 13, Ui.MUTED, false);
+                s.setPadding(Ui.dp(a, 14), Ui.dp(a, 2), Ui.dp(a, 14), 0);
+                panel.addView(s);
+            }
+        }
+        LinearLayout list = new LinearLayout(a);
+        list.setOrientation(LinearLayout.VERTICAL);
+        list.setPadding(0, Ui.dp(a, 8), 0, 0);
+        ScrollView scroll = new ScrollView(a);
+        scroll.addView(list);
+        panel.addView(scroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        d.setContentView(panel);
+
+        Window w = d.getWindow();
+        if (w != null) {
+            Ui.glassWindow(d, blur);
+            w.setGravity(Gravity.BOTTOM);
+            w.setLayout(WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.WRAP_CONTENT);
+            WindowManager.LayoutParams lp = w.getAttributes();
+            lp.horizontalMargin = 0;
+            w.setAttributes(lp);
+        }
+        // Keep the last row clear of the gesture bar
+        panel.setOnApplyWindowInsetsListener((v, insets) -> {
+            int bottom = android.os.Build.VERSION.SDK_INT >= 30
+                    ? insets.getInsets(android.view.WindowInsets.Type.systemBars()).bottom
+                    : insets.getSystemWindowInsetBottom();
+            v.setPadding(v.getPaddingLeft(), v.getPaddingTop(), v.getPaddingRight(), Ui.dp(a, 12) + bottom);
+            return insets;
+        });
+        return new Sheet(a, d, list);
+    }
+
+    public Dialog dialog() {
+        return dialog;
+    }
+
+    public void show() {
+        if (!(a instanceof Activity) || !((Activity) a).isFinishing()) dialog.show();
+    }
+
+    public void dismiss() {
+        dialog.dismiss();
+    }
+
+    public LinearLayout list() {
+        return list;
+    }
+
+    private LinearLayout baseRow(int icon, String title, String detail, boolean active) {
+        LinearLayout r = new LinearLayout(a);
+        r.setOrientation(LinearLayout.HORIZONTAL);
+        r.setGravity(Gravity.CENTER_VERTICAL);
+        r.setPadding(Ui.dp(a, 12), Ui.dp(a, 10), Ui.dp(a, 12), Ui.dp(a, 10));
+        r.setBackground(Ui.ripple(Ui.shape(a, 0, 0, 16)));
+        r.addView(Ui.chip(a, icon, 40, active));
+        LinearLayout t = new LinearLayout(a);
+        t.setOrientation(LinearLayout.VERTICAL);
+        t.addView(Ui.text(a, title, 16, Ui.TEXT, true));
+        if (detail != null && !detail.isEmpty()) {
+            TextView d = Ui.text(a, detail, 13, Ui.MUTED, false);
+            t.addView(d);
+        }
+        LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        tp.leftMargin = Ui.dp(a, 14);
+        r.addView(t, tp);
+        list.addView(r, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return r;
+    }
+
+    /** A row that does something: tap it. `value` is shown on the right (like "2.5x"); empty shows a chevron. */
+    public Sheet row(int icon, String title, String detail, String value, boolean closes, Runnable onClick) {
+        LinearLayout r = baseRow(icon, title, detail, false);
+        if (value != null && !value.isEmpty()) {
+            r.addView(Ui.badge(a, value, Ui.ACCENT));
+        } else {
+            ImageView c = new ImageView(a);
+            c.setImageResource(com.limelight.R.drawable.ic_chevron);
+            c.setColorFilter(Ui.MUTED);
+            r.addView(c, new LinearLayout.LayoutParams(Ui.dp(a, 20), Ui.dp(a, 20)));
+        }
+        r.setOnClickListener(v -> {
+            if (closes) dialog.dismiss();
+            onClick.run();
+        });
+        return this;
+    }
+
+    /** A row with a switch. */
+    public Sheet toggle(int icon, String title, String detail, boolean checked, Toggled onChange) {
+        LinearLayout r = baseRow(icon, title, detail, checked);
+        final View sw = Ui.toggle(a, checked);
+        r.addView(sw);
+        final boolean[] state = { checked };
+        r.setOnClickListener(v -> {
+            state[0] = !state[0];
+            Ui.setToggle(sw, state[0]);
+            ((FrameLayout) r.getChildAt(0)).setBackground(Ui.circle(a, state[0] ? Ui.TONAL_STRONG : Ui.CARD_HIGH, 0));
+            onChange.on(state[0]);
+        });
+        return this;
+    }
+
+    /** A slider row: `min`..`max` in `steps` steps, `format` turns the value into words. */
+    public interface Format {
+        String of(float v);
+    }
+
+    public interface Changed {
+        void to(float v);
+    }
+
+    public Sheet slider(int icon, String title, float min, float max, int steps, float value, Format format, Changed onDone) {
+        LinearLayout r = baseRow(icon, title, null, true);
+        LinearLayout t = (LinearLayout) r.getChildAt(1);
+        final TextView v = Ui.badge(a, format.of(value), Ui.ACCENT);
+        r.addView(v);
+        SeekBar s = new SeekBar(a);
+        s.setMax(steps);
+        s.setProgress(Math.round((value - min) / (max - min) * steps));
+        s.setProgressTintList(ColorStateList.valueOf(Ui.ACCENT));
+        s.setThumbTintList(ColorStateList.valueOf(Ui.ACCENT));
+        s.setProgressBackgroundTintList(ColorStateList.valueOf(0x40FFFFFF));
+        s.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar sb, int p, boolean fromUser) {
+                v.setText(format.of(min + (max - min) * p / steps));
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar sb) {
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar sb) {
+                onDone.to(min + (max - min) * sb.getProgress() / steps);
+            }
+        });
+        t.addView(s, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return this;
+    }
+
+    /** Tint the icon chip of the row just added (a warning colour for a destructive action). */
+    public Sheet tintLast(int color) {
+        View r = list.getChildAt(list.getChildCount() - 1);
+        if (r instanceof LinearLayout && ((LinearLayout) r).getChildAt(0) instanceof FrameLayout) {
+            FrameLayout chip = (FrameLayout) ((LinearLayout) r).getChildAt(0);
+            chip.setBackground(Ui.circle(a, (color & 0x00FFFFFF) | 0x33000000, 0));
+            ((ImageView) chip.getChildAt(0)).setColorFilter(color);
+        }
+        return this;
+    }
+
+    /** A line of explanation between rows. */
+    public Sheet note(String s) {
+        TextView t = Ui.text(a, s, 13, Ui.MUTED, false);
+        t.setPadding(Ui.dp(a, 14), Ui.dp(a, 8), Ui.dp(a, 14), Ui.dp(a, 4));
+        list.addView(t);
+        return this;
+    }
+
+    public Sheet button(String label, int style, Runnable onClick) {
+        android.widget.Button b = Ui.pill(a, label, style, v -> onClick.run());
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Ui.dp(a, 46));
+        lp.topMargin = Ui.dp(a, 10);
+        lp.leftMargin = Ui.dp(a, 6);
+        lp.rightMargin = Ui.dp(a, 6);
+        list.addView(b, lp);
+        return this;
+    }
+}
