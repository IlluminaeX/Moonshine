+    /** A profile picture inside a ring: green when the person is online, grey offline, red on do not disturb. */
+    private View statusAvatar(String username, int sizeDp, boolean online, boolean dnd) {
+        FrameLayout f = new FrameLayout(this);
+        int ring = dnd && online ? RING_DND : online ? ONLINE : RING_OFFLINE;
+        GradientDrawable g = new GradientDrawable();
+        g.setShape(GradientDrawable.OVAL);
+        g.setColor(0);
+        g.setStroke(Math.max(2, dp(sizeDp > 36 ? 3 : 2)), ring);
+        f.setBackground(g);
+        int pad = dp(sizeDp > 36 ? 5 : 4);
+        f.setPadding(pad, pad, pad, pad);
+        f.addView(avatar(username, sizeDp), new FrameLayout.LayoutParams(dp(sizeDp), dp(sizeDp)));
+        f.setLayoutParams(new LinearLayout.LayoutParams(dp(sizeDp) + 2 * pad, dp(sizeDp) + 2 * pad));
+        f.setContentDescription(dnd && online ? "Do not disturb" : online ? "Online" : "Offline");
+        return f;
+    }
+
+    private ImageView avatar(String username, int sizeDp) {
+        ImageView iv = new ImageView(this);
+        iv.setLayoutParams(new LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp)));
+        Bitmap b;
+        synchronized (avatars) {
+            b = avatars.get(username.toLowerCase());
+        }
+        if (b != null) {
+            RoundedBitmapDrawable d = RoundedBitmapDrawableFactory.create(getResources(), b);
+            d.setCircular(true);
+            iv.setImageDrawable(d);
+        } else {
+            GradientDrawable circle = new GradientDrawable();
+            circle.setShape(GradientDrawable.OVAL);
+            circle.setColor(SURFACE_HIGH);
+            iv.setImageDrawable(circle);
+            loadAvatar(username);
+        }
+        return iv;
+    }
+
+    private void loadAvatar(String username) {
+        final String key = username.toLowerCase();
+        synchronized (avatars) {
+            if (!avatarsAsked.add(key)) return;
+        }
+        final String token = m.token();
+        m.run(() -> {
+            byte[] data = Service.avatar(username, token);
+            if (data == null) return;
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeByteArray(data, 0, data.length, o);
+            if (o.outWidth <= 0 || o.outWidth > 1024 || o.outHeight > 1024) return; // a picture, and a small one
+            Bitmap b = BitmapFactory.decodeByteArray(data, 0, data.length);
+            if (b == null) return;
+            synchronized (avatars) {
+                avatars.put(key, b);
+            }
+            runOnUiThread(this::render);
+        });
+    }
