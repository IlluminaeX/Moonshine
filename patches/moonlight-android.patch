+    public boolean isMyPc(String hostUuid) {
+        JSONArray mine = myPcs();
+        for (int i = 0; i < mine.length(); i++) {
+            JSONObject pc = mine.optJSONObject(i);
+            if (pc != null && hostUuid.equals(pc.optString("hostUuid"))) return true;
+        }
+        return false;
+    }
+
+    public JSONObject friendPc(String hostUuid) {
+        JSONObject f = friends;
+        JSONArray list = f != null ? f.optJSONArray("friends") : null;
+        JSONArray mine = myPcs();
+        for (int j = 0; j < mine.length(); j++) {
+            JSONObject pc = mine.optJSONObject(j);
+            if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) {
+                try {
+                    return new JSONObject(pc.toString()).put("username", username());
+                } catch (JSONException e) {
+                    return pc;
+                }
+            }
+        }
+        if (list == null) return null;
+        for (int i = 0; i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend == null || !"accepted".equals(friend.optString("status"))) continue;
+            JSONArray pcs = friend.optJSONArray("pcs");
+            for (int j = 0; pcs != null && j < pcs.length(); j++) {
+                JSONObject pc = pcs.optJSONObject(j);
+                if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) {
+                    try {
+                        return new JSONObject(pc.toString()).put("username", friend.optString("username"));
+                    } catch (JSONException e) {
+                        return pc;
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
+    /** How to ask for a direct connection to this PC (an invite's or a friend's), or null. */
+    Tunnels.Target targetFor(String hostUuid) {
+        JSONObject g = guestInvite();
+        if (g != null) {
+            JSONObject host = g.optJSONObject("host");
+            if (host != null && hostUuid.equals(host.optString("uuid"))) {
+                return new Tunnels.Target(hostUuid, host.optLong("device"), host.optInt("port", 47989), host.optString("name"), ensureGuestHub(), guestToken());
+            }
+        }
+        if (!signedIn()) return null;
+        if (friends == null || System.currentTimeMillis() - friendsAt > FRIENDS_FRESH_MS) {
+            try {
+                friends = Service.call("GET", "/friends", null, token());
+                friendsAt = System.currentTimeMillis();
+            } catch (IOException ignored) {
+                // use what's cached
+            }
+        }
+        JSONObject pc = friendPc(hostUuid);
+        if (pc == null || !pc.optBoolean("tunnel") || pc.optLong("device") <= 0) return null;
+        return new Tunnels.Target(hostUuid, pc.optLong("device"), pc.optInt("port", 47989), pc.optString("name"), hub, token());
+    }
+
+    /**
+     * Before the PC list polls a friend's PC saved at a stand-in address: reopen its direct connection if it
+     * closed and the friend is hosting (at most every two minutes per PC). Blocking.
+     */
+    public void beforePoll(ComputerDetails details) {
+        String address = null;
+        for (ComputerDetails.AddressTuple t : new ComputerDetails.AddressTuple[] { details.manualAddress, details.localAddress, details.remoteAddress }) {
+            if (t != null && Tunnels.isTunnelAddress(t.address)) address = t.address;
+        }
+        if (address == null || started == 0) return;
+        String hostUuid = tunnels.hostFor(address);
+        if (hostUuid == null || tunnels.isOpen(hostUuid)) return;
+        synchronized (reopenTried) {
+            Long last = reopenTried.get(hostUuid);
+            if (last != null && System.currentTimeMillis() - last < REOPEN_EVERY_MS) return;
+            reopenTried.put(hostUuid, System.currentTimeMillis());
+        }
+        try {
+            tunnels.ensureFor(address);
+        } catch (IOException ignored) {
+            // shown offline
+        }
+    }
+
+    /** A stream is using this address (or "" when it ended): its tunnel never closes as idle meanwhile. */
+    public void setActiveStream(String address) {
+        activeStream = address == null ? "" : address;
+    }
