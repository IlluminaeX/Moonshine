new file mode 100644
index 00000000..7ad503cc
--- /dev/null
+++ b/app/src/main/java/com/moonshine/SpeedTest.java
@@ -0,0 +1,84 @@
+package com.moonshine;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+
+/**
+ * A quick download speed test (Cloudflare's free speed test servers), like the desktop app's: a few
+ * connections for a few seconds, only the speed is kept. Used to suggest a stream bitrate.
+ */
+public final class SpeedTest {
+    public interface Progress {
+        void mbps(double now);
+    }
+
+    private static final String URL = "https://speed.cloudflare.com/__down?bytes=50000000";
+    private static final int PARALLEL = 4;
+    private static final long DURATION_MS = 6000;
+    private static final long WARMUP_MS = 1000;
+
+    private SpeedTest() {}
+
+    /** Megabits per second, after a one second warm-up. Blocking. */
+    public static double download(Progress progress, AtomicBoolean cancelled) throws IOException {
+        final OkHttpClient client = Service.http.newBuilder().readTimeout(10, TimeUnit.SECONDS).callTimeout(0, TimeUnit.MILLISECONDS).build();
+        final long start = System.currentTimeMillis();
+        final AtomicLong counted = new AtomicLong();
+        final IOException[] failure = new IOException[1];
+        Thread[] workers = new Thread[PARALLEL];
+        for (int i = 0; i < PARALLEL; i++) {
+            workers[i] = new Thread(() -> {
+                byte[] buf = new byte[64 * 1024];
+                while (System.currentTimeMillis() - start < DURATION_MS && !cancelled.get()) {
+                    try (Response r = client.newCall(new Request.Builder().url(URL).header("Cache-Control", "no-store").build()).execute()) {
+                        if (!r.isSuccessful() || r.body() == null) throw new IOException("The speed test server answered " + r.code() + ".");
+                        InputStream in = r.body().byteStream();
+                        int n;
+                        while ((n = in.read(buf)) > 0) {
+                            if (System.currentTimeMillis() - start >= WARMUP_MS) counted.addAndGet(n);
+                            if (System.currentTimeMillis() - start >= DURATION_MS || cancelled.get()) break;
+                        }
+                    } catch (IOException e) {
+                        synchronized (failure) {
+                            if (failure[0] == null) failure[0] = e;
+                        }
+                        return;
+                    }
+                }
+            }, "Moonshine speed test");
+            workers[i].setDaemon(true);
+            workers[i].start();
+        }
+        try {
+            while (System.currentTimeMillis() - start < DURATION_MS + 300 && !cancelled.get()) {
+                Thread.sleep(400);
+                if (progress != null) progress.mbps(mbps(counted.get(), start));
+            }
+            for (Thread w : workers) w.join(1500);
+        } catch (InterruptedException e) {
+            throw new IOException("Cancelled.");
+        }
+        if (cancelled.get()) throw new IOException("Cancelled.");
+        double result = mbps(counted.get(), start);
+        if (result <= 0.01 && failure[0] != null) throw new IOException("Couldn’t run the speed test. Check your internet connection.");
+        return result;
+    }
+
+    private static double mbps(long bytes, long start) {
+        double seconds = Math.max(0.001, (System.currentTimeMillis() - start - WARMUP_MS) / 1000.0);
+        return (bytes * 8) / seconds / 1e6;
+    }
+
+    /** A bitrate to suggest for this much download speed: about 70%, in steps of 5, from 5 to 150 Mbps. */
+    public static int recommendBitrate(double downMbps) {
+        int steps = (int) Math.floor(downMbps * 0.7 / 5);
+        return Math.max(5, Math.min(150, steps * 5));
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Ui.java b/app/src/main/java/com/moonshine/Ui.java
new file mode 100644
index 00000000..3b92670f
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Ui.java
@@ -0,0 +1,243 @@
+package com.moonshine;
+
+import android.app.Dialog;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Typeface;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.RippleDrawable;
+import android.os.Build;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Moonshine's look for the Android app, in one place: warm dark plum surfaces with a thin rose-tinted
+ * outline, big radii, tonal pills and circular icon chips. Kept in step with the Windows palette.
+ */
+public final class Ui {
+    public static final int BG = 0xFF0E0A14;
+    public static final int CARD = 0xFF1E1726;
+    public static final int CARD_HIGH = 0xFF2B2134;
+    public static final int STROKE = 0xFF3D2C40;
+    public static final int TEXT = 0xFFF7F1F3;
+    public static final int MUTED = 0xFFB6A6BD;
+    public static final int ACCENT = 0xFFF0708C;
+    public static final int BUTTON = 0xFFD6405F;
+    public static final int ONLINE = 0xFF4ADE80;
+    public static final int TONAL = 0x33F0708C;       // accent at 20%
+    public static final int TONAL_STRONG = 0x59F0708C; // accent at 35%
+    public static final int GLASS = 0xE61C1523;        // the floating bar: plum, a little see-through
+
+    private Ui() {}
+
+    public static int dp(Context c, float v) {
+        return Math.round(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.getResources().getDisplayMetrics()));
+    }
+
+    public static GradientDrawable shape(Context c, int fill, int stroke, float radiusDp) {
+        GradientDrawable g = new GradientDrawable();
+        g.setColor(fill);
+        g.setCornerRadius(dp(c, radiusDp));
+        if (stroke != 0) g.setStroke(Math.max(1, dp(c, 1)), stroke);
+        return g;
+    }
+
+    public static GradientDrawable circle(Context c, int fill, int stroke) {
+        GradientDrawable g = new GradientDrawable();
+        g.setShape(GradientDrawable.OVAL);
+        g.setColor(fill);
+        if (stroke != 0) g.setStroke(Math.max(1, dp(c, 1)), stroke);
+        return g;
+    }
+
+    /** A drawable with a light ripple on press. */
+    public static android.graphics.drawable.Drawable ripple(android.graphics.drawable.Drawable base) {
+        return new RippleDrawable(ColorStateList.valueOf(0x33FFFFFF), base, null);
+    }
+
+    public static TextView text(Context c, String s, int sp, int color, boolean bold) {
+        TextView t = new TextView(c);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        return t;
+    }
+
+    /** A rounded, outlined container. Margins are left to the caller. */
+    public static LinearLayout card(Context c) {
+        LinearLayout l = new LinearLayout(c);
+        l.setOrientation(LinearLayout.VERTICAL);
+        l.setBackground(shape(c, CARD, STROKE, 20));
+        l.setPadding(dp(c, 16), dp(c, 14), dp(c, 16), dp(c, 14));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.bottomMargin = dp(c, 12);
+        l.setLayoutParams(lp);
+        return l;
+    }
+
+    /** A circle with a tonal fill and an icon: the little badge at the start of a row. */
+    public static FrameLayout chip(Context c, int icon, int sizeDp, boolean active) {
+        FrameLayout f = new FrameLayout(c);
+        f.setBackground(circle(c, active ? TONAL_STRONG : CARD_HIGH, 0));
+        ImageView iv = new ImageView(c);
+        iv.setImageResource(icon);
+        iv.setColorFilter(active ? ACCENT : MUTED);
+        int pad = dp(c, sizeDp * 0.26f);
+        f.addView(iv, new FrameLayout.LayoutParams(dp(c, sizeDp) - 2 * pad, dp(c, sizeDp) - 2 * pad, Gravity.CENTER));
+        f.setLayoutParams(new LinearLayout.LayoutParams(dp(c, sizeDp), dp(c, sizeDp)));
+        return f;
+    }
+
+    public static final int PRIMARY = 0, TONALPILL = 1, NEUTRAL = 2;
+
+    /** A pill button: filled crimson, tonal rose, or quiet. */
+    public static Button pill(Context c, String label, int style, View.OnClickListener onClick) {
+        Button b = new Button(c);
+        b.setText(label);
+        b.setAllCaps(false);
+        b.setTypeface(Typeface.DEFAULT_BOLD);
+        b.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        b.setStateListAnimator(null);
+        b.setElevation(0);
+        int fill = style == PRIMARY ? BUTTON : style == TONALPILL ? TONAL : CARD_HIGH;
+        b.setTextColor(style == PRIMARY ? 0xFFFFFFFF : style == TONALPILL ? ACCENT : TEXT);
+        b.setBackground(ripple(shape(c, fill, 0, 22)));
+        b.setPadding(dp(c, 18), 0, dp(c, 18), 0);
+        b.setMinHeight(dp(c, 40));
+        b.setMinimumHeight(dp(c, 40));
+        b.setMinWidth(0);
+        b.setMinimumWidth(0);
+        b.setOnClickListener(onClick);
+        return b;
+    }
+
+    /** A round icon button (the header's profile, "more", the send arrow). */
+    public static ImageView circleButton(Context c, int icon, boolean primary, int sizeDp, View.OnClickListener onClick) {
+        ImageView iv = new ImageView(c);
+        iv.setImageResource(icon);
+        iv.setColorFilter(primary ? 0xFFFFFFFF : TEXT);
+        int pad = dp(c, sizeDp * 0.27f);
+        iv.setPadding(pad, pad, pad, pad);
+        iv.setBackground(ripple(circle(c, primary ? BUTTON : CARD_HIGH, 0)));
+        iv.setLayoutParams(new LinearLayout.LayoutParams(dp(c, sizeDp), dp(c, sizeDp)));
+        iv.setOnClickListener(onClick);
+        return iv;
+    }
+
+    /** A small tonal pill with a word or two (a connection kind, a count). */
+    public static TextView badge(Context c, String s, int color) {
+        TextView t = text(c, s, 11, color, true);
+        t.setBackground(shape(c, (color & 0x00FFFFFF) | 0x26000000, 0, 10));
+        t.setPadding(dp(c, 8), dp(c, 2), dp(c, 8), dp(c, 2));
+        t.setSingleLine(true);
+        return t;
+    }
+
+    /** A small coloured dot (online / offline). */
+    public static View dot(Context c, int color, int sizeDp) {
+        View v = new View(c);
+        v.setBackground(circle(c, color, 0));
+        v.setLayoutParams(new LinearLayout.LayoutParams(dp(c, sizeDp), dp(c, sizeDp)));
+        return v;
+    }
+
+    /** A thin line between rows inside a card. */
+    public static View hairline(Context c) {
+        View v = new View(c);
+        v.setBackgroundColor(0x1FFFFFFF);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Math.max(1, dp(c, 1) / 2));
+        lp.topMargin = dp(c, 10);
+        lp.bottomMargin = dp(c, 10);
+        v.setLayoutParams(lp);
+        return v;
+    }
+
+    /** A filled, rounded field with an icon at the start. Returns the container; the EditText is its tag. */
+    public static LinearLayout filledField(Context c, String hint, int icon) {
+        LinearLayout box = new LinearLayout(c);
+        box.setOrientation(LinearLayout.HORIZONTAL);
+        box.setGravity(Gravity.CENTER_VERTICAL);
+        box.setBackground(shape(c, CARD_HIGH, STROKE, 26));
+        box.setPadding(dp(c, 16), 0, dp(c, 8), 0);
+        ImageView iv = new ImageView(c);
+        iv.setImageResource(icon);
+        iv.setColorFilter(MUTED);
+        box.addView(iv, new LinearLayout.LayoutParams(dp(c, 20), dp(c, 20)));
+        EditText e = new EditText(c);
+        e.setHint(hint);
+        e.setTextColor(TEXT);
+        e.setHintTextColor(MUTED);
+        e.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        e.setSingleLine(true);
+        e.setBackground(null);
+        e.setPadding(dp(c, 12), dp(c, 14), dp(c, 8), dp(c, 14));
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        box.addView(e, lp);
+        box.setTag(e);
+        return box;
+    }
+
+    public static EditText fieldOf(LinearLayout filledField) {
+        return (EditText) filledField.getTag();
+    }
+
+    /** Dialogs and sheets: plum, outlined, and on Android 12+ the picture behind is blurred (the glass). */
+    public static void glassWindow(Dialog d, boolean blurBehind) {
+        Window w = d.getWindow();
+        if (w == null) return;
+        w.setBackgroundDrawable(new ColorDrawable(0));
+        if (blurBehind && Build.VERSION.SDK_INT >= 31) {
+            w.addFlags(WindowManager.LayoutParams.FLAG_BLUR_BEHIND);
+            WindowManager.LayoutParams lp = w.getAttributes();
+            lp.setBlurBehindRadius(40);
+            w.setAttributes(lp);
+        }
+        w.setDimAmount(0.45f);
+    }
+
+    /** A switch in the app's look: a pill track and a round thumb that carries a check when it is on. */
+    public static View toggle(Context c, boolean on) {
+        FrameLayout f = new FrameLayout(c);
+        ImageView thumb = new ImageView(c);
+        thumb.setImageResource(com.limelight.R.drawable.ic_check);
+        int pad = dp(c, 5);
+        thumb.setPadding(pad, pad, pad, pad);
+        FrameLayout.LayoutParams tp = new FrameLayout.LayoutParams(dp(c, 24), dp(c, 24));
+        tp.topMargin = dp(c, 4);
+        f.addView(thumb, tp);
+        f.setLayoutParams(new LinearLayout.LayoutParams(dp(c, 52), dp(c, 32)));
+        setToggle(f, on);
+        return f;
+    }
+
+    public static void setToggle(View toggle, boolean on) {
+        FrameLayout f = (FrameLayout) toggle;
+        Context c = f.getContext();
+        ImageView thumb = (ImageView) f.getChildAt(0);
+        f.setBackground(shape(c, on ? BUTTON : CARD_HIGH, on ? 0 : 0x66FFFFFF, 16));
+        thumb.setBackground(circle(c, on ? 0xFFFFFFFF : 0xFF8F7F96, 0));
+        thumb.setColorFilter(on ? BUTTON : 0x00000000);
+        FrameLayout.LayoutParams tp = (FrameLayout.LayoutParams) thumb.getLayoutParams();
+        tp.gravity = on ? Gravity.END : Gravity.START;
+        tp.leftMargin = on ? 0 : dp(c, 4);
+        tp.rightMargin = on ? dp(c, 4) : 0;
+        thumb.setLayoutParams(tp);
+    }
+
+    /** Space for the floating bar at the bottom of a list, so the last row isn't hidden behind it. */
+    public static int barSpace(Context c) {
+        return dp(c, 96);
+    }
+}
diff --git a/app/src/main/java/com/moonshine/Updates.java b/app/src/main/java/com/moonshine/Updates.java
new file mode 100644
index 00000000..bde5a103
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Updates.java
@@ -0,0 +1,445 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.core.content.FileProvider;
+
+import com.limelight.BuildConfig;
+import com.limelight.R;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.Arrays;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * Moonshine updates itself, like the PC app: shortly after it opens, and then as often as the update
+ * setting says (every day, 3 days, week, or each time it opens), it looks at Moonshine's latest GitHub
+ * release. A newer one that carries the Android app is offered; on Update it is downloaded with a progress
+ * bar, checked (it must be Moonshine, signed with the same key, and match the release's checksum), and
+ * handed to Android's installer, which asks for one tap. A new version installs over the old one and keeps
+ * saved PCs and settings.
+ */
+public final class Updates {
+    static final String LATEST = "https://api.github.com/repos/IlluminaeX/Moonshine/releases/latest";
+    static final String RELEASES_PAGE = "https://github.com/IlluminaeX/Moonshine/releases/";
+    static final String DOWNLOADS = "https://github.com/IlluminaeX/Moonshine/releases/download/";
+    /** Where downloads must come from; only tests point it somewhere else. */
+    static String downloadsFrom = DOWNLOADS;
+    static final String ASSET = "Moonshine-Android.apk";
+    private static final long FIRST_CHECK_MS = 3_000;
+    private static final long TICK_MS = 60 * 60 * 1000;
+    private static final long MAX_APK = 200L * 1024 * 1024;
+
+    /** A release that is newer than this app and carries the Android app. */
+    public static final class Found {
+        public final String version;
+        public final String page;
+        public final String url;
+        public final long size;
+        public final String sha256; // lower-case hex, or empty when the release doesn't say
+
+        Found(String version, String page, String url, long size, String sha256) {
+            this.version = version;
+            this.page = page;
+            this.url = url;
+            this.size = size;
+            this.sha256 = sha256;
+        }
+    }
+
+    private static Found waiting;     // found, not yet answered (nobody was looking at the app)
+    private static File downloaded;   // downloaded and checked, waiting for "install unknown apps" to be allowed
+    private static boolean started;
+    private static boolean asking;
+
+    private Updates() {}
+
+    // ---- the schedule ---------------------------------------------------------------------------------
+
+    private static SharedPreferences prefs(Context c) {
+        return c.getApplicationContext().getSharedPreferences("moonshine", Context.MODE_PRIVATE);
+    }
+
+    /** day, 3days, week or launch. */
+    public static String every(Context c) {
+        String e = prefs(c).getString("updateEvery", "day");
+        return e.equals("3days") || e.equals("week") || e.equals("launch") ? e : "day";
+    }
+
+    public static void setEvery(Context c, String e) {
+        prefs(c).edit().putString("updateEvery", e).apply();
+    }
+
+    public static String everyLabel(String e) {
+        switch (e) {
+            case "3days": return "Every 3 days";
+            case "week": return "Every week";
+            case "launch": return "Every time it opens";
+            default: return "Every day";
+        }
+    }
+
+    static long intervalMs(String every) {
+        switch (every) {
+            case "3days": return 3 * 24 * 3600_000L;
+            case "week": return 7 * 24 * 3600_000L;
+            case "launch": return 0;
+            default: return 24 * 3600_000L;
+        }
+    }
+
+    /** Whether a check is due: `atLaunch` is the first look after the app opened. */
+    static boolean due(String every, long lastCheckedAt, long now, boolean atLaunch) {
+        if (atLaunch && every.equals("launch")) return true;
+        if (every.equals("launch")) return false; // only at launch
+        return now - lastCheckedAt >= intervalMs(every);
+    }
+
+    /** Start the schedule (once per process): first look about 3 seconds after the app opens, then an hourly tick. */
+    public static synchronized void start(Context context) {
+        if (started) return;
+        started = true;
+        final Context app = context.getApplicationContext();
+        cleanDownloads(app);
+        final Handler h = new Handler(Looper.getMainLooper());
+        h.postDelayed(new Runnable() {
+            boolean first = true;
+
+            @Override
+            public void run() {
+                boolean launch = first;
+                first = false;
+                if (due(every(app), prefs(app).getLong("updateCheckedAt", 0), System.currentTimeMillis(), launch)) check(app, false, null);
+                h.postDelayed(this, TICK_MS);
+            }
+        }, FIRST_CHECK_MS);
+    }
+
+    /** Look now. With an activity, says so when there is nothing new. */
+    public static void check(Context app, boolean manual, Activity from) {
+        final Moonshine m = Moonshine.get(app);
+        prefs(app).edit().putLong("updateCheckedAt", System.currentTimeMillis()).apply();
+        m.run(() -> {
+            Found found;
+            try {
+                found = latest(BuildConfig.VERSION_NAME);
+            } catch (IOException e) {
+                if (manual && from != null) m.onMain(() -> Toast.makeText(from, "Couldn’t check for updates. Check your internet connection.", Toast.LENGTH_LONG).show());
+                return;
+            }
+            final Found f = found;
+            m.onMain(() -> {
+                if (f == null) {
+                    if (manual && from != null) Toast.makeText(from, "You have the newest Moonshine (" + BuildConfig.VERSION_NAME + ").", Toast.LENGTH_LONG).show();
+                    return;
+                }
+                if (!manual && f.version.equals(prefs(app).getString("updateSkipped", ""))) return;
+                waiting = f;
+                offerWaiting(m.resumedActivity());
+            });
+        });
+    }
+
+    /** Called when one of the app's screens is in front: asks about an update found while nobody was looking. */
+    public static void offerWaiting(Activity a) {
+        if (a == null || a.isFinishing() || a instanceof com.limelight.Game) return;
+        if (downloaded != null && downloaded.exists() && canInstall(a)) {
+            File f = downloaded;
+            downloaded = null;
+            install(a, f);
+            return;
+        }
+        final Found f = waiting;
+        if (f == null || asking) return;
+        asking = true;
+        new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                .setTitle("Moonshine " + f.version + " is out")
+                .setMessage("You have " + BuildConfig.VERSION_NAME + ". The update downloads here, then Android asks you to confirm the install. It keeps your PCs and settings.")
+                .setPositiveButton("Update", (d, w) -> {
+                    waiting = null;
+                    download(a, f);
+                })
+                .setNeutralButton("Skip this version", (d, w) -> {
+                    waiting = null;
+                    prefs(a).edit().putString("updateSkipped", f.version).apply();
+                })
+                .setNegativeButton("Later", (d, w) -> waiting = null)
+                .setOnDismissListener(d -> asking = false)
+                .show();
+    }
+
+    // ---- looking at the release -------------------------------------------------------------------------
+
+    /** The newest release if it is newer than `current` and has the Android app, else null. Blocking. */
+    static Found latest(String current) throws IOException {
+        OkHttpClient c = Service.http.newBuilder().callTimeout(15, TimeUnit.SECONDS).build();
+        Request req = new Request.Builder().url(LATEST).header("Accept", "application/vnd.github+json").header("User-Agent", "Moonshine-Android").build();
+        try (Response res = c.newCall(req).execute()) {
+            ResponseBody b = res.body();
+            if (res.code() == 404) return null;
+            if (!res.isSuccessful() || b == null) throw new IOException("GitHub answered " + res.code());
+            okio.BufferedSource src = b.source();
+            src.request(512 * 1024 + 1);
+            if (src.getBuffer().size() > 512 * 1024) return null;
+            return newer(new JSONObject(src.readUtf8()), current);
+        } catch (JSONException e) {
+            throw new IOException("Unreadable answer");
+        }
+    }
+
+    /** The release as a Found if it is newer than `current` and has the Android app. */
+    static Found newer(JSONObject release, String current) {
+        if (release.optBoolean("draft") || release.optBoolean("prerelease")) return null;
+        String tag = release.optString("tag_name", "");
+        if (!tag.matches("v\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}")) return null;
+        String version = tag.substring(1);
+        if (compare(version, current) <= 0) return null;
+        JSONArray assets = release.optJSONArray("assets");
+        for (int i = 0; assets != null && i < assets.length(); i++) {
+            JSONObject a = assets.optJSONObject(i);
+            if (a == null || !ASSET.equals(a.optString("name"))) continue;
+            long size = a.optLong("size", 0);
+            String digest = a.optString("digest", "");
+            String sha = digest.startsWith("sha256:") && digest.substring(7).matches("[0-9a-fA-F]{64}") ? digest.substring(7).toLowerCase() : "";
+            // Only ever Moonshine's own release, whatever the answer says
+            return new Found(version, RELEASES_PAGE + "tag/" + tag, DOWNLOADS + tag + "/" + ASSET, size, sha);
+        }
+        return null;
+    }
+
+    /** Compare x.y.z versions (anything after a dash, as in 0.5.1-debug, is ignored). */
+    static int compare(String a, String b) {
+        String[] x = a.split("-")[0].split("\\.");
+        String[] y = b.split("-")[0].split("\\.");
+        for (int i = 0; i < 3; i++) {
+            int p = i < x.length ? parse(x[i]) : 0;
+            int q = i < y.length ? parse(y[i]) : 0;
+            if (p != q) return p < q ? -1 : 1;
+        }
+        return 0;
+    }
+
+    private static int parse(String s) {
+        try {
+            return Integer.parseInt(s.replaceAll("\\D", ""));
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    // ---- downloading and installing ----------------------------------------------------------------------
+
+    private static File dir(Context c) {
+        File d = new File(c.getCacheDir(), "updates");
+        //noinspection ResultOfMethodCallIgnored
+        d.mkdirs();
+        return d;
+    }
+
+    private static void cleanDownloads(Context c) {
+        File[] old = dir(c).listFiles();
+        if (old == null) return;
+        for (File f : old) //noinspection ResultOfMethodCallIgnored
+            f.delete();
+    }
+
+    private static void download(Activity a, Found f) {
+        final Moonshine m = Moonshine.get(a);
+        final AtomicBoolean cancelled = new AtomicBoolean();
+        TextView msg = Ui.text(a, "Downloading Moonshine " + f.version + "…", 15, Ui.TEXT, false);
+        ProgressBar bar = new ProgressBar(a, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setMax(1000);
+        bar.setProgressTintList(android.content.res.ColorStateList.valueOf(Ui.ACCENT));
+        LinearLayout box = new LinearLayout(a);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(Ui.dp(a, 24), Ui.dp(a, 20), Ui.dp(a, 24), Ui.dp(a, 8));
+        box.addView(msg);
+        LinearLayout.LayoutParams bp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, Ui.dp(a, 12));
+        bp.topMargin = Ui.dp(a, 14);
+        box.addView(bar, bp);
+        final AlertDialog dlg = new AlertDialog.Builder(a, R.style.MoonshineDialog).setTitle("Updating Moonshine").setView(box)
+                .setCancelable(false).setNegativeButton("Cancel", (d, w) -> cancelled.set(true)).create();
+        dlg.show();
+        m.run(() -> {
+            File out = new File(dir(a), "Moonshine-Android-" + f.version + ".apk");
+            String error = null;
+            try {
+                fetch(f, out, (done, total) -> m.onMain(() -> {
+                    bar.setProgress(total > 0 ? (int) (done * 1000 / total) : 0);
+                    msg.setText(String.format(java.util.Locale.US, "Downloading Moonshine %s… %.1f of %.1f MB", f.version, done / 1048576.0, total / 1048576.0));
+                }), cancelled);
+                verify(a, out, f);
+            } catch (IOException e) {
+                //noinspection ResultOfMethodCallIgnored
+                out.delete();
+                error = cancelled.get() ? null : e.getMessage();
+                if (cancelled.get()) out = null;
+            }
+            final String err = error;
+            final File apk = out;
+            m.onMain(() -> {
+                dlg.dismiss();
+                if (a.isFinishing()) return;
+                if (err != null) {
+                    new AlertDialog.Builder(a, R.style.MoonshineDialog).setTitle("Couldn’t update")
+                            .setMessage(err + "\n\nYou can also download the new app from Moonshine’s releases page.")
+                            .setPositiveButton("Open the page", (d, w) -> openPage(a, f))
+                            .setNegativeButton("Close", null).show();
+                } else if (apk != null) {
+                    install(a, apk);
+                }
+            });
+        });
+    }
+
+    interface Progress {
+        void at(long done, long total);
+    }
+
+    /** Download the APK to `out`, checking size and (when the release says) the SHA-256 as it comes. Blocking. */
+    static void fetch(Found f, File out, Progress progress, AtomicBoolean cancelled) throws IOException {
+        if (!f.url.startsWith(downloadsFrom)) throw new IOException("That isn’t a Moonshine download.");
+        OkHttpClient c = Service.http.newBuilder().callTimeout(0, TimeUnit.MILLISECONDS).readTimeout(30, TimeUnit.SECONDS).build();
+        Request req = new Request.Builder().url(f.url).header("User-Agent", "Moonshine-Android").build();
+        MessageDigest sha;
+        try {
+            sha = MessageDigest.getInstance("SHA-256");
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IOException("This phone can’t check downloads.");
+        }
+        try (Response res = c.newCall(req).execute()) {
+            ResponseBody b = res.body();
+            if (!res.isSuccessful() || b == null) throw new IOException("The download failed (" + res.code() + ").");
+            long total = b.contentLength() > 0 ? b.contentLength() : f.size;
+            if (total > MAX_APK) throw new IOException("The download is too big to be Moonshine.");
+            try (InputStream in = b.byteStream(); FileOutputStream os = new FileOutputStream(out)) {
+                byte[] buf = new byte[64 * 1024];
+                long done = 0;
+                long lastTick = 0;
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    if (cancelled.get()) throw new IOException("Cancelled.");
+                    done += n;
+                    if (done > MAX_APK) throw new IOException("The download is too big to be Moonshine.");
+                    os.write(buf, 0, n);
+                    sha.update(buf, 0, n);
+                    long now = System.currentTimeMillis();
+                    if (now - lastTick > 150) {
+                        lastTick = now;
+                        progress.at(done, total);
+                    }
+                }
+                progress.at(done, Math.max(done, total));
+                if (done < 1_000_000) throw new IOException("The download was incomplete.");
+            }
+        }
+        if (!f.sha256.isEmpty() && !hex(sha.digest()).equals(f.sha256)) throw new IOException("The download doesn’t match the release (its checksum is different). Try again.");
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder s = new StringBuilder();
+        for (byte x : b) s.append(String.format("%02x", x));
+        return s.toString();
+    }
+
+    /** The file must be Moonshine, this version, and signed with the same key as the installed app. */
+    @SuppressWarnings("deprecation")
+    static void verify(Context c, File apk, Found f) throws IOException {
+        PackageManager pm = c.getPackageManager();
+        PackageInfo theirs;
+        PackageInfo mine;
+        try {
+            if (Build.VERSION.SDK_INT >= 28) {
+                theirs = pm.getPackageArchiveInfo(apk.getAbsolutePath(), PackageManager.GET_SIGNING_CERTIFICATES);
+                mine = pm.getPackageInfo(c.getPackageName(), PackageManager.GET_SIGNING_CERTIFICATES);
+            } else {
+                theirs = pm.getPackageArchiveInfo(apk.getAbsolutePath(), PackageManager.GET_SIGNATURES);
+                mine = pm.getPackageInfo(c.getPackageName(), PackageManager.GET_SIGNATURES);
+            }
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            throw new IOException("The download isn’t a valid app.");
+        }
+        if (theirs == null) throw new IOException("The download isn’t a valid app.");
+        if (!c.getPackageName().equals(theirs.packageName)) throw new IOException("The download isn’t Moonshine.");
+        if (theirs.versionName == null || compare(theirs.versionName, f.version) != 0) throw new IOException("The download isn’t the version the release says.");
+        Signature[] a = signatures(theirs);
+        Signature[] b = signatures(mine);
+        if (a == null || b == null || a.length == 0 || !Arrays.equals(a, b)) throw new IOException("The download wasn’t signed by Moonshine’s key, so it can’t replace this app.");
+    }
+
+    @SuppressWarnings("deprecation")
+    private static Signature[] signatures(PackageInfo p) {
+        if (Build.VERSION.SDK_INT >= 28) return p.signingInfo == null ? null : p.signingInfo.getApkContentsSigners();
+        return p.signatures;
+    }
+
+    private static boolean canInstall(Context c) {
+        return Build.VERSION.SDK_INT < 26 || c.getPackageManager().canRequestPackageInstalls();
+    }
+
+    private static void install(Activity a, File apk) {
+        if (!canInstall(a)) {
+            downloaded = apk;
+            new AlertDialog.Builder(a, R.style.MoonshineDialog)
+                    .setTitle("Allow installing")
+                    .setMessage("The update is downloaded. Android needs you to allow Moonshine to install apps once: turn it on on the next screen, then come back here.")
+                    .setPositiveButton("Open settings", (d, w) -> {
+                        try {
+                            a.startActivity(new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:" + a.getPackageName())));
+                        } catch (RuntimeException e) {
+                            Toast.makeText(a, "Open Settings → Apps → Moonshine → Install unknown apps.", Toast.LENGTH_LONG).show();
+                        }
+                    })
+                    .setNegativeButton("Later", null)
+                    .show();
+            return;
+        }
+        try {
+            Uri uri = FileProvider.getUriForFile(a, a.getPackageName() + ".fileprovider", apk);
+            Intent i = new Intent(Intent.ACTION_VIEW).setDataAndType(uri, "application/vnd.android.package-archive")
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
+            a.startActivity(i);
+        } catch (RuntimeException e) {
+            Toast.makeText(a, "Couldn’t open the installer. Install it from the releases page instead.", Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private static void openPage(Activity a, Found f) {
+        try {
+            a.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(f.page)));
+        } catch (RuntimeException ignored) {
+            // no browser
+        }
+    }
+}
diff --git a/app/src/main/java/com/moonshine/tunnel/Stun.java b/app/src/main/java/com/moonshine/tunnel/Stun.java
new file mode 100644
index 00000000..e4d8777e
--- /dev/null
+++ b/app/src/main/java/com/moonshine/tunnel/Stun.java
@@ -0,0 +1,106 @@
+package com.moonshine.tunnel;
+
+import java.security.SecureRandom;
+
+/** STUN Binding requests and answers (RFC 5389), to learn this phone's public address and port. */
+final class Stun {
+    static final int COOKIE = 0x2112a442;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private Stun() {}
+
+    static final class Mapped {
+        final byte[] tx;
+        final String address;
+        final int port;
+
+        Mapped(byte[] tx, String address, int port) {
+            this.tx = tx;
+            this.address = address;
+            this.port = port;
+        }
+    }
+
+    /** A Binding request; its transaction id is bytes 8..20. */
+    static byte[] request() {
+        byte[] msg = new byte[20];
+        msg[0] = 0x00;
+        msg[1] = 0x01;
+        putInt(msg, 4, COOKIE);
+        byte[] tx = new byte[12];
+        RANDOM.nextBytes(tx);
+        System.arraycopy(tx, 0, msg, 8, 12);
+        return msg;
+    }
+
+    /** A Binding success with this phone's mapped address, or null for anything else. */
+    static Mapped parse(byte[] buf, int length) {
+        if (length < 20 || (buf[0] & 0xc0) != 0 || getInt(buf, 4) != COOKIE) return null;
+        if (getShort(buf, 0) != 0x0101) return null;
+        int len = getShort(buf, 2);
+        if (20 + len > length) return null;
+        byte[] tx = new byte[12];
+        System.arraycopy(buf, 8, tx, 0, 12);
+        String address = null;
+        int port = 0;
+        for (int off = 20; off + 4 <= 20 + len; ) {
+            int type = getShort(buf, off);
+            int alen = getShort(buf, off + 2);
+            int v = off + 4;
+            if (v + alen > 20 + len) break;
+            if ((type == 0x0020 || type == 0x0001) && alen >= 8) {
+                boolean xor = type == 0x0020;
+                int family = buf[v + 1] & 0xff;
+                int p = getShort(buf, v + 2) ^ (xor ? (COOKIE >>> 16) : 0);
+                if (family == 1) {
+                    StringBuilder sb = new StringBuilder();
+                    for (int i = 0; i < 4; i++) {
+                        int b = buf[v + 4 + i] & 0xff;
+                        if (xor) b ^= buf[4 + i] & 0xff;
+                        if (i > 0) sb.append('.');
+                        sb.append(b);
+                    }
+                    address = sb.toString();
+                    port = p;
+                } else if (family == 2 && alen >= 20) {
+                    StringBuilder sb = new StringBuilder();
+                    for (int i = 0; i < 16; i += 2) {
+                        int hi = buf[v + 4 + i] & 0xff;
+                        int lo = buf[v + 5 + i] & 0xff;
+                        if (xor) {
+                            hi ^= buf[4 + i] & 0xff;
+                            lo ^= buf[5 + i] & 0xff;
+                        }
+                        if (i > 0) sb.append(':');
+                        sb.append(Integer.toHexString((hi << 8) | lo));
+                    }
+                    address = sb.toString();
+                    port = p;
+                }
+                if (xor) break; // XOR-MAPPED-ADDRESS wins over MAPPED-ADDRESS
+            }
+            off += 4 + alen + ((4 - (alen % 4)) % 4);
+        }
+        return address == null ? null : new Mapped(tx, address, port);
+    }
+
+    static int getShort(byte[] b, int off) {
+        return ((b[off] & 0xff) << 8) | (b[off + 1] & 0xff);
+    }
+
+    static int getInt(byte[] b, int off) {
+        return ((b[off] & 0xff) << 24) | ((b[off + 1] & 0xff) << 16) | ((b[off + 2] & 0xff) << 8) | (b[off + 3] & 0xff);
+    }
+
+    static void putShort(byte[] b, int off, int v) {
+        b[off] = (byte) (v >>> 8);
+        b[off + 1] = (byte) v;
+    }
+
+    static void putInt(byte[] b, int off, int v) {
+        b[off] = (byte) (v >>> 24);
+        b[off + 1] = (byte) (v >>> 16);
+        b[off + 2] = (byte) (v >>> 8);
+        b[off + 3] = (byte) v;
+    }
+}
