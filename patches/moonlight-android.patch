+package com.moonshine;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+public class ReconnectTest {
+    @Test
+    public void aStreamThatNeverStartedIsAnErrorNotADrop() {
+        assertEquals(0, Reconnect.next(0, 0, true));
+    }
+
+    @Test
+    public void aDropStartsTheTries() {
+        assertEquals(1, Reconnect.next(0, 60_000, true));
+    }
+
+    @Test
+    public void triesCountUpThenStop() {
+        assertEquals(2, Reconnect.next(1, 0, true));
+        assertEquals(5, Reconnect.next(4, 0, true));
+        assertEquals(0, Reconnect.next(5, 0, true));
+    }
+
+    @Test
+    public void aStreamThatHeldGetsFreshTries() {
+        assertEquals(1, Reconnect.next(5, 30_000, true));
+    }
+
+    @Test
+    public void turnedOffMeansNever() {
+        assertEquals(0, Reconnect.next(0, 60_000, false));
+    }
+
+    @Test
+    public void volumeBoostIsClamped() {
+        assertEquals(1f, PcPrefs.clampBoost(0.2f), 0f);
+        assertEquals(10f, PcPrefs.clampBoost(99f), 0f);
+        assertEquals(2.5f, PcPrefs.clampBoost(2.5f), 0f);
+        assertEquals(1f, PcPrefs.clampBoost(Float.NaN), 0f);
+    }
+
+    @Test
+    public void bitrateSuggestionFollowsTheSpeed() {
+        assertEquals(5, SpeedTest.recommendBitrate(2));
+        assertEquals(50, SpeedTest.recommendBitrate(75));
+        assertEquals(150, SpeedTest.recommendBitrate(900));
+    }
+}
