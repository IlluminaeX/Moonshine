+    private static JSONObject body(Object... kv) {
+        JSONObject o = new JSONObject();
+        try {
+            for (int i = 0; i + 1 < kv.length; i += 2) o.put((String) kv[i], kv[i + 1]);
+        } catch (JSONException ignored) {
+            // keys are fixed strings
+        }
+        return o;
+    }
