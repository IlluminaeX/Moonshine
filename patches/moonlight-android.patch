+    @Test
+    public void stunAnswerParses() {
+        byte[] req = Stun.request();
+        assertEquals(20, req.length);
+        assertEquals(Stun.COOKIE, Stun.getInt(req, 4));
+        // A Binding success with XOR-MAPPED-ADDRESS 203.0.113.7:54321
+        byte[] res = new byte[32];
+        Stun.putShort(res, 0, 0x0101);
+        Stun.putShort(res, 2, 12);
+        Stun.putInt(res, 4, Stun.COOKIE);
+        System.arraycopy(req, 8, res, 8, 12);
+        Stun.putShort(res, 20, 0x0020);
+        Stun.putShort(res, 22, 8);
+        res[25] = 1;
+        Stun.putShort(res, 26, 54321 ^ (Stun.COOKIE >>> 16));
+        int ip = (203 << 24) | (113 << 8) | 7;
+        Stun.putInt(res, 28, ip ^ Stun.COOKIE);
+        Stun.Mapped m = Stun.parse(res, res.length);
+        assertNotNull(m);
+        assertEquals("203.0.113.7", m.address);
+        assertEquals(54321, m.port);
+        assertArrayEquals(Arrays.copyOfRange(req, 8, 20), m.tx);
+        // Truncated or not a success: nothing
+        assertNull(Stun.parse(res, 24));
+        res[1] = 0x11;
+        assertNull(Stun.parse(res, res.length));
+    }
