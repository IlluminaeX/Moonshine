+                        // Global addresses only (link-local needs a zone, fd7a: is Tailscale, 2001:0: and 2002: are old tunnels)
+                        if (!s.matches("^[23].*") || s.matches("(?i)^2001:0{0,4}:.*") || s.matches("(?i)^2002:.*")) continue;
+                        out.add(new Cand(s, port6));
