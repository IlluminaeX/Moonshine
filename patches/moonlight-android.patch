diff --git a/app/src/test/java/com/moonshine/tunnel/TunnelInteropTest.java b/app/src/test/java/com/moonshine/tunnel/TunnelInteropTest.java
new file mode 100644
index 00000000..6a046ff5
--- /dev/null
+++ b/app/src/test/java/com/moonshine/tunnel/TunnelInteropTest.java
@@ -0,0 +1,254 @@
+package com.moonshine.tunnel;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assume.assumeTrue;
+
+import org.junit.Test;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * The phone's tunnel against the desktop app's real tunnel engine (app/lib/tunnel-engine.js, run by
+ * node as the friend's PC, with echo servers as its host engine): the two must agree on keys, packets,
+ * the stream layer and UDP, or no phone could connect to a friend's PC. Skipped when node or the
+ * Moonshine checkout isn't there.
+ */
+public class TunnelInteropTest {
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private static File hostScript() {
+        for (File d = new File(System.getProperty("user.dir")).getAbsoluteFile(); d != null; d = d.getParentFile()) {
+            File f = new File(d, "scripts/android-tunnel-host.js");
+            if (f.isFile() && new File(d, "app/lib/tunnel-engine.js").isFile()) return f;
+        }
+        return null;
+    }
+
+    private static String field(String json, String name) {
+        Matcher m = Pattern.compile("\"" + name + "\":(\"([^\"]*)\"|(-?\\d+|true|false))").matcher(json);
+        if (!m.find()) return null;
+        return m.group(2) != null ? m.group(2) : m.group(3);
+    }
+
+    private static final class Host implements AutoCloseable {
+        final Process process;
+        final BufferedReader out;
+        final Writer in;
+
+        Host(File script, int hostBase, double dropRate) throws Exception {
+            ProcessBuilder pb = new ProcessBuilder("node", script.getAbsolutePath(), String.valueOf(hostBase), String.valueOf(dropRate));
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+            in = new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8);
+        }
+
+        String line(long timeoutMs) throws Exception {
+            AtomicReference<String> got = new AtomicReference<>();
+            Thread t = new Thread(() -> {
+                try {
+                    got.set(out.readLine());
+                } catch (Exception ignored) {
+                    // process gone
+                }
+            });
+            t.start();
+            t.join(timeoutMs);
+            return got.get();
+        }
+
+        void send(String json) throws Exception {
+            in.write(json + "\n");
+            in.flush();
+        }
+
+        @Override
+        public void close() {
+            process.destroy();
+        }
+    }
+
+    private static boolean nodeAvailable() {
+        try {
+            Process p = new ProcessBuilder("node", "--version").start();
+            return p.waitFor(10, TimeUnit.SECONDS) && p.exitValue() == 0;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /** Open a tunnel to the desktop engine; returns [tunnel, host]. */
+    private Object[] open(double dropRate, int hostBase, String localIp) throws Exception {
+        return open(dropRate, hostBase, localIp, true);
+    }
+
+    /** `honest`: false gives the PC a wrong address for the phone, as a router that changes ports per destination would. */
+    private Object[] open(double dropRate, int hostBase, String localIp, boolean honest) throws Exception {
+        File script = hostScript();
+        assumeTrue("Moonshine checkout not found", script != null);
+        assumeTrue("node not installed", nodeAvailable());
+        Host host = new Host(script, hostBase, dropRate);
+        String ready = host.line(15000);
+        assertNotNull("the desktop engine didn't start", ready);
+        String hostPub = field(ready, "pub");
+        int hostPort = Integer.parseInt(field(ready, "port"));
+
+        CountDownLatch closed = new CountDownLatch(1);
+        Tunnel t = new Tunnel(new Tunnel.Listener() {
+            @Override
+            public void onRelayWanted() {
+            }
+
+            @Override
+            public void onClosed(String reason) {
+                closed.countDown();
+            }
+        });
+        t.dropRate = dropRate;
+        Tunnel.Prep prep = t.prepare();
+        assertEquals(43, prep.pub.length());
+        t.listen(localIp, hostBase);
+        byte[] s = new byte[24];
+        RANDOM.nextBytes(s);
+        String session = TunnelCrypto.b64url(s);
+        int phonePort = honest ? t.localPort4() : 9; // 9: nothing listens (discard)
+        host.send("{\"pub\":\"" + prep.pub + "\",\"cands\":[{\"a\":\"127.0.0.1\",\"p\":" + phonePort + "}],\"session\":\"" + session + "\"}");
+        t.start(hostPub, Collections.singletonList(new Tunnel.Cand("127.0.0.1", hostPort)), session);
+        assertTrue(t.isConnected());
+        String connected = host.line(15000);
+        assertNotNull(connected);
+        assertEquals("true", field(connected, "connected"));
+        return new Object[] { t, host };
+    }
+
+    private static void echoTcp(String ip, int port, int size) throws Exception {
+        byte[] data = new byte[size];
+        RANDOM.nextBytes(data);
+        try (Socket sock = new Socket()) {
+            sock.connect(new InetSocketAddress(ip, port), 5000);
+            sock.setSoTimeout(30000);
+            OutputStream o = sock.getOutputStream();
+            Thread writer = new Thread(() -> {
+                try {
+                    for (int off = 0; off < data.length; off += 8192) o.write(data, off, Math.min(8192, data.length - off));
+                    sock.shutdownOutput();
+                } catch (Exception ignored) {
+                    // the read side reports it
+                }
+            });
+            writer.start();
+            InputStream in = sock.getInputStream();
+            byte[] back = new byte[size];
+            int got = 0;
+            while (got < size) {
+                int n = in.read(back, got, size - got);
+                if (n < 0) break;
+                got += n;
+            }
+            assertEquals("bytes echoed through the tunnel", size, got);
+            assertArrayEquals(data, back);
+            assertEquals("the stream ends after the echo", -1, in.read());
+            writer.join();
+        }
+    }
+
+    @Test(timeout = 120000)
+    public void talksToTheDesktopEngine() throws Exception {
+        int hostBase = 20000 + RANDOM.nextInt(20000);
+        String ip = "127.77.3.4";
+        Object[] o = open(0, hostBase, ip);
+        Tunnel t = (Tunnel) o[0];
+        try (Host host = (Host) o[1]) {
+            // TCP: HTTPS, HTTP and RTSP ports at once, a megabyte each way
+            List<Thread> runs = new ArrayList<>();
+            List<Throwable> errors = Collections.synchronizedList(new ArrayList<>());
+            for (int idx : Tunnel.TCP_IDX) {
+                final int port = hostBase + Tunnel.PORTS[idx];
+                Thread r = new Thread(() -> {
+                    try {
+                        echoTcp(ip, port, 1024 * 1024);
+                    } catch (Throwable e) {
+                        errors.add(e);
+                    }
+                });
+                r.start();
+                runs.add(r);
+            }
+            for (Thread r : runs) r.join();
+            if (!errors.isEmpty()) throw new AssertionError(errors.get(0));
+
+            // UDP: the video, control and audio ports
+            for (int idx : Tunnel.UDP_IDX) {
+                try (DatagramSocket u = new DatagramSocket(new InetSocketAddress("127.0.0.1", 0))) {
+                    u.setSoTimeout(3000);
+                    int back = 0;
+                    for (int i = 0; i < 20; i++) {
+                        byte[] msg = new byte[900];
+                        RANDOM.nextBytes(msg);
+                        u.send(new DatagramPacket(msg, msg.length, InetAddress.getByName(ip), hostBase + Tunnel.PORTS[idx]));
+                        DatagramPacket p = new DatagramPacket(new byte[2000], 2000);
+                        u.receive(p);
+                        assertEquals(msg.length, p.getLength());
+                        assertArrayEquals(msg, java.util.Arrays.copyOf(p.getData(), p.getLength()));
+                        back++;
+                    }
+                    assertEquals(20, back);
+                }
+            }
+
+            // Closing tells the other side straight away
+            t.close("done");
+            String closed = host.line(5000);
+            assertNotNull(closed);
+            assertEquals("peer-closed", field(closed, "closed"));
+        }
+    }
+
+    @Test(timeout = 120000)
+    public void connectsWhenOnlyThePhoneKnowsTheWay() throws Exception {
+        int hostBase = 20000 + RANDOM.nextInt(20000);
+        String ip = "127.77.7.8";
+        Object[] o = open(0, hostBase, ip, false); // the PC learns the phone's address from its probes
+        Tunnel t = (Tunnel) o[0];
+        try (Host host = (Host) o[1]) {
+            echoTcp(ip, hostBase + Tunnel.PORTS[0], 64 * 1024);
+            t.close("done");
+        }
+    }
+
+    @Test(timeout = 180000)
+    public void copesWithLostPackets() throws Exception {
+        int hostBase = 20000 + RANDOM.nextInt(20000);
+        String ip = "127.77.5.6";
+        Object[] o = open(0.05, hostBase, ip); // both sides drop 5% of what they send
+        Tunnel t = (Tunnel) o[0];
+        try (Host host = (Host) o[1]) {
+            echoTcp(ip, hostBase + Tunnel.PORTS[1], 512 * 1024);
+            t.close("done");
+        }
+    }
+}
diff --git a/app/src/test/java/com/moonshine/tunnel/TunnelPartsTest.java b/app/src/test/java/com/moonshine/tunnel/TunnelPartsTest.java
new file mode 100644
index 00000000..7c26186a
--- /dev/null
+++ b/app/src/test/java/com/moonshine/tunnel/TunnelPartsTest.java
@@ -0,0 +1,185 @@
+package com.moonshine.tunnel;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+import java.security.SecureRandom;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.List;
+
+/** The tunnel's pieces on their own: encoding, keys, packet sealing, replay protection, STUN and TURN parsing. */
+public class TunnelPartsTest {
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    @Test
+    public void base64urlMatchesJava() {
+        for (int len = 0; len < 70; len++) {
+            byte[] b = new byte[len];
+            RANDOM.nextBytes(b);
+            String expected = Base64.getUrlEncoder().withoutPadding().encodeToString(b);
+            assertEquals(expected, TunnelCrypto.b64url(b));
+            assertArrayEquals(b, TunnelCrypto.unb64url(expected));
+        }
+        for (String bad : new String[] { "a", "ab=c", "ab+c", "a b" }) {
+            try {
+                TunnelCrypto.unb64url(bad);
+                fail("accepted " + bad);
+            } catch (IllegalArgumentException expected) {
+                // good
+            }
+        }
+    }
+
+    @Test
+    public void bothSidesDeriveTheSameKeys() throws Exception {
+        byte[][] a = TunnelCrypto.newKeyPair();
+        byte[][] b = TunnelCrypto.newKeyPair();
+        byte[][] client = TunnelCrypto.deriveKeys(a[0], TunnelCrypto.b64url(b[1]), "session-abcdefghijklmnopqrstuvwx", true);
+        byte[][] host = TunnelCrypto.deriveKeys(b[0], TunnelCrypto.b64url(a[1]), "session-abcdefghijklmnopqrstuvwx", false);
+        assertArrayEquals(client[0], host[1]);
+        assertArrayEquals(client[1], host[0]);
+        assertFalse(Arrays.equals(client[0], client[1]));
+        // A different session gives different keys
+        byte[][] other = TunnelCrypto.deriveKeys(a[0], TunnelCrypto.b64url(b[1]), "session-zzzzzzzzzzzzzzzzzzzzzzzz", true);
+        assertFalse(Arrays.equals(client[0], other[0]));
+    }
