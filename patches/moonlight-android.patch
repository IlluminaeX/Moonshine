diff --git a/app/src/main/java/com/moonshine/Connect.java b/app/src/main/java/com/moonshine/Connect.java
new file mode 100644
index 00000000..04e07853
--- /dev/null
+++ b/app/src/main/java/com/moonshine/Connect.java
@@ -0,0 +1,179 @@
+package com.moonshine;
+
+import android.content.Context;
+
+import com.limelight.binding.PlatformBinding;
+import com.limelight.computers.ComputerManagerService;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.limelight.nvstream.http.NvApp;
+import com.limelight.nvstream.http.NvHTTP;
+import com.limelight.nvstream.http.PairingManager;
+import com.limelight.nvstream.http.PairingManager.PairState;
+import com.moonshine.tunnel.Tunnels;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.xmlpull.v1.XmlPullParserException;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Getting from "Connect" on a friend's PC to its app list: reach it (its Tailscale or home-network
+ * address if one answers, otherwise a direct connection through Moonshine's service), add it to the PC
+ * list, and pair (Moonshine on that PC lets a friend in with one Accept, or by itself). Blocking: run it
+ * off the main thread.
+ */
+public final class Connect {
+    public interface Progress {
+        void status(String text);
+
+        /** Pairing started: the PIN, and whether Moonshine on that PC asks its user (no typing needed). */
+        void pairing(String pin, boolean moonshine);
+    }
+
+    private Connect() {}
+
+    /**
+     * Reach a friend's PC. `pc` is its entry from the friends list ({device, hostUuid, port, addrs, tunnel,
+     * name}); `target` the direct-connection route (null if there is none). Returns the PC as the list has it.
+     */
+    public static ComputerDetails reach(Context ctx, ComputerManagerService.ComputerManagerBinder binder,
+                                        String hostUuid, String name, int port, List<String> addrs, Tunnels.Target target,
+                                        Progress ui) throws IOException, InterruptedException {
+        Moonshine m = Moonshine.get(ctx);
+        if (port <= 0 || port > 65535) port = 47989;
+        // A direct connection already open (or the PC already reachable as it's saved): use it
+        if (m.tunnels.isOpen(hostUuid)) {
+            ComputerDetails d = add(binder, hostUuid, m.tunnels.localIpFor(hostUuid), port);
+            if (d != null) return d;
+        }
+        ui.status("Looking for " + name + "…");
+        for (String a : addrs) {
+            if (!Tunnels.isTunnelAddress(a)) {
+                ComputerDetails d = add(binder, hostUuid, a, port);
+                if (d != null) return d;
+            }
+        }
+        if (target == null) throw new IOException("Couldn’t reach " + name + ". Their Moonshine may not be signed in, or it’s too old for direct connections.");
+        ui.status("Connecting to " + name + "…");
+        String ip = m.tunnels.connect(target);
+        ComputerDetails d = add(binder, hostUuid, ip, port);
+        if (d == null) throw new IOException(name + " didn’t answer through the connection. Try again in a moment.");
+        return d;
+    }
+
+    /** Add the PC at this address if it answers as the right PC; null otherwise. */
+    private static ComputerDetails add(ComputerManagerService.ComputerManagerBinder binder, String hostUuid, String address, int port) throws InterruptedException {
+        ComputerDetails fake = new ComputerDetails();
+        fake.uuid = hostUuid; // a different PC answering at that address is turned away
+        fake.manualAddress = new ComputerDetails.AddressTuple(address, port);
+        if (!binder.addComputerBlocking(fake)) return null;
+        ComputerDetails d = binder.getComputer(hostUuid);
+        return d != null ? d : fake;
+    }
+
+    /** Addresses from a friends-list entry. */
+    public static List<String> addrs(JSONObject pc) {
+        List<String> out = new ArrayList<>();
+        JSONArray a = pc.optJSONArray("addrs");
+        for (int i = 0; a != null && i < a.length() && i < 8; i++) {
+            String s = a.optString(i, "");
+            if (s.matches("^[0-9a-fA-F.:]{2,45}$")) out.add(s);
+        }
+        return out;
+    }
+
+    /**
+     * Pair with a PC if this phone isn't yet. With Moonshine on that PC, its user accepts the request (or it
+     * goes through by itself for a friend); otherwise the PIN is typed there. Returns null on success, or
+     * what went wrong.
+     */
+    public static String pair(Context ctx, ComputerManagerService.ComputerManagerBinder binder, ComputerDetails computer, Progress ui) {
+        try {
+            if (computer.activeAddress == null) return "That PC isn’t reachable right now.";
+            NvHTTP http = new NvHTTP(computer.activeAddress, computer.httpsPort, binder.getUniqueId(), computer.serverCert,
+                    PlatformBinding.getCryptoProvider(ctx));
+            if (http.getPairState() == PairState.PAIRED) return null;
+            String pin = PairingManager.generatePinString();
+            final String name = computer.name == null ? "that PC" : computer.name;
+            String requestId;
+            try {
+                requestId = Pairing.request(computer.activeAddress.address, computer.activeAddress.port, pin, Moonshine.deviceName(ctx));
+            } catch (Pairing.Refused e) {
+                return Pairing.refusedMessage(e.reason, name);
+            }
+            ui.pairing(pin, requestId != null);
+            final AtomicBoolean declined = new AtomicBoolean(false);
+            final AtomicBoolean done = new AtomicBoolean(false);
+            Thread watcher = null;
+            if (requestId != null) {
+                final String id = requestId;
+                final ComputerDetails.AddressTuple at = computer.activeAddress;
+                watcher = new Thread(() -> {
+                    long deadline = System.currentTimeMillis() + 2 * 60 * 1000;
+                    while (!done.get() && System.currentTimeMillis() < deadline) {
+                        String s = Pairing.status(at.address, at.port, id);
+                        if ("declined".equals(s)) {
+                            declined.set(true);
+                            http.cancelPairing();
+                            return;
+                        }
+                        if ("accepted".equals(s)) return;
+                        try {
+                            Thread.sleep(1000);
+                        } catch (InterruptedException e) {
+                            return;
+                        }
+                    }
+                    if (!done.get()) {
+                        declined.set(true); // nobody answered
+                        http.cancelPairing();
+                    }
+                }, "Moonshine pair watch");
+                watcher.setDaemon(true);
+                watcher.start();
+            }
+            PairState state;
+            PairingManager pm = http.getPairingManager();
+            try {
+                state = pm.pair(http.getServerInfo(true), pin, null);
+            } catch (IOException e) {
+                if (declined.get()) return name + " didn’t accept this phone.";
+                throw e;
+            } finally {
+                done.set(true);
+                if (watcher != null) watcher.interrupt();
+            }
+            if (declined.get() && state != PairState.PAIRED) return name + " didn’t accept this phone.";
+            switch (state) {
+                case PAIRED: {
+                    ComputerDetails saved = binder.getComputer(computer.uuid);
+                    if (saved != null) saved.serverCert = pm.getPairedCert();
+                    computer.serverCert = pm.getPairedCert();
+                    binder.invalidateStateForComputer(computer.uuid);
+                    return null;
+                }
+                case PIN_WRONG: return "The PIN was wrong. Try pairing again.";
+                case ALREADY_IN_PROGRESS: return name + " is already pairing with another device. Try again in a minute.";
+                default: return computer.runningGameId != 0 ? "Pairing didn’t work: " + name + " is busy streaming. Try again when it’s free." : "Pairing with " + name + " didn’t work.";
+            }
+        } catch (XmlPullParserException | IOException e) {
+            return "Pairing didn’t work: " + (e.getMessage() == null ? "the PC stopped answering." : e.getMessage());
+        }
+    }
+
+    /** The app with this name on the PC, or null. Blocking. */
+    public static NvApp findApp(Context ctx, ComputerManagerService.ComputerManagerBinder binder, ComputerDetails computer, String appName) {
+        if (appName == null || appName.isEmpty() || computer.activeAddress == null) return null;
+        try {
+            NvHTTP http = new NvHTTP(computer.activeAddress, computer.httpsPort, binder.getUniqueId(), computer.serverCert,
+                    PlatformBinding.getCryptoProvider(ctx));
+            return http.getAppByName(appName);
+        } catch (IOException | XmlPullParserException e) {
+            return null;
+        }
+    }
+}
diff --git a/app/src/main/java/com/moonshine/FileReceiver.java b/app/src/main/java/com/moonshine/FileReceiver.java
new file mode 100644
index 00000000..7b81f82d
--- /dev/null
+++ b/app/src/main/java/com/moonshine/FileReceiver.java
@@ -0,0 +1,196 @@
+package com.moonshine;
+
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import com.moonshine.tunnel.Tunnels;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+/**
+ * Receiving a file a friend (or your other PC) sends to this phone. The sender's PC offered it through the
+ * friends service; once the user says Save, this fetches it in pieces from that PC's host (over the same
+ * connection a stream would use, with the offer's one-time key) and saves it in Downloads/Moonshine.
+ * Nothing is saved without that yes. Blocking: run it off the main thread.
+ */
+public final class FileReceiver {
+    /** A file offered to this phone. */
+    public static final class Offer {
+        public final String id;
+        public final String from;
+        public final long device; // the sender's PC (a device of the friends service)
+        public final String hostUuid;
+        public final int port;
+        public final String key;
+        public final String name;
+        public final long size;
+
+        Offer(String id, String from, long device, String hostUuid, int port, String key, String name, long size) {
+            this.id = id;
+            this.from = from;
+            this.device = device;
+            this.hostUuid = hostUuid;
+            this.port = port;
+            this.key = key;
+            this.name = safeName(name);
+            this.size = size;
+        }
+
+        void into(Intent i) {
+            i.putExtra("file_id", id).putExtra("file_from", from).putExtra("file_device", device).putExtra("file_host", hostUuid)
+                    .putExtra("file_port", port).putExtra("file_key", key).putExtra("file_name", name).putExtra("file_size", size);
+        }
+
+        static Offer from(Intent i) {
+            String id = i.getStringExtra("file_id");
+            if (id == null) return null;
+            return new Offer(id, String.valueOf(i.getStringExtra("file_from")), i.getLongExtra("file_device", 0), String.valueOf(i.getStringExtra("file_host")),
+                    i.getIntExtra("file_port", 47989), String.valueOf(i.getStringExtra("file_key")), String.valueOf(i.getStringExtra("file_name")), i.getLongExtra("file_size", 0));
+        }
+    }
+
+    public interface Progress {
+        void at(long done, long total);
+    }
+
+    private static final int MAX_PIECE = 8 << 20;
+
+    private FileReceiver() {}
+
+    /** Just a file name: no folders, nothing the file system refuses, not too long. */
+    static String safeName(String name) {
+        String n = name == null ? "" : name;
+        int slash = Math.max(n.lastIndexOf('/'), n.lastIndexOf('\\'));
+        if (slash >= 0) n = n.substring(slash + 1);
+        n = n.replaceAll("[\\p{Cntrl}\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2069\\uFEFF<>:\"/\\\\|?*]", "_");
+        n = n.replaceAll("^[. ]+|[. ]+$", "");
+        if (n.length() > 150) n = n.substring(n.length() - 150); // keep the end: the extension matters most
+        return n.isEmpty() ? "file" : n;
+    }
+
+    /** Validates a hub message into an offer; null if it isn't a well-formed one. */
+    static Offer parse(org.json.JSONObject msg) {
+        org.json.JSONObject from = msg.optJSONObject("from");
+        String id = msg.optString("id", "");
+        String host = msg.optString("hostUuid", "");
+        String key = msg.optString("key", "");
+        long size = msg.optLong("size", 0);
+        int port = msg.optInt("port", 0);
+        if (from == null || from.optString("username").isEmpty() || from.optLong("device") <= 0) return null;
+        if (!id.matches("[A-Za-z0-9]{8,40}") || !host.matches("[0-9A-Za-z-]{8,64}") || !key.matches("[A-Za-z0-9_-]{16,64}")) return null;
+        if (size <= 0 || port < 1 || port > 65535) return null;
+        String name = Moonshine.clean(msg.optString("name"), 120);
+        if (name.isEmpty()) return null;
+        return new Offer(id, Moonshine.clean(from.optString("username"), 40), from.optLong("device"), host, port, key, name, size);
+    }
+
+    /** Where the file ended up. */
+    public static final class Saved {
+        public final String name;
+        public final Uri uri; // null before Android 10 (a plain file in the app's Downloads folder)
+        public final String where;
+
+        Saved(String name, Uri uri, String where) {
+            this.name = name;
+            this.uri = uri;
+            this.where = where;
+        }
+    }
+
+    /** Fetch the whole file and save it. Throws with a message fit to show. */
+    public static Saved receive(Context ctx, Moonshine m, Offer o, Progress progress, AtomicBoolean cancelled) throws IOException {
+        Tunnels.Target target = new Tunnels.Target(o.hostUuid, o.device, o.port, o.from + "’s PC", m.hub, m.token());
+        String ip = m.tunnels.connect(target);
+        OkHttpClient c = Service.http.newBuilder().callTimeout(0, TimeUnit.MILLISECONDS).readTimeout(30, TimeUnit.SECONDS).build();
+        ContentResolver cr = ctx.getContentResolver();
+        Uri uri = null;
+        File file = null;
+        OutputStream out;
+        String where;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            ContentValues v = new ContentValues();
+            v.put(MediaStore.MediaColumns.DISPLAY_NAME, o.name);
+            v.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS + "/Moonshine");
+            v.put(MediaStore.MediaColumns.IS_PENDING, 1);
+            uri = cr.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
+            if (uri == null) throw new IOException("Couldn’t save in Downloads.");
+            out = cr.openOutputStream(uri);
+            where = "Downloads/Moonshine";
+        } else {
+            File dir = new File(ctx.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS), "Moonshine");
+            if (!dir.isDirectory() && !dir.mkdirs()) throw new IOException("Couldn’t make a folder to save in.");
+            file = new File(dir, o.name);
+            for (int n = 2; file.exists(); n++) file = new File(dir, n + "-" + o.name);
+            out = new FileOutputStream(file);
+            where = "the Moonshine folder in this app’s Downloads";
+        }
+        if (out == null) throw new IOException("Couldn’t save in Downloads.");
+        boolean ok = false;
+        try {
+            pull(c, "http://" + ip + ":" + o.port, o, out, progress, cancelled);
+            ok = true;
+        } finally {
+            try {
+                out.close();
+            } catch (IOException ignored) {
+                // the write error, if any, is already being thrown
+            }
+            if (!ok) {
+                if (uri != null) cr.delete(uri, null, null);
+                if (file != null) file.delete();
+            }
+        }
+        if (uri != null) {
+            ContentValues v = new ContentValues();
+            v.put(MediaStore.MediaColumns.IS_PENDING, 0);
+            cr.update(uri, v, null, null);
+        }
+        return new Saved(o.name, uri, where);
+    }
+    /** Fetch the file in pieces from `base` (the sender's PC, e.g. "http://127.77.1.2:47989") into `out`. */
+    static void pull(OkHttpClient c, String base, Offer o, OutputStream out, Progress progress, AtomicBoolean cancelled) throws IOException {
+        long done = 0;
+        progress.at(0, o.size);
+        while (done < o.size) {
+            if (cancelled.get()) throw new IOException("Cancelled.");
+            String url = base + "/moonshine/take?id=" + o.id + "&key=" + o.key + "&offset=" + done;
+            try (Response res = c.newCall(new Request.Builder().url(url).header("User-Agent", "Moonshine-Android").build()).execute()) {
+                ResponseBody b = res.body();
+                if (res.code() == 404) throw new IOException(o.from + " is no longer offering the file.");
+                if (!res.isSuccessful() || b == null) throw new IOException("Couldn’t get the file from " + o.from + "’s PC (" + res.code() + ").");
+                byte[] buf = new byte[64 * 1024];
+                long piece = 0;
+                try (InputStream in = b.byteStream()) {
+                    int n;
+                    while ((n = in.read(buf)) > 0) {
+                        if (cancelled.get()) throw new IOException("Cancelled.");
+                        out.write(buf, 0, n);
+                        piece += n;
+                        done += n;
+                        if (done > o.size || piece > MAX_PIECE) throw new IOException("The file was bigger than it said.");
+                        progress.at(done, o.size);
+                    }
+                }
+                if (piece == 0) throw new IOException("The file ended early.");
+            }
+        }
+        if (done != o.size) throw new IOException("The file was incomplete.");
+    }
+}
diff --git a/app/src/main/java/com/moonshine/FileSender.java b/app/src/main/java/com/moonshine/FileSender.java
new file mode 100644
index 00000000..b4dcda7e
--- /dev/null
+++ b/app/src/main/java/com/moonshine/FileSender.java
@@ -0,0 +1,133 @@
+package com.moonshine;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.OpenableColumns;
+
+import com.limelight.nvstream.http.NvHTTP;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Sending a file from the phone to a paired PC running Moonshine, the same way the desktop app does: the PC
+ * asks its user "X wants to send you a file", and on Accept the file goes up in pieces over the pairing's
+ * secure connection. Blocking: run it off the main thread.
+ */
+public final class FileSender {
+    public interface Listener {
+        /** state: asking, sending or done. */
+        void update(String name, String state, long sent, long size);
+    }
+
+    private static final int PIECE = 4 << 20; // 4 MB per request (the host takes up to 8)
+    private static final long ANSWER_TIMEOUT_MS = 2 * 60 * 1000;
+
+    private FileSender() {}
+
+    /** The file's name and size as the phone's file picker knows them. */
+    public static String[] describe(ContentResolver cr, Uri uri) {
+        String name = "file";
+        long size = -1;
+        try (Cursor c = cr.query(uri, new String[] { OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE }, null, null, null)) {
+            if (c != null && c.moveToFirst()) {
+                if (!c.isNull(0)) name = c.getString(0);
+                if (!c.isNull(1)) size = c.getLong(1);
+            }
+        } catch (RuntimeException ignored) {
+            // some providers don't answer
+        }
+        return new String[] { name, String.valueOf(size) };
+    }
+
+    static String explain(String code, String pc) {
+        switch (code == null ? "" : code) {
+            case "not-allowed": return pc + " doesn’t let this phone send files. On " + pc + ", turn on “Upload files” for this device in Host → Devices.";
+            case "closed": return "Moonshine isn’t running on " + pc + ", so nobody can accept the file.";
+            case "no-space": return pc + " doesn’t have enough free disk space for that file.";
+            case "busy": return pc + " has too many files waiting. Try again in a minute.";
+            case "bad-size": return "That file is empty.";
+            case "declined": return pc + " declined the file.";
+            default: return pc + " refused the file.";
+        }
+    }
+
+    private static JSONObject call(NvHTTP http, String pc, String method, String path, String query, byte[] body, int len) throws IOException {
+        String[] r;
+        try {
+            r = http.moonshineCall(method, path, query, body, 0, len);
+        } catch (javax.net.ssl.SSLException e) {
+            throw new IOException(pc + "’s identity has changed. Pair with it again.");
+        } catch (IOException e) {
+            throw new IOException("Couldn’t reach " + pc + ".");
+        }
+        JSONObject json;
+        try {
+            json = new JSONObject(r[1]);
+        } catch (JSONException e) {
+            json = new JSONObject();
+        }
+        if (!"200".equals(r[0])) throw new IOException(explain(json.optString("error"), pc));
+        return json;
+    }
+
+    /** Send one file; throws with a message fit to show. `cancelled` stops it (the PC is told). */
+    public static void send(Context ctx, NvHTTP http, String pc, Uri uri, Listener l, AtomicBoolean cancelled) throws IOException {
+        String[] d = describe(ctx.getContentResolver(), uri);
+        final String name = d[0];
+        final long size = Long.parseLong(d[1]);
+        if (size <= 0) throw new IOException("That file is empty or its size can’t be read.");
+        l.update(name, "asking", 0, size);
+        String id = call(http, pc, "POST", "moonshine/file/offer", "name=" + Uri.encode(name) + "&size=" + size, null, 0).optString("id");
+        if (!id.matches("[A-Za-z0-9_-]{4,80}")) throw new IOException(pc + " didn’t understand the file.");
+        final String fid = id;
+        try {
+            long asked = System.currentTimeMillis();
+            for (;;) {
+                if (cancelled.get()) throw new IOException("Cancelled.");
+                String status = call(http, pc, "GET", "moonshine/file/status", "id=" + fid, null, 0).optString("status");
+                if ("accepted".equals(status)) break;
+                if ("declined".equals(status)) throw new IOException(explain("declined", pc));
+                if (System.currentTimeMillis() - asked > ANSWER_TIMEOUT_MS) throw new IOException(pc + " didn’t answer.");
+                try {
+                    Thread.sleep(1000);
+                } catch (InterruptedException e) {
+                    throw new IOException("Cancelled.");
+                }
+            }
+            try (InputStream in = ctx.getContentResolver().openInputStream(uri)) {
+                if (in == null) throw new IOException("Couldn’t read that file.");
+                byte[] buf = new byte[(int) Math.min(PIECE, size)];
+                long sent = 0;
+                while (sent < size) {
+                    if (cancelled.get()) throw new IOException("Cancelled.");
+                    int want = (int) Math.min(buf.length, size - sent);
+                    int got = 0;
+                    while (got < want) {
+                        int n = in.read(buf, got, want - got);
+                        if (n < 0) break;
+                        got += n;
+                    }
+                    if (got <= 0) throw new IOException("The file changed while it was being sent.");
+                    JSONObject r = call(http, pc, "POST", "moonshine/file/chunk", "id=" + fid + "&offset=" + sent, buf, got);
+                    sent = r.optLong("received", sent + got);
+                    l.update(name, "sending", sent, size);
+                }
+            }
+            l.update(name, "done", size, size);
+        } catch (IOException e) {
+            try {
+                http.moonshineCall("POST", "moonshine/file/cancel", "id=" + fid, null, 0, 0);
+            } catch (IOException ignored) {
+                // the PC times the offer out by itself
+            }
+            throw e;
+        }
+    }
+}
