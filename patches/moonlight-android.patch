@@ -0,0 +1,1233 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.content.res.ColorStateList;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.text.InputFilter;
+import android.text.InputType;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.inputmethod.EditorInfo;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.core.graphics.drawable.RoundedBitmapDrawable;
+import androidx.core.graphics.drawable.RoundedBitmapDrawableFactory;
+
+import com.limelight.AppView;
+import com.limelight.HelpActivity;
+import com.limelight.R;
+import com.limelight.preferences.StreamSettings;
+import com.limelight.computers.ComputerManagerService;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.limelight.nvstream.http.NvApp;
+import com.limelight.utils.ServerHelper;
+import com.moonshine.tunnel.Tunnels;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Friends: sign in with Discord, see friends and their PCs, connect to one from anywhere (Moonshine
+ * arranges a direct connection when Tailscale or the same network doesn't reach it), friend requests,
+ * quick messages, "join my game" invites and invite links (moonshine://join/...).
+ */
+public class FriendsActivity extends Activity implements Moonshine.Listener {
+    private static final int BG = Ui.BG, SURFACE = Ui.CARD, SURFACE_HIGH = Ui.CARD_HIGH, TEXT = Ui.TEXT,
+            MUTED = Ui.MUTED, ACCENT = Ui.ACCENT, BUTTON = Ui.BUTTON, ONLINE = Ui.ONLINE;
+    private static final Pattern JOIN = Pattern.compile("^moonshine://join/([A-Za-z0-9_-]{20,64})/?$", Pattern.CASE_INSENSITIVE);
+    private static final Map<String, Bitmap> avatars = new HashMap<>();
+    private static final Set<String> avatarsAsked = new HashSet<>();
+
+    private Moonshine m;
+    private LinearLayout content;
+    private ComputerManagerService.ComputerManagerBinder binder;
+    private boolean connecting;
+    private AlertDialog progress;
+    private TextView progressText;
+    private Runnable afterBind;
+    private int insetTop, insetBottom;
+    private final Map<String, PcSheets.Conn> conns = new HashMap<>();
+    private final Map<String, Long> connAsked = new HashMap<>();
+    private JSONObject filePc; // the PC the file picker is choosing files for
+    private static final int PICK_FILES = 77;
+
+    private final ServiceConnection serviceConnection = new ServiceConnection() {
+        @Override
+        public void onServiceConnected(ComponentName name, IBinder service) {
+            final ComputerManagerService.ComputerManagerBinder b = (ComputerManagerService.ComputerManagerBinder) service;
+            m.run(() -> {
+                b.waitForReady();
+                runOnUiThread(() -> {
+                    binder = b;
+                    if (afterBind != null) {
+                        Runnable r = afterBind;
+                        afterBind = null;
+                        r.run();
+                    }
+                });
+            });
+        }
+
+        @Override
+        public void onServiceDisconnected(ComponentName name) {
+            binder = null;
+        }
+    };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        m = Moonshine.get(this);
+        ScrollView scroll = new ScrollView(this);
+        scroll.setBackgroundColor(0); // the sky behind shows through
+        scroll.setFillViewport(true);
+        content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(content, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundResource(R.drawable.moonshine_sky);
+        root.addView(scroll, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        // The bottom bar floats over the list, like glass: rounded, outlined, a little see-through
+        nav = new LinearLayout(this);
+        nav.setBackground(Ui.shape(this, Ui.GLASS, Ui.STROKE, 32));
+        nav.setElevation(dp(10));
+        nav.setPadding(dp(8), dp(8), dp(8), dp(8));
+        FrameLayout.LayoutParams navLp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM);
+        navLp.leftMargin = dp(16);
+        navLp.rightMargin = dp(16);
+        root.addView(nav, navLp);
+        setContentView(root);
+        // System bars: keep the list below the status bar and the floating bar above the gesture bar
+        root.setOnApplyWindowInsetsListener((v, insets) -> {
+            insetTop = Build.VERSION.SDK_INT >= 30
+                    ? insets.getInsets(android.view.WindowInsets.Type.systemBars()).top
+                    : insets.getSystemWindowInsetTop();
+            insetBottom = Build.VERSION.SDK_INT >= 30
+                    ? insets.getInsets(android.view.WindowInsets.Type.systemBars()).bottom
+                    : insets.getSystemWindowInsetBottom();
+            applyInsets();
+            return insets;
+        });
+        root.requestApplyInsets();
+        applyInsets();
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
+            getWindow().setStatusBarColor(BG);
+            getWindow().setNavigationBarColor(BG);
+        }
+        bindService(new Intent(this, ComputerManagerService.class), serviceConnection, Context.BIND_AUTO_CREATE);
+        handleIntent(getIntent());
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        setIntent(intent);
+        handleIntent(intent);
+    }
+
+    private void handleIntent(Intent intent) {
+        if (intent == null) return;
+        Moonshine.PlayInvite inv = m.isOurs(intent) ? Moonshine.PlayInvite.from(intent) : null;
+        if (inv != null) {
+            intent.removeExtra("invite_id");
+            askToJoin(this, inv);
+            return;
+        }
+        FileReceiver.Offer offer = m.isOurs(intent) ? FileReceiver.Offer.from(intent) : null;
+        if (offer != null) {
+            intent.removeExtra("file_id");
+            askToReceive(this, offer);
+            return;
+        }
+        Uri data = intent.getData();
+        if (Intent.ACTION_VIEW.equals(intent.getAction()) && data != null) {
+            Matcher mt = JOIN.matcher(data.toString().trim());
+            intent.setData(null);
+            if (!mt.matches()) {
+                toast("That link isn’t a Moonshine invite link.");
+                return;
+            }
+            final String secret = mt.group(1);
+            new AlertDialog.Builder(this, R.style.MoonshineDialog)
+                    .setTitle("Join with an invite link?")
+                    .setMessage("Someone invited you to play on their PC. The link works once. Moonshine connects to that PC for you, and its owner decides what you can do there.")
+                    .setPositiveButton("Join", (d, w) -> redeem(secret))
+                    .setNegativeButton("Not now", null)
+                    .show();
+        }
+    }
