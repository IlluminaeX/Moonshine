+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+
+    <!--
+        Base application theme, dependent on API level. This theme is replaced
+        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
+
+    -->
+    <style name="AppBaseTheme" parent="Theme.MaterialComponents.NoActionBar">
+        <!--
+            Theme customizations available in newer API levels can go in
+            res/values-vXX/styles.xml, while customizations related to
+            backward-compatibility can go here.
+        -->
+    </style>
+
+    <!-- Application theme. -->
+    <style name="AppTheme" parent="AppBaseTheme">
+        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
+        <item name="android:windowActionBar">false</item>
+        <item name="preferenceTheme">@style/MoonshinePreferenceTheme</item>
+        <item name="alertDialogTheme">@style/MoonshineAlertDialog</item>
+        <item name="materialAlertDialogTheme">@style/MoonshineAlertDialog</item>
+        <item name="android:windowNoTitle">true</item>
+        <item name="android:statusBarColor">@color/moonshine_bg</item>
+        <item name="android:navigationBarColor">@color/moonshine_bg</item>
+        <item name="android:colorBackground">@color/moonshine_bg</item>
+        <item name="android:windowBackground">@drawable/moonshine_sky</item>
+        <!-- Moonshine's accent colours for buttons, switches and highlights -->
+        <item name="colorPrimary">@color/moonshine_accent</item>
+        <item name="colorOnPrimary">#FFFFFF</item>
+        <item name="colorPrimaryContainer">@color/moonshine_button</item>
+        <item name="colorOnPrimaryContainer">#FFFFFF</item>
+        <item name="colorSecondary">@color/moonshine_accent</item>
+        <item name="colorSecondaryContainer">@color/moonshine_surface_high</item>
+        <item name="colorOnSecondaryContainer">@color/moonshine_text</item>
+        <item name="colorAccent">@color/moonshine_accent</item>
+        <item name="android:colorAccent">@color/moonshine_accent</item>
+    </style>
+
+    <style name="StreamBaseTheme" parent="AppBaseTheme">
+        <!-- Transparent streaming background to avoid extra overdraw -->
+        <item name="android:windowBackground">@android:color/transparent</item>
+    </style>
+
+    <!-- Stream activity theme -->
+    <style name="StreamTheme" parent="StreamBaseTheme">
+        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
+        <item name="android:windowActionBar">false</item>
+        <item name="android:windowNoTitle">true</item>
+        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
+        <item name="android:colorControlNormal">@android:color/white</item>
+        <item name="android:colorControlHighlight">@android:color/white</item>
+        <item name="android:colorAccent">@android:color/white</item>
+        <item name="android:colorControlActivated">@android:color/white</item>
+        <item name="android:colorButtonNormal">@android:color/white</item>
+        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
+        <item name="colorControlNormal">@android:color/white</item>
+        <item name="colorControlHighlight">@android:color/white</item>
+        <item name="colorAccent">@android:color/white</item>
+        <item name="colorControlActivated">@android:color/white</item>
+        <item name="colorButtonNormal">@android:color/white</item>
+    </style>
+
+    <!-- Dialogs of the home screen: the same dark plum and crimson as the rest -->
+    <!-- Dialogs opened from Settings (custom bitrate, pickers…): the same dark plum as the rest -->
+    <style name="MoonshineAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
+        <item name="android:windowBackground">@drawable/moonshine_dialog</item>
+        <item name="android:colorBackground">@color/moonshine_surface</item>
+        <item name="colorAccent">@color/moonshine_accent</item>
+        <item name="colorControlActivated">@color/moonshine_accent</item>
+        <item name="android:textColorPrimary">@color/moonshine_text</item>
+        <item name="android:textColorSecondary">@color/moonshine_muted</item>
+        <item name="android:textColorHint">@color/moonshine_muted</item>
+        <item name="buttonBarButtonStyle">@style/Widget.AppCompat.Button.ButtonBar.AlertDialog</item>
+    </style>
+
+    <style name="MoonshineDialog" parent="android:Theme.Material.Dialog.Alert">
+        <item name="android:windowBackground">@drawable/moonshine_dialog</item>
+        <item name="android:colorBackground">@color/moonshine_surface</item>
+        <item name="android:colorAccent">@color/moonshine_accent</item>
+        <item name="android:textColorPrimary">@color/moonshine_text</item>
+        <item name="android:textColorSecondary">@color/moonshine_muted</item>
+        <item name="android:textColorAlertDialogListItem">@color/moonshine_text</item>
+    </style>
+
+    <style name="SettingsTheme" parent="Theme.AppCompat.NoActionBar">
+        <item name="android:statusBarColor">@android:color/transparent</item>
+        <item name="android:navigationBarColor">@android:color/transparent</item>
+        <item name="android:colorBackground">@color/moonshine_bg</item>
+        <item name="android:windowBackground">@drawable/moonshine_sky</item>
+        <item name="colorAccent">@color/moonshine_accent</item>
+        <item name="colorControlActivated">@color/moonshine_accent</item>
+        <item name="colorControlNormal">@color/moonshine_muted</item>
+        <item name="preferenceTheme">@style/MoonshinePreferenceTheme</item>
+    </style>
+
+    <!-- Settings rows: rounded cards, with a switch or the current choice on the right -->
+    <style name="MoonshinePreferenceTheme" parent="PreferenceThemeOverlay">
+        <item name="preferenceCategoryStyle">@style/MoonshinePreferenceCategory</item>
+        <item name="preferenceStyle">@style/MoonshinePreference</item>
+        <item name="checkBoxPreferenceStyle">@style/MoonshineCheckBoxPreference</item>
+        <item name="dialogPreferenceStyle">@style/MoonshineDialogPreference</item>
+        <item name="editTextPreferenceStyle">@style/MoonshineEditTextPreference</item>
+    </style>
+    <style name="MoonshinePreference" parent="Preference">
+        <item name="android:layout">@layout/moonshine_preference</item>
+    </style>
+    <style name="MoonshinePreferenceCategory" parent="Preference.Category">
+        <item name="android:layout">@layout/moonshine_preference_category</item>
+    </style>
+    <style name="MoonshineCheckBoxPreference" parent="Preference.CheckBoxPreference">
+        <item name="android:layout">@layout/moonshine_preference</item>
+        <item name="android:widgetLayout">@layout/moonshine_widget_switch</item>
+    </style>
+    <style name="MoonshineDialogPreference" parent="Preference.DialogPreference">
+        <item name="android:layout">@layout/moonshine_preference</item>
+    </style>
+    <style name="MoonshineEditTextPreference" parent="Preference.DialogPreference.EditTextPreference">
+        <item name="android:layout">@layout/moonshine_preference</item>
+    </style>
+
+    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
+        <item name="android:statusBarColor">@android:color/black</item>
+        <item name="android:navigationBarColor">@android:color/black</item>
+        <item name="android:colorBackground">@android:color/black</item>
+        <item name="android:windowBackground">@android:color/black</item>
+    </style>
+
+    <declare-styleable name="ApertureViewGroup">
+        <attr name="aperture_color1" format="color" />
+        <attr name="aperture_color2" format="color" />
+        <attr name="aperture_border_width" format="dimension" />
+        <attr name="aperture_border_angle" format="dimension" />
+        <attr name="aperture_duration" format="integer" />
+        <attr name="aperture_middle_color" format="color" />
+    </declare-styleable>
+
+</resources>
