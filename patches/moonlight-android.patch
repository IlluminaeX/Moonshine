+            addSpaced(content, text("Loading friends…", 14, MUTED, false), 12);
+            return;
+        }
+        JSONArray list = f.optJSONArray("friends");
+        int accepted = 0;
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend != null && "incoming".equals(friend.optString("status"))) renderIncoming(friend);
+        }
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend != null && "accepted".equals(friend.optString("status"))) {
+                renderFriend(friend);
+                accepted++;
+            }
+        }
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend != null && "outgoing".equals(friend.optString("status"))) renderOutgoing(friend);
+        }
+        if (accepted == 0) {
+            addSpaced(content, text("No friends yet. Add one by their Moonshine username above.", 14, MUTED, false), 12);
+        }
+    }
