+    private void redeem(String secret) {
+        showProgress("Using the invite link…");
+        m.run(() -> {
+            try {
+                JSONObject inv = m.redeemInvite(secret);
+                JSONObject host = inv.optJSONObject("host");
+                runOnUiThread(() -> {
+                    hideProgress();
+                    render();
+                    if (host == null) return;
+                    String name = Moonshine.clean(host.optString("name"), 60);
+                    Hub h = m.guestHub();
+                    Tunnels.Target t = h == null ? null : new Tunnels.Target(host.optString("uuid"), host.optLong("device"), host.optInt("port", 47989), name, h, m.guestToken());
+                    connect(host.optString("uuid"), name, host.optInt("port", 47989), new JSONArray(), t, "");
+                });
+            } catch (IOException e) {
+                runOnUiThread(() -> {
+                    hideProgress();
+                    toast(e instanceof Service.ServiceException && ((Service.ServiceException) e).status == 410
+                            ? e.getMessage() : "Couldn’t use that invite link: " + e.getMessage());
+                });
+            }
+        });
+    }
