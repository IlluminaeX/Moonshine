@@ -0,0 +1,795 @@
+package com.moonshine;
+
+import android.app.Activity;
+import android.app.Application;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import com.limelight.BuildConfig;
+import com.limelight.R;
+import com.limelight.nvstream.http.ComputerDetails;
+import com.moonshine.tunnel.TunnelCrypto;
+import com.moonshine.tunnel.Tunnels;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.lang.ref.WeakReference;
+import java.net.Inet4Address;
+import java.net.Inet6Address;
+import java.net.InetAddress;
+import java.net.NetworkInterface;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Moonshine's account features on this phone: signing in with Discord, friends, telling friends this
+ * phone is online, the live link (messages, "join my game" invites, direct connections) and invite links
+ * (joining a PC as a guest without an account). One per app.
+ *
+ * The phone only watches: it never hosts, so friends see it under their list and never as a PC.
+ */
+public final class Moonshine {
+    public interface Listener {
+        /** Something changed (signed in or out, the friends list, the live link): redraw. Main thread. */
+        void onChanged();
+    }
+
+    public static final String CHANNEL = "moonshine_friends";
+    private static final String PREFS = "moonshine";
+    private static final long PRESENCE_MS = 60_000;
+    private static final long PRESENCE_LINKED_MS = 2 * 60_000;
+    private static final long BACKGROUND_GRACE_MS = 60_000;
+    private static final long LOGIN_POLL_MS = 2000;
+    private static final long LOGIN_WAIT_MS = 10 * 60_000;
+    private static final long FRIENDS_FRESH_MS = 30_000;
+    private static final long REOPEN_EVERY_MS = 2 * 60_000;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private static Moonshine instance;
+
+    public static synchronized Moonshine get(Context ctx) {
+        if (instance == null) instance = new Moonshine(ctx.getApplicationContext());
+        return instance;
+    }
+
+    private final Context ctx;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService work = Executors.newCachedThreadPool(r -> {
+        Thread t = new Thread(r, "Moonshine");
+        t.setDaemon(true);
+        return t;
+    });
+    private final CopyOnWriteArrayList<Listener> listeners = new CopyOnWriteArrayList<>();
+    public final Hub hub;
+    private Hub guestHub;
+    public final Tunnels tunnels;
+
+    private volatile JSONObject friends; // the last GET /friends
+    private volatile long friendsAt;
+    private volatile String loginSession; // a Discord sign-in in progress
+    private volatile String lastError = "";
+    private volatile int started; // activities on screen (changed on the main thread only)
+    private WeakReference<Activity> resumed = new WeakReference<>(null);
+    private final Set<String> seenInvites = Collections.synchronizedSet(new LinkedHashSet<>());
+    private final Map<String, Long> reopenTried = new HashMap<>();
+    private volatile String activeStream = ""; // the stand-in address a stream is using
+
+    private Moonshine(Context ctx) {
+        this.ctx = ctx;
+        hub = new Hub(this::token);
+        hub.addListener(this::onHubMessage);
+        hub.addStateListener(this::changed);
+        tunnels = new Tunnels(ctx);
+        tunnels.setFinder(this::targetFor);
+        tunnels.setInUse(address -> address != null && address.equals(activeStream));
+        Service.loginLost = lost -> main.post(() -> {
+            if (lost.equals(token())) signedOutLocally();
+            else if (lost.equals(guestToken())) leaveInviteLocally("ended");
+        });
+        makeChannel();
+    }
+
+    /** From the Application: follow which screens are open, to stay online only while the app is in use. */
+    public void attach(Application app) {
+        app.registerActivityLifecycleCallbacks(new Application.ActivityLifecycleCallbacks() {
+            @Override public void onActivityStarted(Activity a) {
+                if (started++ == 0) cameForward();
+            }
+            @Override public void onActivityStopped(Activity a) {
+                if (--started == 0) main.postDelayed(goneBack, BACKGROUND_GRACE_MS);
+            }
+            @Override public void onActivityResumed(Activity a) {
+                resumed = new WeakReference<>(a);
+            }
+            @Override public void onActivityPaused(Activity a) {
+                if (resumed.get() == a) resumed = new WeakReference<>(null);
+            }
+            @Override public void onActivityCreated(Activity a, Bundle b) { }
+            @Override public void onActivitySaveInstanceState(Activity a, Bundle b) { }
+            @Override public void onActivityDestroyed(Activity a) { }
+        });
+    }
+
+    private final Runnable goneBack = this::wentBack;
+
+    private void wentBack() {
+        if (started > 0) return;
+        // Out of sight for a minute: show offline to friends at once rather than after a timeout
+        hub.stop(true);
+        if (guestHub != null) guestHub.stop(true);
+        main.removeCallbacks(presenceTick);
+    }
+
+    private void cameForward() {
+        main.removeCallbacks(goneBack);
+        if (signedIn()) {
+            hub.start();
+            main.removeCallbacks(presenceTick);
+            main.post(presenceTick);
+        }
+        if (guestInvite() != null) ensureGuestHub().start();
+    }
+
+    public Activity resumedActivity() {
+        return resumed.get();
+    }
+
+    public void addListener(Listener l) {
+        listeners.add(l);
+    }
+
+    public void removeListener(Listener l) {
+        listeners.remove(l);
+    }
+
+    void changed() {
+        main.post(() -> {
+            for (Listener l : listeners) l.onChanged();
+        });
+    }
+
+    public void run(Runnable r) {
+        work.execute(r);
+    }
+
+    public void onMain(Runnable r) {
+        main.post(r);
+    }
+
+    private SharedPreferences prefs() {
+        return ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * The Friends screen is open to other apps (for moonshine:// links), so the extras Moonshine passes
+     * itself (invite popups, joining a game) carry a key only this app knows. Without it they're ignored,
+     * so no other app can make Moonshine connect somewhere or show a made-up invite.
+     */
+    private synchronized String intentKey() {
+        String k = prefs().getString("intentKey", null);
+        if (k == null || k.length() < 32) {
+            byte[] b = new byte[24];
+            new java.security.SecureRandom().nextBytes(b);
+            k = android.util.Base64.encodeToString(b, android.util.Base64.NO_WRAP | android.util.Base64.URL_SAFE | android.util.Base64.NO_PADDING);
+            prefs().edit().putString("intentKey", k).apply();
+        }
+        return k;
+    }
+
+    public Intent sign(Intent i) {
+        return i.putExtra("moonshine_key", intentKey());
+    }
+
+    public boolean isOurs(Intent i) {
+        String k = i == null ? null : i.getStringExtra("moonshine_key");
+        return k != null && java.security.MessageDigest.isEqual(k.getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                intentKey().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+    }
+
+    // ---- account -----------------------------------------------------------------------------------
+
+    public String token() {
+        return Secrets.get(ctx, "token");
+    }
+
+    public boolean signedIn() {
+        return !token().isEmpty();
+    }
+
+    public String username() {
+        return prefs().getString("username", "");
+    }
+
+    public boolean signingIn() {
+        return loginSession != null;
+    }
+
+    /** The person chose "Skip sign in": the app opens on the PCs they add by hand until they sign in. */
+    public boolean skippedSignIn() {
+        return prefs().getBoolean("skippedSignIn", false);
+    }
+
+    public void setSkippedSignIn(boolean skipped) {
+        prefs().edit().putBoolean("skippedSignIn", skipped).apply();
+    }
+
+    public String lastError() {
+        return lastError;
+    }
+
+    /** Start signing in: Discord's page opens in the browser, and this waits for the answer. */
+    public void signIn(Activity from) {
+        byte[] b = new byte[24];
+        RANDOM.nextBytes(b);
+        final String session = TunnelCrypto.b64url(b);
+        loginSession = session;
+        lastError = "";
+        changed();
+        Intent i = new Intent(Intent.ACTION_VIEW, Uri.parse(Service.base + "/auth/discord/start?session=" + session));
+        try {
+            from.startActivity(i);
+        } catch (Exception e) {
+            loginSession = null;
+            lastError = "No web browser is installed to sign in with.";
+            changed();
+            return;
+        }
+        run(() -> pollLogin(session));
+    }
+
+    public void cancelSignIn() {
+        loginSession = null;
+        changed();
+    }
+
+    private void pollLogin(String session) {
+        long deadline = System.currentTimeMillis() + LOGIN_WAIT_MS;
+        while (session.equals(loginSession) && System.currentTimeMillis() < deadline) {
+            try {
+                Thread.sleep(LOGIN_POLL_MS);
+                JSONObject r = Service.call("GET", "/auth/poll?session=" + session, null, null);
+                if (r.optBoolean("pending", false)) continue;
+                String token = r.optString("token", "");
+                if (token.isEmpty()) break;
+                if (!session.equals(loginSession)) return;
+                Secrets.put(ctx, "token", token);
+                setSkippedSignIn(false);
+                prefs().edit().putString("username", r.isNull("username") ? "" : r.optString("username", "")).apply();
+                loginSession = null;
+                main.post(() -> {
+                    hub.start();
+                    main.removeCallbacks(presenceTick);
+                    main.post(presenceTick);
+                });
+                refreshFriends();
+                changed();
+                return;
+            } catch (Service.ServiceException e) {
+                // 410: the browser hasn't opened the sign-in page yet (a phone's browser can take a while,
+                // with its own first-run screens), or it expired; keep waiting until this side gives up
+                if (e.status == 401) {
+                    lastError = "cancelled".equals(e.getMessage()) ? "Sign-in cancelled." : "Discord sign-in failed. Try again.";
+                    break;
+                }
+            } catch (IOException e) {
+                // no internet for a moment: keep waiting
+            } catch (InterruptedException e) {
+                break;
+            }
+        }
+        if (session.equals(loginSession)) {
+            loginSession = null;
+            if (lastError.isEmpty()) lastError = "Signing in took too long. Try again.";
+        }
+        changed();
+    }
+
+    /** Pick (or change) the username friends find this account by. Blocking. */
+    public void setUsername(String name) throws IOException {
+        try {
+            JSONObject r = Service.call("POST", "/me/username", new JSONObject().put("name", name.trim()), token());
+            prefs().edit().putString("username", r.optString("username", name.trim())).apply();
+            changed();
+        } catch (JSONException e) {
+            throw new IOException(e.getMessage());
+        }
+    }
+
+    public void signOut() {
+        final String token = token();
+        run(() -> {
+            try {
+                Service.call("POST", "/auth/signout", null, token);
+            } catch (IOException ignored) {
+                // forgotten here anyway
+            }
+        });
+        signedOutLocally();
+    }
+
+    private void signedOutLocally() {
+        hub.stop(true);
+        main.removeCallbacks(presenceTick);
+        Secrets.put(ctx, "token", "");
+        prefs().edit().remove("username").putBoolean("skippedSignIn", false).apply();
+        friends = null;
+        friendsAt = 0;
+        if (guestInvite() == null) tunnels.closeAll();
+        changed();
+    }
+
+    // ---- presence ----------------------------------------------------------------------------------
+
+    private final Runnable presenceTick = new Runnable() {
+        @Override
+        public void run() {
+            main.removeCallbacks(this);
+            if (!signedIn() || started == 0) return;
+            work.execute(Moonshine.this::sendPresence);
+            main.postDelayed(this, hub.isConnected() ? PRESENCE_LINKED_MS : PRESENCE_MS);
+        }
+    };
+
+    private void sendPresence() {
+        String token = token();
+        if (token.isEmpty()) return;
+        try {
+            JSONObject body = new JSONObject();
+            body.put("kind", "phone");
+            body.put("name", deviceName(ctx));
+            body.put("addrs", new JSONArray(localAddresses()));
+            body.put("tunnel", true);
+            body.put("version", BuildConfig.VERSION_NAME.replaceAll("[^0-9A-Za-z.\\-]", ""));
+            Service.call("POST", "/presence", body, token);
+        } catch (IOException | JSONException ignored) {
+            // tried again in a minute
+        }
+    }
+
+    /** What friends see this phone called. */
+    public static String deviceName(Context ctx) {
+        String name = null;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N_MR1) {
+            name = Settings.Global.getString(ctx.getContentResolver(), Settings.Global.DEVICE_NAME);
+        }
+        if (name == null || name.trim().isEmpty()) {
+            String model = Build.MODEL == null ? "Android" : Build.MODEL;
+            String maker = Build.MANUFACTURER == null ? "" : Build.MANUFACTURER;
+            name = model.toLowerCase().startsWith(maker.toLowerCase()) ? model : maker + " " + model;
+        }
+        name = name.replaceAll("[\\p{Cntrl}]", " ").trim();
+        return name.length() > 60 ? name.substring(0, 60) : name;
+    }
+
+    /**
+     * This phone's addresses on its networks. Friends' Moonshine lets a pairing through by itself when it
+     * comes from one of them (Tailscale, or the same home network); the service shows the home-network ones
+     * only to friends on that same network.
+     */
+    static List<String> localAddresses() {
+        List<String> out = new ArrayList<>();
+        try {
+            for (NetworkInterface ni : Collections.list(NetworkInterface.getNetworkInterfaces())) {
+                if (!ni.isUp() || ni.isLoopback()) continue;
+                for (InetAddress a : Collections.list(ni.getInetAddresses())) {
+                    String s = a.getHostAddress();
+                    int pct = s.indexOf('%');
+                    if (pct >= 0) s = s.substring(0, pct);
+                    if (a instanceof Inet4Address && !s.startsWith("169.254.")) out.add(s);
+                    else if (a instanceof Inet6Address && !a.isLinkLocalAddress() && s.matches("(?i)^(2|3|fd7a:115c:a1e0:).*")) out.add(s);
+                    if (out.size() >= 8) return out;
+                }
+            }
+        } catch (Exception ignored) {
+            // none readable
+        }
+        return out;
+    }
+
+    // ---- friends -----------------------------------------------------------------------------------
+
+    public JSONObject friends() {
+        return friends;
+    }
+
+    /** Fetch the friends list again (in the background); listeners hear when it's in. */
+    public void refreshFriends() {
+        if (!signedIn()) return;
+        run(() -> {
+            try {
+                JSONObject f = Service.call("GET", "/friends", null, token());
+                JSONObject me = f.optJSONObject("me");
+                if (me != null && !me.isNull("username")) prefs().edit().putString("username", me.optString("username", "")).apply();
+                friends = f;
+                friendsAt = System.currentTimeMillis();
+                lastError = "";
+            } catch (Service.ServiceException e) {
+                lastError = e.getMessage();
+            } catch (IOException e) {
+                lastError = "Can’t reach Moonshine’s service. Check your internet connection.";
+            }
+            changed();
+        });
+    }
+
+    public void refreshFriendsIfOld() {
+        if (System.currentTimeMillis() - friendsAt > FRIENDS_FRESH_MS) refreshFriends();
+    }
+
+    /** One friends-list action (request, respond, remove, nickname, message): blocking, throws the service's words. */
+    public JSONObject friendCall(String path, JSONObject body) throws IOException {
+        JSONObject r = Service.call("POST", path, body, token());
+        if (!path.startsWith("/messages")) refreshFriends();
+        return r;
+    }
+
+    /** An accepted friend's PC by its host id, if it's online and hosting. */
+    /** The signed-in person's own other PCs (they reach them with no friend step), as the service lists them. */
+    public JSONArray myPcs() {
+        JSONObject f = friends;
+        JSONArray mine = f != null ? f.optJSONArray("mine") : null;
+        return mine != null ? mine : new JSONArray();
+    }
+
+    public boolean isMyPc(String hostUuid) {
+        JSONArray mine = myPcs();
+        for (int i = 0; i < mine.length(); i++) {
+            JSONObject pc = mine.optJSONObject(i);
+            if (pc != null && hostUuid.equals(pc.optString("hostUuid"))) return true;
+        }
+        return false;
+    }
+
+    public JSONObject friendPc(String hostUuid) {
+        JSONObject f = friends;
+        JSONArray list = f != null ? f.optJSONArray("friends") : null;
+        JSONArray mine = myPcs();
+        for (int j = 0; j < mine.length(); j++) {
+            JSONObject pc = mine.optJSONObject(j);
+            if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) {
+                try {
+                    return new JSONObject(pc.toString()).put("username", username());
+                } catch (JSONException e) {
+                    return pc;
+                }
+            }
+        }
+        if (list == null) return null;
+        for (int i = 0; i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend == null || !"accepted".equals(friend.optString("status"))) continue;
+            JSONArray pcs = friend.optJSONArray("pcs");
+            for (int j = 0; pcs != null && j < pcs.length(); j++) {
+                JSONObject pc = pcs.optJSONObject(j);
+                if (pc != null && hostUuid.equals(pc.optString("hostUuid")) && pc.optBoolean("online") && pc.optBoolean("hosting")) {
+                    try {
+                        return new JSONObject(pc.toString()).put("username", friend.optString("username"));
+                    } catch (JSONException e) {
+                        return pc;
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
+    /** How to ask for a direct connection to this PC (an invite's or a friend's), or null. */
+    Tunnels.Target targetFor(String hostUuid) {
+        JSONObject g = guestInvite();
+        if (g != null) {
+            JSONObject host = g.optJSONObject("host");
+            if (host != null && hostUuid.equals(host.optString("uuid"))) {
+                return new Tunnels.Target(hostUuid, host.optLong("device"), host.optInt("port", 47989), host.optString("name"), ensureGuestHub(), guestToken());
+            }
+        }
+        if (!signedIn()) return null;
+        if (friends == null || System.currentTimeMillis() - friendsAt > FRIENDS_FRESH_MS) {
+            try {
+                friends = Service.call("GET", "/friends", null, token());
+                friendsAt = System.currentTimeMillis();
+            } catch (IOException ignored) {
+                // use what's cached
+            }
+        }
+        JSONObject pc = friendPc(hostUuid);
+        if (pc == null || !pc.optBoolean("tunnel") || pc.optLong("device") <= 0) return null;
+        return new Tunnels.Target(hostUuid, pc.optLong("device"), pc.optInt("port", 47989), pc.optString("name"), hub, token());
+    }
+
+    /**
+     * Before the PC list polls a friend's PC saved at a stand-in address: reopen its direct connection if it
+     * closed and the friend is hosting (at most every two minutes per PC). Blocking.
+     */
+    public void beforePoll(ComputerDetails details) {
+        String address = null;
+        for (ComputerDetails.AddressTuple t : new ComputerDetails.AddressTuple[] { details.manualAddress, details.localAddress, details.remoteAddress }) {
+            if (t != null && Tunnels.isTunnelAddress(t.address)) address = t.address;
+        }
+        if (address == null || started == 0) return;
+        String hostUuid = tunnels.hostFor(address);
+        if (hostUuid == null || tunnels.isOpen(hostUuid)) return;
+        synchronized (reopenTried) {
+            Long last = reopenTried.get(hostUuid);
+            if (last != null && System.currentTimeMillis() - last < REOPEN_EVERY_MS) return;
+            reopenTried.put(hostUuid, System.currentTimeMillis());
+        }
+        try {
+            tunnels.ensureFor(address);
+        } catch (IOException ignored) {
+            // shown offline
+        }
+    }
+
+    /** A stream is using this address (or "" when it ended): its tunnel never closes as idle meanwhile. */
+    public void setActiveStream(String address) {
+        activeStream = address == null ? "" : address;
+    }
+
+    // ---- invite links (guest) ----------------------------------------------------------------------
+
+    public String guestToken() {
+        return Secrets.get(ctx, "guestToken");
+    }
+
+    /** The invite this phone joined: { invite, host: { device, uuid, port, name, user } }, or null. */
+    public JSONObject guestInvite() {
+        String s = prefs().getString("guestInvite", "");
+        if (s.isEmpty() || guestToken().isEmpty()) return null;
+        try {
+            return new JSONObject(s);
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    synchronized Hub ensureGuestHub() {
+        if (guestHub == null) {
+            guestHub = new Hub(this::guestToken);
+            guestHub.addListener(msg -> {
+                if ("invite-ended".equals(msg.optString("type"))) leaveInviteLocally(msg.optString("reason", "ended"));
+            });
+            guestHub.addStateListener(this::changed);
+        }
+        return guestHub;
+    }
+
+    public Hub guestHub() {
+        return guestInvite() != null ? ensureGuestHub() : null;
+    }
+
+    /** Use up an invite link and become that PC's guest. Blocking; returns the invite. */
+    public JSONObject redeemInvite(String secret) throws IOException {
+        if (guestInvite() != null) leaveInvite();
+        JSONObject r;
+        try {
+            r = Service.call("POST", "/invites/redeem", new JSONObject().put("token", secret).put("name", deviceName(ctx)), null);
+        } catch (JSONException e) {
+            throw new IOException(e.getMessage());
+        }
+        String token = r.optString("token", "");
+        JSONObject host = r.optJSONObject("host");
+        if (token.isEmpty() || host == null || !host.optString("uuid").matches("[0-9A-Za-z-]{8,64}")) {
+            throw new IOException("Moonshine’s service gave an answer this app doesn’t understand.");
+        }
+        JSONObject saved;
+        try {
+            saved = new JSONObject().put("invite", r.optLong("invite")).put("host", host);
+        } catch (JSONException e) {
+            throw new IOException(e.getMessage());
+        }
+        Secrets.put(ctx, "guestToken", token);
+        prefs().edit().putString("guestInvite", saved.toString()).apply();
+        main.post(() -> ensureGuestHub().start());
+        changed();
+        return saved;
+    }
+
+    /** Leave the invite (this phone's choice). */
+    public void leaveInvite() {
+        JSONObject g = guestInvite();
+        final String token = guestToken();
+        if (g != null) {
+            final long id = g.optLong("invite");
+            run(() -> {
+                try {
+                    Service.call("POST", "/invites/end", new JSONObject().put("id", id), token);
+                } catch (IOException | JSONException ignored) {
+                    // the service ends it after a while anyway
+                }
+            });
+        }
+        leaveInviteLocally("left");
+    }
+
+    private void leaveInviteLocally(String reason) {
+        JSONObject g = guestInvite();
+        Secrets.put(ctx, "guestToken", "");
+        prefs().edit().remove("guestInvite").apply();
+        Hub h;
+        synchronized (this) {
+            h = guestHub;
+            guestHub = null;
+        }
+        if (h != null) h.stop(false);
+        if (g != null && g.optJSONObject("host") != null) {
+            String uuid = g.optJSONObject("host").optString("uuid");
+            tunnels.closeFor(uuid);
+            if (!"left".equals(reason)) {
+                notify("invite-ended", "expired".equals(reason) ? "That invite link ran out." : "Your invite to " + g.optJSONObject("host").optString("name", "that PC") + " has ended.", "", null);
+            }
+        }
+        changed();
+    }
+
+    // ---- live link messages ------------------------------------------------------------------------
+
+    private void onHubMessage(JSONObject msg) {
+        switch (msg.optString("type")) {
+            case "friends-changed":
+                refreshFriends();
+                break;
+            case "message": {
+                String from = clean(msg.optString("from"), 40);
+                String text = clean(msg.optString("text"), 200);
+                if (!from.isEmpty() && !text.isEmpty()) notify("message:" + from, friendLabel(from), text, null);
+                break;
+            }
+            case "play-invite":
+                onPlayInvite(msg);
+                break;
+            default:
+        }
+    }
+
+    static String clean(String s, int max) {
+        String t = s == null ? "" : s.replaceAll("[\\p{Cntrl}\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2069\\uFEFF]", " ").replaceAll("\\s+", " ").trim();
+        return t.length() > max ? t.substring(0, max) : t;
+    }
+
+    /** A friend's name as this account shows it: their nickname, else their username. */
+    public String friendLabel(String username) {
+        JSONObject f = friends;
+        JSONArray list = f != null ? f.optJSONArray("friends") : null;
+        for (int i = 0; list != null && i < list.length(); i++) {
+            JSONObject friend = list.optJSONObject(i);
+            if (friend != null && username.equalsIgnoreCase(friend.optString("username"))) {
+                String nick = clean(friend.optString("nickname"), 32);
+                return nick.isEmpty() ? username : nick;
+            }
+        }
+        return username;
+    }
+
+    /** "Join my game" from a friend: a notification, and a question on screen if the app is open. */
+    private void onPlayInvite(JSONObject msg) {
+        String id = msg.optString("id", "");
+        JSONObject from = msg.optJSONObject("from");
+        if (!id.matches("[A-Za-z0-9]{8,40}") || from == null || from.optString("username").isEmpty()) return;
+        if (!seenInvites.add(id)) return;
+        if (seenInvites.size() > 200) {
+            synchronized (seenInvites) {
+                seenInvites.remove(seenInvites.iterator().next());
+            }
+        }
+        PlayInvite inv = new PlayInvite(id, clean(from.optString("username"), 40), from.optLong("device"),
+                msg.optString("hostUuid", ""), clean(msg.optString("app"), 80), clean(msg.optString("game"), 80), clean(msg.optString("host"), 60));
+        if (!inv.hostUuid.matches("[0-9A-Za-z-]{8,64}")) return;
+        Activity a = resumed.get();
+        if (a != null && !a.isFinishing() && !(a instanceof com.limelight.Game)) {
+            FriendsActivity.askToJoin(a, inv);
+        } else {
+            notify("play:" + id, friendLabel(inv.from) + " invites you to play", (inv.game.isEmpty() ? inv.app : inv.game) + " on " + inv.host, inv);
+        }
+    }
+
+    /** A "join my game" invite. */
+    public static final class PlayInvite {
+        public final String id;
+        public final String from;
+        public final long device;
+        public final String hostUuid;
+        public final String app;
+        public final String game;
+        public final String host;
+
+        PlayInvite(String id, String from, long device, String hostUuid, String app, String game, String host) {
+            this.id = id;
+            this.from = from;
+            this.device = device;
+            this.hostUuid = hostUuid;
+            this.app = app.isEmpty() ? "a game" : app;
+            this.game = game;
+            this.host = host.isEmpty() ? "their PC" : host;
+        }
+
+        void into(Intent i) {
+            i.putExtra("invite_id", id).putExtra("invite_from", from).putExtra("invite_device", device)
+                    .putExtra("invite_host_uuid", hostUuid).putExtra("invite_app", app).putExtra("invite_game", game).putExtra("invite_host", host);
+        }
+
+        static PlayInvite from(Intent i) {
+            String id = i.getStringExtra("invite_id");
+            if (id == null) return null;
+            return new PlayInvite(id, String.valueOf(i.getStringExtra("invite_from")), i.getLongExtra("invite_device", 0),
+                    String.valueOf(i.getStringExtra("invite_host_uuid")), String.valueOf(i.getStringExtra("invite_app")),
+                    String.valueOf(i.getStringExtra("invite_game")), String.valueOf(i.getStringExtra("invite_host")));
+        }
+    }
+
+    /** Tell the friend whether this phone is joining. */
+    public void answerPlayInvite(PlayInvite inv, boolean joining) {
+        cancelNotification("play:" + inv.id);
+        run(() -> {
+            try {
+                Service.call("POST", "/friends/play-answer", new JSONObject().put("device", inv.device).put("id", inv.id).put("status", joining ? "joined" : "declined"), token());
+            } catch (IOException | JSONException ignored) {
+                // their popup times out by itself
+            }
+        });
+    }
+
+    // ---- notifications -----------------------------------------------------------------------------
+
+    private void makeChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return;
+        NotificationChannel ch = new NotificationChannel(CHANNEL, ctx.getString(R.string.moonshine_channel_friends), NotificationManager.IMPORTANCE_HIGH);
+        ch.setDescription(ctx.getString(R.string.moonshine_channel_friends_desc));
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm != null) nm.createNotificationChannel(ch);
+    }
+
+    private void notify(String key, String title, String text, PlayInvite inv) {
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm == null) return;
+        Intent open = new Intent(ctx, FriendsActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        if (inv != null) {
+            inv.into(open);
+            sign(open);
+            open.setAction("com.moonshine.PLAY_INVITE." + inv.id); // one PendingIntent per invite
+        }
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT | (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? PendingIntent.FLAG_IMMUTABLE : 0);
+        PendingIntent pi = PendingIntent.getActivity(ctx, key.hashCode(), open, flags);
+        android.app.Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                ? new android.app.Notification.Builder(ctx, CHANNEL)
+                : new android.app.Notification.Builder(ctx);
+        b.setSmallIcon(R.drawable.ic_stat_moonshine)
+                .setContentTitle(title)
+                .setContentText(text)
+                .setStyle(new android.app.Notification.BigTextStyle().bigText(text))
+                .setAutoCancel(true)
+                .setContentIntent(pi);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) b.setColor(0xFFFF5470);
+        try {
+            nm.notify(key, 1, b.build());
+        } catch (SecurityException ignored) {
+            // notifications not allowed
+        }
+    }
+
+    void cancelNotification(String key) {
+        NotificationManager nm = (NotificationManager) ctx.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm != null) nm.cancel(key, 1);
+    }
+}
