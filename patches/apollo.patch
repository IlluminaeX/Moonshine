+  void reorder_gamepads(std::vector<std::shared_ptr<input_t>> order) {
+    using namespace std::literals;
+    // On the input thread, so no controller packet is handled halfway through.
+    task_pool.push([order = std::move(order)]() {
+      struct pad_ref {
+        std::shared_ptr<input_t> input;
+        int index;
+      };
+
+      auto pads = std::make_shared<std::vector<pad_ref>>();
+      for (const auto &input : order) {
+        for (int i = 0; i < (int) input->gamepads.size(); ++i) {
+          if (input->gamepads[i].id >= 0) {
+            pads->push_back({input, i});
+          }
+        }
+      }
+
+      // Unplug them all...
+      for (auto &pad : *pads) {
+        auto &gamepad = pad.input->gamepads[pad.index];
+        free_gamepad(platf_input, gamepad.id);
+        gamepad.id = -1;
+        gamepad.parked = true;
+      }
+
+      // ...and once Windows has noticed, plug them back in the new order. Windows gives each new
+      // controller the lowest free player number, so the first one plugged in becomes player 1.
+      task_pool.pushDelayed([pads]() {
+        for (auto &pad : *pads) {
+          auto &gamepad = pad.input->gamepads[pad.index];
+          gamepad.parked = false;
+          auto id = alloc_id(gamepadMask);
+          if (id < 0) {
+            continue;
+          }
+          if (platf::alloc_gamepad(platf_input, {id, (std::uint8_t) pad.index}, gamepad.arrival, pad.input->feedback_queue)) {
+            free_id(gamepadMask, id);
+            continue;
+          }
+          gamepad.id = id;
+          platf::gamepad_update(platf_input, id, gamepad.gamepad_state);
+        }
+      }, 600ms);
+    });
+  }
