+  // Moonshine: a key made at each start and written next to the host's state file, so the Moonshine
+  // app on this PC can use the API (and show the web UI) without the web login.
+  std::string moonshineToken;
+
+  bool hasMoonshineToken(req_https_t request) {
+    if (moonshineToken.empty()) {
+      return false;
+    }
+    auto header = request->header.find("x-moonshine-token");
+    if (header == request->header.end() || header->second != moonshineToken) {
+      return false;
+    }
+    auto address = net::addr_to_normalized_string(request->remote_endpoint().address());
+    return net::from_address(address) == net::PC;
+  }
