+
+  /// GET /moonshine/take?id=...&key=...&offset=0: a friend's phone fetches a file this PC's user offered it.
+  /// The key is the one-time secret Moonshine told that phone (through the friends service).
+  template<class T>
+  void moonshine_take(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    if (!config::sunshine.moonshine_managed || !moonshine_listening()) {
+      not_found<T>(response, request);
+      return;
+    }
+    auto args = request->parse_query_string();
+    auto id = args.find("id");
+    auto key = args.find("key");
+    std::uint64_t offset = 0;
+    try {
+      auto off = args.find("offset");
+      offset = off == args.end() ? 0 : std::stoull(off->second);
+    } catch (...) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "bad offset"}});
+      return;
+    }
+    if (id == args.end() || key == args.end()) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "bad request"}});
+      return;
+    }
+    std::string piece;
+    std::uint64_t size = 0;
+    const int result = take_file_piece(id->second, key->second, offset, piece, size);
+    if (result == 1) {
+      not_found<T>(response, request);
+      return;
+    }
+    if (result != 0) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::server_error_internal_server_error, {{"error", "unreadable"}});
+      return;
+    }
+    SimpleWeb::CaseInsensitiveMultimap headers;
+    headers.emplace("Content-Type", "application/octet-stream");
+    headers.emplace("X-Moonshine-Size", std::to_string(size));
+    response->write(SimpleWeb::StatusCode::success_ok, piece, headers);
+  }
+
+  /// GET /moonshine/pair?pin=1234&name=Friend-PC: ask this PC's user to accept a pairing.
+  template<class T>
+  void moonshine_pair(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    if (!config::sunshine.moonshine_managed) {
+      not_found<T>(response, request);
+      return;
+    }
+    auto args = request->parse_query_string();
+    auto pin = get_arg(args, "pin", "");
+    auto name = get_arg(args, "name", "").substr(0, 64);
+    if (pin.size() != 4 || !std::all_of(pin.begin(), pin.end(), [](unsigned char c) {
+          return std::isdigit(c);
+        })) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "PIN must be 4 digits"}});
+      return;
+    }
+    if (!config::sunshine.enable_pairing) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_forbidden, {{"error", "disabled"}});
+      return;
+    }
+    if (!moonshine_listening()) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::server_error_service_unavailable, {{"error", "closed"}});
+      return;
+    }
+
+    offer::offer_t o;
+    o.id = uuid_util::uuid_t::generate().string();
+    o.pin = std::move(pin);
+    o.name = name.empty() ? "A device" : std::move(name);
+    o.address = net::addr_to_normalized_string(request->remote_endpoint().address());
+    o.created = std::chrono::steady_clock::now();
+    {
+      std::lock_guard lg {offer::mtx};
+      offer::prune(o.created);
+      auto open = std::count_if(offer::offers.begin(), offer::offers.end(), [](const auto &other) {
+        return other.decision == 0;
+      });
+      if (open >= 8) {
+        moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_too_many_requests, {{"error", "busy"}});
+        return;
+      }
+      offer::offers.push_back(o);
+    }
+    BOOST_LOG(info) << "Pairing request from ["sv << o.name << "] at "sv << o.address << " is waiting for the host's user"sv;
+    moonshine_reply<T>(response, SimpleWeb::StatusCode::success_ok, {{"id", o.id}});
+  }
+
+  /// GET /moonshine/invite?name=Dani-PC&app=Desktop&port=47989: invite this PC's user to join a stream.
+  template<class T>
+  void moonshine_invite(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    if (!config::sunshine.moonshine_managed) {
+      not_found<T>(response, request);
+      return;
+    }
+    if (!moonshine_listening()) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::server_error_service_unavailable, {{"error", "closed"}});
+      return;
+    }
+    auto args = request->parse_query_string();
+    invite_box::invite_t i;
+    i.id = uuid_util::uuid_t::generate().string();
+    i.name = get_arg(args, "name", "").substr(0, 64);
+    if (i.name.empty()) {
+      i.name = "A friend";
+    }
+    i.app = get_arg(args, "app", "Desktop").substr(0, 128);
+    try {
+      i.port = std::stoi(get_arg(args, "port", "47989"));
+    } catch (...) {
+      i.port = 0;
+    }
+    if (i.port <= 0 || i.port > 65535) {
+      moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "bad port"}});
+      return;
+    }
+    i.address = net::addr_to_normalized_string(request->remote_endpoint().address());
+    i.created = std::chrono::steady_clock::now();
+    {
+      std::lock_guard lg {invite_box::mtx};
+      invite_box::prune(i.created);
+      // One open invite per inviter, and only a few in all
+      invite_box::invites.remove_if([&](const auto &other) {
+        return other.address == i.address && other.decision == 0;
+      });
+      if (invite_box::invites.size() >= 8) {
+        moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_too_many_requests, {{"error", "busy"}});
+        return;
+      }
+      invite_box::invites.push_back(i);
+    }
+    BOOST_LOG(info) << "Invite to play from ["sv << i.name << "] at "sv << i.address << " is waiting for the host's user"sv;
+    moonshine_reply<T>(response, SimpleWeb::StatusCode::success_ok, {{"id", i.id}});
+  }
+
+  /// GET /moonshine/invite-status?id=...: did they join?
+  template<class T>
+  void moonshine_invite_status(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    auto args = request->parse_query_string();
+    auto id = get_arg(args, "id", "");
+    std::lock_guard lg {invite_box::mtx};
+    for (const auto &i : invite_box::invites) {
+      // Only the inviter may ask
+      if (i.id == id && i.address == net::addr_to_normalized_string(request->remote_endpoint().address())) {
+        moonshine_reply<T>(response, SimpleWeb::StatusCode::success_ok, {{"status", i.decision == 0 ? "pending" : i.decision == 1 ? "joined" : "declined"}});
+        return;
+      }
+    }
+    moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_not_found, {{"error", "unknown invite"}});
+  }
+
+  /// GET /moonshine/pair-status?id=...: has the host's user answered?
+  template<class T>
+  void moonshine_pair_status(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    auto args = request->parse_query_string();
+    auto id = get_arg(args, "id", "");
+    std::lock_guard lg {offer::mtx};
+    for (const auto &o : offer::offers) {
+      if (o.id == id) {
+        moonshine_reply<T>(response, SimpleWeb::StatusCode::success_ok, {{"status", o.decision == 0 ? "pending" : o.decision == 1 ? "accepted" : "declined"}});
+        return;
+      }
+    }
+    moonshine_reply<T>(response, SimpleWeb::StatusCode::client_error_not_found, {{"error", "unknown request"}});
+  }
