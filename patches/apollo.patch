+      if (out.size() != n) {
+        return 2;  // the file shrank or went away while it was being sent
+      }
+      size = s.size;
+      s.touched = std::chrono::steady_clock::now();
+      s.sent = std::max<std::uint64_t>(s.sent, offset + out.size());
+      if (s.sent >= s.size) {
+        s.done = true;
+      }
+      return 0;
+    }
+    return 1;
+  }
+
+  nlohmann::json pending_requests() {
+    auto now = std::chrono::steady_clock::now();
+    auto age = [&](auto since) {
+      return std::chrono::duration_cast<std::chrono::seconds>(now - since).count();
+    };
+
+    // A millisecond clock for telling which of two requests came first.
+    auto at = [](auto when) {
+      return std::chrono::duration_cast<std::chrono::milliseconds>(when.time_since_epoch()).count();
+    };
+
+    nlohmann::json streams = nlohmann::json::array();
+    {
+      std::lock_guard lg {approval::mtx};
+      approval::last_poll = now;
+      for (const auto &req : approval::waiting) {
+        if (req->decision != 0) {
+          continue;
+        }
+        streams.push_back({{"id", req->id}, {"uuid", req->uuid}, {"name", req->name}, {"address", req->address}, {"app", req->app}, {"age", age(req->created)}});
+      }
+    }
+
+    // Pairing sessions that are waiting for a PIN (the same ones pin() completes).
+    nlohmann::json pairing = nlohmann::json::array();
+    for (auto &[id, sess] : map_id_sess) {
+      auto &async_response = sess.async_insert_pin.response;
+      bool waiting_for_pin = (async_response.has_left() && async_response.left()) || (async_response.has_right() && async_response.right());
+      if (waiting_for_pin) {
+        pairing.push_back({
+          {"id", std::to_string(sess.created.time_since_epoch().count())},
+          {"name", sess.client.name},
+          {"address", sess.remote},
+          {"age", age(sess.created)},
+          {"at", at(sess.created)},
+        });
+      }
+    }
+
+    // Pairing requests from another Moonshine, which sent its PIN along (see namespace offer).
+    nlohmann::json offers = nlohmann::json::array();
+    {
+      std::lock_guard lg {offer::mtx};
+      offer::prune(now);
+      for (const auto &o : offer::offers) {
+        if (o.decision == 0) {
+          offers.push_back({{"id", o.id}, {"pin", o.pin}, {"name", o.name}, {"address", o.address}, {"age", age(o.created)}, {"at", at(o.created)}});
+        }
+      }
+    }
+
+    nlohmann::json invites = nlohmann::json::array();
+    {
+      std::lock_guard lg {invite_box::mtx};
+      invite_box::prune(now);
+      for (const auto &i : invite_box::invites) {
+        if (i.decision == 0) {
+          invites.push_back({{"id", i.id}, {"name", i.name}, {"app", i.app}, {"address", i.address}, {"port", i.port}, {"age", age(i.created)}});
+        }
+      }
+    }
+
+    // Files paired devices are sending: waiting for an answer, arriving, or here and waiting to be taken
+    nlohmann::json files = nlohmann::json::array();
+    {
+      std::lock_guard lg {file_box::mtx};
+      file_box::prune(now);
+      for (const auto &f : file_box::files) {
+        if (f.decision < 0) {
+          continue;
+        }
+        const char *state = f.decision == 0 ? "waiting" : f.done ? "done" : "receiving";
+        files.push_back({{"id", f.id}, {"name", f.name}, {"from", f.from}, {"uuid", f.uuid}, {"size", f.size}, {"received", f.received}, {"state", state}, {"age", age(f.created)}});
+      }
+    }
+
+    return {{"streams", streams}, {"pairing", pairing}, {"offers", offers}, {"invites", invites}, {"files", files}};
+  }
+
+  bool decide_stream_request(std::uint64_t id, bool allow) {
+    std::lock_guard lg {approval::mtx};
+    for (const auto &req : approval::waiting) {
+      if (req->id == id && req->decision == 0) {
+        req->decision = allow ? 1 : -1;
+        approval::cv.notify_all();
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void forget_stream_approval(const std::string &uuid) {
+    std::lock_guard lg {approval::mtx};
+    approval::granted_until.erase(uuid);
+  }
+
+  bool decide_pair_offer(const std::string &id, bool allow) {
+    std::lock_guard lg {offer::mtx};
+    for (auto &o : offer::offers) {
+      if (o.id == id && o.decision == 0) {
+        o.decision = allow ? 1 : -1;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  template<class T>
+  void moonshine_reply(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, SimpleWeb::StatusCode code, const nlohmann::json &body) {
+    SimpleWeb::CaseInsensitiveMultimap headers {{"Content-Type", "application/json"}};
+    response->write(code, body.dump(), headers);
+    response->close_connection_after_response = true;
+  }
+
+  /// Is Moonshine running on this PC to show a prompt? (It polls pending_requests() every second.)
+  bool moonshine_listening() {
+    std::lock_guard lg {approval::mtx};
+    return std::chrono::steady_clock::now() - approval::last_poll <= approval::POLL_ALIVE;
+  }
+
+  /// GET /moonshine/hello: tells another Moonshine that this host is one too, and how many are streaming from it
+  /// (just the count; who and what stays private).
+  template<class T>
+  void moonshine_hello(std::shared_ptr<typename SimpleWeb::ServerBase<T>::Response> response, std::shared_ptr<typename SimpleWeb::ServerBase<T>::Request> request) {
+    if (!config::sunshine.moonshine_managed) {
+      not_found<T>(response, request);
+      return;
+    }
+    moonshine_reply<T>(response, SimpleWeb::StatusCode::success_ok, {{"app", "moonshine"}, {"name", config::nvhttp.sunshine_name}, {"listening", moonshine_listening()}, {"guests", rtsp_stream::get_all_session_activity().size()}, {"busy", proc::proc.running() > 0}});
+  }
