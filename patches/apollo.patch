+    using namespace std::chrono_literals;
+    constexpr auto WAIT = 60s;  // Moonlight waits up to 120s for /launch and /resume
+    constexpr auto GRACE = 3min;  // reconnects after an approval don't ask again right away
+    constexpr auto POLL_ALIVE = 5s;  // no poll for this long means Moonshine isn't running
+
+    struct request_t {
+      std::uint64_t id;
+      std::string uuid;
+      std::string name;
+      std::string address;
+      std::string app;
+      std::chrono::steady_clock::time_point created;
+      int decision = 0;  // 0 waiting, 1 allowed, -1 declined
+    };
+
+    std::mutex mtx;
+    std::condition_variable cv;
+    std::list<std::shared_ptr<request_t>> waiting;
+    std::unordered_map<std::string, std::chrono::steady_clock::time_point> granted_until;
+    std::chrono::steady_clock::time_point last_poll {};
+    std::uint64_t next_id = 1;
