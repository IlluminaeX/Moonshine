new file mode 100644
index 00000000..879792cc
--- /dev/null
+++ b/src/moonshine_adaptive.h
@@ -0,0 +1,162 @@
+/**
+ * @file src/moonshine_adaptive.h
+ * @brief Moonshine: adaptive video quality for one stream.
+ *
+ * Two things tell the host the stream is asking for more than the connection carries: the viewer's
+ * player reporting lost video (frames it couldn't rebuild), and the round trip to the viewer growing
+ * well past its usual time (data piling up in a queue, which often happens with hardly any loss).
+ * Either one is "trouble". When it keeps happening the encoder bitrate is lowered a step; after a long
+ * clean stretch it is raised again, but never back to the level that just failed (that bouncing is why
+ * the player doesn't do this itself). Each change restarts the encoder, so changes are spaced out.
+ *
+ * The controller only decides: it answers with a "scale" (a share of the bitrate the viewer picked)
+ * and knows nothing about encoders, so it can be tested with a made-up clock.
+ */
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <deque>
+#include <optional>
+
+namespace moonshine {
+  class adaptive_controller_t {
+  public:
+    using clock = std::chrono::steady_clock;
+    using seconds = std::chrono::duration<double>;
+
+    // Tuning
+    static constexpr double grace_s = 5;  ///< ignore the stream's first seconds: starting up always loses a frame
+    static constexpr double window_s = 2;  ///< losses this close together count as one bad patch
+    static constexpr int events_to_drop = 2;  ///< losses within the window that lower the quality
+    static constexpr double drop_factor = 0.8;
+    static constexpr double min_between_drops_s = 4;
+    static constexpr double min_after_rise_s = 1;  ///< a rise that fails is undone quickly
+    static constexpr double clean_before_rise_s = 12;  ///< quiet this long (and since the last change) before going up
+    static constexpr double rise_factor = 1.12;
+    static constexpr double bad_rise_s = 20;  ///< a loss this soon after going up means that level was too high
+    static constexpr double relax_s = 60;  ///< the "too high" level is forgotten a step at a time after this long quiet
+    static constexpr double min_scale = 0.25;
+    static constexpr double rtt_window_s = 30;  ///< the usual round trip is the lowest seen in this long
+    static constexpr double rtt_ratio = 1.5;  ///< a round trip this many times the usual is trouble...
+    static constexpr double rtt_margin_ms = 15;  ///< ...and at least this much above it, so small links don't trip on jitter
+    static constexpr double rtt_hold_s = 0.3;  ///< trouble must last this long, and counts once per this long after
+
+    explicit adaptive_controller_t(clock::time_point start):
+        start_ {start}, last_change_ {start}, last_trouble_ {start}, ceiling_checked_ {start} {
+    }
+
+    /** Trouble: the video player lost something it couldn't rebuild (note_rtt adds the other kind). */
+    void note_trouble(clock::time_point now) {
+      if (secs(start_, now) < grace_s) {
+        return;
+      }
+      troubles_.push_back(now);
+      last_trouble_ = now;
+    }
+
+    /**
+     * The round trip to the viewer, in milliseconds (0: not measured yet). Call with every reading.
+     * A round trip that stays well above the usual one counts as trouble.
+     */
+    void note_rtt(clock::time_point now, double rtt_ms) {
+      if (rtt_ms <= 0) {
+        return;
+      }
+      // Lowest round trip in the last rtt_window_s: a queue of readings that only ever gets higher
+      while (!rtts_.empty() && rtts_.back().ms >= rtt_ms) {
+        rtts_.pop_back();
+      }
+      rtts_.push_back({now, rtt_ms});
+      while (secs(rtts_.front().at, now) > rtt_window_s) {
+        rtts_.pop_front();
+      }
+      const auto usual = rtts_.front().ms;
+      if (rtt_ms <= std::max(usual * rtt_ratio, usual + rtt_margin_ms)) {
+        slow_since_.reset();
+        return;
+      }
+      if (!slow_since_) {
+        slow_since_ = now;
+      }
+      if (secs(*slow_since_, now) >= rtt_hold_s) {
+        note_trouble(now);
+        slow_since_ = now;
+      }
+    }
+
+    /**
+     * Call often. Returns the new scale (min_scale..1) when the bitrate should change, otherwise a
+     * negative number.
+     */
+    double evaluate(clock::time_point now) {
+      while (!troubles_.empty() && secs(troubles_.front(), now) > window_s) {
+        troubles_.pop_front();
+      }
+      const auto since_change = secs(last_change_, now);
+      const auto since_trouble = secs(last_trouble_, now);
+
+      // A long quiet spell: the level that failed before may work now
+      if (since_trouble >= relax_s && secs(ceiling_checked_, now) >= relax_s) {
+        ceiling_ = std::min(1.0, ceiling_ + 0.1);
+        ceiling_checked_ = now;
+      }
+
+      if (static_cast<int>(troubles_.size()) >= events_to_drop && since_change >= (rose_last_ ? min_after_rise_s : min_between_drops_s)) {
+        auto lower = std::max(min_scale, scale_ * drop_factor);
+        if (rose_last_ && since_change < bad_rise_s) {
+          // That level was too high: go back to the one before it, and don't try it again for a while
+          ceiling_ = std::min(ceiling_, scale_before_rise_);
+          lower = scale_before_rise_;
+        }
+        troubles_.clear();
+        if (lower >= scale_ - 1e-9) {
+          return -1;  // already as low as it goes
+        }
+        scale_ = std::max(min_scale, std::min(lower, ceiling_));
+        last_change_ = now;
+        rose_last_ = false;
+        return scale_;
+      }
+
+      if (troubles_.empty() && since_trouble >= clean_before_rise_s && since_change >= clean_before_rise_s && scale_ < ceiling_ - 1e-9) {
+        scale_before_rise_ = scale_;
+        scale_ = std::min(ceiling_, scale_ * rise_factor);
+        last_change_ = now;
+        rose_last_ = true;
+        return scale_;
+      }
+      return -1;
+    }
+
+    double scale() const {
+      return scale_;
+    }
+
+    double ceiling() const {
+      return ceiling_;
+    }
+
+  private:
+    static double secs(clock::time_point from, clock::time_point to) {
+      return std::chrono::duration_cast<seconds>(to - from).count();
+    }
+
+    struct rtt_reading_t {
+      clock::time_point at;
+      double ms;
+    };
+
+    clock::time_point start_;
+    clock::time_point last_change_;
+    clock::time_point last_trouble_;
+    clock::time_point ceiling_checked_;
+    std::deque<clock::time_point> troubles_;
+    std::deque<rtt_reading_t> rtts_;
+    std::optional<clock::time_point> slow_since_;
+    double scale_ = 1.0;
+    double ceiling_ = 1.0;
+    double scale_before_rise_ = 1.0;
+    bool rose_last_ = false;
+  };
+}  // namespace moonshine
