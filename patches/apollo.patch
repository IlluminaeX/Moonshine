+  /// The device behind this HTTPS request, if it may send files to this PC; otherwise answers and returns null.
+  crypto::named_cert_t *file_sender(resp_https_t response, req_https_t request) {
+    auto named_cert_p = get_verified_cert(request);
+    if (!config::sunshine.moonshine_managed) {
+      not_found<SunshineHTTPS>(response, request);
+      return nullptr;
+    }
+    if (!named_cert_p || !(named_cert_p->perm & PERM::file_upload)) {
+      moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_forbidden, {{"error", "not-allowed"}});
+      return nullptr;
+    }
+    return named_cert_p;
+  }
+
+  /// POST /moonshine/file/offer?name=photo.png&size=12345: ask this PC's user to accept a file.
+  void moonshine_file_offer(resp_https_t response, req_https_t request) {
+    auto sender = file_sender(response, request);
+    if (!sender) {
+      return;
+    }
+    if (!moonshine_listening()) {
+      moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::server_error_service_unavailable, {{"error", "closed"}});
+      return;
+    }
+    auto args = request->parse_query_string();
+    std::uint64_t size = 0;
+    try {
+      size = std::stoull(get_arg(args, "size", "0"));
+    } catch (...) {
+      size = 0;
+    }
+    if (size == 0) {
+      moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "bad-size"}});
+      return;
+    }
+    {
+      std::error_code ec;
+      std::filesystem::create_directories(file_box::dir(), ec);
+      auto space = std::filesystem::space(file_box::dir(), ec);
+      if (!ec && (space.available < file_box::KEEP_FREE || space.available - file_box::KEEP_FREE < size)) {
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_payload_too_large, {{"error", "no-space"}});
+        return;
+      }
+    }
+
+    file_box::file_t f;
+    f.id = uuid_util::uuid_t::generate().string();
+    f.name = file_box::safe_name(get_arg(args, "name", "file"));
+    f.from = sender->name;
+    f.uuid = sender->uuid;
+    f.size = size;
+    f.created = f.touched = std::chrono::steady_clock::now();
+    {
+      std::lock_guard lg {file_box::mtx};
+      file_box::prune(f.created);
+      auto mine = std::count_if(file_box::files.begin(), file_box::files.end(), [&](const auto &o) {
+        return o.uuid == f.uuid && !o.done;
+      });
+      if (mine >= 8 || file_box::files.size() >= 32) {
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_too_many_requests, {{"error", "busy"}});
+        return;
+      }
+      file_box::files.push_back(f);
+    }
+    BOOST_LOG(info) << "File ["sv << f.name << "] ("sv << f.size << " bytes) from ["sv << f.from << "] is waiting for the host's user"sv;
+    moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::success_ok, {{"id", f.id}});
+  }
+
+  /// GET /moonshine/file/status?id=...: answered yet, and how much has arrived.
+  void moonshine_file_status(resp_https_t response, req_https_t request) {
+    auto sender = file_sender(response, request);
+    if (!sender) {
+      return;
+    }
+    auto id = get_arg(request->parse_query_string(), "id", "");
+    std::lock_guard lg {file_box::mtx};
+    file_box::prune(std::chrono::steady_clock::now());
+    for (const auto &f : file_box::files) {
+      if (f.id == id && f.uuid == sender->uuid) {
+        const char *status = f.decision == 0 ? "pending" : f.decision < 0 ? "declined" : f.done ? "done" : "accepted";
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::success_ok, {{"status", status}, {"received", f.received}});
+        return;
+      }
+    }
+    moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_not_found, {{"error", "unknown"}});
+  }
+
+  /// POST /moonshine/file/chunk?id=...&offset=N, the piece as the body: pieces arrive in order.
+  void moonshine_file_chunk(resp_https_t response, req_https_t request) {
+    auto sender = file_sender(response, request);
+    if (!sender) {
+      return;
+    }
+    auto args = request->parse_query_string();
+    auto id = get_arg(args, "id", "");
+    std::uint64_t offset = 0;
+    try {
+      offset = std::stoull(get_arg(args, "offset", "0"));
+    } catch (...) {
+      offset = ~0ull;
+    }
+    const std::string body = request->content.string();
+    std::lock_guard lg {file_box::mtx};
+    for (auto &f : file_box::files) {
+      if (f.id != id || f.uuid != sender->uuid) {
+        continue;
+      }
+      if (f.decision != 1 || f.done) {
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_conflict, {{"error", f.decision < 0 ? "declined" : "not-accepted"}});
+        return;
+      }
+      if (offset != f.received || body.empty() || body.size() > file_box::MAX_CHUNK || f.received + body.size() > f.size) {
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_bad_request, {{"error", "bad-piece"}, {"received", f.received}});
+        return;
+      }
+      std::ofstream out(file_box::part(f.id), std::ios::binary | std::ios::app);
+      out.write(body.data(), (std::streamsize) body.size());
+      out.close();
+      if (!out) {
+        moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::server_error_internal_server_error, {{"error", "write-failed"}});
+        return;
+      }
+      f.received += body.size();
+      f.touched = std::chrono::steady_clock::now();
+      if (f.received == f.size) {
+        f.done = true;
+        BOOST_LOG(info) << "File ["sv << f.name << "] from ["sv << f.from << "] arrived"sv;
+      }
+      moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::success_ok, {{"received", f.received}, {"done", f.done}});
+      return;
+    }
+    moonshine_reply<SunshineHTTPS>(response, SimpleWeb::StatusCode::client_error_not_found, {{"error", "unknown"}});
+  }
+
+  /// POST /moonshine/file/cancel?id=...: the sender gave up.
+  void moonshine_file_cancel(resp_https_t response, req_https_t request) {
+    auto sender = file_sender(response, request);
+    if (!sender) {
+      return;
+    }
+    auto id = get_arg(request->parse_query_string(), "id", "");
+    std::lock_guard lg {file_box::mtx};
+    bool found = false;
+    file_box::files.remove_if([&](const file_box::file_t &f) {
+      if (f.id != id || f.uuid != sender->uuid || f.done) {
+        return false;
+      }
+      file_box::discard(f);
+      found = true;
+      return true;
+    });
+    moonshine_reply<SunshineHTTPS>(response, found ? SimpleWeb::StatusCode::success_ok : SimpleWeb::StatusCode::client_error_not_found, {{"ok", found}});
+  }
